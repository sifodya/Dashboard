=0,v=[],f=[];i.forEach(function(_){var z=c.options.addPath;typeof c.options.addPath=="function"&&(z=c.options.addPath(_,n));var b=c.services.interpolator.interpolate(z,{lng:_,ns:n});c.options.request(c.options,b,h,function(E,H){m+=1,v.push(E),f.push(H),m===i.length&&s&&s(v,f)})})}}},{key:"reload",value:function(){var i=this,n=this.services,r=n.backendConnector,o=n.languageUtils,s=n.logger,c=r.language;if(!(c&&c.toLowerCase()==="cimode")){var h=[],m=function(f){var _=o.toResolveHierarchy(f);_.forEach(function(z){h.indexOf(z)<0&&h.push(z)})};m(c),this.allOptions.preload&&this.allOptions.preload.forEach(function(v){return m(v)}),h.forEach(function(v){i.allOptions.ns.forEach(function(f){r.read(v,f,"read",null,null,function(_,z){_&&s.warn("loading namespace ".concat(f," for language ").concat(v," failed"),_),!_&&z&&s.log("loaded namespace ".concat(f," for language ").concat(v),z),r.loaded("".concat(v,"|").concat(f),_,z)})})})}}}]),e})();rH.type="backend";const xwt=JSON.parse(`{"menu-label":"À propos","bannerV2Title":"À propos de nous","title":"Notre histoire","summary":{"text":[{"description":"S’appuyant sur une technologie novatrice et sur de nombreuses années d’expérience dans l'industrie, Audiokinetic établit un nouveau standard de production audio pour l'interactivité dans les médias, les jeux, le divertissement basé sur la localisation et l'industrie automobile. Audiokinetic est un partenaire de confiance, et ce, auprès des plus importants acteurs en matière de développeurs, de fabricants d'équipement d'origine et d'entreprises de l'audio professionnelles à l'échelle internationale."},{"description":"À titre de principal fournisseur mondial de solutions audio multiplateformes, Audiokinetic offre une approche intégrée à la production d'audio interactif par le biais de solutions d'audio interactif étoffées à la fine pointe et d'un flux de travail révolutionnaire. Les solutions intergicielles de l'entreprise, incluant les systèmes de création primés Wwise® et SoundSeed®, offrent aux concepteurs de son et aux programmeurs audio un outil de création et un moteur audio rentables et complets afin de concevoir des expériences interactives innovantes. En faisant appel à ses technologies de pointe et ses services sans égal, Audiokinetic s'engage à inspirer les concepteurs sonores et les programmeurs audio à créer des produits qui propulsent l'expérience audio immersive vers de nouveaux sommets."}]},"about-cards":{"2000":{"title":"2000","description":"Audiokinetic a été fondée en 2000 par Martin H. Klein, notre président et PDG. En collaboration avec un personnel chevronné et des experts des industries de la musique, du cinéma et du jeu vidéo, M. Klein a entrepris de développer Wwise®, un intergiciel intégré de création sonore. Leur objectif était d’aider les programmeurs audio et les concepteurs sonores à offrir des expériences de jeu immersives."},"2003":{"title":"2003","description":"Audiokinetic a ouvert les portes de ses premiers bureaux en 2003, dans le Vieux-Port de Montréal."},"2005":{"title":"2005","description":"Audiokinetic a participé à son premier GDC en 2005! Les trois mousquetaires, Martin H. Klein, Simon Ashby et Jacques Deveau, ont pris leur envol vers San Francisco pour y rencontrer une communauté de développeurs et leur présenter Wwise."},"2006":{"title":"2006","description":"En 2006, la première version commerciale de Wwise et son flux de travail révolutionnaire ont vu le jour. Microsoft Game Studios (MGS) a été le tout premier client avec Shadowrun, un jeu conçu pour la nouvelle génération de plateformes de jeu, et le premier titre à utiliser Wwise. Conçu pour Microsoft Vista et Xbox 360, Shadowrun était un jeu multijoueur et multiplateforme en temps réel."},"2007":{"title":"2007","description":"En 2007, Audiokinetic a lancé sa première Tournée Wwise, à Tokyo et à Londres. Aujourd'hui, la Tournée Wwise est un événement anticipé de l'industrie, mettant en vedette le meilleur de l'audio pour les jeux provenant des plus importants développeurs à l'échelle mondiale. Depuis, 14 villes en ont été l'hôte."},"2009":{"title":"2009","description":"Audiokinetic a rapidement misé sur son succès, introduisant ainsi ses premiers plugiciels internes, SoundSeed et Wwise Motion, en 2009."},"2010":{"title":"2010","description":"2010 a été témoin du 100e jeu publié avec Wwise. Des jeux indépendants aux jeux AAA, les professionnels de l'audio ont commencé à adopter Wwise."},"2011":{"title":"2011","description":"En 2011, Audiokinetic a atteint l'étape de commercialisation, étendant ainsi sa portée à toutes les plateformes de nouvelle génération. Audiokinetic s'est positionnée comme le principal fournisseur mondial de solutions audio multiplateformes interactives, et Wwise est rapidement devenu la norme de l'industrie pour les jeux et les médias interactifs."},"2012":{"title":"2012","description":"En 2012, Audiokinetic a introduit le programme de partenaire certifié pour les développeurs tiers et a lancé les produits partenaires Izotope, McDSP et AudioEase. Ceci a introduit des plugiciels audio professionnels à l'univers du jeu et de l'interactivité."},"2013":{"title":"2013","description":"2013 a été témoin du 500e jeu publié avec Wwise. En 2013, Audiokinetic a annoncé la création de sa filiale japonaise, Audiokinetic K.K."},"2014":{"title":"2014","description":"En 2014, Audiokinetic a lancé son programme éducatif avec certifications en ligne, documentation détaillée, tutoriels et jeux échantillons pour les écoles, ainsi que son programme de formation des formateurs, désormais connu sous le nom de programme d'instructeurs certifiés. Aujourd'hui, nous comptons plus de 200 universités et établissements enregistrés à l'échelle mondiale qui enseignent Wwise.\\n\\n En 2014, Audiokinetic s'est positionnée comme un pionnier de la réalité augmentée et de la réalité virtuelle. De plus, elle a commencé à explorer les besoins et les occasions en matière de technologie d'audio interactif auprès de portefeuilles diversifiés touchant à de maints secteurs de marché : Wwise Automotive, divertissement basé sur la localisation et simulation."},"2015":{"title":"2015","description":"Avec la croissance du segment des jeux mobiles, Audiokinetic s'est penchée sur le développement du marché chinois, signant ainsi des ententes commerciales avec la majorité des développeurs et éditeurs de jeux les plus importants de Chine."},"2016":{"title":"2016","description":"2016 a été témoin du 100e titre en RA/RV publié avec Wwise ! En ce qui a trait au secteur automobile, la première voiture de démonstration avec intégration Wwise a été présentée au CES 2016, en partenariat avec Continental.\\n\\n Afin d'unir et de renforcer sa communauté grandissante, Audiokinetic a également lancé en 2016 le <AK_LINK_1>Répertoire des Créateurs</AK_LINK_1>, une base de données dédiée aux prestataires de services souhaitant répertorier et partager leurs offres, et aux développeurs à la recherche de talents et de ressources."},"2017":{"title":"2017","description":"En 2017, 500 titres ont été publiés avec Wwise au cours de l'année. 2017 a été une année importante pour le segment RA/RV et les avancées en audio spatialisée pour Audiokinetic. Cette année a vu le lancement de l'ensemble d'outils <AK_LINK_1>Wwise Spatial Audio</AK_LINK_1>, ainsi que de <AK_LINK_2>Wwise Audio Lab</AK_LINK_2>, un environnement 3D semblable à un jeu vidéo et développé avec Unreal Engine 4, conçu afin expérimenter avec les fonctionnalités d'audio spatialisé.\\n\\nAudiokinetic a aussi lancé sa première itération de l'$t(doNotTranslate:audiokinetic-launcher), offrant ainsi un point d'accueil pour les utilisateurs de Wwise afin qu'ils puissent gérer leurs produits et licences et accéder rapidement aux ressources de Wwise. Afin d'étoffer son programme éducatif, Audiokinetic a lancé la certification Wwise-201, qui se concentre sur la musique interactive.\\n\\nEt concernant le secteur Wwise Automotive, la première version de Wwise Automotive a été lancée et présentée lors du CES 2017, de même que la contribution open-source d'Audiokinetic à la plateforme <AK_LINK_3>Automotive Grade Linux</AK_LINK_3> (AGL), comprenant une API audio orientée application ainsi que la gestion des politiques sonores."},"2018":{"title":"2018","description":"2018 a été témoin du 500e titre RA/RV publié avec Wwise. Alors que la communauté Wwise continue à croître, de plus en plus de développeurs créent des plugiciels et des intégrations pour Wwise. C'est pourquoi, dans sa perspective d'autonomisation de la communauté audio, Audiokinetic a lancé le <AK_LINK_1>Programme de Partenaire à la communauté</AK_LINK_1> afin de permettre aux développeurs de présenter et de vendre leurs produits dans la boutique Audiokinetic.\\n\\nDans le domaine de l'éducation, Audiokinetic a lancé sa troisième certification Wwise, la certification Wwise-251, parallèlement au <AK_LINK_2>$t(doNotTranslate:wwise-adventure-game)</AK_LINK_2>, pour les utilisateurs de Unity Audiokinetic a introduit un nouvel habillage pour Wwise : Dark UI, l'interface sombre lancée avec la version 2018.1. De plus, la première version de Wwise Automotive a été lancée officiellement au CES 2018."},"2019":{"title":"2019","description":"Sony Interactive Entertainment (SIE) finalise l'acquisition d'Audiokinetic en janvier 2019. Avec cette acquisition, SIE bénéficie de la vaste expertise d'Audiokinetic en matière d'ingénierie audio, ce qui ajoute une valeur significative à l'écosystème PlayStation®. Grâce à cette acquisition, Audiokinetic continue de fonctionner de manière indépendante, en concédant des licences pour ses outils audio multiplateformes et ses intergiciels à des développeurs sur des marchés établis et en croissance."},"2020":{"title":"2020","description":"Audiokinetic ouvre sa nouvelle subdivision à Shanghai, en Chine. Avec cette annonce, la société dispose désormais de bureaux dans quatre grands marchés du jeu : l'Amérique du Nord, le Japon, la Corée du Sud et la Chine.\\n« La Chine peut se féliciter d'avoir une industrie du jeu vidéo prospère. La Chine est également devenue un acteur international puissant au sein de divers secteurs en plein essor - qui se tournent tous vers les solutions audio interactives et les adoptent rapidement. Le divertissement basé sur la localisation, la réalité virtuelle, l'automobile et la robotique n'en sont que quelques exemples. » Martin H. Klein, PDG d'Audiokinetic."},"2022":{"title":"2022","description":"Audiokinetic lance Strata™, la première grande bibliothèque d'effets sonores multipistes au monde, avec plus de 300 Go de sons en 2022, et beaucoup plus prévu pour l'avenir.\\nConçu dès le départ avec plus de 100 000 sources audio, clips audio, pistes et paramètres d'effets, le tout dans un format REAPER multipiste et prêt à l'emploi, Strata est parfait pour les projets sonores interactifs et linéaires, permettant aux créateurs de peaufiner les sons à la perfection en seulement quelques secondes."},"2023":{"title":"2023","description":"Audiokinetic a annoncé la création de sa filiale européenne Audiokinetic B.V. à Hilversum aux Pays-Bas. Cette action stratégique rapproche Audiokinetic de sa communauté d'utilisateurs, de clients et de partenaires européens, tout en participant aux objectifs de diversification de l'entreprise."},"2024":{"title":"2024","description":"Cette année a été placée sous le signe de l'innovation pour Audiokinetic. Wwise Automotive d'Audiokinetic a ouvert la voie vers une nouvelle référence en matière d'audio immersif embarqué avec la nouvelle voiture électrique NEVO E07 de CHANGAN en améliorant la perception spatiale, en s'adaptant aux conditions de conduite en temps réel et en créant des expériences sonores personnalisées tant à l'intérieur qu'à l'extérieur du véhicule.\\n\\nAudiokinetic a également élargi son programme de formation en lançant des ateliers axés sur des domaines spécialisés très demandés, afin de favoriser des progrès continus et la croissance des applications audio interactives.\\n\\nEn 2024, Audiokinetic a été reconnue comme l'un des 100 meilleurs employeurs de Montréal."},"2025":{"title":"2025","description":"En 2025, Audiokinetic a célébré son 25e anniversaire ainsi que le 20e anniversaire de Wwise. Pour marquer ces deux étapes importantes, Audiokinetic a dévoilé une série d'initiatives axées sur la communauté et la créativité. L'entreprise a sorti deux documentaires, The Story of Audiokinetic et The Story of Wwise, qui retracent l'histoire et l'évolution de l'entreprise et de son produit phare, Wwise. Audiokinetic a également réalisé un troisième long métrage documentaire, Sounds of Dreamers, qui a demandé trois ans de production et qui est un hommage à la communauté mondiale des créateurs audio, et dont la sortie est prévue en 2026. Dans le cadre de ces célébrations, Audiokinetic a organisé la 40e édition de sa Tournée Wwise à Montréal, où l'entreprise a été fondée.\\n\\nDéterminée à poursuivre son engagement en faveur des personnes, Audiokinetic a également mis en place cette année un niveau affilié au sein de son programme d'instructeur Wwise afin de favoriser une communauté d'éducateurs plus engagée et plus connectée, qui soutient les créateurs audio naissants du monde entier."}}}`),Kwt={"menu-label":"Carrières",bannerV2Title:"Carrières",bannerV2SubTitle:"Façonnez l'avenir de l'audio interactif",advocacy:{montreal:{line1:"Les 100 meilleurs employeurs",line2:"du Canada",line3:"en 2026"},canada:{line1:"Les 100 meilleurs employeurs",line2:"du Canada",line3:"en 2026"}},listing:{title:"Rejoignez l'équipe!",noListings:{title:"Il n'y a pas de poste à pourvoir actuellement.",description:`Nous n'avons pas de poste à pourvoir pour le moment, mais nous sommes toujours heureux de faire connaissance avec des personnes talentueuses. N'hésitez pas à <a class='ak-link' target='_blank' href="https://www.google.com">nous envoyer vos informations</a>, et nous vous garderons à l'esprit si une occasion se présente!`}},culture:{title:"Une culture où règnent passion et travail d'équipe",carouselCards:{card_01:{title:"Libérez votre potentiel",description:"Notre engagement en faveur du développement continu garantit que les ressources nécessaires au perfectionnement professionnel sont disponibles, ce qui permet à nos collaborateurs d'accroître leurs compétences."},card_02:{title:"Trouvez le bon équilibre",description:"Nous croyons qu'il est possible de trouver un rythme harmonieux où la passion professionnelle et la vie personnelle coexistent. Nos modalités de travail flexibles aident nos collaborateurs à trouver cet équilibre tout au long de l'année."},card_03:{title:"Une culture fondée sur nos voix communess",description:"Nous créons des technologies audio novatrices pour les industries des jeux et médias interactifs.  Notre succès repose sur des esprits brillants et une passion commune. Nous sommes déterminés à offrir un environnement dynamique et inclusif qui favorise la créativité et l'innovation."}}},environment:{title:"Notre environnement","environment-description":`Le siège social d'Audiokinetic est situé dans le Vieux-Montréal. Cette prestigieuse cité historique accueille plusieurs sociétés œuvrant au sein des industries du développement de logiciels et du multimédia. Quelque 35 000 personnes travaillent dans le Vieux-Montréal, où elles profitent de l’équilibre parfait entre la riche histoire de la ville et sa culture vivante. 

 Comptant plusieurs grandes sociétés de haute technologie, Montréal est devenue un pôle important en matière de développement de médias interactifs. Audiokinetic continue de croître dans cette ville qui offre une combinaison unique de potentiel technologique et de talents créatifs sans fin. 

Les bureaux d’Audiokinetic reflètent la culture de l'entreprise ainsi que ses valeurs. Ils sont conçus afin d'encourager le libre échange d’idées, la collaboration, la créativité et l’innovation. Notre lieu de travail est illuminé et spacieux, comptant plusieurs pièces pour les rencontres de groupe, dont une salle de jeu et une salle de repos. Nous offrons un bar ouvert avec bière en fût à la cafétéria, ainsi que des fruits frais, une variété de thés et de l'excellent café!

Le siège social d'Audiokinetic est situé à Montréal, au Canada. L'entreprise compte une filiale à Tokyo, au Japon, et des experts en produits en Chine et en Europe.`}},Rwt={bannerTagline:"Nous joindre",bannerSubTagline:"Chez Audiokinetic, nous accordons une grande importance à votre opinion. Pour joindre l’un de nos services, veuillez utiliser ce formulaire.",cards:{tech_support:{title:"Soutien technique",description:"Vous avez besoin de l'aide de notre équipe d'assistance?",ctaPrimary:"$t(common:buttons.submit-support-ticket)",footnote:"Ce service est payant. Pour plus d'informations, consultez notre <AK_LINK>page d'Aide</AK_LINK>."},project_inquiry:{title:"Demande concernant le projet",description:"Vous avez des questions à propos de votre projet?",ctaPrimary:"Soumettez une demande concernant le projet",footnote:""},general_inquiry:{title:"Demande générale",description:"Rentrons en contact!",ctaPrimary:"Soumettre un formulaire de contact",footnote:""}},addresses:{"img-alt":"Image des bureaux de {{AK_VAR_OFFICE_NAME}}",title:"Bureaux d'Audiokinetic",montreal:"Siège social à Montréal",tokyo:"Filiale Japon",shanghai:"Filiale Chine",hilversum:"Filiale Pays-Bas"}},Pwt={"menu-label":"Actualités",title:"Actualités"},Uwt={about:xwt,careers:Kwt,contacts:Rwt,news:Pwt,"press-room":{"menu-label":"Salle de presse",title:"Salle de presse",news:{title:"Actualités",tools:{"tooltip-grid":"Affichage grille","tooltip-carousel":"Affichage carousel"}},social:{title:"Comptes sur les réseaux sociaux"},downloads:{title:"Logos et assets pour les médias"},cards:{pressKit:{title:"Kit pour la presse",ctaPrimary:"$t(common:buttons.download)",footnote:""},inGameCredits:{title:"Génériques de jeu",ctaPrimary:"$t(common:labels.more-info)",footnote:""},logosWwise:{title:"Logos Wwise",ctaPrimary:"$t(common:buttons.download)",footnote:""},logosStrata:{title:"Logos Strata",ctaPrimary:"$t(common:buttons.download)",footnote:""},logosAudiokinetic:{title:"Logos Audiokinetic",ctaPrimary:"$t(common:buttons