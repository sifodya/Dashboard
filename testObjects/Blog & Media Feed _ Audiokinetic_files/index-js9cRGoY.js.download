date",selectStartDate:"Present day"},description:{label:"Description",placeHolder:"Give us a brief description of what you were doing"}},validation:{title:{required:"Job Title field is required"},organizationName:{required:"Company Name field is required"},startDate:{required:"Please add a start date"}},labels:{at:"$t(common:labels.occupation-title)",title:"Job title",locationName:"Company name",location:"Location",start:"Start",end:"End",description:"Description","add-new-item":"Add a new <AK_BLACK>Experience</AK_BLACK> to your profile"}},CQ={title:"Education",editing:{defaultItem:"Education",newItem:"New Education entry",editItem:"Editing Education entry"},"no-content":"You currently do not have any education information in your profile.",formLabels:{title:{label:"Diploma",placeHolder:"What did you do?"},organizationName:{label:"School",placeHolder:"Who did you do it with?"},location:{label:"Location",placeHolder:"Where did you do it?"},startEndDate:{label:"NEEDED_IN_CODE_BUT_NOT_USED_DO_NOT_TRANSLATE",placeHolder:"NEEDED_IN_CODE_BUT_NOT_USED_DO_NOT_TRANSLATE"},startDate:{label:"Start Date",placeHolder:"When did you start doing this?"},endDate:{label:"End Date",placeHolder:"When did you stop doing this?",selectStartDate:"Present day"},description:{label:"Description",placeHolder:"Give us a brief description of what you were doing"}},validation:{title:{required:"Diploma field is required"},organizationName:{required:"School field is required"}},labels:{at:"$t(common:labels.occupation-title)",title:"Diploma",locationName:"School",location:"Location",start:"Start",end:"End",description:"Description","add-new-item":"Add a new <AK_BLACK>Education</AK_BLACK> to your profile"}},BQ={title:"Certifications",description:"Online Wwise certifications are designed with your learning needs in mind. Develop your skills and get certified whenever you’re ready to establish your experience with Wwise and get the job of your dreams!","no-content":"You currently have no certifications in your account",downloadCertificate:"Certificate",downloadLogoKit:"Logo kit",nextStep:{takeExam:"Take Exam",renewCertification:"Renew Certification"},expired:"Expired: {{AK_VAR_DATE}}",aboutToExpire:"Expiring on {{AK_VAR_DATE}}",previousCertifications:"Previous Certification(s)",showPreviousCertification:"Show previous certification badge",showNewerCertification:"Show newer certification badge"},IQ={title:"Portfolio",editing:{defaultItem:"Portfolio",newItem:"New Portfolio entry",editItem:"Editing Portfolio entry"},"title-singular":"Portfolio","no-content":"Share links to the great things you've built to show off your skills!","has-content":"<AK_FAT_BLACK>{{AK_NUMBER_OF_PROJECTS}}</AK_FAT_BLACK> Confirmed Wwise projects",labels:{type:"Project Type",url:"Project URL",title:"Title",description:"Project Description"},formLabels:{emptyUrlExplained:{label:"You can leave the URL empty if you want to publish your own URL in the description. For security reasons we cannot make your custom URL live, interested parties will need to copy+paste to visit you portfolio."},url:{label:"Project URL",placeHolder:"What's your portfolio's project URL? You can leave this empty."},title:{label:"Title",placeHolder:"Title"},description:{label:"Project Description",placeHolder:"Describe what you are showcasing"}},validation:{title:{required:"Portfolio title is required"},description:{required:"Portfolio description is required"},url:{invalid:"Enter a valid YouTube or Soundcloud URL"}},portfolioTypes:{youtube:"YouTube",soundcloud:"Sound Cloud",file:"File"}},OQ={title:"Projects","title-singular":"Project","no-content":"You aren't a member of any published projects.","has-content":"<AK_FAT_BLACK>{{AK_NUMBER_OF_PROJECTS}}</AK_FAT_BLACK> Confirmed Wwise projects"},NQ={title:"Publications","title-singular":"Publication","no-content":"You currently do not have any publications listed in your profile.",labels:{title:"Publication title",url:"External publication link URL",publishedDate:"Published date",description:"Description","add-new-item":"Tell us about your <AK_BLACK>Publications</AK_BLACK> and add them to your profile"},formLabels:{title:{label:"Title",placeHolder:"How do you call your masterpiece?"},publicationUrl:{label:"Publication's URL (please include https://)",placeHolder:"Where can we read this masterpiece?"},publishedDate:{label:"Publish Date",placeHolder:"When did you make it available?"},description:{label:"Description",placeHolder:"Tell us more about it?"}}},xQ={title:"Languages",editing:{defaultItem:"Language",newItem:"New Language entry",editItem:"Editing Language entry"},"title-singular":"Language","no-content":"You are not currently sharing any of your spoken language proficiency in your profile.",validation:{language:{required:"Language field is required"},languageCode:{required:"Language field is required"},proficiency:{required:"Proficiency field is required"}},labels:{language:"Language",proficiency:"Proficiency",description:"Description","add-new-item":"Add a new <AK_BLACK>Language</AK_BLACK> to your profile"},formLabels:{languageCode:{label:"Language",placeHolder:"What language do you speak/read/write?"},language:{label:"Language",placeHolder:"What language do you speak/read/write?"},proficiency:{label:"Proficiency",placeHolder:"How good are you?"},description:{label:"Description",placeHolder:"Where did you learn?"}},"spoken-languages":{FRA:"French",ENG:"English",ARA:"Arabic",BEN:"Bengali",DEU:"German",HIN:"Hindi",IND:"Indonesian",JPN:"Japanese",PAN:"Punjabi",POR:"Portuguese",SPA:"Spanish",UKR:"Ukrainian",URD:"Urdu",ZHO:"Chinese",RUS:"Russian"},"languages-proficiency":{elementary:"Elementary Proficiency",limited:"Limited Working Proficiency",professional:"Professional Working Proficiency",fullPro:"Full Professional Proficiency",native:"Native / Bilingual Proficiency"}},KQ={module:yQ,tools:EQ,avatar:HQ,intro:TQ,about:SQ,experiences:VQ,education:CQ,certifications:BQ,portfolio:IQ,projects:OQ,publications:NQ,languages:xQ,"profile-management":{"account-creation-thank-you":{title:"Thank you for creating an account on Audiokinetic.com!",description:"Please check your email to finalize account creation and unlock all features available to you"},"profile-new-password":"Set new Profile password","profile-new-email":"Set new Profile Email Address","basic-information":"Basic Information","resend-confirmation-email":"Resend Confirmation Email","menu-label":"Profile Confirmation",bannerTagline:"Profile Confirmation","set-new-password":{title:"Reset Password",description:`Your are about to reset the password for account linked to
<b>{{AK_ACCOUNT_EMAIL_ADDRESS}}</b>`,ctaButton:"Reset Password",formLabels:{password:{label:"New Password",placeHolder:"New password"},confirmPassword:{label:"Confirm New Password",placeHolder:"Confirm New password"}}},"set-new-email":{title:"Update Email Address","description-1":`You are about to update the email address associated with your Audiokinetic account.
This will be your new email address, please verify that the following email address is correct: <b>{{AK_ACCOUNT_EMAIL_ADDRESS}}</b>`,"description-2":"Please enter your current Audiokinetic account email and password to complete the update.",ctaButton:"Submit change",successMessage:"You have successfully changed your primary email address",errorMessage:"There was an error processing your request. Please try again",formLabels:{primaryEmail:{label:"Current Email Address",placeHolder:"Enter current email address (the one you currently sign in with)"},password:{label:"Current Password",placeHolder:"Confirm current password"}}},confirm:{bannerTagline:"Account Profile",ctaButton:"Complete Profile",title:"Complete Profile",description:"Please fill out the basic profile information to finish creating your new account.","description-fine-print":"* Incomplete profiles will be deleted after 30 days.","description-explained":"This will allow us to better communicate with you.",formLabels:{basicInfoHeader:{label:"Basic information"},profileEmail:{label:"Please confirm password for <b>{{currentEmail}}</b>",placeHolder:"Confirm password"},confirmPassword:{label:"Password",placeHolder:"Confirm password"},password:{label:"Password",placeHolder:"Confirm password"},firstName:{label:"$t(profile:intro.formLabels.firstName.label)",placeHolder:"$t(profile:intro.formLabels.firstName.placeHolder)"},lastName:{label:"$t(profile:intro.formLabels.lastName.label)",placeHolder:"$t(profile:intro.formLabels.lastName.placeHolder)"},company:{label:"$t(profile:intro.formLabels.company.label)",placeHolder:"$t(profile:intro.formLabels.company.placeHolder)"},companySize:{label:"$t(profile:intro.formLabels.companySize.label)",placeHolder:"$t(profile:intro.formLabels.companySize.placeHolder)"},title:{label:"$t(profile:intro.formLabels.title.label)",placeHolder:"$t(profile:intro.formLabels.title.placeHolder)"},titleOther:{label:"$t(profile:intro.formLabels.titleOther.label)",placeHolder:"$t(profile:intro.formLabels.titleOther.placeHolder)"},countryCode:{label:"$t(profile:intro.formLabels.countryCode.label)",placeHolder:"$t(profile:intro.formLabels.countryCode.placeHolder)"}}},"confirm-discourse":{bannerTagline:"Account Profile",ctaButton:"Complete Profile",title:"One last step!",description:"We are happy to see you onboard. Before you can start, please choose a username for yourself that will be used within the community.","description-fine-print":"* Your username must be between 3 and 60 characters long. It must start with a letter or a number and can only contain letters, numbers, dots (.), dashes (-), and underscores (_).",formLabels:{basicInfoHeader:{label:"Discourse username"},userName:{label:"Discourse username",placeHolder:"Type in your username (required)"}},validation:{userName:{required:"Username field is required",minLength:"Username must be at least 3 characters long",maxLength:"Username must not exceed 60 characters",startsWithAlphanumeric:"Username must start with a letter or number",allowedCharacters:"Username can only contain letters, numbers, dashes, dots, and underscores"}}}}},RQ={ContentProvider:{employeeCount:"{{AK_VAR_EMPLOYEE_COUNT}} employees",wwiseProjects:"Wwise projects: {{AK_VAR_COUNT}}",services:"Services",certifiedUsers:"Members with public profile"},School:{courses:"Courses",certifiedUsers:"Members with public profile"},project:{"confirm-request":{title:"Confirm Request",description:"You're about to send a request to register to {{AK_VAR_CODE}}, titled {{AK_VAR_TITLE}}.","description-no-code":"You're about to send a request to register to {{AK_VAR_TITLE}}."}}},PQ={entity:RQ},UQ={"menu-label":"Account & Settings",title:"Account & Settings"},DQ={"menu-label":"General",profile:{title:"Profile"},emails:{"no-content":"$t(doNotTranslate:empty-email-field)",title:"Email",primary:"Email",primaryChangeTo:"Pending Primary email change",secondary:"Backup Email",secondaryChangeTo:"Pending Secondary email change",confirmChangeProfileEmailAddress:`Current email address: <b>{{AK_CURRENT_EMAIL_ADDRESS}}</b>

