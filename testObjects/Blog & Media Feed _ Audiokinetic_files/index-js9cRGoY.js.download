Netherlands`},DJ={en_US:{montreal:"$t(doNotTranslate:akOfficeAddresses.montreal)",tokyo:"$t(doNotTranslate:akOfficeAddresses.tokyo)",shanghai:"$t(doNotTranslate:akOfficeAddresses.shanghai)",hilversum:"$t(doNotTranslate:akOfficeAddresses.hilversum)"},fr_CA:{montreal:"$t(doNotTranslate:akOfficeAddresses.montreal)",tokyo:"$t(doNotTranslate:akOfficeAddresses.tokyo)",shanghai:"$t(doNotTranslate:akOfficeAddresses.shanghai)",hilversum:"$t(doNotTranslate:akOfficeAddresses.hilversum)"},ja_JP:{montreal:"$t(doNotTranslate:akOfficeAddresses.montreal)",tokyo:"$t(doNotTranslate:akOfficeAddresses.tokyo_ja)",shanghai:"$t(doNotTranslate:akOfficeAddresses.shanghai)",hilversum:"$t(doNotTranslate:akOfficeAddresses.hilversum)"},ko_KR:{montreal:"$t(doNotTranslate:akOfficeAddresses.montreal)",tokyo:"$t(doNotTranslate:akOfficeAddresses.tokyo)",shanghai:"$t(doNotTranslate:akOfficeAddresses.shanghai)",hilversum:"$t(doNotTranslate:akOfficeAddresses.hilversum)"},zh_CN:{montreal:"$t(doNotTranslate:akOfficeAddresses.montreal)",tokyo:"$t(doNotTranslate:akOfficeAddresses.tokyo)",shanghai:"$t(doNotTranslate:akOfficeAddresses.shanghai_zh)",hilversum:"$t(doNotTranslate:akOfficeAddresses.hilversum)"}},kJ={en_US:"English",fr_CA:"Français",ja_JP:"日本語",ko_KR:"한국어",zh_CN:"中文"},WJ={asc:{string:"A-Z",number:"Asc"},desc:{string:"Z-A",number:"Desc"}},$J={label:"English",tag:"EN"},qJ={label:"Français",tag:"FR"},jJ={label:"日本語",tag:"日本語"},FJ={label:"中文",tag:"中文"},GJ={label:"한국어",tag:"한국어"},YJ={angel_ignace:{name:"Angel Ignace",title:"Technical Sound Designer - Co owner Aurae Studios",avatar:"/images/testimonials/angel_ignace.png"},anthony_biafore:{name:"Anthony Biafore",title:"Audio Professional-Wwise Affiliate Instructor",avatar:"/images/testimonials/anthony_biafore.png"},booker_edwards:{name:"Booker Edwards",title:"Professor of Practice",avatar:"/images/testimonials/booker_edwards.png"},brian_doliveira:{name:"Brian D'Oliveira",title:"CEO and Composer at La Hacienda Creative"},carl_noren:{name:"Carl Norén",title:"Audio Lead - Avalanche Studios"},dave_kalberg:{name:"Dave Kalberg",title:"Audio Instructor / Studio Owner",avatar:"/images/testimonials/dave_kalberg.png"},florian_bodenschatz:{name:"Florian Bodenschatz",title:"Audio Director"},francois_xavier_dupas:{name:"François-Xavier Dupas",title:"Co-founder, Composer and Creative Director at Vibe Avenue"},jon_vincent:{name:"Jon Vincent",title:"Studio Audio Director at Rare LTD, Microsoft Games Studios"},marshall_mcgee:{name:"Marshall McGee",title:"Sound Design Consultant"},matt_pirog:{name:"Matt Pirog",title:"Audio Lead - Valen Studios"},robert_brock:{name:"Robert Brock",title:"Game Audio dept. director at Conservatory of Recording Arts and Sciences"},simone_cicconi:{name:"Simone Cicconi",title:"Lead Sound Designer",avatar:"/images/testimonials/simone_cicconi.png"},tim_brown:{name:"Tim Brown",title:"Educator/Composer",avatar:"/images/testimonials/tim_brown.png"},tyler_gillis:{name:"Tyler Gillis",title:"Sound Designer"},vasilis_milesis:{name:"Vasilis Milesis",title:"Composer - Video Game Developer - Lecturer",avatar:"/images/testimonials/vasilis_milesis.png"}},JJ={android:"Android",ios:"iOS",linux:"Linux",mac_os_x:"MacOS",playstation_4:"Playstation 4",playstation_5:"Playstation 5",nintendo_switch:"Switch",nintendo_switch_2:"Switch 2",windows:"Windows",xbox_one:"XBox One"},uc={tTesterStrings:IJ,buttonsComparisonStrings:OJ,INTERPOLATION:NJ,audiokinetic:xJ,"audiokinetic-bug-reporter":"<AK_NO_WRAP>Bug Reporter</AK_NO_WRAP>","audiokinetic-bug-reporter-TextOnly":"Bug Reporter","audiokinetic-launcher":"<AK_NO_WRAP>Audiokinetic Launcher</AK_NO_WRAP>","audiokinetic-launcher-TextOnly":"Audiokinetic Launcher","audiokinetic-launcher-kr":"Audiokinetic 런처","wwise-adventure-game":"Wwise Adventure Game","wwise-adventure-game-wag":"Wwise Adventure Game (WAG)","empty-email-field":"<AK_RED>THIS MESSAGE SHOULD NEVER APPEAR AS ALL USER MUST HAVE A T LEAST ONE EMAIL</AK_RED>",notifications:KJ,"footer-zh":{beianAltText:"沪公网安备 31010402009871号"},readspeakerVoices:RJ,carNames:PJ,akOfficeAddresses:UJ,i18nAkOfficeAddresses:DJ,localeLabel:kJ,labels:WJ,english:$J,french:qJ,japanese:jJ,chinese:FJ,korean:GJ,testimonials:YJ,platforms:JJ},dc={"feature-flags":{"menu-label":"...",bannerTagline:"Jakhub's Feature–Flag configuration",bannerSubTagline:`QA / Dev reserved page.
This page should NEVER be seen in production.
Please report if you do see it in prod!

This page IS NOT translated`,features:{FEATURE_FLAGS:{"toggle-label":"Feature Flags","feature-description":"A feature flag to Enable/Disable the FeatureFlag functionnality. One flag to rule them all"},FEATURE_FLAGS_ADMIN:{"toggle-label":"MainMenu link to FeatureFlags","feature-description":"Display ... in main-memu to facilitate getting to feature flags"},DESCRIPTION_TESTER:{"toggle-label":"Description tester","feature-description":"Activate Collection's description tester link + feature"},NAM_PAGE:{"toggle-label":"News & Media Page","feature-description":"Enable/Disable News & Media Page. If this feature is disabled, the old fcrm-Blog page will be used"},EVENTS_PAGE:{"toggle-label":"Events Page","feature-description":"Enable/Disable Events Page."},COMMUNITY_BLOG_PAGE:{"toggle-label":"Jakhub Blog Page","feature-description":"Enable/Disable Jakhub Blog Page. If this feature is disabled, the Blog to be loaded will be fCRM's"},FCRM_LINK_SUFFIX:{"toggle-label":"SwitchLink fCRM suffix ( >)","feature-description":"Enable/Disable adding a ' >' on menu links that will bring you to an fCRM page"},CONSOLE_LOGS_ARE_ACTIVE:{"toggle-label":"console.log","feature-description":"console.[log, info, debug, warn] will output to the console if this is set"},UNOBFUSCATE_SEARCH_URL:{"toggle-label":"Show search URL","feature-description":"Search URL-params are obfuscated by default"},ROUTER_DEBUG_IS_ACTIVE:{"toggle-label":"router transitions","feature-description":"Router transitions will be shown in the console. Make sure console.log is also active"}}}},XJ=JSON.parse(`{"menu-label":"About","bannerV2Title":"About us","title":"Our Story","summary":{"text":[{"description":"Built on pioneering technology and years of industry experience, Audiokinetic sets the standard in audio production for the interactive media, gaming, location based entertainment, and automotive industries, and is a trusted partner to the world's largest game developers, OEMs and professional audio companies."},{"description":"As the global leading provider of cross-platform solutions, Audiokinetic offers an integrated approach to interactive audio production through cutting-edge, comprehensive interactive audio solutions and a revolutionary workflow. The company’s middleware solutions, including the award-winning Wwise® and SoundSeed®, empower sound designers and audio programmers with a cost effective, comprehensive authoring tool and audio engine for creating innovative interactive experiences. With its ground-breaking technologies and unsurpassed services, Audiokinetic is committed to inspiring sound designers and audio programmers to create products which take the immersive experience of audio to new heights."}]},"about-cards":{"2000":{"title":"2000","description":"Audiokinetic was founded in 2000 by Martin H. Klein, President and CEO. Klein, working with a group of dedicated veterans and experts from the music, film, and gaming industries, set out to develop Wwise®, the integrated audio authoring middleware. Their goal was to help audio programmers and sound designers provide truly immersive gaming experiences."},"2003":{"title":"2003","description":"Audiokinetic opened up its first office space in 2003, in Montreal’s old port."},"2005":{"title":"2005","description":"Audiokinetic’s first GDC was in 2005! Three musketeers, Martin H. Klein, Simon Ashby and Jacques Deveau flew to San Francisco to meet a community of developers and introduce them to Wwise."},"2006":{"title":"2006","description":"By 2006, the first commercial version of Wwise and its revolutionary workflow was released. Microsoft Game Studios (MGS) was its first customer, and Shadowrun, developed for next-generation gaming platforms at the time was the first title to be shipped using Wwise. Developed for Microsoft Vista and Xbox 360, Shadowrun allowed live, cross-platform multiplayer gaming."},"2007":{"title":"2007","description":"In 2007, Audiokinetic launched its first Wwise Tour, in Tokyo and London. Today, the Wwise Tour is an anticipated industry event, featuring the best of game audio in the making by top tier developers from around the world, and has taken place in 14 cities."},"2009":{"title":"2009","description":"Audiokinetic, quickly building on its success, introduced its first internal plug-ins SoundSeed and Wwise Motion in 2009."},"2010":{"title":"2010","description":"2010 marked the 100th game shipped with Wwise. From indies to AAA games, audio professionals were turning to Wwise."},"2011":{"title":"2011","description":"In 2011, Audiokinetic reached its commercialisation stage, and became available for all new generation platforms. Audiokinetic established itself as the global leading provider of cross-platform interactive audio solutions, and Wwise quickly became the industry standard for the interactive media and gaming industries."},"2012":{"title":"2012","description":"Audiokinetic introduced the Certified Partner Program for third party plug-in developers in 2012, and launched Izotope, McDSP and AudioEase partner products that same year. This introduced pro audio plug-ins to the gaming/interactive world."},"2013":{"title":"2013","description":"2013 marked the 500th game shipped with Wwise. In 2013, Audiokinetic also announced its Japanese subsidiary Audiokinetic K.K."},"2014":{"title":"2014","description":"In 2014, Audiokinetic launched its Educational Program with online certifications, comprehensive literature, tutorials and sample games for schools, as well as a train-the-trainer program, today known as the Certified Instructors Program. Today, there are more than 200 registered universities and institutions around the world teaching with Wwise.\\n\\n By 2014, Audiokinetic had established itself as a pioneer in the AR/VR space, and also began exploring the interactive audio technology needs and opportunities of a diversified portfolio for various market segments: Wwise Automotive, Location-Based Entertainment, and Simulation."},"2015":{"title":"2015","description":"With the growth of the Mobile game segment, Audiokinetic focused on developing the Chinese market, signing enterprise agreements with most of the major game publishers and developers in China."},"2016":{"title":"2016","description":"2016 marked the 100th AR/VR title shipped with Wwise! On the Automotive front, the first demo car with Wwise integrated was showcased at CES 2016, in partnership with Continental that year!\\n\\n To unite and further empower its growing community, Audiokinetic also launched the <AK_LINK_1>Creators Directory</AK_LINK_1> in 2016 year, a database dedicated to service providers wanting to list and share services, and developers looking to find talent and resources."},"2017":{"title":"2017","description":"By 2017, 500 titles per year were being shipped with Wwise. 2017 was a big year for Audiokinetic’s AR/VR segment and Spatial Audio developments. The <AK_LINK_1>Wwise Spatial Audio</AK_LINK_1> toolset and the <AK_LINK_2>Wwise Audio Lab</AK_LINK_2> a game-like 3D environment developed with Unreal Engine 4, for experimenting with spatial audio features were released.\\n\\nAudiokinetic also launched the first iteration of the $t(doNotTranslate:audiokinetic-launcher), offering a home for Wwise users to manage their projects and licenses, and to quickly access Wwise resources. Adding to its Education Program, Audiokinetic launched the the Wwise-201 Certification, a certification focused on Interactive Music.\\n\\nAnd, in the Wwise Automotive segment, the first version of Wwise Automotive was launched and showcased during CES 2017, as well as Audiokinetic’s open-source contribution to the <AK_LINK_3>Automotive Grade Linux</AK_LINK_3> (AGL) platform, which included an application-facing audio API and policy management."},"2018":{"title":"2018","description":"2018 marked the 500th AR/VR title shipped with Wwise. As the Wwise community continues to grow, more and more developers are creating plug-ins and integrations for Wwise. Therefore, in keeping with its mission towards empowering the audio community, Audiokinetic launched the <AK_LINK_1>Community Partner Program</AK_LINK_1> to allow developers to feature and sell their products on the Audiokinetic Store.\\n\\nIn Education, Audiokinetic launched its third Wwise Certification, the Wwise-251 Certification, alongside <AK_LINK_2>The $t(doNotTranslate:wwise-adventure-game)</AK_LINK_2>, for Unity users. Audiokinetic introduced the new Wwise skin: Dark UI, which was released with 2018.1. And, the first version of Wwise Automotive was officially launched at CES 2018."},"2019":{"title":"2019","description":"Sony Interactive Entertainment (SIE) completes the acquisition of Audiokinetic in January of 2019. With this acquisition, SIE taps into Audiokinetic’s vast audio engineering expertise, adding significant value to the PlayStation® ecosystem. With the acquisition, Audiokinetic continues to operate independently, licensing its multi-platform audio tools and middleware to developers in established and growth markets."},"2020":{"title":"2020","description":"Audiokinetic launches its new subsidiary in Shanghai, China. With this announcement, the company now has offices in four major gaming markets: North-America, Japan, South Korea, and China.\\n“China boasts a prospering video game industry. China has also become a powerful international player within various rising industries - all turning to, and rapidly embracing interactive audio solutions. Location-Based Entertainment, AR/VR, Automotive, and Robotics are just a few examples.” Martin H. Klein, Audiokinetic CEO."},"2022":{"title":"2022","description":"Audiokinetic launches Strata™, the world’s first massive multitrack sound effects library, with over 300Gb of sounds in 2022, and much more planned for the future.\\nDesigned from the ground-up with over 100,000 audio sources, clip edits, tracks and effect parameters in ready-to-edit REAPER multitrack format, Strata is perfect for interactive and linear sound projects, making it fast and easy for creators to fine-tune sounds to perfection in a matter of seconds."},"2023":{"title":"2023","description":"Audiokinetic announced the opening of its European subsidiary Audiokinetic B.V. in Hilversum, Netherlands. This strategic move positions Audiokinetic closer to its European community of users, clients and partners, while aligning with the company's diversification goals."},"2024":{"title":"2024","description":"This was a year of innovation for Audiokinetic. Wwise Automotive set a new standard for immersive in-car audio by powering CHANGAN’s NEVO E07 electric vehicle, enhancing spatial awareness, adapting to real-time driving conditions, and creating custom sound experiences both inside and outside the vehicle.\\n\\nAudiokinetic also expanded its education program by launching workshops focused on in-demand specialized subject areas to support continued advancements and the growth in interactive audio applications.\\n\\nIn 2024, Audiokinetic was recognized as one of Montreal’s Top 100 Employers."},"2025":{"title":"2025","description":"In 2025, Audiokinetic celebrated its 25th anniversary and the 20th anniversary of Wwise. To mark these two major milestones, Audiokinetic unveiled a series of initiatives rooted in community and creativity. It released two documentaries, The Story of Audiokinetic and The Story of Wwise, which trace the history and evolution of the company and its flagship product Wwise. Audiokinetic also completed a third upcoming feature documentary, Sounds of Dreamers, which was produced over three years as a reverent homage to the global community of audio creators, and will be released in 2026. As part of these celebrations, Audiokinetic hosted the 40th edition of its Wwise Tour in Montreal, where the company was founded.\\n\\nContinuing its focus on people, Audiokinetic also established an Affiliate tier within its Wwise Instructor Program this year to foster a more engaged and connected community of educators who support emerging audio creators worldwide."}}}`),QJ={"menu-label":"Careers",bannerV2Title:"Careers",bannerV2SubTitle:"Shape the future of interactive audio",advocacy:{montreal:{line1:"Montreal's",line2:"Top 100 Employers",line3:"2026"},canada:{line1:"Canada's",line2:"Top 100 Employers",line3:"2026"}},listing:{title:"Join our team!",noListings:{title:"There are no current openings.",description:`We don't have any open roles at the moment, but we're always happy to hear from talented people. Feel free to <a class='ak-link' target='_blank' href="https://www.google.com">send us your information</a>, and we'll keep you in mind for what's next!`}},culture:{title:"A team-oriented and passionate culture",carouselCards:{card_01:{title:"Tune into your potential",description:"Our commitment to continuous development ensures that the resources for professional growth are available, empowering our people to amplify their skills."},card_02:{title:"Find the right balance",description:"We believe in finding a harmonious rhythm where professional passion and personal life coexist. Our flexible work arrangements help our people find that balance all year long."},card_03:{title:"A culture built from our collective voices",description:"We create innovative audio technology for the gaming and interactive media industries.  Our success is built on a foundation of brilliant minds and shared passion. We are dedicated to providing a dynamic and inclusive environment where creativity and innovation thrive."}}},environment:{title:"Our environment","environment-description":`Audiokinetic’s headquarters are located in Old Montreal. This historic and prestigious city center is home to several software development and multimedia companies. Some 35,000 people work in Old Montreal, where they enjoy the perfect blend of the city's rich history and vibrant culture. 

Montreal has emerged as an international hub for the development of interactive products and game development tools. With a concentration of high tech giants in the city, Montreal has secured its position as a global center for interactive media development. Audiokinetic continues to thrive in this city that offers the unique combination of unlimited technological potential and creative talent. 

Audiokinetic's office space reflects the company’s culture and values. It is designed to stimulate the free exchange of ideas, encourage collaboration, and nurture creativity and innovation. Our workspace is bright and spacious with several rooms for group meetings, including a game room, and a nap room. We have an open bar including a beer tap in our cafeteria, as well as complimentary fresh fruit, a variety of teas, and great coffee!

Audiokinetic is headquartered in Montréal, QC, Canada and has a subsidiary in Tokyo, Japan, and Product Experts in China and Europe.`}},ZJ={bannerTagline:"Contacts",bannerSubTagline:"At Audiokinetic, we value your input. To contact any one of our departments, please use this Contact Form.",cards:{tech_support:{title:"Technical Support",description:"Need help from our support team?",ctaPrimary:"$t(common:buttons.submit-support-ticket)",footnote:"This is paid service. For more information, please view our <AK_LINK>Support page</AK_LINK>."},project_inquiry:{title:"Project Inquiry",description:"Questions about your project?",ctaPrimary:"Submit a project inquiry",footnote:""},general_inquiry:{title:"General Inquiry",description:"Let's get in touch",ctaPrimary:"Submit a contact form",footnote:""}},addresses:{"img-alt":"Office image for {{AK_VAR_OFFICE_NAME}}",title:"Audiokinetic Offices",montreal:"Montreal Head Office",tokyo:"Japan Office",shanghai:"China Office",hilversum:"Netherlands Office"}},eX={"menu-label":"News",title:"News"},tX={about:XJ,careers:QJ,contacts:ZJ,news:eX,"press-room":{"menu-label":"Press Room",title:"Press Room",news:{title:"News",tools:{"tooltip-grid":"Grid view","tooltip-carousel":"Carousel view"}},social:{title:"Social Accounts"},downloads:{title:"Logos & Media Assets"},cards:{pressKit:{title:"Press Kit",ctaPrimary:"$t(common:buttons.download)",footnote:""},inGameCredits:{title:"In Game Credits",ctaPrimary:"$t(common:labels.more-info)",footnote:""},logosWwise:{title:"Wwise Logos",ctaPrimary:"$t(common:buttons.download)",footnote:""},logosStrata:{title:"Strata Logos",ctaPrimary:"$t(common:buttons.download)",footnote:""},logosAudiokinetic:{title:"Audiokinetic Logos",ctaPrimary:"$t(common:buttons.download)",footnote:""},brochureAudiokinetic:{title:"Audiokinetic Brochures",ctaPrimary:"$t(common:buttons.download)",footnote:""},brochureGaming:{title:"Gaming Brochures",ctaPrimary:"$t(common:buttons.download)",footnote:""},brochureStrata:{title:"Strata Br