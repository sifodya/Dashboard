rCallToAction:{primaryLabel:"提交技术支持申请单",secondaryLabel:"求助社区"},bannerCallToActionMobile:{primaryLabel:"提交技术支持申请单"}},EOt={"menu-label":"帮助",bannerV2Title:"如在项目开发中遇到问题，我们会竭力为您提供帮助。",bannerCallToAction:{primaryLabel:"提交技术支持申请单",secondaryLabel:"求助社区"},bannerCallToActionMobile:{primaryLabel:"提交技术支持申请单"}},HOt={"menu-label":"帮助",help:{"menu-label":"帮助",bannerV2Title:"怎样才能帮到你？",documentation:{wwise_help:{title:"Wwise",description:"访问所有 Wwise 相关文档，包括 Wwise Help、SDK、Unreal/Unity Integration 和 Wwise 基础知识。",ctaPrimary:"用户文档"},ak_launcher:{title:"$t(doNotTranslate:audiokinetic-launcher)",description:"了解能用 Launcher 来做什么，比如安装 Wwise、添加插件、将 Wwise 集成到 Unreal 或 Unity 工程中、下载 Strata 合集。",ctaPrimary:"用户文档"},strata_library:{title:"Strata",description:"访问所有 Strata 相关文档（包括 Strata 用户指南和各个合集用户指南）。",ctaPrimary:"用户文档"},support:{title:"技术支持",description:"获取有关 Wwise 技术支持策略和技术支持方案的细节或提交技术支持申请单。",ctaPrimary:"$t(common:buttons.learn-more)"},creative_services:{title:"创意服务",description:"跟我们一起合作来让您的音频项目和 Wwise 更上一层楼。",ctaPrimary:"$t(common:buttons.learn-more)"},request_feature:{title:"请求功能",description:"您是否对Wwise有功能提议？在“社区问答”版块告诉我们您希望未来版本提供什么功能或者为其他人的提议投票。",ctaPrimary:"请求功能"},report_bug:{title:"报告漏洞",description:"我们会查看记录的所有漏洞报告，并认真评估这些漏洞的修复方案，但不会直接对特定问题做出回应。",ctaPrimary:"了解详情"},community_qa:{title:"社区问答",description:"进Audiokinetic社区求助！提出问题、寻找答案并与全球各地的 Wwise 和 Strata 用户分享相关专业知识。",ctaPrimary:"社区问答"}}},support:{"menu-label":"技术支持","wwise-support-policy":{title:"Wwise 技术支持策略",description:"请确保使用与当前 Wwise 版本对应的最新补丁版本。",version:"Wwise 版本",supportPeriod:"支持期限",active:{barLabel:"已激活",title:"已激活",titleClassName:"support-policy-active",description:"Audiokinetic 以公有代码补丁形式对目前为止最后一个和倒数第二个大版本的 Wwise 提供完全支持。"},private:{barLabel:"私人",title:"私人",titleClassName:"support-policy-private",description:"对倒数第三个版本的 Wwise 提供支持，除非可使用更新的 Wwise 版本解决所报告的问题。可通过签订创意服务协议来以私有代码补丁形式对倒数第三个版本的 Wwise 提供扩展支持。"},"end-of-life":{barLabel:"终止支持",title:"终止支持",titleClassName:"support-policy-end-of-life",description:"尽量对所有早期版本的 Wwise 提供支持，但不作任何保证。"}},"technical-support":{title:"技术支持","support-tier":{pay_2_go:{title:"Pay2Go",description:`单张技术支持申请单，可以提前在网上购买。
对于严重问题和重大故障，会在 <AK_BLACK>2 个工作日内</AK_BLACK>做出初步回应。<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>申请单</AK_IRON>",ctaPrimary:"购买 Pay2Go"},standard:{title:"Standard（标准）",description:`随 Wwise 授权许可一起购买的技术支持方案。
对于严重问题和重大故障，会在 <AK_BLACK>2 个工作日内</AK_BLACK>做出初步回应。<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>张申请单</AK_IRON>/年",ctaPrimary:"联系我们"},unlimited:{title:"无限制",description:`随 Wwise 授权许可一起购买的技术支持方案。
对于严重问题和重大故障，会在 <AK_BLACK>2 个工作日内</AK_BLACK>做出初步回应。<AK_RED>*</AK_RED> 
