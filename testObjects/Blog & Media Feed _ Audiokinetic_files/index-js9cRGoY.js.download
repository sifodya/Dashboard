You should receive an email shortly with the instruction on how to reset your password.`},errors:{"invalid-email":"Please provide a valid email address used while signing-up","invalid-password":"Please provide your strong password"},"btn-forgotten-password":"Forgot password?","no-account":"Don't have an account?","btn-sign-up":"Create account","btn-continue":"Continue","btn-close":"Close","3-block-agreement":"By signing up, you acknowledge that you have read and agreed to the site's <AK_TERMS_LINK>Terms of Use</AK_TERMS_LINK>, its <AK_PRIVACY_POLICY_LINK>Privacy Policy</AK_PRIVACY_POLICY_LINK> and the <AK_USER_ACCOUNT_POLICY_LINK>User Account Policy</AK_USER_ACCOUNT_POLICY_LINK>."},"language-switcher":{"available-languages":"Available Languages","en-US":{"selector-label":"$t(doNotTranslate:english.label)",indicator:"$t(doNotTranslate:english.tag)"},"fr-CA":{"selector-label":"$t(doNotTranslate:french.label)",indicator:"$t(doNotTranslate:french.tag)"},"ja-JP":{"selector-label":"$t(doNotTranslate:japanese.label)",indicator:"$t(doNotTranslate:japanese.tag)"},"zh-CN":{"selector-label":"$t(doNotTranslate:chinese.label)",indicator:"$t(doNotTranslate:chinese.tag)"},"ko-KR":{"selector-label":"$t(doNotTranslate:korean.label)",indicator:"$t(doNotTranslate:korean.tag)"}}},"solutions-wwise":{"stand-alone-title":"Discover what Wwise can do for your project!"}},MX=JSON.parse(`{"menu-label":"Community","description":"A hub for interactive audio creators—learn, share, and connect with the Wwise and Strata community worldwide.","helmet":{"title":"Community Hub","description":"A hub for interactive audio creators—learn, share, and connect with the Wwise and Strata community worldwide."},"bannerV2Title":"Join the largest interactive audio community!","bannerCallToAction":{"primaryLabel":"$t(common:buttons.create-account)"},"bannerCallToActionLoggedIn":{"primaryLabel":"$t(common:buttons.subscribe-blog)"},"community":{"menu-label":"Community","mainPageCards":{"blog":{"title":"$t(community:module.blog.menu-label)","description":"$t(community:module.blog.description)"},"events":{"title":"$t(community:module.events.menu-label)","description":"$t(community:module.events.description)"},"creators_directory":{"title":"$t(community:module.creators-directory.menu-label)","description":"$t(community:module.creators-directory.description)"},"q_a":{"title":"$t(community:module.questions-answers.menu-label)","description":"$t(community:module.questions-answers.description)"},"t1":{"title":"Test #1","description":"Description One"},"t2":{"title":"Test #2","description":"Description Two"},"t3":{"title":"Test #3","description":"Description Three"},"t4":{"title":"Test #4","description":"Description Four"}}},"partners":{"menu-label":"Partners","helmet":{"title":"Partners","description":"A list of all Audiokinetic technology and content partners."},"bannerV2Title":"Technology and Content Partners","bannerV2Description":"Thank you for your partnership!","technology":{"label":"Technology partners","description":"Audiokinetic is proud to partner with industry-leading developers, bringing their solutions to the Wwise community. Wwise features an open API and integrates easily into in-house game engines, the world's top commercial game engines, and any tool or application."},"content":{"label":"Content partners","description":"Audiokinetic would like to thank the following content partners for their contributions in academic or demonstration material, made available to the Wwise community."},"partnerList":{"audio_ease":"<AK_BOLD>AudioEase</AK_BOLD> provides Wwise users with a game-centric selection of Altiverb impulse responses to enhance the Wwise Convolution plug-in.","auro_3d":"<AK_BOLD>Auro-3D®</AK_BOLD> is the next generation three-dimensional audio standard. It provides the most immersive and natural realistic 3D sound experience. Completely immersing the listener in a cocoon of life-like sound, Auro-3D® creates the sensation of actually 'being there'. Thanks to a unique 'height' layer, acoustic reflections are generated and heard naturally as sounds originate from around, as well as above the listener.","basemark":"<AK_BOLD>Basemark</AK_BOLD> is a forerunning provider of software & tooling solutions for advanced automotive AR application development – Video AR, AR Navigation, AR HUDs and AR Clusters. Their solution, Rocksolid AR, is comprised of developer tools, SDKs and runtimes that are optimized for automotive SW & HW environments.","bay_area_sound":"<AK_BOLD>Bay Area Sound</AK_BOLD> is an award-winning audio production facility located in the San Francisco Bay Area with 20 years of hands-on experience. Specializing in game and interactive audio, their music composition, sound design and voiceover credit list includes such titles as Telltale's Walking Dead and Wolf Among Us, Marvel Heroes, Star Wars Old Republic and Skylanders. They provide a complete audio solution for projects of any size and have also become the go-to outfit for many in-house audio teams seeking overflow help. Their resource, experience and talent combined with their personable working style create a formidable member of any production.","crankcase":"<AK_BOLD>Crankcase Audio, Inc.</AK_BOLD> has brought their revolutionary <AK_BOLD>REV</AK_BOLD> system to Wwise, allowing you to create realistic engine sounds using granular synthesis techniques to eliminate looping.","cras":"The <AK_BOLD>Conservatory of Recording Arts and Sciences</AK_BOLD> in Tempe, Arizona, concentrates on providing its students with a thorough education in audio. From live sound and recording to post-production and business practices, students attending The Conservatory receive an audio-focused education designed to make them employable in the music discipline of their choice.","dolby_atmos":"<AK_BOLD>Dolby Atmos</AK_BOLD> enables industry leading sound experiences for all forms of interactive, immersive content. Dolby’s partnership with Audiokinetic provides a deeper integration of Dolby Atmos into the <a href=\\"https://www.audiokinetic.com/en/wwise/overview/\\">Wwise pipeline</a>, making it easier for developers to produce and deliver consistent interactive spatial audio experiences across a wide range of devices and platforms.","epic-games":"The <AK_BOLD>Wwise Unreal Integration</AK_BOLD> is an Unreal Engine plug-in that enables you to use the Wwise Sound Engine in Unreal games. It leverages Unreal Engine Objects and Blueprints to expose Wwise features. It is also fully integrated with Unreal Engine's Level Sequencer and provides occlusion support. Last but not least, a Wwise Authoring API layer allows for deeper integration and support of advanced Wwise features.<br /><br /><a href=\\"https://www.audiokinetic.com/library/edge/?source=UE4&id=using__features.html&__hstc=186884983.b5a45bdfb7ed52932789ec17a10dc539.1731513273852.1732642228276.1732645599620.20&__hssc=186884983.2.1732645599620&__hsfp=4190853523&_gl=1*46z12d*_gcl_au*MTI0NzE0Nzg4MS4xNzMyMTMxNTg1\\" target=\\"_blank\\">Learn more</a>","gme":"<a href=\\"/wwise/plugins/gme\\" target=\\"_self\\">Game Multimedia Engine (GME)</a> is a game cloud service by <AK_BOLD>Tencent Cloud</AK_BOLD>, which provides low-latency, high-quality, cost-efficient and scalable in-game voice communication services for game developers. GME is integrated in Wwise as input sources which is similar to any pre-recorded audio assets, so Wwise’s powerful audio processing and control capabilities can be applied to the voice, which allows a bigger space for designing creative voice features for game sound effects while improving the voice sound quality.","goer_dynamics":"<AK_BOLD>Auro-3D®</AK_BOLD> is the next generation three-dimensional audio standard. It provides the most immersive and natural realistic 3D sound experience. Completely immersing the listener in a cocoon of life-like sound, Auro-3D® creates the sensation of actually 'being there'. Thanks to a unique 'height' layer, acoustic reflections are generated and heard naturally as sounds originate from around, as well as above the listener.","izotope":"<AK_BOLD>iZotope</AK_BOLD> offers a suite of their most popular sound design plug-ins for use directly within Wwise. The suite of Trash tools and Hybrid Reverb can take your sound design projects to the next level.","mcdsp":"<AK_BOLD>McDSP</AK_BOLD> brings a selection of their award-winning plug-ins directly to Wwise. These plug-ins, which are considered a staple for audio professionals in the film and music industries are now available for your interactive needs.","michael_mccann":"<AK_BOLD>Michael McCann's</AK_BOLD> award winning work as composer, sound designer, and producer has been recognized and showcased worldwide. His broadcast and client resume includes some of the biggest companies in entertainment and advertising, including MTV, Ubisoft, Deutsch Inc. L.A., Ogilvy & Mather, Alliance Atlantis, Gap Inc., VH1, and more.","platinum_games":"<AK_BOLD>PlatinumGames Inc.</AK_BOLD> provides the state-of-the-art technology and develops uncompromising video games. They have contributed the <a href=\\"https://www.audiokinetic.com/library/edge/?source=Help&id=conversion_settings_editor\\" target=\\"_blank\\">ADPCM</a> encoder and decoder technology used in Wwise as of 2019.1.","retro_force_9k":"<AK_BOLD>RETROFORCE9000</AK_BOLD> specializes in interactive audio, and provides the following services: Sound Design, Editing, VO Recording/Editing/Directing as well as technical and interactive audio support for multiple game developers and audio service providers.","side":"<AK_BOLD>SIDE</AK_BOLD> works at the cutting edge of interactive media as a provider of audio services for the global entertainment market. For over 25 years, our award-winning team of technical and creative experts have been providing voice production, casting, directing, performance capture, localized audio, sound design, music composition, integration, and beyond to the global games industry. <br />To this day, our team holds the same collective intention: to develop the truest interpretation of each client's vision, for audiences of every genre, on any platform, in all languages.","sonorum":"A veteran sound designer and musician, Stéphane Larivière shows exceptional originality, consistency and perspicacity in all projects and mandates entrust to him. He combines his musical education and sensitivity to his passion for sound recording and creation to offer innovative sound design. He has contributed to many TV series, films and video games during the past 20 years. And more recently, he was given a major role for the sound design and supervision of the critically acclaimed AAA video games Far Cry 3, Assassin's Creed 3 and Assassin's Creed Brotherhood. Stéphane Larivière has interest in many forms of creation, expression and entertainment, either on stage or on-screen, multimedia and interactivity in its many itemizations and flavors.","soundelux":"<AK_BOLD>Soundelux Design Music Group</AK_BOLD> is located in the heart of Hollywood. Soundelux has been applying its experience in feature film sound design, music composition, and voiceover recording to video games for over 15 years, shaping the audio landscape of more than 150 games. The company’s artists have garnered multiple Oscar, BAFTA, Golden Reel, and G.A.N.G. nominations and awards.","p3_digital":"<AK_BOLD>SPARQ OS</AK_BOLD> provides an Android Automotive platform that helps vehicle makers, system integrators, software development companies, and content providers with a secure environment to develop automotive applications for infotainment systems.","steinberg":"The <AK_BOLD>Nuendo</AK_BOLD> integration is developed and maintained by <a href=\\"https://www.steinberg.net/en/home.html\\" target=\\"_blank\\"><AK_BOLD>Steinberg</AK_BOLD></a>. Enjoy a real-time and seamless connection between Nuendo 7 or its later versions and Wwise, via the <a href=\\"https://www.steinberg.net/en/products/nuendo_range/nuendo/game_audio.html\\" target=\\"_blank\\">Game Audio Connect feature</a>. Steinberg Nuendo offers the utmost compatibility and flexibility, and the richest feature set for sound creation, composing, dialog recording, mixing, and middleware interaction.","technicolor":"<AK_BOLD>Technicolor's</AK_BOLD> Game Sound Services team brings together decades of game sound experience with award-winning sound design staff and world-class sound studios on three continents. They have been part of many of the top games of recent years, working on franchises such as Uncharted, Gears of War, Ratchet & Clank, and Mass Effect.","unity":"The <AK_BOLD>Wwise Unity Integration</AK_BOLD> is a Unity plug-in that allows the use of the Wwise Sound Engine in Unity games. The Integration consists of a Unity plug-in library, the Wwise SDK API bindings in C#, a few other helpful components, and Editor windows."}},"news-and-media":{"menu-label":"Blog","helmet":{"title":"Blog & Media Feed","description":"Content created by and for the interactive audio community, catered by Audiokinetic."},"title":"News & Media (USED ?)","contextual-banner-image-alt":"AK Blog logo","submit-your-blog-link":"Interested in writing an article?","tabs":{"featured":{"label":"Featured"},"browse_all":{"label":"All"},"gaming":{"label":"Gaming"},"game_audio":{"label":"Gaming"},"wwise_automotive":{"label":"Wwise Automotive"},"lbe":{"label":"LBE"},"consumer_electronics":{"label":"Consumer Electronics"},"simulation":{"label":"Simulation"}},"topMediaIn":"{{AK_VAR_MEDIA_SOURCE}} in {{AK_VAR_SEGMENT}}","topMediaInMultiple":"{{AK_VAR_MEDIA_SOURCE}} in multiple segments","topMediaAge":" • {{AK_VAR_MEDIA_AGE}}","topMediaReadTime":" • {{AK_VAR_MEDIA_READ_TIME}} read time","topMediaViewTime":" • {{AK_VAR_MEDIA_READ_TIME}} view time","filters":{"searchTermPlaceHolder":"Textual search in news & media...","textualDescription":"Filters Summary","noResultsWithSelection":"There are no articles with the combination of filters you have currently selected.","BLOG":{"title":"Filters"},"segments":{"title":"Segments","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following segments :","types":{"all":"All","gaming":"Gaming","wwise_automotive":"Wwise Automotive","lbe":"LBE","consumer_electronics":"Consumer Electronics","simulation":"Simulation"}},"mediaTypes":{"title":"Sources","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following sources :","tooltip":"Show all <AK_BOLD>{{AK_VAR}}</AK_BOLD> content.","type":{"blog":"Blog","video":"Video","news":"Press Release","press_release":"Press Release"},"types":{"blog":"Blogs","video":"Videos","news":"Press Releases","press_release":"Press Releases"}},"tags":{"title":"Tags","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following tags :","tooltip":"Search for content with the <AK_BOLD>{{AK_VAR}}</AK_BOLD> tag.","types":{"arvr":"AR / VR / XR","automotive":"$t(community:module.news-and-media.filters.segments.types.wwise_automotive)","bootcamp":"Bootcamp","certification":"Certification","engineering":"Engineering","instructor_program":"Instructor Program","wwisetour":"Wwise Tour","wwise_tour":"Wwise Tour","ar_vr_xr":"AR / VR / XR","audio_programming":"Audio Programming","case_study":"Case Study","consumer_electronics":"$t(community:module.news-and-media.filters.segments.types.consumer_electronics)","engine_integration":"Engine Integration","events":"Events","education":"Education","lesson":"Lesson","game_audio":"Game Audio","games":"Games","gaming":"$t(community:module.news-and-media.filters.segments.types.gaming)","interactive_music":"Interactive Music","lbe":"$t(community:module.news-and-media.filters.segments.types.lbe)","live_stream":"Live Stream","mobile":"Mobile","simulation":"$t(community:module.news-and-media.filters.segments.types.simulation)","sound_design":"Sound Design","spatial_audio":"Spatial Audio","strata":"Strata","tutorial":"Tutorial / Guide","tutorial_guide":"Tutorial / Guide","upcoming":"Upcoming Event","webinar":"Webinar","workshop":"Workshop","wwise":"Wwise","wwise_automotive":"$t(community:module.news-and-media.filters.segments.types.wwise_automotive)"}}},"community-updates":{"title":"Community Updates","description":"Fresh posts, events, and people to follow.","blocks":{"tableOfContent":{"title":"Table of Contents"},"relatedContent":{"title":"Related Content"},"subscribeToBlog":{"title":"Get the latest news","altImg":"Audiokinetic Blog Logo"},"LIVE_STREAM":{"hasEvents":{"title":""},"noEvents":{"title":"Join our Communities"}},"EVENT":{"hasEvents":{"title":"Upcoming Events"},"noEvents":{"title":"Upcoming Events"}},"contributors":{"title":"Contributors"},"latestProjects":{"title":"Powered by Wwise"},"latestQA":{"title":"Latest Q&A"}}},"details":{"loginToPost":"Please <AK_LINK_SIGNIN>Sign in</AK_LINK_SIGNIN> or <AK_LINK_SIGNUP>Create An Account</AK_LINK_SIGNUP> to comment or reply","notifyMe":"Notify me when new comments are posted.","postYourComment":"Post your comment","commentHasBeenSubmitted":"Your message has been successfully submitted.\\nPlease note that it requires review before being posted publicly.","postComment":"Post Comment","postCommentPlaceHolder":"Post your comment here (at least 5 characters)","commentorEmail":"{{AK_VAR_COMMENTOR_EMAIL}} | Your email will not be published"},"submit-your-blog":{"contextual-banner-image-alt":"AK Blog logo","title":"Submit Your Blog","body":"Thank you for your interest in blogging for Audiokinetic! We love connecting with audio professionals and writers who share our mission: empowering the audio creator. Our goal is to keep the Audiokinetic blog community-focused and community-driven. We want to celebrate your work, share relevant and versatile content around interactive audio, and build an inspiring knowledge resource for all of us.<br /><br />Please find our Blogging Guidelines, as well as Guidelines for Sharing and Republishing Content, below.<br /><br />Got questions you don’t see answers to? Please <AK_LINK>contact us</AK_LINK>. We’ll be happy to help.","blogging-guidelines":"Blogging Guidelines","blogging-faqs":"Blogging FAQs","sharing-guidelines":"Guidelines for Sharing and Republishing Content","sharing-guidelines-text":"So you want to republish a piece of content from Audiokinetic or any of our properties? First off, thanks! We love it when people want to share Audiokinetic blogs. We have some requests when it comes to how our content gets shared:","accordion":{"blogging-guidelines":{"block-1":{"title":"Who is Audiokinetic's blog audience?","description":"Our readers represent a wide spectrum of audio professionals seeking content on various topics related to interactive audio. Sound designers, music composers, audio programmers, audio directors, and more. The Audiokinetic blog audience comprises industry veterans, AAA studios, indies and students, from all over the world. Our blog is available in English, Japanese and Chinese."},"block-2":{"title":"How do I submit a post to Audiokinetic?","description":"Please submit your draft in a Word doc or Google doc format to <a href=\\"mailto:blog@audiokinetic.com\\">blog@audiokinetic.com</a>."},"block-3":{"title":"What topics is Audiokinetic looking for?","description":"We are looking for posts around these categories, as they relate to the interactive audio community and/or the Wwise user.<br /><br /><AK_BULLET>Project-based blogs: Feature your game, AR/VR experience, installation, or location-based project, and share your creative direction, audio development process, and how Wwise was used for the audio implementation.</AK_BULLET><AK_BULLET>Audio programming</AK_BULLET><AK_BULLET>Sound design</AK_BULLET><AK_BULLET>Interactive music</AK_BULLET><AK_BULLET>Spatial audio</AK_BULLET><AK_BULLET>Wwise tips and tools</AK_BULLET><AK_BULLET>Wwise partner and community plug-ins</AK_BULLET><AK_BULLET>Interactive audio news</AK_BULLET><AK_BULLET>Automotive</AK_BULLET><AK_BULLET>And other related topics !</AK_BULLET>"},"block-4":{"title":"What topics is Audiokinetic not looking for?","description":"We are not looking for posts with one of more of these characteristics:<br /><br/><AK_BULLET>It has been published elsewhere. (Exceptions can sometimes be made here.)</AK_BULLET> <AK_BULLET>It is promotional only and not an educational post.</AK_BULLET> <AK_BULLET>The post lacks a clear tie to audio.</AK_BULLET> <AK_BULLET>It’s too basic.</AK_BULLET> <AK_BULLET>It gives only a general overview of complex topics.</AK_BULLET> <AK_BULLET>It’s an op-ed-style post that discusses why an issue is important without discussing what, specifically, audio professionals can do.</AK_BULLET> <AK_BULLET>It’s a white paper or other form of promotional content that is meant to tout the benefits of one specific project/product/service over others.</AK_BULLET>"},"block-5":{"title":"What makes a good Audiokinetic post?","description":"Blog submissions that we can accept need to add value to the community. To give yourself an edge, consider these tips:<br /><br/><AK_BULLET>Read our blog. Develop a sense of what we publish. Subscribe to our blog to receive our most recent posts.</AK_BULLET> <AK_BULLET>Write for audio professionals.</AK_BULLET> <AK_BULLET>Tell a story—like a journalist. Cover who, what, when, where, how, and why.</AK_BULLET> <AK_BULLET>Be prescriptive. Don’t just tell readers how great Wwise was for your project for example, explain how.</AK_BULLET> <AK_BULLET>Make it personal. Share your ideas, lessons you’ve learned, challenges you’ve overcome, or problems you’ve solved.</AK_BULLET> <AK_BULLET>Make it concrete. Give examples, details, and metrics. Tell and show. Make it real.</AK_BULLET> <AK_BULLET>Make it long enough to engage and enrich readers. We don’t have a word-count goal or limit, but may suggest splitting very long blogs into series.</AK_BULLET> <AK_BULLET>Self-disclosure. Please disclose any relationships/partnerships you have when providing examples, speaking of technologies, and so on. (For instance, if an example comes from a client or your company, indicate this in the post).</AK_BULLET> <AK_BULLET>Avoid or explain buzzwords. Even though this is an audio community, we have a range of readers, all with various levels of experience. So, when you’re talking audio tech, make sure people will understand you; avoid undefined acronyms.</AK_BULLET> <AK_BULLET>Self-promotion. Focus on educational or inspirational content, as opposed to promoting your project or company in your post. Your author bio is a good place to do that.</AK_BULLET> <AK_BULLET>Include high res images (PNGs or JPGs) and/or video, audio files, or infographics.</AK_BULLET> <AK_BULLET>Incorporate utility content. Share templates, checklists, and step-by-step instructions.</AK_BULLET> <AK_BULLET>Give credit. Check your facts and quotations. Cite your sources.</AK_BULLET> <AK_BULLET>Where appropriate, share your feelings!</AK_BULLET>"}},"sharing-guidelines":{"block-1":{"title":"Social sharing","description":"Of course, we love when you share our content via social media. If you want this to catch our attention, please use the #Wwise hashtag across social media platforms. You can also tag us at:<br /><br />"},"block-2":{"title":"Article summaries","description":"Feel free to publish a summary (up to 500 words) of any of our blogs, along with a link to the full blog on the Audiokinetic website."},"block-3":{"title":"Full blog posts on the web","description":"If you are not the author, we ask that you do not republish any articles from Audiokinetic in full. Please see <AK_BOLD>Article summaries</AK_BOLD>, above."},"block-4":{"title":"Images and other media","description":"All images and media files belong to the blog authors or their companies. We, therefore, cannot grant permissions for republishing them, and you will need to submit your request to each owner independently."}}},"more-questions-contact-us":"Any other questions on Audiokinetic’s blogging, sharing or republishing guidelines?","subscribe-to-blog":"Subscribe to our blog for the latest in interactive audio!"}},"blog":{"menu-label":"Blog","title":"AK Blog","description":"Explore articles, videos, and insights from the Wwise community.","interaction-bubble":"Are you interested in <AK_LINK>sharing your work</AK_LINK> on the Audiokinetic Blog?","posts":"posts"},"related-videos":{"description":"Learn and get inspired!","dynamic-interaction-bubble":{"YOUTUBE":"Do you have a channel or videos you would like to <AK_LINK>share</AK_LINK> with the community?","BILIBILI":"Do you have a channel or videos you would like to <AK_LINK>share</AK_LINK> with the community?"}},"popular-series":{"title":"Popular series not to be missed!","series":{"one-minute-wwise":{"title":"One Minute Wwise","description":"No commercials, no lengthy introductions. Get \\"Wwiser\\" in 1 minute! Quick tutorials by Mads Maretty.","link":{"banner":"One Minute Wwise","cta":"$t(common:buttons.subscribe-youtube)"}},"wwise-up-on-air":{"title":"Wwise Up On Air","description":"A monthly variety show presented by Damian Kastbauer covering product overviews, demos, deeper dive walk-through segments, and interviews with developers and creators from around the world!","link":{"banner":"Wwise Up On Air","cta":"$t(common:buttons.subscribe-twitch)"}}}},"noteworthy-events":{"menu-label":"Noteworthy Event","title":"Events","description":"Wwise here, there, and everywhere.","wwise-tour":{"title":"Wwise Tour","description":"Meet and learn from the finest of game audio teams. Wwise Tour is a showcase of developers presenting comprehensive deep-dives into their workflows and dynamic audio accomplishments using Wwise.","image-caption":"Wwise Tour 2019 - Skywalker Sound (2 of 2) Immersive location-based experience \\"War Remains\\""},"wwise-interactive-music-symposium":{"title":"Interactive Music Symposium","description":"Interactive Music Symposium brings together composers from the film, interactive media, and video game industries amongst several others, for a meeting of the minds about composing for new mediums and the future of interactive music.","image-caption":"Orchestral Manoeuvres - Part 1: Sure get interactive, but don't over-cook it!"},"wwise-world-wide-online-expo":{"title":"Wwise Expo","description":"Wwise Expo promises a behind-the-scenes look into the Wwise ecosystem. From demos and new feature updates from members of the Audiokinetic team, to interviews with developers and audio creators from Audiokinetic partners and the community, this is an event not to be missed."},"game-jam":{"title":"Game Jams","description":"Game Jam organizers are listing their game jams with us to allow their participants to register for an all-access, free Wwise license!"}},"contributors":{"menu-label":"Contributors","title":"Contributors"},"creators-directory":{"filters":{"companyType":{"title":"Company / Freelancer{{AK_VAR_COUNT}}","types":{"company":"Company","freelancer":"Freelancer"}},"services":{"title":"Services{{AK_VAR_COUNT}}"},"wwiseAmbassador":{"title":"Wwise Ambassador","description":"Wwise Ambassadors are appointed by Audiokinetic and authorized to re-sell Wwise licenses to third party developers. <br /><br /><AK_LINK_BECOME_AN_AMBASSADOR>Become a Wwise Ambassador</AK_LINK_BECOME_AN_AMBASSADOR>","types":{"ambassador":"Wwise Ambassador"}},"nbPublishedWwiseProjects":{"title":"Number of wwise published projects"},"certification":{"title":"Certifications{{AK_VAR_COUNT}}","types":{"WWISE101":"Wwise Fundamentals","WWISE110":"Wwise Fundamentals Practicum","WWISE135":"Wwise Certified Instructor","WWISE201":"Interactive Music","WWISE251":"Performance Optimization","WWISE301":"Wwise Unity Integration"}},"nbPersonalWwiseProjects":{"title":"Number of wwise projects"},"occupation":{"title":"Occupation{{AK_VAR_COUNT}}"},"certifiedInstructor":{"title":"Personnel","types":{"certifiedInstructor":"Wwise Certified Instructor"}},"COMMON":{"empty-result":"Your search did not match any results.","filters":{"title":"Filters","location":{"title":"Location","placeholder":"Enter city, region or country"},"languages":{"title":"Languages{{AK_VAR_COUNT}}"}},"results":{"noLuck":"Your search did not match any result","occupation":"$t(common:labels.occupation-title)"}},"COMPANIES":{"title":"Filters","tabLabel":"Content Providers","bannerV2Title":"Content Providers","bannerV2LongDescription":"The Wwise Creators Directory is a place for developers, from indies to AAA studios, to find audio professionals with Wwise experience, who can help them with their game audio. If you’re Wwise Fundamentals certified and offer professional audio services, register your company and <AK_AMBASSADOR_LINK>become an ambassador</AK_AMBASSADOR_LINK> today!","ctas":{"primary":"Register Your Company"},"filters":{"searchTermPlaceHolder":"Search companies...","sortableFields":{"points":"Relevance","name":"Company name ({{AK_LABEL_ASC_OR_DESC}})","projectsCount":"Number of published projects ({{AK_LABEL_ASC_OR_DESC}})","certifiedUsersCount":"Number of certified users ({{AK_LABEL_ASC_OR_DESC}})"}}},"SCHOOLS":{"title":"Filters","tabLabel":"Schools","bannerV2Title":"Schools","bannerV2LongDescription":"The Wwise Creators Directory allows students looking for interactive audio schools that offer Wwise Certification programs, to find the appropriate schools in their area.","ctas":{"primary":"Create School Account"},"filters":{"main":{"title":"Filters #2"},"searchTermPlaceHolder":"Search schools...","sortableFields":{"name":"School name ({{AK_LABEL_ASC_OR_DESC}})","registeredCoursesCount":"Number of registered courses ({{AK_LABEL_ASC_OR_DESC}})"}}},"PEOPLE":{"title":"Filters","tabLabel":"People","bannerV2Title":"People","bannerV2LongDescription":"The Wwise Creators Directory is a place for developers, from indies to AAA studios, to find audio professionals with Wwise experience, who can help them with their game audio. If you’re Wwise Fundamentals certified and offer professional audio services, you can register your services on the Creators Directory!","ctas":{"primary":"Register Your Service","secondary":"Get Certified"},"filters":{"main":{"title":"Filters #2"},"searchTermPlaceHolder":"Search people...","sortableFields":{"name":"User name ({{AK_LABEL_ASC_OR_DESC}})","certificationsCount":"Number of completed certifications ({{AK_LABEL_ASC_OR_DESC}})","projectsCount":"Number of projects ({{AK_LABEL_ASC_OR_DESC}})"}}}},"menu-label":"Creators Directory","title":"Creators Directory","description":"Find studios, schools, and sound creators working with Wwise.","smallTitle":"Creators Directory","faq":{"bannerV2Title":"Creators Directory FAQ","more-questions-contact-us":"Any other questions on Audiokinetic’s Creators Directory?","accordion":{"block-1":{"title":"What is the Creators Directory?","description":"The Creators Directory is a means of you, as an audio professional providing services to the gaming industry (a Creator), can have a presence on our site. The goal being to help you find additional business, to assist smaller developers who are starting out with Wwise, and to help build a community of Creators to work with to constantly improve the Wwise software, and the Wwise development experience."},"block-2":{"title":"How do I get in?","description":"Simply create your Company. For many of you, this will be yourselves (My Name Audio) and that's fine. Upload your logo (to the specs provided), select the primary and secondary services you offer, and the rest of the information in the form. Once approved, you'll be added to the list."},"block-3":{"title":"Any other requirements?","description":"There is one big one – at least one member of your Company must be Wwise-101 certified. We want to make sure that the teams in the Wwise Creators Directory do indeed know Wwise to a certain degree, and this is the method of validation."},"block-4":{"title":"What if I have more than one person in my company?","description":"You can invite other members to join. Simply put in their name and email address, and the next time they log in to the Audiokinetic site, they'll be able to accept the invitation by visiting their Account page (click on their name at the top of the site). There will be a notification jewel next to their name to alert them of the invitation. They'll then be added to your Company."},"block-5":{"title":"Who can add other members?","description":"Only the 'Organization Administrator' can do this. Generally, this is the person who created the Company entry in the first place, though the role can be reassigned by contacting us."},"block-6":{"title":"Are you involved in our business dealings with developers?","description":"No, definitely not. We are simply trying to help developers find you. Currently, this means that they would look in the directory, search for the location, or services, or languages, or amount of experience. The resultant list of Creators is then sorted by their Creator Score. The Developer can then visit your site, where they can find the information on how to contact you and then it's up to you to win them over!"},"block-7":{"title":"Why can't Developers contact us directly from the Directory?","description":"We wanted to make sure that the system wasn't spam-friendly. Having a method where we either exposed your contact email clearly, or allowed contact to you via a form could have resulted in inappropriate communication and spam."},"block-8":{"title":"What is the Creator Score?","description":"This is a points system that runs behind the scenes. Points are allocated as follows:<br /><br /><AK_BULLET>2 points for each member of the Company that is Wwise-101 certified. Note that additional points will be allocated for members with higher certifications, as those become available.</AK_BULLET><AK_BULLET>2 points for every Published game project that has at least one member from the Company within it. Having more team members in a particular project does not allocate more points for that project.</AK_BULLET><AK_BULLET>2 points for every Published game project that has your Company attached. This also provides other benefits, including being publicly listed alongside the game on our Customers page.</AK_BULLET><AK_BULLET>1 point for every 100 Q&A points you have in our system. This will evolve as that system evolves.</AK_BULLET><br /><br />Over time, we hope to add more methods of earning points. These will generally be focused around things you can do to help the community!</AK_BULLET>"},"block-9":{"title":"How is the number of Projects managed?","description":"The Project Number that is displayed as part of your entry is calculated from multiple sources. Note that this is an absolute figure, so titles cannot be double-counted if they meet multiple criteria below:<br /><br /><AK_BULLET>If your company is attached to a project, it is counted.</AK_BULLET><AK_BULLET>If you have at least one member in the project, it is counted.</AK_BULLET><AK_BULLET>We can also attach a project to your company, which counts towards your Project Number, but does not then display your involvement publicly. This will be used in cases where the Developer or Publisher does not allow us to list you publicly.</AK_BULLET><br /><br />We definitely encourage Creators to take ownership and credit wherever possible. This is largely dictated by your contracts with the Developers, but fight for that right to be publicly acknowledged!"},"block-10":{"title":"Why should we have our staff members added to a Wwise project page?","description":"Aside from earning you Creator Points, there are other benefits:<br /><br /><AK_BULLET>You'll be able to be notified whenever the license key changes (added platforms, added plug-ins, evaluation extensions, etc.)</AK_BULLET><AK_BULLET>You'll be able to access the license key directly, rather than relying on one of the developers to send it to you.</AK_BULLET><AK_BULLET>You'll be able to file support tickets from the project page, assuming that the particular project currently has support access.</AK_BULLET><br /><br />As above, we strongly encourage you to contact the Developer about getting invited to the project. We can do that for you, but the Wwise Project Leader can also do this."},"block-11":{"title":"Is there a fee for joining?","description":"There is no direct fee for joining the Creators Directory. The only monetary cost is the Wwise-101 certification exam."},"block-12":{"title":"I need to make a change to my Company entry – can I?","description":"Absolutely. Certain fields are flagged as requiring approval (generally, anything that is public-facing, and is user created). This includes the company description, website and company name. Just like with the original Company creation, this would come to us for approval, and once approved, the changes would take hold. However, during that time, your listing would still be available on the site."},"block-13":{"title":"How do I get myself added to my portfolio of Wwise games?","description":"For older games, you can send us the list of games that you worked on. If you have proof of this (credits screen, for example), this helps as well. In some cases, it may not be possible to add you to an older game.<br /><br />For games in development still, you can contact the developer to be added via invitation."}}},"groups":{"content-providers":{"title":"Content Providers","description":"Audio teams specializing in delivering Wwise projects.","cta":{"primary":"List your company","secondary":"Find a company"}},"schools":{"title":"Schools","description":"Certified and Licensed schools teaching Wwise.","cta":{"primary":"Register your school","secondary":"$t(common:buttons.find-a-school)"}},"certified-users":{"title":"Certified Users","description":"Professionals with Wwise experience offering their expertise.","cta":{"primary":"Get certified","secondary":"Find Wwise talent"}}},"COMMON":{"empty-result":"Your search did not match any results.","filters":{"title":"Filters","locationField":{"title":"Location","placeholder":"Enter city, region or country"},"languagesDropdown":{"title":"Languages{{AK_VAR_COUNT}}"}},"results":{"noLuck":"Your search did not match any result","occupationNoData":"No occupation information provided","occupationNoLocation":"{{AK_EXPERIENCE_TITLE}}","occupation":"$t(common:labels.occupation-title)"}},"tabs":{"COMPANIES":{"label":"Content Providers","icon":"apartment","bannerV2Title":"Content Providers","bannerV2LongDescription":"The Wwise Creators Directory is a place for developers, from indies to AAA studios, to find audio professionals with Wwise experience, who can help them with their game audio. If you’re Wwise Fundamentals certified and offer professional audio services, register your company and <AK_AMBASSADOR_LINK>become an ambassador</AK_AMBASSADOR_LINK> today!","ctas":{"primary":"Register Your Company","secondary":"FAQ"},"filters":{"main":{"title":"Filters"},"searchTermPlaceHolder":"Search companies...","sortableFields":{"points":"Relevance","name":"Company name ({{AK_LABEL_ASC_OR_DESC}})","projectsCount":"Number of published projects ({{AK_LABEL_ASC_OR_DESC}})","certifiedUsersCount":"Number of certified users ({{AK_LABEL_ASC_OR_DESC}})"},"typeSelector":{"title":"Company / Freelancer{{AK_VAR_COUNT}}","types":{"company":"Company","freelancer":"Freelancer"}},"serviceSelector":{"title":"Services{{AK_VAR_COUNT}}"},"wwiseAmbassadorSelector":{"title":"Wwise Ambassador","description":"Wwise Ambassadors are appointed by Audiokinetic and authorized to re-sell Wwise licenses to third party developers. <br /><br /><AK_LINK_BECOME_AN_AMBASSADOR>Become a Wwise Ambassador</AK_LINK_BECOME_AN_AMBASSADOR>","types":{"ambassador":"Wwise Ambassador"}},"nbPublishedProjects":{"title":"Number of wwise published projects"}}},"SCHOOLS":{"label":"Schools","icon":"school","bannerV2Title":"Schools","bannerV2LongDescription":"The Wwise Creators Directory allows students looking for interactive audio schools that offer Wwise Certification programs, to find the appropriate schools in their area.","ctas":{"primary":"Create School Account"},"filters":{"main":{"title":"Filters"},"searchTermPlaceHolder":"Search schools...","sortableFields":{"name":"School name ({{AK_LABEL_ASC_OR_DESC}})","registeredCoursesCount":"Number of registered courses ({{AK_LABEL_ASC_OR_DESC}})"},"certifiedInstructorSelector":{"title":"Personnel","types":{"certifiedInstructor":"Wwise Certified Instructor"}}}},"PEOPLE":{"label":"People","icon":"groups","bannerV2Title":"People","bannerV2LongDescription":"The Wwise Creators Directory is a place for developers, from indies to AAA studios, to find audio professionals with Wwise experience, who can help them with their game audio. If you’re Wwise Fundamentals certified and offer professional audio services, you can register your services on the Creators Directory!","ctas":{"primary":"Register Your Service","secondary":"Get Certified"},"filters":{"main":{"title":"Filters"},"searchTermPlaceHolder":"Search people...","sortableFields":{"name":"User name ({{AK_LABEL_ASC_OR_DESC}})","certificationsCount":"Number of completed certifications ({{AK_LABEL_ASC_OR_DESC}})","projectsCount":"Number of projects ({{AK_LABEL_ASC_OR_DESC}})"},"certificationSelector":{"title":"Certifications{{AK_VAR_COUNT}}","types":{"WWISE101":"Wwise Fundamentals","WWISE110":"Wwise Fundamentals Practicum","WWISE135":"Wwise Certified Instructor","WWISE201":"Interactive Music","WWISE251":"Performance Optimization","WWISE301":"Wwise Unity Integration"}},"nbPersonalProjects":{"title":"Number of wwise projects"},"occupationDropdown":{"title":"Occupation{{AK_VAR_COUNT}}"}}}}},"questions-answers":{"menu-label":"Q & A","title":"Community Q & A","description":"Ask questions and get answers from experienced community members.","view-all-questions":"View All Questions","access-all-questions":"Access Community Q&A","ask-a-question":"Ask A Question","recent-questions":"Recent Questions","popular-questions":"Popular Questions","metaTopIn":"Updated {{AK_VAR_AGE}} in {{AK_VAR_CATEGORY}}","authorNoPoints":"{{AK_VAR_AUTHOR_NAME}}","authorWithPoints":"{{AK_VAR_AUTHOR_NAME}} ({{AK_VAR_AUTHOR_POINTS}} points)"},"ask-a-question":{"menu-label":"Community Q & A | Ask A Question"},"events":{"menu-label":"Events","title":"Events","description":"Join talks, workshops, game jams, and community events.","helmet":{"title":"Events","description":"Join talks, workshops, game jams, and community events."},"register-your-game-jam-link":"Register your game jam here","confirm-game-jam-request":{"title":"Confirm Game Jam Request","description":"You're about to register to {{AK_VAR_EVENT_NAME}} ({{AK_VAR_CODE}})."},"request-access-success":{"title":"Request Access Submitted","message":"Your request to register to {{AK_VAR_EVENT_NAME}} ({{AK_VAR_CODE}}) has been successfully submitted. You will receive an email confirmation shortly."},"sold-out":"Sold out","online":"Online","free":"Free","registered":"Registered","purchased":"Purchased","legend":{"wwise":"Wwise Events","community":"Community events","education":"Educational events","gamejam":"Game Jam","other":"Other types of events"},"filters":{"searchTermPlaceHolder":"Textual search in events...","noResultsWithSelection":"There are no events with the combination of filters you have currently selected.","EVENTS":{"title":"Filters"},"categories":{"title":"Categories","tooltip":"Search for events of category <AK_BOLD>{{AK_VAR}}</AK_BOLD>.","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following event categories :","types":{"gamejam":"Game Jam","instructor_program":"Instructor Program","live_stream":"Live Stream","tradeshow":"Trade Show","webinar":"Webinar","workshop":"Workshop","fundamentals_practicum":"Wwise Fundamentals Practicum","interactive_music_practicum":"Wwise Interactive Music Practicum","wwisetour":"Wwisetour"}},"locations":{"title":"Locations","tooltip":"Search for events at this location <AK_BOLD>{{AK_VAR}}</AK_BOLD>.","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following locations :","types":{"online":"Online","physical":"In Person"}},"tags":{"title":"Tags","tooltip":"Search for events tagged with <AK_BOLD>{{AK_VAR}}</AK_BOLD>.","textualTitle":"With <em><b>{{AK_INCLUSION_MODE}}</b></em> of the following tags :","types":{"ar_vr_xr":"$t(community:module.news-and-media.filters.tags.types.ar_vr_xr)","audio_programming":"$t(community:module.news-and-media.filters.tags.types.audio_programming)","case_study":"$t(community:module.news-and-media.filters.tags.types.case_study)","consumer_electronics":"$t(community:module.news-and-media.filters.tags.types.consumer_electronics)","engine_integration":"$t(community:module.news-and-media.filters.tags.types.engine_integration)","events":"$t(community:module.news-and-media.filters.tags.types.events)","game_audio":"$t(community:module.news-and-media.filters.tags.types.game_audio)","gaming":"$t(community:module.news-and-media.filters.tags.types.gaming)","interactive_music":"$t(community:module.news-and-media.filters.tags.types.interactive_music)","lbe":"$t(community:module.news-and-media.filters.tags.types.lbe)","mobile":"$t(community:module.news-and-media.filters.tags.types.mobile)","simulation":"$t(community:module.news-and-media.filters.tags.types.simulation)","sound_design":"$t(community:module.news-and-media.filters.tags.types.sound_design)","spatial_audio":"$t(community:module.news-and-media.filters.tags.types.spatial_audio)","strata":"$t(community:module.news-and-media.filters.tags.types.strata)","tutorial_guide":"$t(community:module.news-and-media.filters.tags.types.tutorial_guide)","wwise":"$t(community:module.news-and-media.filters.tags.types.wwise)","wwise_automotive":"$t(community:module.news-and-media.filters.tags.types.wwise_automotive)","wwise_tour":"$t(community:module.news-and-media.filters.tags.types.wwise_tour)"}}},"details":{"when":"When","where":"Where","price":"Price","day":"Day {{AK_NUMBER}}","all-times-are-in-timezone":"All times are in {{timezone}}","registration-deadline":"Registration deadline","maximum-participants":"Maximum participants","included-products":"Included products","fetch-error-message":"Oops! We’re having trouble finding that event. Try refreshing the page, or contact support if the problem persists.","warning-sold-out":"This event is sold out.","warning-deadline":"The registration period has ended.","register-interest":"I'm interested","only-x-spots-left-in-parenthesis":"(Only {{AK_VAR}} spots left)"}},"wwise-tour":{"menu-label":"Wwise Tour"},"one-minute-wwise":{"menu-label":"One Minute Wwise"},"wwise-up-on-air":{"menu-label":"Wwise Up On Air"},"game-jams":{"menu-label":"Game Jams"}}`),_X={module:MX,"wwise-ambassador":{"menu-label":"Wwise Ambassador",helmet:{title:"Wwise Ambassador Program",description:"Wwise Ambassadors are appointed by Audiokinetic and authorized to re-sell Wwise licenses to third party developers."},bannerV2Title:"Wwise Ambassador Program",bannerV2SubTitle:"Streamline the Wwise experience for your clients by offering full turn-key service",programDescription:"Audiokinetic is pleased to offer select content providers the opportunity to become Wwise Ambassadors. Wwise Ambassadors are appointed by Audiokinetic and authorized to re-sell Wwise licenses to third party developers.<br />Please note that to become a Wwise Ambassador, you must meet all program prerequisites, must agree to comply with all program requirements, namely the Audiokinetic Wwise Ambassador Agreement, and must follow all guidelines related to using Audiokinetic trademarks and logos on any of your marketing collateral and communications channels.<br /><br />Please read the following to learn more about becoming a Wwise Ambassador, and contact us for the next steps if you’re interested.",programBenefits:{title:"Benefits of a Wwise Ambassador",business:{title:"Good for business",description:"The Wwise Ambassadors program empowers you to set your clients up with Wwise licenses as a part of your service, and manage all client projects and licenses until your services are rendered. Wwise Ambassadors may purchase Wwise licenses for their projects, and resell them to the developers as part of their services package, ensuring the best price for their clients while streamlining the process for them."},recognition:{title:"Recognition",description:"Wwise Ambassadors are identified as such on the Creators Directory, and granted additional Creators points towards their ranking on the Creators Directory. Subject to compliance with all Audiokinetic trademark usage guidelines, Wwise Ambassadors may also use the Wwise Ambassador badge for marketing purposes on their marketing materials and communications channels."},advisoryBoard:{title:"Advisory Boards",description:"Wwise Ambassadors will be invited to participate in Audiokinetic’s Virtual Advisory Boards and expected to commit to at least one per calendar year."}},becoming:{title:"How to become a Wwise Ambassador",steps:{step1:{title:"Register on the Creators Directory as a Content Provider",description:"If you haven’t registered, <AK_LINK_REGISTER_COMPANY>Register your company</AK_LINK_REGISTER_COMPANY>",ctas:{}},step2:{title:"Contact us to become a Wwise Ambassador",description:"",ctas:{primary:"$t(common:buttons.contact-us)"}}}}}},LX={"menu-label":"My Support Tickets"},AX={module:LX,"support-tickets":{bannerV2Title:"My Support Tickets",tabs:{open:{label:"Open Tickets"},closed:{label:"Closed Tickets"}},ctas:{submitSupportTicket:"$t(common:buttons.submit-support-ticket)",viewSupportPolicy:"$t(common:buttons.view-support-policy)",submitFeedback:"Submit feedback"},pendingTicketInfo:{description:"You have $t(customers:support-tickets.pendingTicketInfo.ticket). It can take up to 5 minutes before the ticket is fully created and the status shows as <b>Open</b>. Please check again in 5 minutes.",ticket_one:"a <b>Pending</b> ticket",ticket_other:"<b>Pending</b> tickets"},tableHeaders:{postDate:"Updated",severity:"Severity",subject:"Subject",author:"Latest Post Author",status:"Status",numbers:"Bug/Feature #",projectId:"Project #",survey:"Survey"},form:{title:"Submit a Support Ticket",sections:{project:{title:"Project",description:"Please select the project you need help with from the list below:",subDescription:"Supported plan: {{AK_PLAN_NAME}}",dropdownInstruction:"Select project",impliedTicketUsage:"To ensure proper tracking and the fastest possible resolution, please limit your support ticket to a single topic."}},warning:"Audiokinetic Support is available during regular business hours: Monday to Friday from 9AM to 5PM (EST).<br /><br />There will be no support in upcoming holidays:"}}},zX={"menu-label":"Documentation"},bX={"menu-label":"Wwise"},wX={"menu-label":"Strata"},yX={audiokinetic_launcher:{title:"Audiokinetic Launcher",description:"Learn how to install Wwise, Strata collections, plug-ins, samples, course materials, and more.",ctaPrimary:"Open doc"},certified_partner_plugin:{title:"Certified Partner Plug-ins",description:"Learn about the plug-ins for Wwise created by our certified partners.",ctaPrimary:"Browse docs"},intro_to_wwise:{title:"Introduction to Wwise",description:"An overview of the key concepts.",ctaPrimary:"Open doc"},reawwise:{title:"ReaWwise",description:"Learn about the REAPER extension that lets you transfer audio files from REAPER to Wwise.",ctaPrimary:"Open doc"},latest_release_notes:{title:"Latest Release Notes",description:"See what’s new, improved, and fixed in the latest version of Wwise.",ctaPrimary:"View release notes"},whats_new:{title:"New Features Overview",description:"Learn about the new features in the latest major release of Wwise.",ctaPrimary:"View new features"},recently_viewed:{title:"Recently Viewed",description:"Return to pages you recently explored.",ctaPrimary:"Continue reading"},strata:{title:"Strata",description:"Learn all about Strata, our multitrack sound effect library.",ctaPrimary:"Open doc"},wwise_help:{title:"Wwise Help",description:"Learn how to design interactive audio with the Wwise user interface.",ctaPrimary:"Open doc"},wwise_samples:{title:"Wwise Samples",description:"Learn about the samples that let you experience Wwise in action.",ctaPrimary:"Browse docs"},wwise_sdk:{title:"Wwise SDK",description:"Learn how to integrate the Wwise sound engine into your game and how to customize Wwise to suit your needs.",ctaPrimary:"Open doc"},wwise_unity_integration:{title:"Wwise Unity Integration",description:"Learn how to use Wwise in your Unity games.",ctaPrimary:"Open doc"},wwise_unreal_integration:{title:"Wwise Unreal Integration",description:"Learn how to use Wwise in your Unreal games.",ctaPrimary:"Open doc"}},EX={module:zX,wwise:bX,strata:wX,"ak-launcher":{"menu-label":"$t(doNotTranslate:audiokinetic-launcher)"},landing:yX},HX={"menu-label":"Learning",bannerV2Title:"Shape your career with Wwise",bannerV2Description:"Become a leader in interactive audio.",imageAriaLabel:"Learning Wwise",helmet:{title:"Learning",description:"Start shaping your career with Wwise using our free learning resources"}},TX={segments:{learn:{title:"Learn",imageAriaLabel:"Learning Wwise",description:"Develop Wwise skills to build a successful career in today’s interactive audio job market. Learn at your own pace with our free certification courses designed for all levels of learners, tutorial videos, and free game samples.",MAIN:{primary:"$t(common:buttons.start-learning)"}},teach:{title:"Teach",imageAriaLabel:"Teach Wwise",description:"Bring Wwise into your classroom and prepare your students for their future career using our free course material and academic licensing.  Join our community of teachers, stay up-to-date with our dedicated training for educators, and  benefit from discounts on certification exams.",MAIN:{primary:"$t(common:buttons.start-teaching)"}},train:{title:"Train",imageAriaLabel:"Wwise Team Training",description:"Gain in-demand skills, cover career- advancing topics, and access instructors in real-time through various workshops. If you’re working with a team, take advantage of our custom Team Training to increase your team's confidence and mastery.",MAIN:{primary:"$t(common:buttons.find-training)"}}},"strata-more-info":{title:"Learn sound design with the multitrack sound library, Strata",imageAriaLabel:"Strata logo",description:"Designed for interactive projects, Strata collections are delivered in ready-to-edit multitrack REAPER sessions, allowing you to learn by example and get inspired by the industry’s best sound design professionals."}},SX={title:"Training",bannerV2Title:"Training",bannerV2Description:"Fast-track your proficiency within your areas of interest with expert-led training customized to your needs.",imageAriaLabel:"Wwise Training",helmet:{title:"Wwise Training",description:"We offer individual & Wwise Team Training to fast-track your proficiency within your areas of interest with expert-led training customized to your needs."},"information-cards":{title:"Individual training",upcomingEvents:{title:"Getting started with Wwise",noUpcomingEvents:"No upcoming events.<br /><br /><AK_LINK_COMMUNICATION>Get notified</AK_LINK_COMMUNICATION> when an event is planned!",bootcamp:{title:"Accelerated Training",imageAriaLabel:"Wwise Accelerated Training",subTitle:"",description:"Deep dive into our intensive accelerated training sessions. Designed to give you the confidence you need on the job, you’ll gain practical insights from our expert trainers and be able to immediately apply your skills on any project.",MAIN:{primary:"$t(common:buttons.learn-more)"},"extra-info-label":"Next Events"},workshop:{title:"On-Demand Workshops",imageAriaLabel:"Wwise On-Demand Workshops",subTitle:"",description:"Join our 4-hour hands-on workshops covering in-demand topics. Focused on specific feature sets and their technical applications, these workshops will help you quickly leverage your skills professionally.",MAIN:{primary:"$t(common:buttons.learn-more)"},"extra-info-label":"Next Events"},certified_instructor_program:{title:"Wwise Instructor Program",imageAriaLabel:"Wwise Instructor Program",subTitle:"",description:"Explore proven instructional techniques and practices for  teaching Wwise. This program is designed for educators who want to provide a practical learning experience to prepare students for the current  job market. By successfully completing this training, you’ll also be able to administer the Wwise Fundamentals Practicum certification exam at your institution.",MAIN:{primary:"$t(common:buttons.learn-more)"},"extra-info-label":"Next Events"}}},"team-training-explained":{title:"Team Training","card-data":{title:"",imageAriaLabel:"Wwise Team Training",description:"Empower your team with training customized to your specific project needs. Whether your objective is to quickly onboard a team, or to increase proficiency on specific or advanced Wwise feature sets, Team Training ensures that your team is ready  to tackle any creative endeavor.",MAIN:{primary:"$t(common:buttons.request-assessment-meeting)"}},faqs:{faq_1:{title:"What are the steps to receive a Team training?",description:"<ol><li>Request a meeting to discuss your team’s training needs and availability</li><li>Review and validate your team training outline</li><li>Accept your custom quote</li><li>Receive your custom training</li></ol>",ctaPrimary:""},faq_2:{title:"Who would benefit from Team Training?",description:"Team Training is available to all companies looking to onboard, upskill and empower their employees. Whether you have new team members or managers to onboard, or a team looking to advance their knowledge on complex workflows or new features,  we'll adapt the training to your needs.",ctaPrimary:""},faq_3:{title:"What is the minimum duration of a Team Training?",description:"Duration depends on your specific needs, however, typically a minimum of 2 days is required to allow time for diving into the topics, applying knowledge to your projects and receiving feedback.",ctaPrimary:""},faq_4:{title:"How many team members can join a training session?",description:"There is no minimum number of participants however the maximum number per session is 10.",ctaPrimary:""},faq_5:{title:"How much does Team Training cost?",description:"Our Wwise onboarding Team Training package includes everything needed to get your team started with their Wwise project. For more information on customized team training pricing <AK_TEXT_TARGET_ONE>contact us</AK_TEXT_TARGET_ONE>.",ctaPrimary:""},faq_6:{title:"Is Team Training offered on-site, or only available online?",description:"On-site Team Training can be accommodated upon trainer availability, and all associated charges will be included in your custom quote.",ctaPrimary:""},faq_7:{title:"Can we share confidential information about our project(s)?",description:"Yes, you can. All training sessions are under Non-Disclosure Agreement.",ctaPrimary:""},faq_8:{title:"Will the Team Training session be recorded?",description:"Team Training sessions will only be recorded with your approval, exclusively for your future use.  On-site training will not be recorded by Audiokinetic.",ctaPrimary:""}}}},VX=JSON.parse(`{"title":"Certifications","bannerV2Title":"Certifications","bannerV2Description":"Get certified to demonstrate your proficiency with Wwise, the trusted gold standard for cross-platform interactive and spatial audio development.","imageAriaLabel":"Wwise Certifications","helmet":{"title":"Wwise Certifications","description":"Wwise Certifications help you demonstrate your proficiency with Wwise, the trusted gold standard for cross-platform interactive and spatial audio development."},"certifications-discovery":{"title":"Certifications","certs":{"wwise101":{"titlePrefix":"","title":"Wwise Fundamentals","description":"$t(learning:certifications.certifications-discovery.certs.wwise101.helmet.description)","imageAriaLabel":"Blank Badge for Wwise Fundamentals Certification","helmet":{"title":"Wwise Fundamentals Certification","description":"The Wwise Fundamentals Certification covers all the fundamentals you’ll need to get started with Wwise. You will learn how to create and mix virtual soundscapes"},"MAIN":{"primary":"$t(common:buttons.learn-more)"},"INFO":{"primary":"$t(common:buttons.purchase-exam)","secondary":"$t(common:buttons.prepare-for-exam)"},"overview":{"title":"Overview","description":"The Wwise Fundamentals Certification covers all the fundamentals you’ll need to get started with Wwise. You will learn how to create and mix virtual soundscapes and leverage sound triggering systems. You will also practice audio integration workflows, and learn system performance optimization techniques.\\n\\nBecoming Wwise Fundamentals certified grants you the opportunity of getting listed on the Creators Directory as a Content Provider. The Creators Directory is where developers source interactive audio talent and services!"},"benefits":{"title":"Who should take this certification?","description":"<AK_BULLET>Audio professionals or sound engineers</AK_BULLET><AK_BULLET>Game and VR/AR designers and developers</AK_BULLET><AK_BULLET>Music composers</AK_BULLET><AK_BULLET>Educators</AK_BULLET><AK_BULLET>Students and hobbyists</AK_BULLET>"},"examSummary":{"title":"Exam summary","summaryTable":{"line_1":{"title":"Duration","description":"90 minutes"},"line_2":{"title":"Format","description":"80 questions :<AK_BULLET>Either multiple-choice, multi-select, hot spot, matching questions.</AK_BULLET><AK_BULLET>At least 50 % of the exam questions come directly from the lesson quizzes.</AK_BULLET>"},"line_3":{"title":"Passing grade","description":"90% or above"},"line_4":{"title":"Delivery methods","description":"Computer-Based Test"},"line_5":{"title":"Attempts included","description":"2 attempts"}}}},"wwise201":{"titlePrefix":"","title":"Interactive Music","description":"$t(learning:certifications.certifications-discovery.certs.wwise201.helmet.description)","imageAriaLabel":"Blank Badge for Wwise Interactive Music Certification","helmet":{"title":"Wwise Interactive Music Certification","description":"The Wwise Interactive Music certification helps you demonstrate your ability to master Wwise music systems"},"MAIN":{"primary":"$t(common:buttons.learn-more)"},"INFO":{"primary":"$t(common:buttons.purchase-exam)","secondary":"$t(common:buttons.prepare-for-exam)"},"overview":{"title":"Overview","description":"The Wwise Interactive Music certification is designed for individuals who have already completed the Wwise Fundamentals course and/or have a foundational understanding of Wwise. This certification covers all the essentials you need to learn about Wwise for interactive music. You’ll learn how to create a dynamic score, how to integrate music from a DAW into your game and implement custom created music within Wwise.  \\n\\nBecoming Wwise Interactive Music certified grants you the opportunity of getting listed on the Creators Directory as a Content Provider. The Creators Directory is where developers source interactive audio talent and services!"},"benefits":{"title":"Who should take this certification?","description":"<AK_BULLET>Audio professionals or sound engineers</AK_BULLET><AK_BULLET>Game and VR/AR designers and developers</AK_BULLET><AK_BULLET>Music composers</AK_BULLET><AK_BULLET>Educators</AK_BULLET><AK_BULLET>Students</AK_BULLET>"},"examSummary":{"title":"Exam summary","summaryTable":{"line_1":{"title":"Duration","description":"90 minutes"},"line_2":{"title":"Format","description":"80 questions :<AK_BULLET>Either multiple-choice, multi-select, hot spot, matching questions.</AK_BULLET><AK_BULLET>At least 50 % of the exam questions come directly from the lesson quizzes.</AK_BULLET>"},"line_3":{"title":"Passing grade","description":"90% or above"},"line_4":{"title":"Delivery methods","description":"Computer-Based Test"},"line_5":{"title":"Attempts included","description":"2 attempts."}}}},"wwise251":{"titlePrefix":"","title":"Performance Optimization","description":"$t(learning:certifications.certifications-discovery.certs.wwise251.helmet.description)","imageAriaLabel":"Blank Badge for Wwise Performance Optimization Certification","helmet":{"title":"Wwise Performance Optimization Certification","description":"The Wwise Performance Optimization Certification helps you validate your ability to optimize wwise project across platforms and balance CPU budget based on hardware specifications."},"MAIN":{"primary":"$t(common:buttons.learn-more)"},"INFO":{"primary":"$t(common:buttons.purchase-exam)","secondary":"$t(common:buttons.prepare-for-exam)"},"overview":{"title":"Overview","description":"The Wwise Performance Optimization Certification is designed for individuals who have already completed the Wwise Fundamentals course and/or have a foundational understanding of Wwise. It covers a series of performance optimization techniques using Wwise.\\n\\nYou’ll learn about SoundBank granularity and how to optimize your project across platforms and balance your CPU budget based on hardware specifications. You’ll also explore voice management including audio content prioritization, optimizing Effects within the voice pipeline, and conversion and compression settings best practices. \\n\\nBecoming Wwise Performance Optimization certified grants you the opportunity of getting listed on the Creators Directory as a Content Provider. The Creators Directory is where developers source interactive audio talent and services!"},"benefits":{"title":"Who should take this certification?","description":"<AK_BULLET>Audio professionals or sound engineers</AK_BULLET><AK_BULLET>Game and VR/AR designers and developers</AK_BULLET><AK_BULLET>Music composers</AK_BULLET><AK_BULLET>Educators</AK_BULLET><AK_BULLET>Students</AK_BULLET>"},"examSummary":{"title":"Exam summary","summaryTable":{"line_1":{"title":"Duration","description":"90 minutes"},"line_2":{"title":"Format","description":"80 questions :<AK_BULLET>Either multiple-choice, multi-select, hot spot, matching questions.</AK_BULLET><AK_BULLET>At least 50 % of the exam questions come directly from the lesson quizzes.</AK_BULLET>"},"line_3":{"title":"Passing grade","description":"90% or above"},"line_4":{"title":"Delivery methods","description":"Computer-Based Test"},"line_5":{"title":"Attempts included","description":"2 attempts."}}}},"wwise301":{"titlePrefix":"","title":"Wwise Unity Integration","description":"$t(learning:certifications.certifications-discovery.certs.wwise301.helmet.description)","imageAriaLabel":"Blank Badge for Wwise Unity Integration Certification","helmet":{"title":"Wwise Unity Integration Certification","description":"The Wwise Unity Integration Certification covers everything you need to know about the Wwise Unity Integration"},"MAIN":{"primary":"$t(common:buttons.learn-more)"},"INFO":{"primary":"$t(common:buttons.purchase-exam)","secondary":"$t(common:buttons.prepare-for-exam)"},"overview":{"title":"Overview","description":"The Wwise Unity Integration certification is designed for individuals who have already completed the Wwise Fundamentals course and/or have a foundational understanding of Wwise. It covers everything you need to know about the Wwise Unity Integration. \\n\\nYou’ll learn how to load SoundBanks and post Events in Unity, how to create or customize in-game mechanics to trigger and modify audio, and how to integrate and customize the Wwise Unity Integration for any technical and artistic requirements.\\n\\nBecoming Wwise Unity Integration certified grants you the opportunity of getting listed on the Creators Directory as a Content Provider. The Creators Directory is where developers source interactive audio talent and services!"},"benefits":{"title":"Who should take this certification?","description":"<AK_BULLET>Audio professionals or sound engineers</AK_BULLET><AK_BULLET>Game and VR/AR designers and developers</AK_BULLET><AK_BULLET>Music composers</AK_BULLET><AK_BULLET>Educators</AK_BULLET><AK_BULLET>Students</AK_BULLET>"},"examSummary":{"title":"Exam summary","summaryTable":{"line_1":{"title":"Duration","description":"90 minutes"},"line_2":{"title":"Format","description":"80 questions :<AK_BULLET>Either multiple-choice, multi-select, hot spot, matching questions.</AK_BULLET><AK_BULLET>At least 50 % of the exam questions come directly from the lesson quizzes.</AK_BULLET>"},"line_3":{"title":"Passing grade","description":"90% or above"},"line_4":{"title":"Delivery methods","description":"Computer-Based Test"},"line_5":{"title":"Attempts included","description":"2 attempts"}}}},"wwise110":{"titlePrefix":"","title":"Wwise Fundamentals Practicum","description":"The Wwise Fundamentals Practicum is only offered by schools with certified instructors. Find a school near you to have more information about the next sessions.","imageAriaLabel":"Blank Badge for Wwise Fundamentals Practicum ","helmet":{"title":"Wwise Fundamentals Practicum","description":"Wwise Fundamentals Practicum is a practical assessment add-on to the Wwise Fundamentals certification exam. Wwise Fundamentals Practicum helps you demonstrate your practical know-how"},"MAIN":{"primary":"$t(common:buttons.learn-more)","secondary":""},"INFO":{"primary":"See Upcoming Sessions","secondary":""},"whatItIs":{"title":"Complement your Wwise Fundamentals certification with a live, hands-on practical exam.","description":"The Wwise Fundamentals Practicum is a live, instructor-administered exam that evaluates the practical application of the competencies covered in Wwise Fundamentals. Successful candidates earn the Wwise Fundamentals Practicum certification."},"eligibility":{"title":"Eligibility","description":"To register for a Practicum live exam session, you must:<AK_BULLET>Hold a current Wwise Fundamentals certification.</AK_BULLET><AK_BULLET>Candidates certified before Wwise 2024.1 must pass the Wwise Fundamentals recertification exam before taking the Practicum exam.</AK_BULLET>"},"whyDoIt":{"title":"Why add the Practicum exam?","description":"The Wwise Fundamentals certification demonstrates your knowledge of Wwise concepts. The Wwise Fundamentals Practicum complements it by evaluating your ability to apply those same competencies through a live, hands-on exam that simulates a real-world Wwise implementation workflow.\\n\\nUpon successful completion, you'll:<AK_BULLET>Earn the Wwise Fundamentals Practicum Certification.</AK_BULLET><AK_BULLET>Complement your Wwise Fundamentals Certification with a practical credential.</AK_BULLET><AK_BULLET>Demonstrate your ability to apply the competencies covered in Wwise Fundamentals in a production-style implementation.</AK_BULLET><AK_BULLET>Become eligible to be listed as a Content Provider in the Wwise Creators Directory.</AK_BULLET>"},"whatToExpect":{"title":"What to expect?","description":"Using the Cube demo project, you'll complete practical tasks covering:<AK_BULLET>Project setup</AK_BULLET><AK_BULLET>Sound implementation</AK_BULLET><AK_BULLET>Mixing</AK_BULLET><AK_BULLET>Reactive audio</AK_BULLET><AK_BULLET>Optimization</AK_BULLET><AK_BULLET>SoundBank generation and delivery</AK_BULLET>\\n\\nThe exam also includes live demonstrations of selected Wwise workflows observed by an instructor."},"whosItFor":{"title":"Who should take the Practicum exam?","description":"The Wwise Fundamentals Practicum is designed for learners who want to complement their Wwise Fundamentals certification with a practical exam.\\n\\nIt is recommended for:<AK_BULLET>Audio professionals working with Wwise.</AK_BULLET><AK_BULLET>Sound designers and technical audio implementers.</AK_BULLET><AK_BULLET>Game developers using Wwise.</AK_BULLET><AK_BULLET>Educators.</AK_BULLET><AK_BULLET>Students preparing for professional practice.</AK_BULLET>"},"examSummary":{"title":"Exam Overview","summaryTable":{"line_1":{"title":"Duration","description":"2 hours"},"line_2":{"title":"Exam Format","description":"Live practical exam"},"line_3":{"title":"Project","description":"Cube demo project"},"line_4":{"title":"Delivery","description":"Instructor-administered"},"line_5":{"title":"Assessment","description":"37 practical tasks"},"line_6":{"title":"Passing Score","description":"90%"},"line_7":{"title":"Attempts included","description":"1"}}},"pleaseNote":{"description":"<i>Please note: Audiokinetic reserves the right to reschedule or cancel a live training session if the minimum number of participants is not reached. Registered participants will be notified and offered an alternative session date. </i>"}},"wwise135":{"titlePrefix":"","title":"Wwise Instructor Program","description":"The Wwise instructor Program is a 4-day sessions. The sessions will be held by Robert Brock, Game Audio Department Director at the CRAS.","imageAriaLabel":"Blank Badge for Wwise Instructor Program","MAIN":{"primary":"$t(common:buttons.learn-more)","secondary":""},"INFO":{"primary":"","secondary":""}},"wwiseCertificationBundles":{"title":"Certification Bundle","imageAriaLabel":"Wwise Certification bundle","description":"Buy 10+ Certifications of your choice and get discount","MAIN":{"primary":"$t(common:buttons.request-discount)","secondary":""},"INFO":{"primary":"","secondary":""}}}},"getting-certified":{"title":"How to get certified?","step_1":{"title":"Complete lessons","description":"Learn at your own pace, online."},"step_2":{"title":"Take quizzes","description":"Complete the quizzes associated with each lesson."},"step_3":{"title":"Pass exam","description":"Take the exam when you are ready!"}},"certification-details":{"loadingEvents":"Loading Upcoming Sessions","upcomingEvents":"See Upcoming Sessions","noEvents":"No Upcoming Sessions"}}`),CX={title:"Strata"},BX={title:"Documentation"},IX={title:"Videos",filters:{searchTermPlaceHolder:"Textual search in educational videos...",noResultsWithSelection:"There are no videos with the combination of filters you have currently selected.",tags:{title:"Tags",types:{education:"Education",lesson:"Lesson",tutorial_guide:"Tutorial Guide",webinar:"Webinar"}}}},OX=JSON.parse(`{"menu-label":"Samples","bannerV2Title":"Learn Wwise Samples","platforms":"Platforms","downloadLauncher":"$t(audiokineticLauncher.download)","openLauncher":"$t(audiokineticLauncher.open)","details":{"experience":"Sample type","skills":"Skills learned","compatible-platforms":"Compatible Platforms","takeaway":"Takeaway","noLauncherYet":"You need $t(doNotTranslate:audiokinetic-launcher-TextOnly) to download this Sample.<br><br>Not installed yet?<br><AK_LINK_GET_LAUNCHER>Download $t(audiokineticLauncher.name) instead</AK_LINK_GET_LAUNCHER>","installation":"How to install with $t(audiokineticLauncher.name)","installationGuideButton":"View Installation Guide","sampleDetailsStats":{"author":{"title":"Author","description":"$t(doNotTranslate:audiokinetic)"},"versions":{"title":"Compatible Wwise versions","description":"Wwise {{AK_VAR_WWISE_LOW}} to {{AK_VAR_WWISE_HIGH}}"},"platforms":{"title":"Compatible Platforms"}}},"filtersOptions":{"experience":{"demo":"Demo","fullGame":"Full Game","guidedLearning":"Guided Learning","sandbox":"Sandbox","testCases":"Test Cases"},"skills":{"fundamentals":"Fundamentals","integration":"Integration","interactiveAudio":"Interactive Audio","mixing":"Mixing","sourcePlugins":"Source Plug-ins","spatialAudio":"Spatial Audio","unityPlayground":"Unity Playground"},"difficulties":{"beginner":"Beginner","intermediary":"Intermediary","advanced":"Advanced"},"takeaway":{"wwise101":"Wwise Fundamentals","wwise201":"Interactive Music","unreal":"Unreal","unity":"Unity","cpp":"C++","3D_audio":"3D Audio","spatial_audio":"Spatial Audio","midi":"midi","open_source":"Open Source","sound_effects":"Sound SFX","waapi":"WAAPI","sdk":"SDK"}},"tabs":{"AUDIOKINETIC":{"label":"Audiokinetic","searchTermPlaceHolder":"Textual search Audiokinetic Samples..."},"COMMUNITY":{"label":"Community","searchTermPlaceHolder":"Textual search Community Samples..."}},"filters":{"title":"Filters","AUDIOKINETIC":{"title":"Audiokinetic","searchTermPlaceHolder":"Audiokinetic...","types":{"demo":"Demo","fullGame":"Full Game","guidedLearning":"Guided Learning","sandbox":"Sandbox","testCases":"Test Cases"}},"COMMUNITY":{"title":"Community","searchTermPlaceHolder":"Community...","types":{"demo":"Demo","fullGame":"Full Game","guidedLearning":"Guided Learning","sandbox":"Sandbox","testCases":"Test Cases"}},"LEARNING_SAMPLES":{"title":"Filters"},"communitySamples":{"title":"Community Samples","description":"Explore sample projects created and shared by the Wwise community.<br /><br />These projects showcase real-world workflows, techniques, integrations, and experiments that can help you learn from other creators and discover new ways to work with Wwise."},"experience":{"title":"Sample type","types":{"demo":"Demo","fullGame":"Full Game","guidedLearning":"Guided Learning","sandbox":"Sandbox","testCases":"Test Cases"}},"skills":{"title":"Skills Learned{{AK_VAR_COUNT}}","types":{"fundamentals":"Fundamentals","integration":"Integration","interactiveAudio":"Interactive Audio","mixing":"Mixing","sourcePlugins":"Source Plug-ins","spatialAudio":"Spatial Audio","unityPlayground":"Unity Playground"}},"difficulty":{"title":"Difficulty{{AK_VAR_COUNT}}"},"platforms":{"title":"Compatible Platforms{{AK_VAR_COUNT}}","types":{"android":"$t(doNotTranslate:platforms.android)","ios":"$t(doNotTranslate:platforms.ios)","linux":"$t(doNotTranslate:platforms.linux)","mac_os_x":"$t(doNotTranslate:platforms.mac_os_x)","playstation_4":"$t(doNotTranslate:platforms.playstation_4)","playstation_5":"$t(doNotTranslate:platforms.playstation_5)","nintendo_switch":"$t(doNotTranslate:platforms.nintendo_switch)","nintendo_switch_2":"$t(doNotTranslate:platforms.nintendo_switch_2)","windows":"$t(doNotTranslate:platforms.windows)","xbox_one":"$t(doNotTranslate:platforms.xbox_one)"}},"takeaway":{"title":"Takeaway{{AK_VAR_COUNT}}"},"searchTermPlaceHolder":"Search for samples by name","order-by":{"AtoZ":"Name (A-Z)","ZtoA":"Name (Z-A)","EasyToHard":"Difficulty (Easy-Hard)","HardToEasy":"Difficulty (Hard-Easy)"}},"supporting-tags":{"difficulty":{"beginner":"Beginner","intermediate":"Intermediate","advanced":"Advanced","expert":"Expert"}},"by-id":{"cube":{"title":"Cube","description":"A non-violent adaptation of the open-source first-person game <b>Cube</b>, this version features the Wwise Wwizard from the $t(doNotTranslate:wwise-adventure-game) sample. Playing the Wwise Wwizard who collects potions and spells, you can also throw magical gems with your magic wand. This sample comes with C++ source code and a Wwise project, and can be used alongside the <AK_MODULE_LEARNING_CERTIFICATION_MORE_INFO slugId='wwise-fundamentals'>Wwise Fundamentals</AK_MODULE_LEARNING_CERTIFICATION_MORE_INFO> and <AK_MODULE_LEARNING_CERTIFICATION_MORE_INFO slugId='interactive-music'>Interactive Music</AK_MODULE_LEARNING_CERTIFICATION_MORE_INFO> certifications learning content. We have ensured that all the mechanisms in this modified Cube sample game remain the same, and have simply changed some audio assets, and renamed certain Objects and Events in the certifications' content to align with the sample's new non-violent theme."},"gyms":{"title":"Gyms","description":"Sample <>projects for the Wwise Unreal and Unity Integrations. Gyms provide working examples of Wwise features that you can explore and test in both game engines."},"limbo":{"title":"Limbo","description":"The <b>Limbo</b> game and its corresponding Wwise project have been made available to allow experimenting with interactive audio using Wwise along with an actual game. Modify the game sound design by adding your own audio files, changing audio behaviors, remixing, and monitor in real-time what happens under the hood in an actual game situation. Note that the original audio files will not be included, only the Wwise project with empty Sound SFX objects. This sample project is meant for users who are already familiar with Wwise. If you are unfamiliar with Wwise, we recommend that you start by learning Wwise using the <AK_LINK_WWISE_FUN><b>Wwise Fundamentals Certification</b></AK_LINK_WWISE_FUN> learning material."},"sample-project":{"title":"Sample Project","description":"The <b>Sample Project</b> is a Wwise project accompanied with documentation. Through typical sound design examples, it demonstrates fundamental Wwise features such as footstep structures, day/night cycling ambiences, interactive music, MIDI, virtual instruments, and more. We encourage you to take a look at this project to see how you can creatively use Wwise to manage your game audio, in a complete project."},"waapi":{"title":"Wwise Authoring API Samples Pack","description":"The <b>Wwise Authoring API Samples Pack</b> provides you with various samples structured around tasks that help you learn WAAPI essentials. You will be able to create comprehensive integrations of Wwise into any engine, tool, or application, and you will be able to do so with any Internet-capable language, operating system, or environment."},"wal":{"title":"Wwise Audio Lab (WAL)","description":"<b>Wwise Audio Lab (WAL)</b> is an open-source game-like 3D environment developed with Unreal Engine 4, which runs on Mac and Windows. It showcases various spatial audio methods and technologies, such as geometry-informed dynamic early reflections, sound portals, oriented reverb, in-addition to leveraging 3D Audio when its available at the endpoint. Information nodes distributed in the maps help identify sound propagation phenomena, and in-game options allow for instant A-B comparison between various spatial and object-based audio approaches. Although WAL is designed for experimenting with spatial audio features, the project is fully customizable for users interested in finding the perfect combination of tools and methods for their future projects."},"wag":{"title":"$t(doNotTranslate:wwise-adventure-game-wag)","description":"The <b>$t(doNotTranslate:wwise-adventure-game-wag)</b> is a third-person action-adventure game developed with Unity and running on Windows, Mac, iOS, and Android. This is a full game with quests, items to retrieve, enemies to overcome, and a final combat to defeat the plague scourging Allegro Kingdom. \\n\\nWAG is open-source and comes with its complete Wwise and Unity projects. As such, it’s a great playground to learn and experiment with the Wwise integration for Unity."},"wwise-sdk":{"title":"Wwise SDK Samples","description":"The <b>Wwise SDK Samples</b> contains several samples with source code.","details":{"effects":{"title":"Sample Effect and Source Plug-ins","description":"Sine Generator, Tone Generator, Audio Input plug-in, and Delay Effect. These are more than just samples, they are the actual plug-ins that are part of the Wwise authoring application and SDK."},"demo":{"title":"Integration Demo","description":"The Wwise Integration Demo is an application that contains samples demonstrating how you can integrate the Wwise sound engine and its various features and concepts into game engines."},"dll":{"title":"Sound Engine Sample DLL","description":"This sample explains how to wrap the sound engine inside a DLL to be used by your Windows-based game."},"implementation":{"title":"Default Low-Level I/O and File Packager Implementation","description":"The full source code of the default low-level I/O and File Packager that are provided with Wwise. You can use this to customize how the Streaming Manager will deal with files and/or how data files get packaged into bigger binary files."},"samples":{"title":"SoundFrame Samples","description":"Car Simulator and SFTest provide examples of the SoundFrame API."},"plugins":{"title":"Source Control Plug-ins","description":"These are the sources for the Perforce and Subversion plug-ins, as well as a more basic sample plug-in that can be used to write your own source control plug-in."}}}},"sections-NO-LONGER-USED":{"cube":{"title":"Cube","description":"A non-violent adaptation of the open-source first-person game <b>Cube</b>, this version features the Wwise Wwizard from the $t(doNotTranslate:wwise-adventure-game) sample. Playing the Wwise Wwizard who collects potions and spells, you can also throw magical gems with your magic wand. This sample comes with C++ source code and a Wwise project, and can be used alongside the Wwise Fundamentals and Wwise Interactive Music certifications learning content. We have ensured that all the mechanisms in this modified Cube sample game remain the same, and have simply changed some audio assets, and renamed certain Objects and Events in the certifications’ content to align with the sample’s new non-violent theme."},"wal":{"title":"Wwise Audio Lab (WAL)","description":"<b>Wwise Audio Lab (WAL)</b> is an open-source game-like 3D environment developed with Unreal Engine 4, which runs on Mac and Windows. It showcases various spatial audio methods and technologies, such as geometry-informed dynamic early reflections, sound portals, oriented reverb, in-addition to leveraging 3D Audio when its available at the endpoint. Information nodes distributed in the maps help identify sound propagation phenomena, and in-game options allow for instant A-B comparison between various spatial and object-based audio approaches. Although WAL is designed for experimenting with spatial audio features, the project is fully customizable for users interested in finding the perfect combination of tools and methods for their future projects."},"sample":{"title":"Sample Project","description":"The <b>Sample Project</b> is a Wwise project accompanied with documentation. Through typical sound design examples, it demonstrates fundamental Wwise features such as footstep structures, day/night cycling ambiences, interactive music, MIDI, virtual instruments, and more. We encourage you to take a look at this project to see how you can creatively use Wwise to manage your game audio, in a complete project."},"wag":{"title":"$t(doNotTranslate:wwise-adventure-game-wag)","description":"The <b>$t(doNotTranslate:wwise-adventure-game-wag)</b> is a third-person action-adventure game developed with Unity and running on Windows, Mac, iOS, and Android. This is a full game with quests, items to retrieve, enemies to overcome, and a final combat to defeat the plague scourging Allegro Kingdom. \\n\\nWAG is open-source and comes with its complete Wwise and Unity projects. As such, it’s a great playground to learn and experiment with the Wwise integration for Unity."},"limbo":{"title":"Limbo","description":"The <b>Limbo</b> game and its corresponding Wwise project have been made available to allow experimenting with interactive audio using Wwise along with an actual game. Modify the game sound design by adding your own audio files, changing audio behaviors, remixing, and monitor in real-time what happens under the hood in an actual game situation. Note that the original audio files will not be included, only the Wwise project with empty Sound SFX objects. This sample project is meant for users who are already familiar with Wwise. If you are unfamiliar with Wwise, we recommend that you start by learning Wwise using the <AK_LINK_WWISE_FUN>Wwise Fundamentals Certification</AK_LINK_WWISE_FUN> learning material."},"authoring":{"title":"Wwise Authoring API Samples Pack","description":"The <b>Wwise Authoring API Samples Pack</b> provides you with various samples structured around tasks that help you learn WAAPI essentials. You will be able to create comprehensive integrations of Wwise into any engine, tool, or application, and you will be able to do so with any Internet-capable language, operating system, or environment."},"sdk":{"title":"Wwise SDK","description":"The <b>Wwise SDK</b> contains several samples with source code. Sample Effect and Source Plug-ins, Integration Demo, Sound Engine Sample DLL, Default Low-Level I/O and File Packager Implementation, SoundFrame Samples, and Source Control Plug-ins.","details":{"severalSamples":"The <b>Wwise SDK</b> contains several samples with source code.","effects":"<b>Sample Effect and Source Plug-ins:</b> Sine Generator, Tone Generator, Audio Input plug-in, and Delay Effect. These are more than just samples, they are the actual plug-ins that are part of the Wwise authoring application and SDK.","demo":"<b>Integration Demo:</b> The Wwise Integration Demo is an application that contains samples demonstrating how you can integrate the Wwise sound engine and its various features and concepts into game engines.","dll":"<b>Sound Engine Sample DLL:</b> This sample explains how to wrap the sound engine inside a DLL to be used by your Windows-based game.","implementation":"<b>Default Low-Level I/O and File Packager Implementation:</b> The full source code of the default low-level I/O and File Packager that are provided with Wwise. You can use this to customize how the Streaming Manager will deal with files and/or how data files get packaged into bigger binary files.","samples":"<b>SoundFrame Samples:</b> Car Simulator and SFTest provide examples of the SoundFrame API.","plugins":"<b>Source Control Plug-ins:</b> These are the sources for the Perforce and Subversion plug-ins, as well as a more basic sample plug-in that can be used to write your own source control plug-in."}},"simulator":{"title":"Wwise Game Simulator","description":"The <b>Wwise Game Simulator</b> is a LUA interpreter with Wwise SDK bindings. This application allows you to use the simple scripting language Lua to reproduce exactly how sounds behave in your game. The Game Simulator can access most functionalities of the sound engine, allowing you to validate sound behaviors and profile the performance of Wwise on each platform before the integration of Wwise into your game's sound engine."}},"details-addon":{"installViaLauncher":"Samples can be installed from the $t(doNotTranslate:audiokinetic-launcher).","wal":"The Wwise Audio Lab can be installed from the $t(doNotTranslate:audiokinetic-launcher). Please ensure that you have updated your $t(doNotTranslate:audiokinetic-launcher) prior to following the installation steps.","wag":"The $t(doNotTranslate:wwise-adventure-game) can be installed from the $t(doNotTranslate:audiokinetic-launcher). Please ensure that you have updated your $t(doNotTranslate:audiokinetic-launcher) prior to following the installation steps.","authoring":"The Wwise Authoring API can be installed during the installation of Wwise 2017.1, or later versions."},"installSteps":{"title":"Installation Steps","steps":{"step0":"Step 1","step1":"Step 2","step2":"Step 3"},"selectWwise":"Click on the SAMPLES tab, then select <b>Wwise</b>.","selectWwiseAudioLab":"Click on the SAMPLES tab, then select <b>Wwise Audio Lab</b>.","selectWAG":"Click on the SAMPLES tab, then select <b>$t(doNotTranslate:wwise-adventure-game)</b>.","selectVersion":"Select the version you would like to install, then click <b>Install</b>.","clickInstall":"Click <b>Install</b> on this page.","afterInstall":"The Wwise Audio Lab will start installing. After the installation process is complete, you will be able to access the Wwise Audio Lab from your SAMPLES tab.","afterWAGInstall":"The $t(doNotTranslate:wwise-adventure-game) will start installing. After the installation process is complete, you will be able to access the $t(doNotTranslate:wwise-adventure-game) from your SAMPLES tab.","sampleDistributed":"Samples are distributed for a specific version of Wwise.","selectWwiseVersion":"Select your Wwise version. If you have not installed Wwise yet, you can do so from the Wwise tab.","sampleDisplayed":"Your samples will be displayed below the Versions box. If no samples are installed, click on the blue <b>Modify Wwise [version number]</b> button.","expandSamples":"From the left column labeled Packages, select Samples to expand the list of individual Samples available.","selectSamples":"Select the samples you wish to install.","clickModify":"Click on the blue button labeled <b>Modify</b> at the bottom of the page.","willStartInstalling":"Your samples will start installing. After the installation process is complete, samples you have installed will be listed in SAMPLES tab.","duringInstallation":"During the Installation of Wwise 2017.1, or later versions:","ensureCheck":"Ensure you check <b>SDK (C++)</b>","selectPlatform":"Select the relevant Deployment Platforms","afterInstallShort":"After Installation:","clickInstallShort":"Click <b>Install.</b>","clickTool":"In the <b>Wwise</b> tab, click the tool icon","selectFolder":"Select Open Containing Folder","browseToSamples":"Browse to SDK\\\\samples","browseToAPI":"Browse to SDK\\\\samples\\\\WwiseAuthoringAPI","furtherInformation":"Further information on each sample is provided <a>here</a>.","findReadme":"Find the readme.md file in the subdirectories for your preferred language and protocol (e.g. \\\\python\\\\wwise-pubsub-wamp)","followInstructions":"Follow the instructions in the file"}}`),NX={module:HX,"learning-carousel":{motto_1:{title:"Over 3000",description:"Wwise users have chosen to get Wwise certified, giving themselves an edge on the job market."},motto_2:{title:"Nearly 10,000",description:"new independent learners embarked on their Wwise learning journey in 2022"},motto_3:{title:"More than 15,000",description:"students are learning Wwise in 300+ partner schools across 5 continents."}},learning:TX,"learn-wwise":JSON.parse(`{"title":"Learn Wwise","bannerV2Title":"Learn Wwise","bannerV2Description":"Leverage our free learning material to propel your interactive audio career.","imageAriaLabel":"Learn Wwise","helmet":{"title":"Learn Wwise","description":"Learn Wwise and explore courses on interactive Music, performance optimization, Unity Integration to succeed in your projects"},"learn-from-experts":{"title":"Learn with experts","cards":{"find-school":{"title":"Find a partner school","imageAriaLabel":"Find a Wwise Partner School","description":"Browse the Creators Directory to find a partner school in your area.","MAIN":{"primary":"$t(common:buttons.find-a-school)"}},"find-training":{"title":"Find professional workshops and training","imageAriaLabel":"Train your Team on Wwise with our experts","description":"Fast-track your learning with the guidance of subject matter experts. Gain in-demand skills and practice what you learn through hands-on sessions.","MAIN":{"primary":"$t(common:buttons.find-training)"}}}},"get-certified":{"title":"Get Certified","description":"Whether you’re just starting out or looking to expand your skills and expertise, getting certified  allows you to demonstrate your professional interactive audio competencies."},"information-cards":{"suited-for-groups":{"group-title":"Topics covered:","animations":"Animations","cpu":"CPU","callbacks":"Callbacks","compression":"Compression","compressor":"Compressor","control_surface":"Control Surface","conversion":"Conversion","distance_attenuation":"Distance Attenuation","dynamic_mixing":"Dynamic Mixing","effects":"Effects","game_parameters":"Game Parameters","game_audio":"Game Audio","interactive_music":"Interactive Music","midi":"MIDI","memory":"Memory","multi_position":"Multi-Position","music_playlist":"Music Playlist","music_track":"Music Track","optimizations":"Optimizations","platform_management":"Platform Management","playback_limits":"Playback Limits","positioning":"Positioning","priority":"Priority","profiling":"Profiling","rendering_effects":"Rendering Effects","reverb_zones":"Reverb Zones","side_chain":"Side-chain","signal_flow":"Signal Flow","sound_design":"Sound Design","soundbank_management":"SoundBank Management","states":"States","switches":"Switches","synthesis":"Synthesis","transitions":"Transitions","triggers":"Triggers","unity_integration":"Unity Integration","virtual_voice":"Virtual Voice"},"gettingStartedWithWwise":{"title":"Getting started with Wwise","wwiseFundamentals":{"title":"Wwise Fundamentals","description":"Get familiar with the most essential features and workflows in Wwise and learn how to produce vibrant soundscapes and how to design game audio professionally.","MAIN":{"primary":"$t(common:buttons.learn-for-free)","secondary":"$t(common:buttons.get-certified)"}}},"chooseYourTopics":{"title":"Explore courses","interactiveMusic":{"title":"Interactive Music","description":"Learn how to liberate your music compositions in a dynamic game context. Layer your music based on in-game actions, direct the flow of music scores and associate your transitions with musical behavior, like rhythm or cues.","MAIN":{"primary":"$t(common:buttons.learn-for-free)","secondary":"$t(common:buttons.get-certified)"}},"performanceOptimization":{"title":"Performance Optimization","description":"Learn how to optimize your Wwise project across platforms by prioritizing audio content and balancing your CPU budget based on hardware specifications.","MAIN":{"primary":"$t(common:buttons.learn-for-free)","secondary":"$t(common:buttons.get-certified)"}},"unityIntegration":{"title":"Wwise Unity Integration","description":"Learn to integrate and customize Wwise in a real Unity game. Master SoundBanks, Events, in-game triggers, reverb zones, and music callbacks for any Wwise project integrated in a Unity game.","MAIN":{"primary":"$t(common:buttons.learn-for-free)","secondary":"$t(common:buttons.get-certified)"}}}},"wwise101":{"bannerTagline":"Wwise Fundamentals","bannerSubTagline":"","helmet":{"title":"Wwise Fundamentals","description":"This course covers the fundamentals, helping you practice audio integration workflows, performing optimization techniques among others"},"outline":"Course Includes","detailed-outline":{"loggedIn":"Course Outline","notLoggedIn":"Course Outline","content":{"step0":{"title":"Installing the Course Materials","description":"Get your system ready for this certification! Follow the guidelines to install Wwise, and any other tools, assets and files you’ll be using throughout this course.","ctaPrimary":"$t(common:audiokineticLauncher.open)"},"step1":{"title":"Module 1: Quick Start–From Silence to Sound","description":"In this module, you'll transform a simple action in the game Cube—the throwing of an ice gem—into an engaging experience, complete with an ice blast sound effect. Let’s get started!","ctaPrimary":"$t(common:buttons.launchModule)"},"step2":{"title":"Module 2: Using a single WAV file for multiple applications","description":"In this module, you’ll learn to use different parts of a WAV file for different purposes. You'll also learn how to fine-tune those parts.","ctaPrimary":"$t(common:buttons.launchModule)"},"step3":{"title":"Module 3: Creating sonic variety with few resources","description":"In video game development, audio is often given a relatively small budget with regard to memory and processor usage. In this module, you'll learn to work within these constraints by creating a lot of sonic variety with few resources.","ctaPrimary":"$t(common:buttons.launchModule)"},"step4":{"title":"Module 4: Using Switches","description":"This module introduces the use of Game Syncs, a category of game call that allows the game to communicate more detail about the particular conditions of the game. You’ll attach footstep sounds to the Wwizard’s movements, and you'll use Switches, a type of Game Sync, to change that sound anytime the surface under his feet changes.","ctaPrimary":"$t(common:buttons.launchModule)"},"step5":{"title":"Module 5: Using Game Parameters","description":"In the game Cube, the health meter of the Wwizard is visible in the lower-left corner of the screen. In this module, you'll create audible feedback related to the Wwizard's health. You'll do this using an important type of Game Sync called a Game Parameter.","ctaPrimary":"$t(common:buttons.launchModule)"},"step6":{"title":"Module 6: Using States","description":"In the game Cube, the Wwizard's heart beats louder and clearer as his health declines. In this module, you'll make sure the sound of his heartbeat stops when he's defeated (gulp!), using a type of Game Sync called a State.","ctaPrimary":"$t(common:buttons.launchModule)"},"step7":{"title":"Module 7: Profiling Game Syncs","description":"Keeping track of all the things that can impact a sound can sometimes be difficult. You might find yourself wondering why your design isn't working as intended. In this module, you'll learn some techniques to quickly uncover the cause of any such issues.","ctaPrimary":"$t(common:buttons.launchModule)"},"step8":{"title":"Module 8: Using 3D Spatialization","description":"In the game Cube, teleporters let the Wwizard magically move from one location to another. In this module, you'll use 3D Spatialization to make the droning teleporter sound gradually increase in volume and frequency as the player approaches the teleporter. You'll also make the teleporter sound muffled any time it rotates away from the player.","ctaPrimary":"$t(common:buttons.launchModule)"},"step9":{"title":"Module 9: Using 3D Position Automation","description":"In this module, you'll position a sound in the 3D world in a way that's randomized, creating the impression that each time a gem falls, it lands at a different point in front of the listener and bounces along its own unique path.","ctaPrimary":"$t(common:buttons.launchModule)"},"step10":{"title":"Module 10: Using Speaker Panning","description":"Speaker Panning is ideal for sounds that accompany objects that are always viewed in the same position relative to the player. It also works well for music or narration. In this module, you’ll use Speaker Panning to position woosh and magic sounds in the 3D world.","ctaPrimary":"$t(common:audiokineticLauncher.open)"},"step11":{"title":"Module 11: Organizing with Actor-Mixers","description":"A finished Wwise project often includes hundreds if not thousands of sounds. In this module, you'll learn how to manage such large numbers.","ctaPrimary":"$t(common:buttons.launchModule)"},"step12":{"title":"Module 12: Understanding the Master Audio Bus","description":"During gameplay, it’s not uncommon for fifty or more sounds to play simultaneously. In this module, you'll learn how Wwise mixes all of those sounds together, considering a computer or video game console might only have two output channels, left and right.","ctaPrimary":"$t(common:buttons.launchModule)"},"step13":{"title":"Module 13: Submixing with Additional Audio Busses","description":"In this module, you’ll learn to create dedicated busses for your environmental, music, and SFX sounds. This way, you can quickly apply changes to those sounds without affecting any other sounds.","ctaPrimary":"$t(common:buttons.launchModule)"},"step14":{"title":"Module 14: Working with Effects","description":"In this module, you'll add Effects to your toolbox, offering a world of possibilities, including reverbs, dynamic processors, equalization, and delays.","ctaPrimary":"$t(common:buttons.launchModule)"},"step15":{"title":"Module 15: Using Soundcaster","description":"In this module, you'll learn to use the Soundcaster view to arrange multiple instances of the Transport Control, each targeting a specific object so that you can play many different objects at the same time. You'll also learn how to adjust some of their properties without leaving the Soundcaster view.","ctaPrimary":"$t(common:buttons.launchModule)"},"step16":{"title":"Module 16: Configuring a Mixing Desk","description":"The Mixing Desk allows you to fine-tune the audio mix of your game by grouping a variety of properties in one view. In this module, you'll learn how to use the Mixing Desk alongside the Soundcaster view.","ctaPrimary":"$t(common:buttons.launchModule)"},"step17":{"title":"Module 17: Using Control Surfaces","description":"If you're only using a keyboard and mouse, you can only adjust one parameter in Wwise at a time. In this module, you'll learn to go beyond this limitation and dramatically enhance your productivity using an external MIDI-based control surface as an alternate input device.","ctaPrimary":"$t(common:buttons.launchModule)"},"step18":{"title":"Module 18: Working with Multiple SoundBanks","description":"In this module, you'll create a second SoundBank and then ensure all of your Events are added to one SoundBank or the other depending on when they are needed in the game.","ctaPrimary":"$t(common:buttons.launchModule)"},"step19":{"title":"Module 19: Managing SoundBank Size","description":"You could have the most amazing soundscape for a game, but it's worthless if it requires more memory than was allocated for the game's audio. In this module,  you’ll learn how you can scale a project in the later stages of development, reducing the size of your SoundBanks with minimal impact on your creative vision.","ctaPrimary":"$t(common:buttons.launchModule)"},"step20":{"title":"Module 20: Optimizing Your Sound Design","description":"In this module, you’ll learn how to determine how much processing power your design requires, particularly during the most active parts of the game when there will be spikes in demand. Then you'll learn how to add some constraints to your design, reducing those spikes in ways the player is unlikely to notice.","ctaPrimary":"$t(common:buttons.launchModule)"},"lastStep":{"title":"Certification exam","description":""}}},"what-you-ll-learn":{"title":"What You'll Learn","description":"Our modules cover all you need to get started with Wwise. Take advantage of our quizzes to validate your knowledge along the way:","how-you-ll-learn":{"check-one":{"title":"Practice audio integration workflows.","description":""},"check-two":{"title":"Create and mix virtual soundscapes.","description":""},"check-three":{"title":"Leverage sound triggering systems.","description":""},"check-four":{"title":"Discover system performance optimization techniques.","description":""}}},"requirements":{"title":"Requirements","description":"","requirements":{"pre-req":{"title":"No prior experience is required for this course"},"wwise-app":{"title":"Recommended Wwise version: <AK_LINK_LAUNCHER>Wwise 2024.1</AK_LINK_LAUNCHER>"},"cube":{"title":"Sample Game required: <AK_LINK_CUBE>Cube</AK_LINK_CUBE>"}}},"courseDetails":{"lessons":"{{AK_VARIABLE_NUMBER_OF}} lessons","modules":"{{AK_VARIABLE_NUMBER_OF}} modules","quizzes":"{{AK_VARIABLE_NUMBER_OF}} quizzes","videos":"{{AK_VARIABLE_NUMBER_OF}} videos","languages":"{{AK_VARIABLE_NUMBER_OF}} languages","pdf":"{{AK_VARIABLE_NUMBER_OF}} PDF","certification":"{{AK_VARIABLE_NUMBER_OF}} certificate"}},"wwise201":{"bannerTagline":"Interactive Music","bannerSubTagline":"","helmet":{"title":"Interactive Music Course","description":"The Wwise Interactive Music course helps you implement music into a game, create a dynamic score, among others"},"outline":"Course Includes","detailed-outline":{"loggedIn":"Course Outline","notLoggedIn":"Course Outline","content":{"step0":{"title":"Installing the Course Materials","description":"Get your system ready for this certification! Follow the guidelines to install Wwise, Cube, and the course materials.","ctaPrimary":"$t(common:audiokineticLauncher.open)"},"step1":{"title":"Module 1: Preparing music for implementation","description":"Learn to import WAV files provided by a composer and then configure their tempo, time signature, and entry and exit cues.","ctaPrimary":"$t(common:buttons.launchModule)"},"step2":{"title":"Module 2: Creating music playlists","description":"Learn to use Music Playlist Containers to arrange and assemble Music Segments using the sequential approach. To avoid a repetitive arrangement, you’ll learn how to randomize their order.","ctaPrimary":"$t(common:buttons.launchModule)"},"step3":{"title":"Module 3: Configuring complex playlists","description":"Learn to create complex playlists that include several Groups, ensuring the main theme is always heard first, followed by a highly randomized series of Music Segments, including the occasional bridge. All this variety will ensure the music never sounds repetitive.","ctaPrimary":"$t(common:buttons.launchModule)"},"step4":{"title":"Module 4: Preparing a multitrack loop","description":"In this module, you’re introduced to the layered approach. You’ll learn to work with Music Segments that contain multiple Music Tracks.","ctaPrimary":"$t(common:buttons.launchModule)"},"step5":{"title":"Module 5: Editing clips","description":"In the Music Segment Editor, you can see waveforms, referred to as clips, that visually reflect what you hear. Learn to move, copy, trim, and loop clips. These skills will give you a lot of creative possibilities!","ctaPrimary":"$t(common:buttons.launchModule)"},"step6":{"title":"Module 6: Configuring Sub-Tracks","description":"Learn to add Sub-Tracks to your Music Tracks, allowing multiple versions of a track to exist within one primary track. Then configure a Music Segment so that only one of the variations is heard at a time.","ctaPrimary":"$t(common:buttons.launchModule)"},"step7":{"title":"Module 7: Creating mixed method playlists","description":"Learn to combine the sequential and layered approaches taught in earlier modules to give your music even more variation.","ctaPrimary":"$t(common:buttons.launchModule)"},"step8":{"title":"Module 8: Connecting MIDI tracks to a synthesizer","description":"Learn to bring MIDI files to life using Synth One, a source plug-in synthesizer built into Wwise. Just like MIDI files, Synth One requires very little memory, so using the two in combination is a great way to produce a lot of sound with little impact on your memory budget.","ctaPrimary":"$t(common:buttons.launchModule)"},"step9":{"title":"Module 9: Working with MIDI synthesizers","description":"Learn several ways to fine-tune the Synth One plug-in to give a MIDI synthesizer exactly the sound you want.","ctaPrimary":"$t(common:buttons.launchModule)"},"step10":{"title":"Module 10: Creating MIDI samplers","description":"Learn to use MIDI sequences with audio files as their target. You'll also learn how to modify the pitch of the audio files based on the notes specified in the MIDI sequence, creating a sampler playback system.","ctaPrimary":"$t(common:buttons.launchModule)"},"step11":{"title":"Module 11: Reacting to gameplay using Stingers","description":"Learn to use Stingers to add a short musical accompaniment to actions in the game, and configure them to occur at a musically sensitive time, such as on the next bar or beat.","ctaPrimary":"$t(common:buttons.launchModule)"},"step12":{"title":"Module 12: Reacting to gameplay using States","description":"Learn to use a change in State to modify your music. For example, a particular part might only play when the player has a power-up, adding a bit of excitement to the music in that mode.","ctaPrimary":"$t(common:buttons.launchModule)"},"step13":{"title":"Module 13: Reacting to gameplay using Switch Sub-Tracks","description":"In this module, you’ll configure a Switch Sub-Track so that as the player’s health declines, the electric guitar parts become more intense.","ctaPrimary":"$t(common:buttons.launchModule)"},"step14":{"title":"Module 14: Configuring Music Switch Containers","description":"In this module, you'll start the task of ensuring the appropriate Music Playlist Container plays during each mode of gameplay. You'll do this by putting all six Music Playlist Containers in a Music Switch Container. You'll also learn to configure the transitions between pieces of music so they're musically sensitive.","ctaPrimary":"$t(common:buttons.launchModule)"},"step15":{"title":"Module 15: Creating State Groups for music","description":"In this module, you’ll learn to use Events to set States, so the States can be used to determine which music plays.","ctaPrimary":"$t(common:buttons.launchModule)"},"step16":{"title":"Module 16: Smoothing transition decisions","description":"To avoid frequent back-and-forth changes in music, you'll learn to use a feature of Game Parameters called Slew Rate.","ctaPrimary":"$t(common:buttons.launchModule)"},"step17":{"title":"Module 17: Advanced transitions","description":"Learn to create transitions that crossfade between two pieces of music while maintaining the same position in the form and chord progression. This gives the impression of a single piece of music that simply changes in intensity with the action.","ctaPrimary":"$t(common:buttons.launchModule)"},"step18":{"title":"Module 18: Using transition segments","description":"Learn how to play a short piece of music while transitioning between two other pieces of music. You'll also learn how to prioritize Transition rules.","ctaPrimary":"$t(common:buttons.launchModule)"},"step19":{"title":"Module 19: Mixing music","description":"Learn to create a bus structure you can use to control the relational volumes of various musical themes. You'll also learn how to create a Mixing Session you can use to observe signal flow and adjust various properties of busses, such as Voice Volume.","ctaPrimary":"$t(common:buttons.launchModule)"},"step20":{"title":"Module 20: Volume and metering","description":"Learn to use the various audio meters in Wwise to assess volume, including measuring integrated loudness and loudness range over time. You'll also learn how to ensure the volume doesn't exceed target levels.","ctaPrimary":"$t(common:buttons.launchModule)"},"step21":{"title":"Module 21: Adding reverberation","description":"Learn to add reverb to your music in a way that responds dynamically to gameplay. You’ll also learn to add reverb to MIDI tracks, since you can't add it in a DAW.","ctaPrimary":"$t(common:buttons.launchModule)"},"step22":{"title":"Module 22: Sidechaining Stingers","description":"Learn how to use the signal from one bus to modify the properties of another bus, such as volume. In this module, you’ll use sidechaining to lower the volume of your music each time a Stinger plays.","ctaPrimary":"$t(common:buttons.launchModule)"},"lastStep":{"title":"Certification exam","description":""}}},"what-you-ll-learn":{"title":"What You'll Learn","description":"Our modules cover the essentials of interactive music in Wwise. Take advantage of our quizzes to validate your knowledge along the way:","how-you-ll-learn":{"check-one":{"title":"Explore how music created in a DAW can be implemented in a game.","description":""},"check-two":{"title":"Learn to create a dynamic score that responds to gameplay.","description":""},"check-three":{"title":"Implement custom music while acquiring fundamental concepts.","description":""},"check-four":{"title":"Create, test and play the result of what you’ve learned.","description":""}}},"requirements":{"title":"Requirements","description":"","requirements":{"pre-req":{"title":"Prerequisites for this course: <AK_LINK_WWISE_101>Wwise Fundamentals</AK_LINK_WWISE_101>"},"wwise-app":{"title":"Recommended Wwise version: <AK_LINK_LAUNCHER>Wwise 2025.1</AK_LINK_LAUNCHER>"},"cube":{"title":"Sample Game required: <AK_LINK_CUBE>Cube</AK_LINK_CUBE>"}}},"courseDetails":{"lessons":"{{AK_VARIABLE_NUMBER_OF}} lessons","modules":"{{AK_VARIABLE_NUMBER_OF}} modules","quizzes":"{{AK_VARIABLE_NUMBER_OF}} quizzes","languages":"{{AK_VARIABLE_NUMBER_OF}} languages","videos":"{{AK_VARIABLE_NUMBER_OF}} videos","pdf":"{{AK_VARIABLE_NUMBER_OF}} PDF","certification":"{{AK_VARIABLE_NUMBER_OF}} certificate"}},"wwise251":{"bannerTagline":"Performance Optimization","bannerSubTagline":"","helmet":{"title":"Performance Optimization Course","description":"Our Wwise performance optimization course helps you optimize your Wwise project across platforms by prioritizing audio content and balancing your CPU budget based on hardware specifications."},"outline":"Course Includes","detailed-outline":{"loggedIn":"Lesson Plan","notLoggedIn":"Course Outline","content":{"step0":{"title":"Installation of Wwise","description":"Get your system ready for this certification! Follow the guidelines to install Wwise, and any other tools, assets and files you’ll be using throughout this course.","ctaPrimary":"$t(common:audiokineticLauncher.open)"},"step1":{"title":"Lesson 1: Understanding Resource Usage","description":"Understand the first step in optimizations: what resources you have and how the sound engine is using them. You’ll learn how to load from memory, load by streaming and how to use the Profiler.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step2":{"title":"Lesson 2: Conversion and Compression","description":"Deep dive into Conversion Setting ShareSets. You’ll learn how to configure sample rate, audio channels, and learn how to choose the most optimal audio format for your audio sources.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step3":{"title":"Lesson 3: Voice Management","description":"Stay in control of your physical and virtual voices. Use priorities, virtual voice behaviors and voice limits, to reduce resource usage, and learn how to create Level-of-Detail systems with Wwise.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step4":{"title":"Lesson 4: Effects","description":"Optimize your Effects by rendering and adjusting effect controls, and determine the most optimal processing pipeline. Learn how to use the Wwise Integrity Report to scan your project for more optimizations.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step5":{"title":"Lesson 5: Platform Management","description":"Scale soundscape diversity with platform resources. Learn to manage platforms, exclude audio objects / audio source, set individual property values per platform, and optimize music systems.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step6":{"title":"Lesson 6: SoundBank Granularity","description":"Separate your audio content and load progressively. Learn to minimize your SoundBank memory usage by only loading what’s necessary and integrate a SoundBank into a Unity scene.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step7":{"title":"Lesson 7: Runtime Management","description":"As a final touch, estimate and assign memory pools. Learn what parts of your sound design affects what memory pool, and understand voice and source starvation.","ctaPrimary":"$t(common:buttons.launchLesson)"},"lastStep":{"title":"Certification exam","description":""}}},"what-you-ll-learn":{"title":"What You'll Learn","description":"Our 8 lessons cover a series of performance optimization techniques using Wwise. Take advantage of our quizzes to validate your knowledge along the way:","how-you-ll-learn":{"check-one":{"title":"Understand resource usage optimization and per platform customization.","description":""},"check-two":{"title":"Master voice management including audio content prioritization, and learn about conversion and compression settings best practices.","description":""},"check-three":{"title":"Understand where Effects are applied in the voice pipeline and how they can be optimized.","description":""},"check-four":{"title":"Learn about SoundBank granularity and system memory usage.","description":""}}},"requirements":{"title":"Requirements","description":"","requirements":{"pre-req":{"title":"Prerequisites for this course: <AK_LINK_WWISE_101>Wwise Fundamentals</AK_LINK_WWISE_101>"},"wwise-app":{"title":"Recommended Wwise version: <AK_LINK_LAUNCHER>Wwise 2023.1.11</AK_LINK_LAUNCHER>","description":"While critical content has been updated to reflect major advancements, a few images may still refer to the 2019.1 version. Rest assured: this won’t impact your understanding of Wwise features and usability."},"wag":{"title":"Sample Game required: <AK_LINK_WAG>Wwise Adventure Game</AK_LINK_LAUNCHER>"},"convolution-reverb":{"title":"Required plug-in: <AK_LINK_CONVOLUTION>AK Convolution Reverb</AK_LINK_CONVOLUTION>"},"soundseed-grain":{"title":"Required plug-in: <AK_LINK_SOUNDSEED_GRAIN>Soundseed Grain</AK_LINK_SOUNDSEED_GRAIN>"},"soundseed-air":{"title":"Required plug-in: <AK_LINK_SOUNDSEED_AIR>Soundseed Air</AK_LINK_SOUNDSEED_AIR>"}}},"courseDetails":{"lessons":"{{AK_VARIABLE_NUMBER_OF}} lessons","quizzes":"{{AK_VARIABLE_NUMBER_OF}} quizzes","videos":"{{AK_VARIABLE_NUMBER_OF}} videos","languages":"{{AK_VARIABLE_NUMBER_OF}} languages","pdf":"{{AK_VARIABLE_NUMBER_OF}} PDF","certification":"{{AK_VARIABLE_NUMBER_OF}} certificate"}},"wwise301":{"bannerTagline":"Wwise Unity Integration","bannerSubTagline":"","helmet":{"title":"Wwise Unity Integration Course","description":"The Wwise Unity Integration course: learn how to load SoundBanks and post Events in Unity. Customize in-game mechanics to trigger and modify your audio"},"outline":"Course Includes","detailed-outline":{"loggedIn":"Lesson Plan","notLoggedIn":"Course Outline","content":{"step0":{"title":"Installation of Wwise","description":"Get your system ready for this certification! Follow the guidelines to install Wwise, and any other tools, assets and files you’ll be using throughout this course.","ctaPrimary":"$t(common:audiokineticLauncher.open)"},"step1":{"title":"Lesson 1: Adding Sound","description":"Take a deep-dive into integrating audio. Learn to load a SoundBank, post an Event and how to only allow specific objects to trigger them.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step2":{"title":"Lesson 2: Ambiences","description":"Learn to use special positioning modes, attenuation spheres for displaying attenuation distances in Unity and the power of custom scripts.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step3":{"title":"Lesson 3: SoundBank Management","description":"Learn to load Soundbanks during gameplay from either Triggers or Scenes. Configure SoundBanks to decompress in runtime and save on disk.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step4":{"title":"Lesson 4: Posting Events from Script","description":"Take your first steps into writing scripts, an essential part of Unity. Learn to attach sounds to in-game mechanisms and how to call mechanisms using the microphone input.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step5":{"title":"Lesson 5: Controlling Game Syncs from Script","description":"Manage how your soundscape behaves using Game Syncs. Explore how set Game Syncs from both components and scripts and learn the difference of Global and Game Object scope.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step6":{"title":"Lesson 6: Using Effects on Regions","description":"Use Unity Triggers to define the effects applied in an area. Learn how Unity calculates physics like collisions and how it is used to manage effects on your sounds.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step7":{"title":"Lesson 7: Callbacks","description":"Learn to communicate from Wwise to Unity using callbacks. Make the world of the Wwise Adventure Game move to the tempo of the music.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step8":{"title":"Lesson 8: Advanced Music System","description":"Combine your knowledge from previous lessons into integrating an advanced two-piece multi-layered music system and control detailed variations using Game Syncs.","ctaPrimary":"$t(common:buttons.launchLesson)"},"step9":{"title":"Lesson 9: Making Your Own Adventure Game","description":"Create your own Unity project, integrate the Wwise Unity Integration and learn to use change listener position and where to set memory pools.","ctaPrimary":"$t(common:buttons.launchLesson)"},"lastStep":{"title":"Certification exam","description":""}}},"what-you-ll-learn":{"title":"What You'll Learn","description":"Our 9 lessons cover everything you need to know about the Wwise Unity Integration.\\nTake advantage of our quizzes to validate your knowledge along the way:","how-you-ll-learn":{"check-one":{"title":"Learn how to load SoundBanks and post Events in Unity.","description":""},"check-two":{"title":"Learn how to create or customize in-game mechanics to trigger and modify your audio.","description":""},"check-three":{"title":"Define reverb areas and set music Callbacks.","description":""},"check-four":{"title":"Learn how to integrate and customize the Wwise Unity Integration for any technical and artistic requirements.","description":""}}},"requirements":{"title":"Requirements","description":"","requirements":{"pre-req":{"title":"Prerequisites for this course: <AK_LINK_WWISE_101>Wwise Fundamentals</AK_LINK_WWISE_101>"},"wwise-app":{"title":"Recommended Wwise version: <AK_LINK_LAUNCHER>Wwise 2023.1.11</AK_LINK_LAUNCHER>","description":"While critical content has been updated to reflect major advancements, a few images may still refer to the 2019.1 version. Rest assured: this won’t impact your understanding of Wwise features and usability."},"wag":{"title":"Sample Game required: <AK_LINK_WAG>Wwise Adventure Game</AK_LINK_LAUNCHER>"},"convolution-reverb":{"title":"Required plug-in: <AK_LINK_CONVOLUTION>AK Convolution Reverb</AK_LINK_CONVOLUTION>"},"soundseed-grain":{"title":"Required plug-in: <AK_LINK_SOUNDSEED_GRAIN>Soundseed Grain</AK_LINK_SOUNDSEED_GRAIN>"},"soundseed-air":{"title":"Required plug-in: <AK_LINK_SOUNDSEED_AIR>Soundseed Air</AK_LINK_SOUNDSEED_AIR>"}}},"courseDetails":{"lessons":"{{AK_VARIABLE_NUMBER_OF}} lessons","quizzes":"{{AK_VARIABLE_NUMBER_OF}} quizzes","videos":"{{AK_VARIABLE_NUMBER_OF}} videos","languages":"{{AK_VARIABLE_NUMBER_OF}} languages","pdf":"{{AK_VARIABLE_NUMBER_OF}} PDF","certification":"{{AK_VARIABLE_NUMBER_OF}} certificate"}}}`),"teach-wwise":{title:"Teach Wwise",bannerV2Title:"Teach Wwise",bannerV2Description:"Prepare your students for a future in interactive audio using learning material grounded in today’s market reality.",bannerCallToAction:{primaryLabel:"$t(common:buttons.create-school-account)"},imageAriaLabel:"Teach Wwise",helmet:{title:"Teach Wwise",description:"Teach Wwise: Prepare your students for a future in interactive audio using learning material grounded in today’s market reality."},"information-cards":{academicPrograms:{title:"Academic Programs",freeLearningCourses:{title:"Learning material",imageAriaLabel:"Wwise Learning Material",description:"Take advantage of our free course material and learning resources including samples, tutorial videos and more, to enrich your curriculum and provide an engaging class experience.",MAIN:{primary:"$t(common:buttons.access-learning-material)"}},freeLicencesAndPlugins:{title:"Academic licensing ",imageAriaLabel:"Get your Wwise Academic License",description:"Create a school account to get access to our free Wwise and <AK_NO_WRAP>plug-ins</AK_NO_WRAP> licensing for your classes and research projects.",MAIN:{primary:"$t(common:buttons.create-school-account)"}},becomeCertifiedInstructor:{title:"Become a Certified Instructor",imageAriaLabel:"Become a Certified Instructor",description:"Take your teaching career to the next level with our 3-tier certification program. Enhance your expertise, grow professionally, and unlock opportunities to earn by collaborating with us.",MAIN:{primary:"$t(common:buttons.learn-more)"}},trainingForEducators:{title:"Educator training",imageAriaLabel:"Get Additional Training",description:"Take advantage of our specialized training for educators, designed to help you develop instructional techniques and strategies for teaching Wwise. As a Wwise Certified Instructor, you’ll join a community of educators at the forefront of interactive audio and industry advancements.",MAIN:{primary:"$t(common:buttons.explore-training)"}},certificationBundles:{title:"Certification discount",imageAriaLabel:"Request Certification Bundles Pricing",description:"Receive special discounts on certification exams for you and your students.",MAIN:{primary:"$t(common:buttons.request-discount)"}},wwise110:{title:"Wwise Fundamentals Practicum",imageAriaLabel:"Blank Badge for Wwise Fundamentals Practicum",description:"As a Wwise Certified Instructor, you can ensure that your students are ready for the job market by administering the Wwise Fundamentals Practicum certification practical assessment, an add-on to the Wwise Fundamentals certification online exam.",MAIN:{primary:"$t(common:buttons.learn-more)"}},educatorSpace:{title:"Educator Space",imageAriaLabel:"Educator space",description:"Get training documents curated by our Education Team.",MAIN:{primary:"Sign in for Educator Space access"}},educatorSpace_NOT_LOGGED_IN:{title:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.title)",imageAriaLabel:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.imageAriaLabel)",description:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.description)",MAIN:{primary:"Sign in for Educator Space access"}},educatorSpace_NOT_AN_EDUCATOR:{title:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.title)",imageAriaLabel:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.imageAriaLabel)",description:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.description)",MAIN:{primary:"Join Educator Space"}},educatorSpace_IS_EDUCATOR:{title:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.title)",imageAriaLabel:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.imageAriaLabel)",description:"$t(learning:teach-wwise.information-cards.academicPrograms.educatorSpace.description)",MAIN:{primary:"Go to Educator Space"}}}},"academic-programs":{title:"Getting access to Academic licensing ","get-started":{cardOne:{title:"3 easy steps",description:"",ctaPrimary:"$t(common:buttons.get-started)"},cardTwo:{stepOne:{title:"Create a school account",description:"If you are new to Audiokinetic you need to create a user account. Click the Get started button and submit your school account form. You’ll receive an email to confirm your school’s approval."},stepTwo:{title:"Register your course information",description:"Upon confirmation of your school’s approval, sign in to your Audiokinetic user account and click on your profile icon on the top right of your screen. Select ‘My school’. Register your course  and submit your information. Within the next few days, a license key will be issued for your course."},stepThree:{title:"Access your course license key",description:"On your school page, click on your course’s name. Go to the Licenses tab to retrieve your license key information. License keys are valid for 1 year, renewable, and can be used on workstations or student laptops."}}}},"academic-partnership":{title:"Academic Partners","view-partners":"View all Partners"},"teach-wwise-faq":{title:"FAQ",faqs:{faq_1:{title:"How can I access academic licensing?",description:`Audiokinetic provides free academic licensing to accredited institutions that operate exclusively for academic, educational and/or research purposes. To access academic licensing, a member of the institution must create a school account and sign the academic agreement. 
Students from non-registered institutions can also request access to academic license keys via <AK_TEXT_TARGET_ONE>Audiokinetic School</AK_TEXT_TARGET_ONE>.`,ctaPrimary:""},faq_2:{title:"Who can create a school account?",description:"School administrators, educators, or IT managers are eligible to create a school account as long as they are legally authorized to sign the academic agreement. If they are not, they will be able to forward the form to a school administrator with authority to sign it. By signing the academic agreement, your school will become a Partner School.",ctaPrimary:""},faq_3:{title:"What are the benefits of becoming a Partner School?",description:"As a Partner, you have access to academic licensing, and your school is listed on our <AK_TEXT_TARGET_ONE>Creators Directory</AK_TEXT_TARGET_ONE> as an institution learners can trust. Our Partner schools benefit from accessing our free course material and learning resources for their curriculums, and are committed to offering high-quality Wwise training courses.",ctaPrimary:""},faq_4:{title:"How much does it cost to be a Partner School?",description:"There are no fees associated with becoming an Audiokinetic Partner School.",ctaPrimary:""},faq_5:{title:"Does Audiokinetic provide technical support for Partner Schools?",description:"We don’t provide direct technical support to schools, however if you need help to install our software or setting up workstations our <AK_TEXT_TARGET_ONE>Community Q&A</AK_TEXT_TARGET_ONE> and <AK_TEXT_TARGET_TWO>documentation</AK_TEXT_TARGET_TWO> sections are a good place to start.",ctaPrimary:""},faq_6:{title:"How long is a license key valid for?",description:"A license key expires a month after your course end date but can be renewed for a period of 1 year. A month prior to the expiration date, school account administrators will receive a notification to allow them to request an extension if they need one.",ctaPrimary:""},faq_7:{title:"I am not affiliated with a school, how can I teach Wwise?",description:"As a first step,  we strongly recommend our <AK_TEXT_TARGET_ONE>Wwise Instructor Program</AK_TEXT_TARGET_ONE>. When Institutions are looking for qualified instructors, we put them in contact with our network of certified instructors.  As an independent educator, you and your students can request access to academic license keys via <AK_TEXT_TARGET_TWO>Audiokinetic School</AK_TEXT_TARGET_TWO>.",ctaPrimary:""}}}},"educator-space":{title:"Educator Space","predefined-sections":{TeachingResources:{title:"Teaching Resources",description:"Discover a curated collection of ready-to-use materials designed to help you seamlessly integrate Wwise into your classroom."},SchoolAccountManagement:{title:"School Account Management",description:"A one-stop destination for managing your school account, troubleshooting, and keeping your software up to date."},UNCLASSIFIED:{title:"Miscellaneous"}},"student-certification":{title:"Certify your students!",description:"Enter the list of emails (one per line) and select the according certification.","ui-labels":{submit:"Submit email list",submitting:"Processing…",success:"Success",failed:"Failed",certification:"Certification","certification-select":"Select the certification","certification-failed":"User cannot be certified.",emails:"Student's email addresses","emails-instructions":"Enter one email address per line.","emails-errors":{no_cert:"Select the Certification we should assign to these emails",empty:"Enter at least one email address.",invalids:"Correct the invalid email addresses before submitting."},"emails-example":`alex.martin@example.com
charlie.taylor@example.com`}}},"create-school-account":{title:"Create School Account",bannerTagline:"Create School Account",helmet:{title:"Create your school Account",description:"Create a school account to get access to our free Wwise and plug-ins licensing for your classes and research projects."},"thank-you":{title:"Thank you",descriptionVerified:"We’ve received your request to create a school account. We’ll notify you within the next 5 business days to confirm your school approval.",descriptionUnverified:"To enable us to proceed further with your request to create a school account, you must verify your account. Once done, we’ll notify you within the next 5 business days to confirm your school approval."},"please-login":{title:"<AK_LINK_SIGNIN>Sign in</AK_LINK_SIGNIN> or <AK_LINK_SIGNUP>Create An Account</AK_LINK_SIGNUP>",description:"An Audiokinetic account is required to create a School Account. You can sign in with an existing account or create a new one."},"back-to-teach-wwise":{"button-label":"Back To Academic Program"},authorisation:{title:"Are you legally authorized to register this school?",description:"School administrators, educators, or IT managers are eligible to create a school account as long as they are legally authorized to sign the academic agreement.","checkbox-label":"Yes, I am legally authorized to register this school?","checkbox-description":"If you are not the authorized to register a school, share this page with the right person."},"academic-license-agreement":{title:"Academic License Agreement",description:"","checkbox-label":"I acknowledge that I have read and agree to the terms of the <AK_LINK>Academic License Agreement</AK_LINK>.","checkbox-description":"Please note that should you have any hesitation in regards to signing this agreement due to questions, concerns, or special requests, please <AK_LINK>contact us</AK_LINK>."},"account-admin-and-comm":{title:"Account administration and communications",description:"","checkbox-label":"I understand that I will be the first point of contact for the school and will be assigned as the account administrator."},"school-administrator":{"logged-in":{verified:{title:"Your Information"},unverified:{title:"Unknown User",description:"Please note, you will need to verify your account before we proceed with your request"}}},unauthorized:{title:"Unauthorized to create school",description:"If you are unauthorized to create and manage your school, please ask the authorized person to do this step or give you authority to do so."},formLabels:{"personalInfo-email":{label:"Email",placeHolder:""},"personalInfo-password":{label:"Password",placeHolder:""},"personalInfo-userId":{label:"UserId",placeHolder:""},"school-name":{label:"School Name",placeHolder:""},"school-type":{label:"School Type",placeHolder:""},"school-logo":{label:"School Logo",placeHolder:""},"school-website":{label:"Website",placeHolder:""},"school-address-streetAddress":{label:"Street Address",placeHolder:""},"school-address-streetAddressLine2":{label:"Street Address (line 2, optional)",placeHolder:""},"school-address-city":{label:"City",placeHolder:""},countryCode:{label:"Country",placeHolder:""},regionCode:{label:"Province/Region/State",placeHolder:""},zip:{label:"Postal/Zip Code",placeHolder:""},countryRegionPostalCodes:{label:"Country/Region/Postal Code",placeHolder:""},"school-address-countryRegionPostalCodes":{label:"Country/Region/Postal Code",placeHolder:""},"school-phone":{label:"Phone",placeHolder:""},"school-faculty-name":{label:"Name",placeHolder:""},"school-faculty-email":{label:"Email",placeHolder:""},"school-faculty-website":{label:"Website",placeHolder:""},"school-faculty-phone":{label:"Phone",placeHolder:""}},formSections:{personalInfo:{title:"Your Information"},schoolInfo:{title:"School Information"},facultyInfo:{title:"Department/Faculty Information"},licensingInterest:{title:"Licensing Interests",formLabels:{strata:{label:"I’m interested in Strata Academic License",moreInfo:"More info on Strata Academic License"},wwise:{label:"I’m interested in Wwise Academic License",moreInfo:"More info on Wwise Academic License"}}},agreement:{title:"Academic License Agreement",formLabels:{agreeWithAcademicLicenseAgreement:{label:"I acknowledge that I have read and agree to the terms of the <AK_LINK_ACADEMIC_LICENSE_AGREEMENT>Academic License Agreement</AK_LINK_ACADEMIC_LICENSE_AGREEMENT>."}},footnote:"Please note that should you have any hesitation in regards to signing this agreement due to questions, concerns, or special requests, please <AK_LINK_CONTACT_US>contact us</AK_LINK_CONTACT_US>."}},validation:{"personalInfo-email":{required:"Email is required."},"personalInfo-password":{required:"Password is required.",minLength:"Password must have at least 8 characters",uppercase:"Requires one uppercase character",lowercase:"Requires one lowercase character",numbercheck:"Requires one number character"},"personalInfo-userId":{required:"UserId is required."},"school-name":{required:"School name is required."},"school-type":{required:"School type is required."},"school-logo":{required:"School logo is required."},"school-website":{required:"Website's URL is required."},"school-address-streetAddress":{required:"Street address is required."},"school-address-city":{required:"City is required."},"school-address-zip":{required:"Postal/Zip code is required.",invalid:"Postal/Zip code is invalid."},"school-address-countryCode":{required:"Country is required."},"school-address-countryRegionPostalCodes":{required:"Country is required.",countryRequired:"Country is required.",regionRequired:"Region is required.",postalCodeRequired:"Postal Code is required."},"school-address-regionCode":{required:"Province/State/Region is required."},"school-phone":{required:"Phone is required."},"school-faculty-name":{required:"Faculty name is required."},"school-faculty-email":{required:"Faculty email is required.",invalid:"Please provide a valid email address."},"school-faculty-website":{required:"Faculty website's URL is required."},"school-faculty-phone":{required:"Faculty phone is required."}}},training:SX,"wwise-instructor-program":JSON.parse(`{"title":"Wwise Instructor Program","bannerV2Title":"Shape the Future of Interactive Audio","bannerV2SubTitle":"Join a global community of certified Wwise educators ","imageAriaLabel":"Wwise Instructor Program","contactForm":{"formLabels":{"interest":{"label":"Instructor Program","placeHolder":"Select the Instructor Program you’re interested in"},"loggedInUser":{"label":""},"name":{"label":"Name"},"firstName":{"label":"First name","placeHolder":"Enter your first name"},"lastName":{"label":"Last name","placeHolder":"Enter your last name"},"email":{"label":"Email address","placeHolder":"Enter your email address"},"user_email_copy":{"label":"Send me a copy by email"},"company":{"label":"Company name","placeHolder":"Enter your company name"},"title":{"label":"Job title","placeHolder":"Select your job title"},"titleOther":{"label":"Other","placeHolder":"Enter your job title"},"country":{"label":"Country","placeHolder":"Select your country"},"comment":{"label":"Comment","placeHolder":""},"termsAgreement":"By filling this form, you acknowledge that you have read and agree to the site's <AK_TERMS>Terms of Use</AK_TERMS> and <AK_PRIVACY>Privacy Policy</AK_PRIVACY>.","termsAgreementOld":"By filling this form, you acknowledge that you have read and agree to the site's <a href='{{termsUrl}}' target='_blank'>Terms of Use</a> and <a href='{{privacyUrl}}' target='_blank'>Privacy Policy</a>.","acceptTermsAgreement":"Please accept Terms of Use & Privacy Policy"}},"content":{"masteryPaths":{"title":"Start your journey to becoming a certified Wwise educator","subTitle":"","description":"","journeyForm":{"title":"Continue your journey","formTriggerCtaLabel":"Purchase training","formSubmitLabel":"Submit"},"certificationSubjects":{"interactiveMusic":"Interactive Music","performanceOptimization":"Performance Optimization","spatialAudio":"Spatial Audio Acoustics","unrealIntegration":"Unreal Integration","unityIntegration":"Unity Integration"},"cardLabels":{"role":"Your role","eligibility":"Eligibility"},"tiersDetails":{"role":"Your role","price":"Price","eligibility":"Eligibility","whatYouGain":"What you'll gain","whatYouUse":"How the training works","howYouDoIt":"How you'll do it"},"tiers":{"tier1":{"name":"Tier 1","title":"Wwise Certified Instructor","role":"Master and deliver the <a href=\\"/learning/certifications/wwise-fundamentals\\">Wwise Fundamentals</a> curriculum within professional training centers or global educational institutions. Become a recognized expert shaping the next generation of game audio talent.","eligibility":{"certifiedInstructor":"Be certified in <a href=\\"/learning/certifications/wwise-fundamentals\\">Wwise Fundamentals</a> and <a href=\\"/learning/certifications/wwise-301-certification\\">Wwise Unity Integration</a>."},"price":"2250","cta":"Purchase training","whatYouGain":"<AK_SLIM_BULLET>Ability to administer the <a href=\\"/learning/certifications/wwise-fundamentals-plus\\">Wwise Fundamentals Practicum certification</a> </AK_SLIM_BULLET><AK_SLIM_BULLET>Access to official teaching and assessment tools, and media assets</AK_SLIM_BULLET><AK_SLIM_BULLET>A structured course framework aligned with global standards</AK_SLIM_BULLET><AK_SLIM_BULLET>Training to confidently deliver and assess student work</AK_SLIM_BULLET>","whatYouUse":"Your certification training includes:\\n\\n<AK_SLIM_BULLET><AK_BOLD>2.5 hours of self-paced eLearning</AK_BOLD></AK_SLIM_BULLET><AK_SLIM_BULLET><AK_BOLD>2 live sessions (5 hours each)</AK_BOLD></AK_SLIM_BULLET>\\nA focused format designed to build both your technical expertise and instructional skills.","howYouDoIt":"<AK_SLIM_BULLET><AK_BOLD>Practicum Certification Pack</AK_BOLD>: grading rubrics, evaluation forms, and project guidelines</AK_SLIM_BULLET><AK_SLIM_BULLET><AK_BOLD>Pedagogical Blueprint</AK_BOLD>: ready-to-use course structure and teaching strategies</AK_SLIM_BULLET><AK_SLIM_BULLET><AK_BOLD>Instructional Simulations</AK_BOLD>: practice delivery, pacing, and student interaction</AK_SLIM_BULLET>"},"tier2":{"name":"Tier 2","title":"Wwise Specialized Instructor","role":"Master and deliver advanced Wwise training in your specialization. Position yourself as the technical lead within professional training centers or global educational institutions, capable of teaching the industry's most complex workflows.","eligibility":{"interactiveMusic":"<AK_SLIM_BULLET>Be an active Wwise Certified Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Be certified in <a href=\\"/learning/certifications/interactive-music\\">Wwise Interactive Music</a></AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <a href=\\"/community/events?evt_cat=workshop\\">Interactive Music with Wwise Workshop</a></AK_SLIM_BULLET>","performanceOptimization":"<AK_SLIM_BULLET>Be an active Wwise Certified Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Be certified in <b>Wwise Performance Optimization</b></AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <b>CPU, Memory & Quality Workshop</b></AK_SLIM_BULLET>","spatialAudio":"<AK_SLIM_BULLET>Be an active Wwise Certified Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <b>Wwise Spatial Audio Acoustics in Unity or Unreal Workshop</b></AK_SLIM_BULLET>","unrealIntegration":"<AK_SLIM_BULLET>Be an active Wwise Certified Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <a href=\\"/community/events?evt_cat=workshop\\">Integrating Wwise in Unreal Workshop</a></AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <b>Integrating Wwise in Unreal</b> technical assessment</AK_SLIM_BULLET>","unityIntegration":"<AK_SLIM_BULLET>Be an active Wwise Certified Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Be certified in <a href=\\"/learning/certifications/wwise-301-certification\\">Wwise Unity Integration</a></AK_SLIM_BULLET><AK_SLIM_BULLET>Complete the <a href=\\"/community/events?evt_cat=workshop\\">Integrating Wwise in Unity</a> technical assessment</AK_SLIM_BULLET>"},"price":"Coming soon","cta":"Register your interest","whatYouGain":"<AK_SLIM_BULLET>Ability to administer advanced Wwise Practicum Certifications in your specialty</AK_SLIM_BULLET><AK_SLIM_BULLET>Access to official teaching, assessment tools, and media assets</AK_SLIM_BULLET><AK_SLIM_BULLET>Advanced course frameworks aligned with global standards</AK_SLIM_BULLET><AK_SLIM_BULLET>Training to confidently deliver complex workflows and assess student performance</AK_SLIM_BULLET>","whatYouUse":"Your certification training includes:\\n\\n<AK_SLIM_BULLET>Self-paced eLearning</AK_SLIM_BULLET><AK_SLIM_BULLET>One live session</AK_SLIM_BULLET>","howYouDoIt":"<AK_SLIM_BULLET><AK_BOLD>Advanced Certification Packs</AK_BOLD>: grading rubrics, evaluation forms, and project guidelines for each specialty</AK_SLIM_BULLET><AK_SLIM_BULLET><AK_BOLD>Pedagogical Blueprint</AK_BOLD>: advanced course structures and teaching strategies</AK_SLIM_BULLET><AK_SLIM_BULLET><AK_BOLD>Instructional Simulations</AK_BOLD>: practice delivery, pacing, and student interaction in complex scenarios</AK_SLIM_BULLET>"},"tier3":{"name":"Tier 3","title":"Wwise Affiliate Instructor","role":"Lead strategic initiatives to expand the Wwise ecosystem in high-priority growth areas.\\nConduct official Train-the-Trainer sessions, specialized workshops, and technical webinars. Act as the voice of Audiokinetic by delivering expert presentations at major industry events. Serve as the primary link between regional audio communities and the Audiokinetic education team.","eligibility":{"affiliateInstructor":"<AK_SLIM_BULLET>Be an active Wwise Specialized Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Provide a track record of delivering high-impact Wwise instruction in academic or professional settings</AK_SLIM_BULLET><AK_SLIM_BULLET>Demonstrate active involvement in the game audio community</AK_SLIM_BULLET>"},"price":"Upon call for application","cta":"Register your interest","whatYouGain":"<AK_SLIM_BULLET>Active Wwise Specialized Instructor</AK_SLIM_BULLET><AK_SLIM_BULLET>Proven track record of delivering high-impact Wwise training</AK_SLIM_BULLET><AK_SLIM_BULLET>Active involvement in the game audio community</AK_SLIM_BULLET>","whatYouUse":"<AK_SLIM_BULLET>Access to an exclusive global network of Affiliate Instructors</AK_SLIM_BULLET><AK_SLIM_BULLET>Ongoing mentorship and technical sessions with Audiokinetic teams</AK_SLIM_BULLET><AK_SLIM_BULLET>Recognition on official Audiokinetic platforms as a regional leader</AK_SLIM_BULLET><AK_SLIM_BULLET>Revenue opportunities through training delivery (up to 30% commission)</AK_SLIM_BULLET>","howYouDoIt":"<AK_SLIM_BULLET>Affiliate Instructor resource Pack: workshop materials, slide decks, and Train-the-Trainer playbook</AK_SLIM_BULLET><AK_SLIM_BULLET>Professional tools & licensing: Wwise licenses, plug-ins, and communication tools</AK_SLIM_BULLET><AK_SLIM_BULLET>Branding & merchandising: official materials for professional representation</AK_SLIM_BULLET>"}}},"stepsToMastery":{"title":"Steps you need to take","subTitle":"Your path to becoming a Wwise Instructor begins here.","description":"Submit your interest, stay informed about upcoming workshops, and follow our streamlined approval process to start teaching with official Wwise materials.","tiersDescription":"Each instructor track has its own process. Select a track below to see how it works.","tiers":{"tier1":{"title":"$t(learning:wwise-instructor-program.content.masteryPaths.tiers.tier1.title)","subjects":{"certifiedInstructor":""},"steps":{"step1":{"title":"Get the pre-requisites","description":"Complete the <a href=\\"/learning/certifications/wwise-fundamentals\\">Wwise Fundamentals</a> and <a href=\\"/learning/certifications/wwise-301-certification\\">Wwise Unity Integration certifications</a> to qualify for the program."},"step2":{"title":"Register and Prepare","description":"Purchase the Wwise instructor training to access the self-paced eLearning modules and prepare for the live sessions."},"step3":{"title":"Complete Live Training","description":"Participate in two live instructor-led sessions where you apply teaching strategies in realistic classroom and troubleshooting scenarios."},"step4":{"title":"Get Certified ","description":"Complete the final assessments during the live sessions to earn your <AK_BOLD>Wwise Certified Instructor badge</AK_BOLD>, access your toolkit, and gain the ability  to administer the Wwise Fundamentals Practicum certification. "},"step5":{"ctaLabel":"Apply for Certification"}}},"tier2":{"title":"$t(learning:wwise-instructor-program.content.masteryPaths.tiers.tier2.title)","subjects":{"interactiveMusic":"Interactive Music","performanceOptimization":"Performance Optimization","spatialAudio":"Spatial Audio","unityIntegration":"Unity Integration","unrealIntegration":"Unreal Integration"},"steps":{"step1":{"title":"Get the pre-requisites ","description":"Complete the required training and certification in your area of expertise (Interactive Music, Unreal or Unity Game Engine Integration)"},"step2":{"title":"Register and Prepare","description":"Enroll in the instructor training to access official eLearning modules and prepare for upcoming certification activities."},"step3":{"title":"Certification Training (in development)","description":"Advance practicum and certification materials for this tier are currently in development. Submit your interest to stay informed and gain early access when available."},"step4":{"title":"Get Certified ","description":"Complete the final assessments to earn your <AK_BOLD>Wwise Specialized Instructor</AK_BOLD> badge, access your toolkit, and gain the ability  to administer Advanced Wwise Practicum certifications."},"step5":{"ctaLabel":"Notify Me When Open"}}},"tier3":{"title":"$t(learning:wwise-instructor-program.content.masteryPaths.tiers.tier3.title)","subjects":{"affiliateInstructor":""},"steps":{"step1":{"title":"Get the pre-requisites ","description":"Maintain active status as a Wwise Specialized Instructor and demonstrate a track record of high-impact teaching and leadership within the game audio community "},"step2":{"title":"Apply and Qualify","description":"Submit your application to begin a comprehensive vetting process, including an interview and advanced technical assessment with the Audiokinetic team."},"step3":{"title":"Complete Onboarding","description":"Gain full proficiency with the training materials, tools, and Wwise Affiliate Instructor resource pack."},"step4":{"title":"Launch and Grow","description":"Begin delivering official training as a <AK_BOLD>Wwise Affiliate Instructor</AK_BOLD> and unlock performance-based commissions and professional recognition."},"step5":{"ctaLabel":"Notify Me When Open"}}}}},"impact":{"title":"Scale your impact","subTitle":"","description":"Becoming a Wwise Certified Instructor is a commitment to technical excellence that builds your professional authority and scales your impact across the industry.","impacts":{"main":{"title":"Ready to Transform Your Career?"},"nextGen":{"title":"Shape the Next Generation","description":"Deliver official Wwise training and help develop the next generation of game audio professionals. Lead Wwise programs within your institution and contribute to industry standards."},"eliteNetwork":{"title":"Join a Global Network","description":"Connect with a private community of certified instructors and industry professionals. Share insights and access ongoing mentorship, technical sessions, and training from the Audiokinetic team."},"globalAuth":{"title":"Boost Your Professional Authority","description":"Gain official recognition as an Audiokinetic partner, with visibility on global platforms. Strengthen your position as a trusted educator and open new opportunities for collaboration."},"commission":{"title":"Earn Revenue","description":"Generate income through student certifications and authorized training sessions, supported by Audiokinetic’s official programs."}},"form":{"title":"Start your Journey today","formTriggerCtaLabel":"Start your Journey today","formSubmitLabel":"Submit"}},"testimonials":{"title":"Hear from Our Wwise Affiliate Instructors","subTitle":"Wwise Affiliate Instructors are active across the globe.","description":"","testies":{"testie1":{"title":"Anthony Biafore","subTitle":"Audio Professional-Wwise Affiliate Instructor","description":"My goal is to make Wwise feel approachable and exciting, giving both educators and students the confidence to use it the same way professionals do."},"testie2":{"title":"Vasilis Milesis","subTitle":"Composer - Video Game Developer - Lecturer","description":"As a Wwise Affiliate Instructor, I want to inspire students to think of every sound as a character, every silence as a choice, and every project as a story waiting to be told. A chance to remind them that sound can be as narrative as dialogue or light."},"testie3":{"title":"Angel Ignace","subTitle":"Technical Sound Designer - Co owner Aurae Studios","description":"After 10 years doing sound for games in both France and Asia while teaching Wwise at many schools worldwide, becoming Wwise Affiliate was the natural next step and i am super happy to bring my experience and help the Wwise community grow worldwide."}}},"faq":{"title":"FAQ","subTitle":"","description":"Have questions about becoming a Wwise Instructor? Find answers to the most common questions about eligibility, the application process, and what to expect along the way.","faqs":{"wip_faq_1":{"title":"Can I skip Tier 1 if I’m already an expert?","description":"No. All instructors must start with the Wwise Certified Instructor (Tier 1) program to align with our specific teaching strategies and technical standards."},"wip_faq_2":{"title":"How do I maintain my active instructor status?","description":"To remain listed as an active instructor, you must fulfill two requirements:<AK_BULLET>Stay Current: Keep your certification up to date with the latest major version of Wwise.</AK_BULLET><AK_BULLET>Demonstrate Activity: Lead at least two official Wwise Classes per year to ensure your pedagogical and technical skills remain sharp.</AK_BULLET>"},"wip_faq_3":{"title":"Can institutions hire me to teach a Wwise Class?","description":"Yes. As a Wwise certified educator, you hold the official credentials to lead Wwise classes for schools and training centers and administer Wwise Practicum certification exams. This allows institutions to partner with you to deliver the curriculum and validate their students' certifications."},"wip_faq_4":{"title":"Can I specialize in only one topic?","description":"Yes. You can choose to be certified in a single specialization after you’ve completed your training for teaching Wwise fundamentals. To become a Specialized Instructor (Tier 2) in any topic, such as Interactive Music or Unreal or Unity Integration, you must first hold an active Wwise Certified Instructor (Tier 1) status."},"wip_faq_5":{"title":"When do I start earning commissions?","description":"The revenue-sharing model is exclusive to the Affiliate Instructor (Tier 3) level. Tier 1 and Tier 2 focus on the ability to train and certify students"}}},"showYourInterest":{"title":"Apply to Become a Wwise Instructor","description":"We’ll contact you as soon as the next instructor training becomes available.","form":{"title":"Register Your Interest","formTriggerCtaLabel":"Register Your Interest","formSubmitLabel":"Submit"}}}}`),certifications:VX,"learning-resources":{title:"Recommended learning resources",subTitle:"",wwiseSamples:{title:"Wwise samples",resources:[{label:"Cube"},{label:"Wwise Adventure Game"},{label:"View all samples"}]},quickVideos:{title:"Quick videos",resources:[{label:"One Minute Wwise"},{label:"Wwise tutorial videos"},{label:"View all videos"}]},liveSessions:{title:"Live sessions",resources:[{label:"Wwise Up on Air"},{label:"Wwise Up on Air I Hands on"},{label:"View all Live sessions"}]},documentation:{title:"Documentation",resources:[{label:"Wwise Unreal Integration"},{label:"Wwise Unity Integration"},{label:"View all documentation"}]}},strata:CX,documentation:BX,videos:IX,samples:OX},xX="An error occurred while trying to remove your payment method. Please try again later.",KX="This payment method cannot be deleted because it is linked to an active subscription.",RX="You do not have the required permissions to cancel this subscription.",PX="Subscription cancellation failed because no payment method is associated with this account.",UX="Subscription cancellation failed because the credit card on file has expired. Please update your card to proceed.",DX="Subscription cancellation failed because the card was declined. Please update your billing information.",kX="This subscription cannot be canceled at this time.",WX={"generic-api-error":"The was an error while processing the request.",DELETE_PAYMENT_EXTERNAL_ERROR:xX,DELETE_PAYMENT_REFUSED_ACTIVE_SUB:KX,CANCEL_SUB_FAILED_NOT_ALLOWED:RX,CANCEL_SUB_FAILED_NO_CARD:PX,CANCEL_SUB_FAILED_CARD_EXPIRED:UX,CANCEL_SUB_FAILED_CARD_DECLINED:DX,CANCEL_SUB_FAILED_NOT_CANCELLABLE:kX,"bad-user":"We don't recognize this user ID or password","audio-not-supported":"Your browser does not support the audio element."},$X={"menu-label":"Footer",legal:{"menu-label":"Legal"},about:{"menu-label":"About"},news:{"menu-label":"News"},contact:{"menu-label":"Contact"},partners:{"menu-label":"Partners"},bilibili:{"menu-label":"bili bili"},bluesky:{"menu-label":"bluesky"},naver:{"menu-label":"Naver"},weibo:{"menu-label":"Weibo"},wechat:{"menu-label":"WeChat"},facebook:{"menu-label":"Facebook"},twitter:{"menu-label":"Twitter"},linkedin:{"menu-label":"LinkedIn"},youtube:{"menu-label":"YouTube"},twitch:{"menu-label":"Twitch"},"terms-of-use":{"menu-label":"Terms of Use"},"privacy-policy":{"menu-label":"Privacy Policy"},"user-account-policy":{"menu-label":"User Account Policy"},"cookie-policy":{"menu-label":"Cookie Policy"},"code-of-conduct":{"menu-label":"Code o