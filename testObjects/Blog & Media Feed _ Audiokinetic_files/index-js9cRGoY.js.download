I'm interested in attending {{name}}, an event taking place on {{date}}. Please notify me when this event is scheduled again, or when similar events become available.`},contactExternalEventInfoForm:{title:"More information about an event",description:`Hi there,

I'd like more information about {{name}}, an event taking place on {{date}}.`},thankYou:{title:"$t(general:contact-form.title)",description:"Thank you"},contactBlogForm:{title:"$t(general:contact-form.title)",description:""}},formLabels:{unknown_user_firstname:{label:"First name",placeHolder:"First name $t(general:contact-form.required)"},unknown_user_lastname:{label:"Last name",placeHolder:"Last name $t(general:contact-form.required)"},unknown_user_email:{label:"Email",placeHolder:"Email $t(general:contact-form.required)"},logged_in_user:{label:"<AK_BOLD>{{AK_VAR_NAME}}</AK_BOLD> | {{AK_VAR_EMAIL}}"},user_email:{label:"Email: <AK_BOLD>{{AK_VAR_INTERPOLATION}}</AK_BOLD>"},user_email_copy:{label:"Send me a copy by email"},selected_project:{label:"Is your inquiry about one of your projects? (optional)"},project_member_email_copy:{label:"Send a copy to my project's members"},inquiry_teaching_facility:{label:"Associated Teaching Facility",placeHolder:"Which school are you associated with?"},inquiry_subject:{label:"Subject of your inquiry"},inquiry_subject_other:{label:"Please specify",placeHolder:"Please specify the subject of your inquiry"},inquiry_description:{label:"Description",placeHolder:"Please tell us more about your inquiry"},formTitle:{label:"Form title"},basicInfoHeader:{label:"Info header",placeHolder:"Confirm password"},accept_terms_and_conditions:{label:"By filling this form, you acknowledge that you have read and agree to the site's <AK_TERMS_LINK>Terms of Use</AK_TERMS_LINK> and <AK_PRIVACY_POLICY_LINK>Privacy Policy</AK_PRIVACY_POLICY_LINK>."},read_terms_of_use:{label:"I understand that exchanges on the Educator Portal follow the Audiokinetic <AK_TERMS_LINK>Terms of Use</AK_TERMS_LINK>."}}},inquiry:FX,inGameCredits:GX,"project-invitation":{title:"Project invitation",somethingWentWrong:{withProjects:"Invitation request couldn't be processed. Please make sure that you are accepting it with the correct Audiokinetic account or contact the Project Leader to review project details.",noProjects:"Invitation request couldn't be processed. <AK_LINK_REGISTER_PROJECT>Register a project</AK_LINK_REGISTER_PROJECT> to start the process."}},"organization-invitation":{title:"Organization invitation",somethingWentWrong:{withProjects:"Invitation request couldn't be processed. Please make sure that you are accepting it with the correct Audiokinetic account or contact the Project Leader to review project details.",noProjects:"Invitation request couldn't be processed."}},module:YX,"simple-generic-component":{"menu-label":"Simple Test Component"},searchBar:JX},QX="https://www.facebook.com/Audiokinetic/",ZX="https://twitter.com/audiokinetic",eQ={FACEBOOK:QX,TWITTER:ZX},tQ={HOME:{}},iQ={OVERVIEW:{}},nQ={HOME:tQ,WWISE:iQ},aQ={"menu-label":"Help",bannerTagline:"Your project is important to us. We're here to help.",bannerCallToAction:{primaryLabel:"Submit Support Ticket",secondaryLabel:"Ask the Community"},bannerCallToActionMobile:{primaryLabel:"Submit Support Ticket"}},rQ={"menu-label":"Help",bannerV2Title:"Your project is important to us. We're here to help.",bannerCallToAction:{primaryLabel:"Submit Support Ticket",secondaryLabel:"Ask the Community"},bannerCallToActionMobile:{primaryLabel:"Submit Support Ticket"}},oQ={"menu-label":"Help",help:{"menu-label":"Help",bannerV2Title:"How can we help you?",documentation:{wwise_help:{title:"Wwise",description:"Access all Wwise-related documentation, including the Wwise Help, SDK, the Unreal and Unity Integrations, and Wwise Fundamentals.",ctaPrimary:"Documentation"},ak_launcher:{title:"$t(doNotTranslate:audiokinetic-launcher)",description:"Learn what you can do with the Launcher, from installing Wwise and adding plug-ins to integrating Wwise into an Unreal or Unity project and downloading Strata collections.",ctaPrimary:"Documentation"},strata_library:{title:"Strata",description:"Access all Strata related documentation including the main user guide and the individual collection guides.",ctaPrimary:"Documentation"},support:{title:"Support",description:"Get details on the Wwise support policy and technical support plans, or submit a support ticket.",ctaPrimary:"$t(common:buttons.learn-more)"},creative_services:{title:"Creative Services",description:"Work with us to take your audio project and Wwise to the next level.",ctaPrimary:"$t(common:buttons.learn-more)"},request_feature:{title:"Request a Feature",description:"Do you have a feature suggestion for Wwise? Let us know what you want in future versions, or vote for other people's ideas on the Community Q&A.",ctaPrimary:"Request a feature"},report_bug:{title:"Report a Bug",description:"We read all logged bug reports and evaluate options to address them; however, please do not expect a response regarding your bug submission.",ctaPrimary:"Learn how"},community_qa:{title:"Community Q&A",description:"Get help from the Audiokinetic community! Ask questions, find answers and share expertise with Wwise and Strata users around the world.",ctaPrimary:"Community Q&A"}}},support:{"menu-label":"Support","wwise-support-policy":{title:"Wwise Support Policy",description:"Make sure you are using the most recent patch release for the Wwise version you’re on.",version:"Wwise Version",supportPeriod:"Support Period",active:{barLabel:"Active",title:"Active",titleClassName:"support-policy-active",description:"Audiokinetic fully supports the ultimate and penultimate major versions of Wwise through public code patch releases."},private:{barLabel:"Private",title:"Private",titleClassName:"support-policy-private",description:"Audiokinetic provides support for the antepenultimate version of Wwise, unless a newer version could be used to solve the reported issue. Agreements under Creative Services can be reached to extend support of the antepenultimate version of Wwise through private code patches."},"end-of-life":{barLabel:"End of Life",title:"End of Life",titleClassName:"support-policy-end-of-life",description:"Best effort support with no guarantees for all older versions of Wwise."}},"technical-support":{title:"Technical Support","support-tier":{pay_2_go:{title:"Pay2Go",description:`Single support ticket, purchased upfront online.
Initial response within <AK_BLACK>2 business days</AK_BLACK> for severe and showstoppers issues.<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>Ticket</AK_IRON>",ctaPrimary:"Purchase Pay2Go"},standard:{title:"Standard",description:`Support plan purchased with Wwise license.
Initial response within <AK_BLACK>2 business days</AK_BLACK> for severe and showstoppers issues.<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>Tickets</AK_IRON> / year",ctaPrimary:"Contact Us"},unlimited:{title:"Unlimited",description:`Support plan purchased with Wwise license.
Initial response within <AK_BLACK>2 business days</AK_BLACK> for severe and showstoppers issues.<AK_RED>*</AK_RED> 
Premium Wwise license includes 1 year of unlimited support. 
Platinum Wwise license includes unlimited support for duration of development plus 6 months post launch. 
`,periodOfTickets:"",ctaPrimary:"Contact Us"}},"support-queue-fine-print-1":"A single topic per ticket.","support-queue-fine-print-2":"The support queue is based on the order received and severity. <AK_DEEMPHASIZED>(local business hours in Montreal -5 GMT, Beijing +8 GMT and Tokyo +9 GMT)</AK_DEEMPHASIZED>","business-hours":"Audiokinetic Support is available during regular business hours: Monday to Friday from 9AM to 5PM (EST).  Please note that support will not be provided during holidays. ",holidays:{title:"Audiokinetic Holiday Schedule","date-label":"Dates","holiday-name":"Holidays","holiday-line-date":{single:"{{mon}} / {{dateFrom}}",multiple:"{{mon}} / {{dateFrom}}-{{dateTo}}"}}},"need-help":{title:"Still can't find what you're looking for?",subText:"",ctaPrimary:"$t(common:buttons.get-in-touch-bang)"},requests:{requestType:{feature_request:{title:"Request a Feature",description:"Do you have a feature suggestion for Wwise? Let us know what you want in future versions, or vote for other people's ideas on the Community Q&A.",ctaPrimary:"Request a feature"},report_a_bug:{title:"Report a Bug",description:"We read all logged bug reports and evaluate options to address them, however, please do not expect a response regarding your bug submission.",ctaPrimary:"Report a bug"}}},"useful-resources":{title:"Helpful Resources",subTitle:"We’ve got you covered!",integrations:{title:"Integrations",resources:[{label:"Unity Integration"},{label:"Unreal Integration"},{label:"WAAPI"}]},documentation:{title:"Documentation",resources:[{label:"$t(doNotTranslate:audiokinetic-launcher)"},{label:"Wwise Help"},{label:"Wwise SDK"}]},samples:{title:"Samples",resources:[{label:"$t(doNotTranslate:wwise-adventure-game)"},{label:"Wwise Audio Lab"},{label:"Wwise Authoring API Pack"}]},education:{title:"Learning",resources:[{label:"Learning Material"},{label:"Wwise Certifications"}]}},"wwise-help":{"stand-alone-description":"Get help from the Wwise <AK_BLACK>Community Q&A</AK_BLACK>! Ask questions, find answers and share expertise with Wwise users around the world."}},"creative-services":{"menu-label":"Creative Services",title:"Creative Services",description:"A great way to leverage our expertise towards the specific needs of your audio project.",perks:[{name:"Tailored development"},{name:"Workflow improvements"},{name:"Project evaluation"},{name:"Integration support"}],ctaPrimary:"$t(common:buttons.learn-more)"},documentation:{"menu-label":"Documentation"},"questions-answers":{"menu-label":"Q & A"},"submit-support-ticket":{"menu-label":"$t(common:buttons.submit-support-ticket)"},"request-feature":{"menu-label":"Request Feature"},"report-bug":{"menu-label":"Report Bug"}},sQ={help:aQ,support:rQ,module:oQ},lQ={"menu-label":"$t(doNotTranslate:audiokinetic)",bannerV2Title:"Where Sound Awakens New Worlds",bannerV2SubTitle:"The Global Leader in Interactive Audio Technology",bannerCallToAction:{primaryLabel:"$t(common:audiokineticLauncher.download)",secondaryLabel:"$t(common:buttons.learn-more)"},bannerCallToActionMobile:{primaryLabel:"$t(common:buttons.learn-more)"}},cQ={"menu-label":"$t(doNotTranslate:audiokinetic)",integrations:{title:"Integrations",description:"Audiokinetic solutions integrate easily into any technology including embedded systems."},platforms:{title:"Platforms",description:"Audiokinetic provides cross-platform audio solutions."}},uQ={title:"Integrations",description:"Audiokinetic solutions integrate easily into any technology including embedded systems."},dQ={title:"Platforms",description:"Audiokinetic provides cross-platform audio solutions."},hQ={title:"AK Blog","interaction-bubble":"<AK_LINK>Subscribe to AK Blog</AK_LINK> for the latest industry updates, Wwise tips, and interactive audio stories from the community!"},pQ={home:lQ,module:cQ,"home-cards":{"card-a":{title:"Pioneering immersive audio technology",description:"Audiokinetic is the leading global provider of the most advanced and scalable cross platform interactive audio solutions. A trusted technology partner to the world’s largest developers, OEMs, and audio production companies, its flagship product <AK_WWISE_PRODUCT_PAGE>Wwise</AK_WWISE_PRODUCT_PAGE> is the gold standard interactive audio engine on the market, and <AK_STRATA_PRODUCT_PAGE>Strata</AK_STRATA_PRODUCT_PAGE> is the world's first ready-to-edit multitrack sound library."},"card-b":{title:"Empowering the audio community",description:"The catalyst transforming and mobilizing industries worldwide around the role and value of immersive audio, Audiokinetic empowers the largest and fastest growing community of interactive audio creators. Audiokinetic enables creative freedom, champions thought leadership, and inspires collaboration."},"card-c":{title:"Fostering the next generation of audio creators and educators",description:"An educational partner to more than 400 universities and academic institutions around the world, Audiokinetic contributes to the advancement of curriculums teaching interactive audio. Its education program offers reputable interactive audio certifications, a certification for interactive audio educators, as well as team training for studios and developers."}},integrations:uQ,platforms:dQ,blog:hQ,"related-videos":{title:"Video Channel","dynamic-interaction-bubble":{YOUTUBE:"<AK_LINK>Subscribe to Audiokinetic's YouTube Channel</AK_LINK> to learn and get inspired!",BILIBILI:"<AK_LINK>Subscribe to Audiokinetic's BiliBili Channel</AK_LINK> to learn and get inspired!"}}},mQ={"page-title":"Audiokinetic Trademarks","page-info":"<AK_BIG_AND_BLACK>List of Trademarks </AK_BIG_AND_BLACK>","page-description":`<AK_ITALIC>Last Updated {{last_update_date}}</AK_ITALIC>

The following is a non-exhaustive list of Audiokinetic’s trademarks.

The absence of a trademark from this list does not constitute a waiver of Audiokinetic’s trademark or other intellectual property rights concerning that name.
`,"guidelines-title":"<AK_BIG_AND_BLACK>Trademark Guidelines<AK_BIG_AND_BLACK>","other-trademarks":"<AK_BIG_AND_BLACK>Other Trademarks<AK_BIG_AND_BLACK>","guidelines-description":`You may use the Audiokinetic trademarks if such use constitutes a truthful and accurate reference to Audiokinetic products or services for the purpose of, explanation, information, or as an indicator of compatibility.

If you are a licensee of an Audiokinetic trademark or logo and have been provided with special trademark usage guidelines with your license agreement, please follow those guidelines. If your license agreement does not provide usage guidelines, then follow these guidelines.

When using the marks in publications that will be distributed only in the United States, include the appropriate ™, ℠, or ® symbol on first use. For publications that will be distributed outside the United States, do not include trademark symbols. Instead use the appropriate trademark attribution notice, for example: Wwise is a trademark of Audiokinetic Inc., registered in the U.S. and other countries. Any use of the Audiokinetic trademarks or logos must be accompanied by a notice that clearly indicates that the Audiokinetic trademarks or logos are trademarks of Audiokinetic Inc.

Audiokinetic reserves the right in its sole discretion to terminate or modify your permission to display the Audiokinetic trademarks and to take action against any use that does not conform to these guidelines, infringes any Audiokinetic intellectual property or other right, or violates applicable law.  All Audiokinetic trademarks are provided “as is”, and Audiokinetic disclaims any implied or express warranties regarding the same, including warranties of non-infringement.

Please refer to our specific guidelines for <AK_LINK_IN_GAME_CREDITS>In-game Credits</AK_LINK_IN_GAME_CREDITS> and other credits.`},vQ={trademarks:mQ,"legal-notice":{title:"",description:"<AK_NOTICE_LINK>Legal notice</AK_NOTICE_LINK>  Copyright © {{AK_VAR_CURRENT_YEAR}} Audiokinetic Inc. and Conservatory of Recording Arts & Sciences. All rights reserved."}},fQ={"menu-label":"Licenses & Subscriptions",title:"Licenses & Subscriptions",strata:{tabLabel:"Strata","no-subscriptions":{title:"No license found",description:"To add licenses for this account, visit our <AK_LINK_TO_STRATA_STORE>store</AK_LINK_TO_STRATA_STORE>"},subscriptions:{title:"Subscription(s)",productName:"Product",owner:"Owner",status:"Status",expiration:"Expiration",nextPayment:{nextPaymentLabel:"Next billing date will be <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>.",nextGuaranteedPaymentLabel:"Next payment of <AK_BOLD>{{nextPaymentAmount}}</AK_BOLD> will be processed on <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>.",guaranteedPriceLabel:"Your discounted price will be be re-evaluated on <AK_BOLD>{{guaranteedPriceUntil}}</AK_BOLD>."},installment:{date:"Installment Dates",amount:"Amount",status:"Status","no-installments-personal":"No upcoming payments are required","no-installments-project":"No upcoming payments are required","no-installments-enterprise":"Section reserved to owner"},subscriptionCancellation:{title:"Subscription Cancellation",confirm:'Are you sure you want to cancel your "{{AK_VAR_SUBSCRIPTION_NAME}}" ?',fee:"<AK_BOLD>Cancellation fees: {{AK_VAR_CANCELLATION_FEE}}</AK_BOLD><br /><AK_BOLD>Payment method: Default card ({{AK_VAR_DEFAULT_CARD}})</AK_BOLD>","fee-description":"Upon early termination, <AK_RED>fees will be charged</AK_RED> as per<br /><AK_LINK_TO_DOCUMENTS>Subscription Agreement</AK_LINK_TO_DOCUMENTS>.","successful-cancellation":"Your {{AK_VAR_SUBSCRIPTION_NAME}} has been successfully canceled."}},"asset-download":{title:"Strata Collections",description:"Collections are downloadable directly from $t(doNotTranslate:audiokinetic-launcher)",ctas:{primary:"$t(audiokineticLauncher.open)",secondary:"$t(audiokineticLauncher.download)"}},downloads:{title:"Downloads",plugins:"Plug-ins",version:"Version",installer_links:"Installers"},"license-agreements":{title:"License Agreements","i-agree-bullet-link":"<AK_BULLET>{{AK_FILE_NAME}}</AK_BULLET>","accept-and-sign":"Agree to all license agreements"},licenses:{title:"License(s)",type:"Type",licenseKey:"Activation key",status:"Status",productName:"Associated product",licenseKeyCopied:"License key copied"},"need-help":{title:"Need help?",description:"Let us know if you have any questions regarding your subscriptions.",ctas:{primary:"Contact your Audiokinetic Representative"}}},wwise:{tabLabel:"Wwise",licenses:{title:"",type:"",status:"","relates-to-name":"","relates-to-id":"",licenseKey:"",expirationDate:""}}},gQ={module:fQ},MQ=JSON.parse(`{"bannerV2Title":"Audiokinetic Product Licensing FAQ","bannerSubTagline":"","faq-dropdown-selector":"What license are you interested in? ","faq":{"strataLicenses":{"tabLabel":"Strata Licenses","content":{"q01":{"title":"Do I have access to all Strata collections ?","content":"Yes. You have access to all Strata collections as long as you are subscribed to any of the Paid subscriptions. The Free subscription provides you access to Sample collections only."},"q02":{"title":"How much does it cost to access Strata?","content":"Please refer to our <AK_STRATA_PRICING_LINK>pricing</AK_STRATA_PRICING_LINK> page."},"q03":{"title":"Will the subscription fees change during my subscription?","content":"No. Once you confirm your subscription at a particular price, it will apply for the entire duration of your subscription period."},"q04":{"title":"When do I have to pay?","content":"Strata is payable in annual installments."},"q05":{"title":"What is the duration of the subscription? ","content":"Strata offers a variety of plans tailored to meet your specific needs ranging from a 1 to 3-year term for both personal and enterprise subscriptions. Students and teachers can also benefit from a 1-year Academic plan. See the <AK_STRATA_PRICING_LINK>pricing</AK_STRATA_PRICING_LINK> page for more details."},"q06":{"title":"What if I forget to update my credit card information and the payment does not go through?","content":"You will receive a message from us notifying you that a payment has been missed, and you will have 30 days to update your payment information to maintain your subscription. If we are not able to process your payment within that 30-day window, we will contact you to arrange for an alternative payment method."},"q07":{"title":"Can I try out Strata before buying a subscription?","content":"Yes. We offer a sample project containing examples from various Strata collections through a <AK_FREE_SUBSCRIPTION_LINK>free subscription</AK_FREE_SUBSCRIPTION_LINK>."},"q08":{"title":"Where can I find Strata’s terms and conditions?","content":"Visit the <AK_STRATA_LICENCING_AGREEMENT>Strata License agreement</AK_STRATA_LICENCING_AGREEMENT> and <AK_STRATA_SUBSCRIPTION_AGREEMENT>subscription agreement</AK_STRATA_SUBSCRIPTION_AGREEMENT>."},"q09":{"title":"Can I cancel my subscription?","content":"Strata offers various subscription models which you can learn more about <AK_STRATA_PRICING_LINK>here</AK_STRATA_PRICING_LINK>. The subscription term will renew in accordance with the agreed upon terms. Subject to local consumer legislation, all payments made are non-refundable and any remaining unpaid portion of the subscription remains due. Your subscription will continue until the end of the current paid term."},"q10":{"title":"What happens at the end of the subscription term?","content":"You will receive a notification regarding the upcoming expiration of your subscription, along with any updated pricing information relevant to your plan. You will have the opportunity to opt into a new subscription period."},"q11":{"title":"I want a subscription that covers several members of my team. Do you have a program that allows organizations to centralize the management of subscriptions?","content":"Yes. We offer an Enterprise subscription that makes it easy for an organization to manage the attribution of per-seat licenses to its team members. "},"q12":{"title":"What is the Enterprise subscription?","content":"The Enterprise subscription makes it easy for organizations to manage multiple users.\\n\\nContact your Audiokinetic representative for more details about the Enterprise subscription."},"q13":{"title":"What if new members need access during the period of the initial subscription, or some members leave the team?","content":"You can increase the number of enterprise seats at any time.\\n\\nYou can modify who has access to Stata as long as the total number of users does not exceed the number of purchased seats.\\n\\nSimply contact your Audiokinetic representative for changes to your Enterprise subscription."},"q14":{"title":"What am I allowed to do with the sounds I download?","content":"As long as you have a valid subscription to Strata, you can:\\n    1) Edit the sounds\\n    2) Render the sounds\\n    3) Add the sounds to a SFX library\\n    4) Synchronize into a product you are working on"},"q15":{"title":"Are there any restrictions on what I can do with the sounds?","content":"Yes. Source, pre-rendered media, and user-derived media cannot be repacked or re-sold as an audio asset library. \\nDetails regarding your licence restrictions can be found in section 3 of the Stata License Agreement.\\n\\nIf you want to use Strata for any purposes other than those set out in our standard agreements, please contact our Sales team."},"q16":{"title":"Once the sounds have been rendered, what am I allowed to do with them?","content":"You can include rendered sounds in any media and can use them in perpetuity, as long as the rendered media is synchronised into a product during a valid subscription period.\\n\\nFor instance, you can use them in any mobile, PC, or console video game, podcast, or livestream, add them to musical compositions, movies, or live theatre/music productions, broadcast them over the radio or television, use them in advertisements, or post them on YouTube, Facebook, Instagram, TikTok, or other social media. "},"q17":{"title":"What am I allowed to do with the sounds I developed once my subscription is over?","content":"You are free to continue to use the sounds as part of a product if the sound was integrated into the product during your subscription in accordance with the <AK_STRATA_LICENCING_AGREEMENT>Strata License Agreement</AK_STRATA_LICENCING_AGREEMENT> even after your subscription is over.\\n\\nHowever, sounds that you created or edited can be re-used in a project that is directly dependent on the original production where the sounds were first published, such as a sequel or expansion pack. Otherwise, you can no longer create any new sounds or use any of the source sounds or rendered sounds that were made available to you through Strata."},"q18":{"title":"What does royalty-free mean?","content":"Royalty-free means that you don’t owe any additional fees for personal or commercial use of a Strata sound file that is incorporated into any audio or multimedia production. Once you have subscribed to Strata, you have the license to use that sound as often as you like, in as many projects as you like, and you will never be required to pay another fee of any kind for Strata sounds used in those projects during your subscription. "},"q19":{"title":"Can I resell either original Strata sounds or new original sounds I created using Strata?","content":"No. Strata sounds cannot be copied, resold or distributed as individual files. They can only be resold and distributed when incorporated or synchronized into a product during your subscription."},"q20":{"title":"How can I obtain the software necessary to open the sounds?","content":"All the necessary VST3 plug-ins (ENRAGE, Wwise, and IEM) are included with your subscription and can be downloaded from the $t(doNotTranslate:audiokinetic-launcher).\\n\\nYou will need to provide your own version of <AK_REAPER_LINK>REAPER</AK_REAPER_LINK> though as it is not included with your Strata subscription. "},"q21":{"title":"Can I transfer my subscription to someone else?","content":"The Personal subscription is not transferable.\\n\\nThe Enterprise subscription allows for the transfer of seats within the same organization."},"q22":{"title":"When do I need an Enterprise subscription?","content":"You will need an Enterprise subscription when you need more than 1 seat or if you are making the purchase on behalf of an organisation."},"q23":{"title":"Can I put the licensed Strata sounds on several computers? ","content":"For Enterprise subscriptions, all users who access Strata content must have a valid Enterprise license assigned to their Audiokinetic account. In the case of a personal subscription, you are allowed to back up the Strata content according to the terms of the  subscription agreement."},"q24":{"title":"Does the license cover indemnity?","content":"Yes. Review the Audiokinetic <AK_STRATA_LICENCING_AGREEMENT>Strata License agreement</AK_STRATA_LICENCING_AGREEMENT> for details."},"q25":{"title":"As a contractor, can I use Strata in projects I create for my client?","content":"Yes. You are licensed to edit and render the original Strata sounds provided from Strata projects or any rendered sound, and resell them as a part of your customer’s project. You are not licensed to resell either the original Strata sounds or any elements from Strata sounds you edit or design."},"q26":{"title":"What intellectual property protections are in place for Strata?","content":"We protect Strata through the use of intellectual property rights, including  trademark, patents and copyright."},"q27":{"title":"How can I obtain an invoice after I've subscribed to an individual Strata license?","content":"Sign in to your Audiokinetic account and navigate to your Transaction History to find it. If the presented invoice is not adequate for your needs, please contact your sales representative (or sales@audiokinetic.com) to switch to an enterprise license. We support business-to-business payment methods and are able to issue VAT general/special invoices."},"q28":{"title":"Can I pay for the entire 3 year subscription fee upfront in a single payment?","content":"We invite you to contact your <AK_CONTACT_SALES_LINK>Audiokinetic sales representative</AK_CONTACT_SALES_LINK> to discuss alternative payment options, including an upfront payment for the entire subscription."},"q29":{"title":"I am completing payment information in my native language. Why do I encounter an error when making the payment?","content":"We apologize for the inconvenience. Our payment system currently only supports Western characters. Please input all information in English instead of your native language and if the error is still occuring, try to switch the website language to English."},"q30":{"title":"Can I subscribe to Strata and let multiple users access my Strata subscription?","content":"This goes against the Strata license and subscription agreement. Other users must obtain their own personal subscription or get an enterprise subscription if you all work for the same employer. Your account should be only available to yourself and never shared. You may showcase any of your Strata projects to anybody else but you must not let anyone else work under your Strata license."}}}}}`),_Q={licensing:MQ},LQ=JSON.parse(`{"menu-label":"Strata","bannerV2Title":"Sound Effects Library, Reimagined","bannerV2SubTitle":"","bannerV2Description":"Strata is a new approach to sound effect collections, in a dynamic multitrack layered workflow.","pricing-plans-secondary-banner":{"bannerV2Title":"Flexible Pricing for Every Creator","bannerV2SubTitle":"Choose your plan and unlock sound design without limits."},"contextual-banner-image-alt":"Strata logo","subscribe-strata-newsletter":{"title":"Stay up-to-date with the latest Strata news!","subTitle":"Create your Audiokinetic account to subscribe to the Strata newsletter and stay up-to-date with all the newest releases.","subTitleLoggedIn":"Subscribe to the Strata newsletter and stay up-to-date with all the newest releases.","ctaPrimary":"$t(common:buttons.create-account)","callToActionLoggedInLabel":"$t(common:buttons.subscribe-strata-newsletter)"},"bannerCallToAction":{"primaryLabel":"Get Free Samples","secondaryLabel":"Subscribe now","tertiaryLabel":"Explore collections","gotoPricingPage":"See Plans","subLabel":"+++ Strata collections are specifically designed for games and interactive audio production. Create your unique sound, effortlessly. "},"the-making-of-banner":{"title":"Designed for Interactive Audio","description":"Strata is more than just a sound library, it’s a complete workflow for interactive audio. Strata empowers you to sculpt, layer, and modify every element to match your creative vision.\\n\\n Over time, Strata evolves beyond a library - it becomes your library.","alt-text":"The making of Strata trigger-image to view video","label":"Watch the Making of Strata","targetLink":"https://www.youtube.com/embed/KEynYDyY6eI"},"promo-video":{"title":"Your sound library, in multitrack format","label":"Watch Video"},"collections":{"title":"Discover the Collections","cardAltText":"Card image for {{CARD_NAME}}","soundCount":"{{count}} Sounds","current":{"label":"Collections","labelCount":"({{collectionCount}})"},"ctas":{"view-all-collections":"View All Collections"},"coming-soon":{"label":"Upcoming Release","labelCount":"({{collectionCount}}) October 2022"},"release-schedule":{"title":"Release Schedule"},"collection-names":{"aircraft":"Aircraft","ambience-detailed-rain":"Ambience Detailed Rain","ambience-doom":"Ambience Doom","ambience-fantasy":"Ambience Fantasy","ambience-medieval":"Ambience Medieval","ambience-nature":"Ambience Nature","ambience-scifi":"Ambience Scifi","ambience-urban":"Ambience Urban","ambience-warfare":"Ambience Warfare","ambience-fire-water":"Ambience Fire and Water","ambience-space-station":"Ambience Space Station","animal-domestic":"Animal Domestic","animal-wild":"Animal Wild","bullets":"Bullets","cannons":"Cannons","cinematic-hits":"Cinematic Hits","close-combat":"Close Combat","combat-groups":"Combat Groups - Walla","combat-groups-p2":"Combat Groups - Callouts","creature":"Creature","creature-ancient":"Creature Ancient","creature-humanoid":"Creature Humanoid","creature-movement":"Creature Movement","doors":"Doors","doors-historical":"Doors Historical","doors-scifi":"Doors Scifi","explosions":"Explosions","footstep":"Footstep","gore":"Gore","historical-firearms":"Historical Firearms","human-movement":"Human Movement","heavy-weapons-medieval":"Heavy Weapons Medieval","interactable-objects":"Interactable Objects","magic":"Magic","medieval-weapons":"Medieval Weapons","modern-firearms":"Modern Firearms","physics":"Physics","physics-debris":"Physics Debris","physics-destruction":"Physics Destruction","quadcopters":"Quadcopters","robotic":"Robotic","scifi-weapons":"Scifi Weapons","sorcery_absorption":"Sorcery Absorption","sorcery-strike":"Sorcery Strike","sorcery-whimsical":"Sorcery Whimsical","spaceships":"Spaceships","space-station":"Space Station","space-station-ambience":"Space Station Ambience","submersion":"Submersion","ui-general":"UI General","ui-modern":"UI Modern","ui-organic":"UI Organic","vehicles":"Vehicles","voice":"Voice","warfare":"Warfare","wwi-firearms":"WWI Firearms","wwi-shotguns":"WWI Shotguns","wwi-pistols":"WWI Pistols","wwi-rifles":"WWI Rifles","wwii-firearms":"WWII Firearms","zombies":"Zombies","strata-sample-01":"Strata Sample 01","strata-sample-02":"Strata Sample 02","strata-sample-03":"Strata Sample 03","strata-sample-04-wwi":"Strata Sample 04"}},"testimonials":{"title":"What Audio Professionals Are Saying"},"stand-alone-descriptions":{"description-a":[{"text":"<AK_BLACK>Strata™</AK_BLACK> provides unparalleled sound design flexibility so that you can focus on what matters most—your creative vision. Strata is an extensive curated library of high-quality sounds designed for interactive audio production. Collections include complete professional multitrack REAPER projects, with all original audio sources for infinite variations and customization empowering you to create unique sounds for your unique projects, effortlessly. Produced by top-tier sound designers and SFX providers, new Strata collections are delivered monthly so you’ll always have access to relevant audio recordings. For creative freedom, subscribe to Strata library! \\n"}]},"free-samples":{"title":"$t(common:labels.free-samples)","cta-label":"Get Free Samples"},"library-list":{"title":"Strata","titleCount":"({{collectionCount}})","cta-label":"Buy Subscription","view-upcoming-releases":"View Upcoming Collections"},"overview-faq":{"title":"FAQ","section-data":{"q01":{"sectionTitle":"Can I try Strata for free?","description":"Yes! Subscribe to the free sample collections <AK_LINK_1>here</AK_LINK_1>. The free sample collections include a read-only ENRAGE plug-in, and while you can’t edit its effect properties, all sounds are royalty-free and commercially safe to use in your projects."},"q02":{"sectionTitle":"What do I need to get started with Strata?","description":"Strata collections are built using REAPER as the multitrack DAW of choice. To fully leverage Strata in its multitrack format, you will need a version of REAPER installed. For more technical details on getting started with Strata, check out our <AK_LINK_1>Features page</AK_LINK_1>."},"q03":{"sectionTitle":"How can I get support or more information?","description":"For other questions or if you encounter technical issues with Strata or its plug-ins, please visit our <AK_LINK_1>Community Q&A</AK_LINK_1> section.\\n\\nStill can't find your answer? <AK_LINK_2>Post a new question here</AK_LINK_2>."}}},"needed":{"title":"What you need","section-data":{"needed_01":{"sectionTitle":"REAPER","description":"Strata collections are designed for use with REAPER, and a REAPER installation is required to utilize their multitrack capabilities.\\n\\nFor more information on REAPER, visit <AK_LINK_1>https://www.reaper.fm/</AK_LINK_1>"},"needed_02":{"sectionTitle":"Plug-ins","description":"Strata plug-ins seamlessly complement Strata design software by providing specialized tools for 3D tasks, boosting efficiency, and empowering users to achieve precise design goals for an enhanced experience.","logos":{"wwise-vst":"Wwise VST3 plug-in","iem":"IEM Plug-in","enrage":"Enrage Plug-in"}},"needed_03":{"sectionTitle":"Integrations","description":"With Strata's integration into Soundly, Basehead, and Soundminer, you can efficiently search using embedded metadata and instantly open Strata REAPER Projects at the exact timeline location, allowing for rapid audio customization.<br/><br/>Check out the <AK_LINK>Strata User Guide</AK_LINK> to learn how these integrations work.","logos":{"soundly":"Soundly","soundminer":"Soundminer","basehead":"BaseHead"}},"needed_04":{"sectionTitle":"Strata Tools","blocs":{"b00":{"description":"Built to enhance your Strata workflows, Audiokinetic has created a series of REAPER extensions and scripts."},"b01":{"title":"<AK_LINK>ReaWwise</AK_LINK>","description":"ReaWwise enables fast and efficient transfer from REAPER directly to Wwise as simple sounds or as complex hierarchies in a single-click operation. Build and save Wwise object hierarchies as presets, and use wildcards for automatic naming."},"b02":{"title":"<AK_LINK>Open Associated REAPER Project</AK_LINK>","description":"Rapid iteration is essential. This script opens the associated REAPER project of your Strata audio file directly from Wwise, using the metadata embedded in the Strata audio file to open the project and locate the source sounds."},"b03":{"title":"<AK_LINK>Strata_Copy Selection to Next Project</AK_LINK>","description":"This REAPER script package makes it easy to copy items, tracks and plug-ins from one REAPER project to another."},"b04":{"title":"Where to get them?","description":"<AK_LINK_1>REAPER Tools</AK_LINK_1> is our GitHub repository.\\n\\n<AK_LINK_2>ReaPack</AK_LINK_2> is the fast & easy way to install and keep all your Strata Tools up to date."}}}}},"tips-tools":{"title":"Tools, Tips & Overviews"},"learn-with-videos":{"title":"Learn with Strata videos"},"overview-community-videos":{"title":"Strata Community Videos"},"strataContains":{"title":"Strata at a glance","description":"","projects":"REAPER projects","size":"GB","collections":"Collections","soundEffects":"Sound Effects","soundItems":"Sound Items"},"strata-benefits":{"title":"Strata: Unlock the full benefits of a groundbreaking sound library.","section-data":{"creative-control":{"sectionTitle":"Unlock Total Creative Control","main":{"description":"Move beyond rigid, pre-rendered files. With Strata’s layered architecture, you gain full access to every essential element—clips, tracks, effects, and source files—so you can shape sound exactly the way you envision it."}},"dynamic-gameplay":{"sectionTitle":"Infinite Variations for Dynamic Gameplay","main":{"description":"When it comes to interactive audio, there’s no such thing as too much variation. Strata lets you generate endless variations from raw elements, so your sound design is as dynamic as your game (or at least until you hit your release date)."}},"learn-from-the-best":{"sectionTitle":"Learn from the Best, Create Your Own","main":{"description":"Sound design is the magic behind the curtain—heard but rarely seen. Strata pulls that curtain back, giving you direct access to multitrack sessions from top sound designers. Study their techniques, uncover their workflows, and use their expertise to shape your own signature sound."}},"consistency-by-design":{"sectionTitle":"Consistency by Design","main":{"description":"Strata’s inherent consistency, from sound quality to metadata, ensures every element works in harmony. Integrate sounds effortlessly into your project, creating a cohesive audio aesthetic."}}}},"benefits":{"title":"Strata Benefits","customization":{"title":"Infinite creative customization","description":"Explore an evergrowing library of multitrack collections accompanied by all the necessary ingredients: clips, tracks, unrendered effects, and source files. You have endless sound variations at your fingertips with unparalleled creative customization."},"consistency":{"title":"Consistency by design","description":"Simplify your workflow with consistency and uniformity across all collections, multitrack project layouts, effects, and UCS standard metadata. Streamline your workflow with integrations with REAPER, Soundminer, Soundly, Wwise, and soon Basehead."},"efficiency":{"title":"Increased efficiency","description":"Slash hours spent searching, editing, and organizing sounds and allow time for actual design work. With monthly new collections by top-tier sound designers, keep costs associated with recording sounds from scratch minimal and reduce costs associated with the busy work of finding, organizing, and editing rendered sounds, or mixing inconsistent sound files."},"top_tier":{"title":"Top-tier sound collections","description":"Access a continuously growing library produced by top-tier sound designers and SFX providers, with infinite variations."},"reverse_engineering":{"title":"Learning by reverse engineering","description":"Learn from the industry’s very best sound designers by accessing their original sound design sessions. You’ll be able to reverse engineer their work and immediately become familiar with their methodologies and best practices."}},"plugins":{"title":"Plug-ins","description":"Strata plug-ins seamlessly enhance Strata design software, offering specialized tools for 3D tasks and optimizing efficiency, empowering users to achieve precise design goals. Elevate your Strata experience with these powerful add-ons."},"integrations":{"title":"Integrations","description":"Enhance Strata projects by seamlessly integrating with Soundly, Soundminer, and basehead for efficient access to high-quality sounds, achieving a harmonious blend of visual and auditory excellence."},"partners":{"title":"Production Partners","description":"Elevate your creative workflow with seamless integrations, innovative tools, and enhanced efficiency for design and production processes."},"production-partners":{"title":"Production Partners","description":"We collaborate with the industry's finest creative sound recordists and designers to craft bespoke, high-value collections.","partners":{"boom":{"title":"","description":"Boom Library, a world-renowned sound effects provider, partners with Strata to deliver exceptional audio quality and an extensive library of meticulously crafted sounds, trusted by professionals in film, games, and media production worldwide."},"digitalRainLab":{"title":"","description":"Digital Rain Lab is a collective of professional sound designers/tech and sci-fi wizards, whose experience spans across many subdisciplines: from cinematography to in-house interactive audio system development. This is the best place to find premium quality sound effect libraries for any project."},"rockTheSpeakerBox":{"title":"","description":"A team of award-winning audio professionals with two decades of experience designing sound for AAA game titles for multiple platforms. They bring their passion for recording and designing and a solid understanding of the challenges of game production. Their collections combine high-quality sounds designed to enable game sound designers to take their project's sound to the next level."},"soundexMachina":{"title":"","description":"We are a small and agile team of recordists and sound designers. We provide royalty-free, context-based sound effects libraries in HQ to sound pros, developers and filmmakers around the world."},"spectravelers":{"title":"","description":"We are Spectralevers, humans coming from the future and travelling using an alien technology involving an audio spectral time portal. During our journey, we gather many audio spectral textures that we mix and combine together in order to share them with you!"},"monsterFactory":{"title":"","description":"The Monster Factory offers unique expertise in the field of sound creation, voice acting, localization, voice direction and sound design destined for many types of virtual monsters and creatures."},"biquette":{"title":"","description":"With 20 years of experience in the video game industry, the team at Biquette Studio captures and shapes authentic natural soundscapes designed to enrich documentaries, films, and video games. Our DNA is built around the immersive and spatial power of sound using ambisonic and binaural 3D sound recording techniques."},"aftertouch":{"title":"","description":"Aftertouch Audio is a small team of Sound Recordists and Sound Designers dedicated to producing high-quality, royalty-free sound effects libraries."}}},"what_you_need":{"title":"What you need","cards":{"reaper":{"title":"REAPER","description":"Strata collections are built using REAPER as the multitrack DAW of choice.\\n\\nTo fully leverage Strata in its multitrack format, you will need a version of REAPER installed.\\n\\nFor more information on REAPER, visit\\n<AK_REAPER_LINK>https://www.reaper.fm/</AK_REAPER_LINK>"}}},"with_reawwise":{"title":"Import from REAPER into Wwise easily with ReaWwise™","cards":{"reawwise":{"title":"ReaWwise","description":"ReaWwise is a REAPER extension created by Audiokinetic that streamlines the transfer of audio assets from REAPER into Wwise.The extension simplifies and automates the creation of complex Wwise hierarchies by leveraging REAPER’s render configuration matrix.\\n\\nDownload via <AK_REAPACK_LINK>ReaPack</AK_REAPACK_LINK> and speed up your workflow."}}},"what_you_get":{"title":"What’s included","cards":{"strata":{"title":"A three-year subscription to Strata","description":"As a subscriber, you have access to Strata’s complete <AK_STRATA_COLLECTIONS>sound collection</AK_STRATA_COLLECTIONS> and plug-ins, with exciting new collections added every month.  \\n\\nCurrently, Strata contains:\\n<AK_BULLET>{{AK_COLLECTION_COUNT}} collections</AK_BULLET>\\n<AK_BULLET>{{AK_SOUND_FX_COUNT}}+ sound FX</AK_BULLET>\\n<AK_BULLET>{{AK_SOURCE_ITEM_COUNT}}+ source items</AK_BULLET>\\n\\nCheck <AK_STRATA_RELEASE_SCHEDULE>Release Schedule</AK_STRATA_RELEASE_SCHEDULE> for upcoming collections."},"vst":{"title":"Wwise VST3 Plug-in Suite","description":"A collection of Wwise plug-ins, ported to the VST3 format.\\n\\nThe plug-ins have names that reflect their functions, and run the same code as the runtime versions used in Wwise, reliably and efficiently. Full documentation is available here: <AK_WWISE_EFFECT_PLUGINS>Wwise Effect Plug-ins</AK_WWISE_EFFECT_PLUGINS>\\n\\nThe plug-ins are free and licensed under the terms and conditions of a Wwise Project license. If you are using Wwise, you have a license even if the Wwise project is an evaluation license.\\n\\nThe plug-ins are used throughout Strata, so you will need to install them."},"enrage":{"title":"ENRAGE plug-in","description":"<AK_ENRAGE_VIDEO_LINK>ENRAGE</AK_ENRAGE_VIDEO_LINK> is a multi-modular FX processing plug-in designed by BOOM Library. It offers more than 50 devices divided into clear categories: In/Out, Delay, Distortion, Modulation, Generator, Pitch, Filter, Imaging, Reverb, Analyzer, Gain & Dynamics. There are ten modulation sources available: Curve, ADSR, Envelope Follower, LFO, Mapping, Delay, Transient Follower, Change Analyzer, Pitch Tracker, and Formula (for the math-heads).\\n\\nThis plug-in is extremely versatile and used extensively in the REAPER projects with all the presets the designers from BOOM created specifically for Strata.\\n\\nA license for ENRAGE is included with the subscription to Strata. The ENRAGE plug-in will require a free iLok account and installation of iLok management software, for authorization."},"iem":{"title":"IEM plug-in Suite","description":"A free and open-source audio plug-in suite including ambisonic plug-ins up to 7th order created by staff and students of the Institute of Electronic Music and Acoustics. Full details are available here:\\n<AK_IEM_LINK>https://plug-ins.iem.at/</AK_IEM_LINK>\\n\\nStrata uses the VST3 version of the IEM suite for all collections that use ambisonics. Currently the Ambience libraries are the only libraries that use ambisonics. The REAPER projects are set up to mix in 3rd order ACN, and output using the IEM Suite’s decoders to a range of formats including stereo, binaural to octophonic 3D, and 1st, 2nd and 3rd order ambisonics."}}},"faq":{"title":"Frequently Asked Questions","description":"","other-faq-links":{"licensing":"Licensing FAQ","community":"Community FAQ"},"content":{"q01":{"title":"What is Strata?","content":"Strata is a subscription service that provides access to a variety of sound collections in multitrack format. Developed by Audiokinetic, Strata is designed for use with REAPER."},"q02":{"title":"What is unique about Strata?","content":"Strata is delivered in multitrack format, organized in tracks, exposing all the clip edits and effect settings. Contrairily to other libraries, Strata is the only library that provides Sound Designers with total control over each component (clip edits, sources, effect settings, etc.) that makes up the rendered sounds."},"q03":{"title":"How are the collections organised?","content":"All collections consist of a main REAPER project to which multiple sub-projects are attached. Sub-projects are separated based on logical organization such as object types, locations, intentions, etc.\\n\\nFile names and metadata follows UCS (Universal Category System) for every source and rendered audio file."},"q04":{"title":"Can I use Strata with sound librarian software?","content":"Yes! All source and rendered audio files follow UCS (Universal Category System) naming, which makes it easy to find what you’re looking for using SFX search engines such as SoundMiner, Basehead, Soundly, and so on.\\n\\nOnce you find the sound you’re looking for in Strata, you can use the source as is or open the associated REAPER project when you need to tweak that sound."},"q05":{"title":"Does Strata work with Wwise?","content":"Strata is designed to enhance your creative flow overall, regardless of the software you use. The projects are configured to leverage REAPER’s comprehensive rendering capabilities, which makes the creation of content and variations a breeze.\\n\\nWwise users will see a great improvement in productivity with Strata in conjunction with <AK_REAPACK_LINK>ReaWwise</AK_REAPACK_LINK>. This REAPER extension is streamlined to easily create Wwise container hierarchies in a few clicks."},"q06":{"title":"How can I purchase Strata?","content":"Strata is a subscription service that grows on a monthly basis. Check our <AK_STRATA_PRICING_LINK>pricing</AK_STRATA_PRICING_LINK> and the most current library content."},"q07":{"title":"How frequently are new collections added?","content":"New Collections are added monthly and are published on the <AK_STRATA_RELEASE_SCHEDULE>Strata Release calendar</AK_STRATA_RELEASE_SCHEDULE>."},"q08":{"title":"How can I get support or more information?","content":"For problems with invoicing, subscription terms, or payments, please contact <AK_CONTACT_SALES_LINK>sales</AK_CONTACT_SALES_LINK>.\\n\\nFor other questions or if you encounter technical issues with Strata or its plug-ins, please visit our community <AK_STRATA_COMMUNITY_QNA>Q&A</AK_STRATA_COMMUNITY_QNA> section. If you don’t find an answer to your question there, please post a new question in the Q&A.  "}}},"community-review":{"title":"Community Review"}}`),AQ={"menu-label":"Wwise",bannerV2Title:"Wwise, the most advanced, feature-rich interactive audio solution.",bannerCallToAction:{primaryLabel:"$t(common:buttons.get-started)",secondaryLabel:"$t(common:buttons.versionFeatures)",tertiaryLabel:"$t(common:buttons.versionFeatures)"},"stand-alone-descriptions":{"description-a":[{text:"Powering interactive experiences and real-time performing technologies, Wwise features a complete suite of design and development tools, making it easy to prototype and bring to life your creative vision for audio, no matter the scale of your project."}],"description-b":"A variety of free integrated and premium <AK_LINK>plug-ins</AK_LINK>, as well as partner and community plug-ins, are available for use with Wwise to target the specific needs of your interactive projects."},"stand-alone-title":{"title-a":"Empowering the Audio Community"},benefits:{"enhance-creativity":{title:"Enhance Creativity",description:"Wwise integrates into your production pipeline and empowers your audio team to focus on being creative without limitations or dependencies. Author, simulate, integrate, mix and profile using one audio engine. "},"increase-efficiency":{title:"Increase Efficiency",description:"Wwise streamlines your interactive audio projects with its comprehensive interactive audio pipeline. Leverage creative control with fast concept prototyping and ship your best work on time."}}},zQ={"menu-label":"Integrations",bannerV2Title:"Integrations",bannerSubTagline:"",sections:{firstParty:{title:"Audiokinetic Developed & Maintained",description:"Wwise features an open API and integrates easily into in-house game engines and the world's top commercial game engines.",cardSource:{wwise:{title:"Wwise Authoring API",description:"The new <AK_BLACK>Wwise Authoring API</AK_BLACK> allows the comprehensive integration of Wwise into any engine, tool, or application. It is usable from any Internet-capable language, operating system, or environment."},unity:{title:"Wwise Unity Integration",description:"The <AK_BLACK>Wwise Unity Integration</AK_BLACK> is a Unity plug-in that allows the use of the Wwise Sound Engine in Unity games. The Integration consists of a Unity plug-in library, the Wwise SDK API bindings in C#, a few other helpful components and Editor windows."},unrealEngine:{title:"Wwise Unreal Integration",description:"The <AK_BLACK>Wwise Unreal Integration</AK_BLACK> is an Unreal Engine plug-in that enables you to use the Wwise Sound Engine in Unreal games. It leverages Unreal Engine Objects and Blueprints to expose Wwise features, is fully integrated with Unreal Engine's Level Sequencer, and provides occlusion support. <AK_LINK_1>Learn more</AK_LINK_1>"},reawwise:{title:"ReaWwise™",description:`<AK_BLACK>ReaWwise</AK_BLACK> is a REAPER extension created by Audiokinetic that facilitates the transfer of audio assets into Wwise projects. The extension allows for the creation of complex Wwise audio structures based on users' REAPER render configurations.
<AK_LINK_1>Download and try it out via ReaPack</AK_LINK_1>`}}},thirdParty:{title:"Third-party Distributed",description:"Wwise integrates easily into in-house game engines, the world's top commercial game engines, and any tool or application. Third-party integrations are developed and maintained by our partners.",cardSource:{cryEngine:{title:"CryEngine",description:"This integration is developed, maintained, and supported by <AK_LINK_1>Crytek</AK_LINK_1>. It is included with all CryEngine licenses and subscriptions."},nuendo:{title:"Nuendo",description:"This integration is developed and maintained by <AK_LINK_1>Steinberg</AK_LINK_1>. Enjoy a real-time and seamless connection between Nuendo 7 or its later versions and Wwise, via the <AK_LINK_2>Game Audio Connect feature</AK_LINK_2>. Steinberg Nuendo offers the utmost compatibility and flexibility, and the richest feature set for sound creation, composing, dialog recording, mixing, and middleware interaction."},O3DE:{title:"O3DE",description:"This integration is developed, maintained, and supported by the <AK_LINK_1>Linux Foundation</AK_LINK_1>. Open 3D Engine (O3DE) is an Apache 2.0-licensed multi-platform 3D engine that enables developers and content creators to build AAA games, cinema-quality 3D worlds, and high-fidelity simulations without any fees or commercial obligations."},speechless:{title:"Speechless",description:"This voice-over asset management integration is developed and maintained by <AK_LINK_1>Speechless.games</AK_LINK_1>. Speechless, handles scripts, text-to-speech, recorded audio, and localization, offering a streamlined solution that seamlessly integrates with Wwise. Additionally, Speechless includes a unique casting tool and a database of professional voice actors recording directly into the platform."}}},community:{title:"Community Managed",description:"Community integrations are developed and maintained by the community. If you are interested in learning more about game engine integrations, check out the <AK_LINK_1>Wwise SDK</AK_LINK_1>. If you are interested in creating your own integrations, check out the new <AK_LINK_2>Wwise Authoring API</AK_LINK_2>, which allows the comprehensive integration of Wwise into any engine, tool, or application.",cardSource:{baseHead:{title:"basehead 5.1 integration by BaseHead, LLC",description:"This Wwise integration allows sending audio objects and parameters back and forth between Wwise and basehead. basehead also offers a native support for Strata which allows it to open the associated REAPER projects from any Strata rendered audio file found in basehead."},cocos2DX:{title:"COCOS2DX integration by Kakyoism",description:"This integration demo application contains a series of demonstrations on how to integrate various Wwise features into your game."},gameMaker:{title:"GameMaker Studio integration by Caklassen",description:"A Wwise plug-in for GameMaker Studio. GameMaker Studio is a game creation system."},godot:{title:"Godot",description:"Developed and maintained by Alessandro Fama, this <AK_LINK_1>GDExtension</AK_LINK_1> library integrates Wwise into the Godot engine for Windows, macOS, Linux, Android, iOS, and Web (experimental)."},reaper:{title:"REAPER integration by Karl Davis",description:"REAPER extension for quickly importing rendered audio files into Wwise."},reaOpen:{title:"ReaOpen REAPER integration by Nikola Lukić and Jeremy Rogers",description:"A free lightweight program that allows you to select an audio file and open its original REAPER project with ease. "},soundMiner:{title:"Soundminer integration by Justin Drury",description:"Soundminer is an audio management tool that helps users quickly find assets and manipulate them."},WAAPI_BR:{title:"WAAPI Integrations by Bernard Rodrigue",description:"WAAPI sample projects by Bernard Rodrigue, such as Jsfxr for Wwise, WAAPI Text-to-Speech, and WAAPI Import by Name, were built to demonstrate a few of the many features of WAAPI. Bernard discussed these samples in his talk at the Austin Game Conference in 2017 and in his blog, <AK_LINK_1>Three Open Source Projects for the Wwise Authoring API</AK_LINK_1>."}}}}},bQ={"menu-label":"Products",plugins:{"menu-label":"Plug-ins"},"getting-started":{title:"How to get started?",description:"Register your project for a free evaluation. No strings attached!",step_1:{title:"Create Account",description:"Create an account to manage everything related to your projects including licenses, learning material, and more."},step_2:{title:"Download",description:"Download the $t(doNotTranslate:audiokinetic-launcher) to install Wwise. You will be able to use the $t(doNotTranslate:audiokinetic-launcher) to manage your projects and License Keys, install plug-ins, install new patch releases to update your Wwise version, and more!"},step_3:{title:"Register Project",description:"Register your project to start your Wwise evaluation with no sound limitations and access to evaluating premium plug-ins."}},products:{"wwise-feature-cards":{authoring:{title:"Authoring",description:"Wwise offers endless possibilities, giving you the ultimate in artistic freedom. Programming concerns and performance considerations are removed from the design process, while multi-platform development is simplified."},"dynamic-mixing":{title:"Dynamic Mixing",description:"Wwise offers various dynamic mixing techniques, letting you manage sound priority based on changing conditions while ensuring processing constraints are respected and processing power is put to best use."},"spatial-audio":{title:"Spatial Audio",description:"Wwise Spatial Audio specializes in sound propagation, virtual acoustics, and spatially informed audio rendering, making it easy to create highly-immersive audio environments with an unparalleled sense of your virtual surroundings. As a continuing field of research at Audiokinetic, many new spatial audio features, plug-ins, and partnerships can be expected in the coming years."},"interactive-music":{title:"Interactive Music",description:"Wwise gives composers the freedom to create award-winning adaptive musical scores. With Wwise, musical cues respond to rule-based transitions, ensuring the best possible segment plays at any given moment."},"sound-design":{title:"Runtime Processing and Synthesis",description:"Wwise features an array of built-in sound synthesizers, giving sound designers the power to generate infinite variety with little impact on resources."}}},integrations:{"menu-label":"Integrations",title:"Integrations",description:"Wwise features an open API and integrates easily into any technology including embedded systems."},platforms:{title:"Platforms",description:"Wwise is a cross-platform solution."},"wwise-integration":{"menu-label":"Wwise Integrations"},"wwise-wow":{community:{title:"Community",description:"The Audiokinetic community is the largest and fastest-growing interactive audio community. Creators and developers from around the world engage, collaborate, and share ideas through community events and various dedicated channels such as the Audiokinetic Blog, and the Community Q&A."},documentation:{title:"Documentation",description:"Robust documentation and sample projects make it easy to get started with Wwise, learn how to use features and about audio workflows. "},education:{title:"Education",description:"We offer Team Training customized to your needs. Our free online learning material is also available and includes detailed coursework and sample projects."},performance:{title:"Performance",description:"Wwise takes the guesswork out of troubleshooting. Visualize the path of audio signals or objects, identify any performance issues before they happen, and resolve them easily using powerful profiling tools."},stability:{title:"Stability",description:"Reduce technical risk by using Wwise, the most reliable solution and proven gold standard for interactive audio. "},support:{title:"Support",description:"Our technical support offers you peace of mind. Select a support plan for your Wwise project, or opt for a Pay2Go ticket whenever you need help. Our team aims to resolve issues quickly so that your team remains as efficient and creative as ever."}},"supported-platforms":{"menu-label":"$t(common:labels.supported-platforms)"},"creative-services":{"menu-label":"Creative Services"},"wwise-spatial-audio":{"menu-label":"Spatial Audio"}},wQ={strata:LQ,wwise:AQ,integrations:zQ,"wwise-spatial-audio":{bannerV2Title:"Wwise Spatial Audio",bannerV2Description:"Create realistic or out of this world dynamic immersive experiences!",blocks:{family:{title:"Wwise Spatial Audio",description:"<AK_BOLD>Wwise Spatial Audio</AK_BOLD> is a family of built-in spatial audio features complemented by in-house and 3rd party plug-ins that seamlessly integrate with the Wwise production workflow. Wwise Spatial Audio specializes in sound propagation, virtual acoustics, and spatially informed audio rendering. As a continuing research field at Audiokinetic, many new spatial audio features, plug-ins, and partnerships can be expected in the coming years."},geometry:{title:"Geometry",description:"The Wwise Spatial Audio Geometry API uses emitter and listener positions, and the raw triangles of your game's (typically simplified) geometry in order to compute image sources for simulating dynamic early reflections, in conjunction with the Wwise Reflect plug-in. Sound designers control translation of image source positions into early reflections directly in Wwise Reflect, through tweaking of properties based on distance and materials."},roomsAndPortal:{title:"Rooms and Portal",description:"The Wwise Spatial Audio module exposes a simple, high-level geometry abstraction called Rooms and Portals, which allows it to efficiently model sound propagation of emitters located in other rooms. The main features of room-driven sound propagation are diffraction, coupling, and spatialization of reverbs. It does so by leveraging the tools at the disposal of the sound designer in Wwise, leaving them full control of the resulting transformations to audio. Furthermore, it allows you to restrict game engine-driven raycast-based obstruction, which is highly game engine-specific, and typically costly in terms of performance, to emitters that are in the same room as the listener."},wwiseCore:{title:"Wwise CORE",description:"",cards:{busses:"<AK_BOLD>3D busses</AK_BOLD> provide developers with the building blocks for a performant sound propagation solution by submixing groups of sounds and/or reverb anywhere in the signal flow, and positioning these submixes in the 3D world. This makes them a key component in implementing spatial audio effects, such as dynamic room portals and oriented reverb.",ambisonics:"<AK_BOLD>Ambisonics</AK_BOLD> is fully supported in the Wwise voice pipeline, which makes it easy to import ambisonic files, submix other channel configurations to the ambisonics format, and ultimately have an ambisonic output that can be played natively on any of an increasing number of platforms supporting ambisonics. A cross platform audio delivery solution, this surround sound format produces a regular spherical representation of the sound field surrounding the listener and is speaker configuration and binaural filter agnostic.",acoustics:"<AK_BOLD>Acoustic textures</AK_BOLD>, used in combination with the Wwise Reflect plug-in, help reflective surfaces imitate the natural sound of different materials, such as wood, concrete, and drywall. Parameters to define a surface's roughness and the amount of dampening within certain frequencies ensure the right sound can be found for any material."}},wwisePlugIns:{title:"Wwise Plug-ins",description:"Audiokinetic has developed a series of premium plug-ins that target the specific needs of interactive sound design and enhance the Wwise experience.",cards:{convolution:"<AK_BOLD>Wwise Convolution</AK_BOLD> lets you create convincing reverberation based on samples of real acoustic spaces, from the smallest room to the largest cathedral. You can use the impulse responses provided by Audiokinetic and AudioEase. Or import your own in any channel configuration, including ambisonics.",reflect:"<AK_BOLD>Wwise Reflect</AK_BOLD> is a geometry-informed plug-in that dynamically renders early reflections based on the proximity of the listener/emitter to reflective surfaces, such as walls, ceilings, and floors. Wwise Reflect not only enhances immersion and the sense of space, but also brings out variety and naturalness from limited audio assets by blending them with a dynamic environment. Wwise Reflect offers full customization, catering to the artistic needs of sound designers and today’s interactive media narrative and storytelling demands."}},integrations:{title:"Integrations",description:"Wwise Spatial Audio integrates easily into in-house game engines and the world's top commercial game engines. The Wwise Unreal plug-in and the Wwise Unity plug-in allow the integration of spatial audio components in a game via features such as Rooms and Portals, 3D positioned Sound SFX, and acoustic textures, alongside the Reflect plug-in via the Wwise Authoring Tool.",cards:{unreal:"<AK_BOLD>Unreal 5</AK_BOLD> <AK_LINK_LEARN_MORE_UNREAL>Learn more</AK_LINK_LEARN_MORE_UNREAL> about using Wwise Spatial Audio in Unreal 5",unity:"<AK_BOLD>Unity</AK_BOLD> <AK_LINK_LEARN_MORE_UNITY>Learn more</AK_LINK_LEARN_MORE_UNITY> about using Wwise Spatial Audio in Unity"}},wwiseAudioLab:{title:"Wwise Audio Lab",description:"Prototype ideas, evaluate different approaches, and polish the results in a controlled virtual environment.",cards:{wal:"Wwise Audio Lab (WAL) is an open-source game-like 3D environment developed with Unreal Engine 4, which runs on Mac, Windows, Oculus, and HTC Vive. It showcases various spatial audio methods and technologies, such as geometry-informed dynamic early reflections, acoustic portals, oriented reverb, and more. Information nodes distributed in the maps help identify sound propagation phenomena, and in-game options allow for instant A-B comparisons between various spatial audio approaches. Although the WAL is designed for experimenting with spatial audio features, the project is fully customizable for users interested in finding the perfect combination of tools and methods for their future projects."},ctas:{getWal:"Get Wwise Audio Lab"}}}},module:bQ},yQ={"menu-label":"Profile",title:"User Profile"},EQ={preview:{buttons:{exit:"Exit public view",preview:"Preview your public Profile"},previewDescription:"This content is how your profile looks in Public View."},visibilityManager:{title:"Profile Visibility",description:"You control your profile's appearance for other people on the Audiokinetic website. It affects how your profile appears on both the Creators Directory and search result.",mainToggle:"Make my Profile public",profile:"Profile",details:"Profile Details",about:"About",experiences:"Experience",education:"Education",wwise_certifications:"Certifications",portfolio:"Portfolio",projects:"Wwise Projects",publications:"Publications",languages:"Languages"}},HQ={title:"Avatar image","img-alt":"Loaded avatar image",loadedAvatarImage:"User's avatar image",upload:{imageOriginal:"Original image",imagePreview:"Avatar preview",imageActual:"Actual size",imageZoomed:"3 x",imageToCrop:"Image to crop",instruction:"Please upload an image file to start",dragNDrop:"Choose a file or <strong>drag it here</strong>",uploadErrorFileSize:"File size exceeds limit. Please select a file less than {{AK_VAR_FILE_SIZE_LIMIT}}",uploadErrorFileType:"File type not supported. Please select a valid file type ( {{AK_VAR_FILE_TYPE}} )",button:"Upload your avatar image"},formLabels:{avatar:{label:"Avatar",placeHolder:""}}},TQ={title:"User Information","no-content":"Please start by entering your first and last name. Click <AK_ADD_LINK>here</AK_ADD_LINK> to start",formLabels:{firstName:{label:"First name",placeHolder:"Type in your first name (required)"},lastName:{label:"Last n