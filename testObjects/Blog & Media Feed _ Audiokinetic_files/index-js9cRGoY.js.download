facebook.com/Audiokinetic/",ECt="https://twitter.com/audiokinetic",HCt={FACEBOOK:yCt,TWITTER:ECt},TCt={HOME:{}},SCt={OVERVIEW:{}},VCt={HOME:TCt,WWISE:SCt},CCt={"menu-label":"도움 및 지원",bannerTagline:"고객님의 프로젝트는 저희에게 중요합니다. 언제든지 도와드릴 준비가 되어 있습니다.",bannerCallToAction:{primaryLabel:"지원 티켓 보내기",secondaryLabel:"커뮤니티에게 질문하기"},bannerCallToActionMobile:{primaryLabel:"지원 티켓 보내기"}},BCt={"menu-label":"도움 및 지원",bannerV2Title:"고객님의 프로젝트는 저희에게 중요합니다. 언제든지 도와드릴 준비가 되어 있습니다.",bannerCallToAction:{primaryLabel:"지원 티켓 보내기",secondaryLabel:"커뮤니티에게 질문하기"},bannerCallToActionMobile:{primaryLabel:"지원 티켓 보내기"}},ICt={"menu-label":"도움 및 지원",help:{"menu-label":"도움 및 지원",bannerV2Title:"무엇을 도와드릴까요?",documentation:{wwise_help:{title:"Wwise",description:"Wwise 도움말, SDK, Unreal/Unity 통합, Wwise 핵심 개념 등 모든 Wwise 관련 문서를 확인해 보세요.",ctaPrimary:"문서"},ak_launcher:{title:"$t(doNotTranslate:audiokinetic-launcher-kr)",description:"Wwise 설치 및 플러그인 추가부터 Unreal이나 Unity 프로젝트의 Wwise 통합과 Strata 컬렉션 다운로드까지, 런처로 할 수 있는 작업에 대해 알아보세요.",ctaPrimary:"문서"},strata_library:{title:"Strata",description:"주요 사용 안내 및 컬렉션별 안내를 포함한 모든 Strata 관련 문서를 확인해 보세요.",ctaPrimary:"문서"},support:{title:"지원",description:"Wwise 지원 약관과 기술적 지원 플랜에 대한 자세한 설명을 확인하거나, 지원 티켓을 제출하세요.",ctaPrimary:"$t(common:buttons.learn-more)"},creative_services:{title:"크리에이티브 서비스",description:"Audiokinetic과 함께 여러분의 오디오 프로젝트와 Wwise를 한차원 높일 수 있습니다.",ctaPrimary:"$t(common:buttons.learn-more)"},request_feature:{title:"기능 요청하기",description:"Wwise의 기능에 대해 제안하고 싶으신 점이 있으신가요? 향후 버전에서 있었으면 하는 것들을 알려주세요. 혹은 커뮤니티 Q&A에서 다른 사용자가 낸 아이디어에 투표해 주세요.",ctaPrimary:"기능 요청하기"},report_bug:{title:"버그 보고하기",description:"저희는 보고되는 버그와 문제를 해결하기 위한 평가 옵션을 모두 확인합니다. 하지만 모든 버그 보고에 답장을 드리지는 않습니다.",ctaPrimary:"사용 방법 알아보기"},community_qa:{title:"커뮤니티 Q&A",description:"Audiokinetic 커뮤니티에서 도움을 받아보세요! 전 세계 Wwise와 Strata 사용자들과 묻고 답하며 전문지식을 공유할 수 있습니다.",ctaPrimary:"커뮤니티 Q&A"}}},support:{"menu-label":"지원","wwise-support-policy":{title:"Wwise 지원 방침",description:"사용 중인 Wwise 버전의 최신 패치 릴리즈를 사용하고 계신지 확인해 주세요.",version:"Wwise 버전",supportPeriod:"지원 기간",active:{barLabel:"활성",title:"활성",titleClassName:"support-policy-active",description:"Audiokinetic은 공개 코드와 패치 릴리즈를 통해 가장 최신 및 바로 이전의 Wwise 메이저 버전을 완전히 지원합니다."},private:{barLabel:"개인",title:"개인",titleClassName:"support-policy-private",description:"Audiokinetic 기술 지원은 새로운 Wwise 버전이 해결할 수 있는 경우를 제외하고는 가장 최신 버전에서부터 세 번째까지의 버전을 지원합니다. 크리에이티브 서비스 약관을 사용하면 사적 코드 패치를 통해 이 지원을 연장할 수 있습니다."},"end-of-life":{barLabel:"지원 종료",title:"지원 종료",titleClassName:"support-policy-end-of-life",description:"오래된 버전의 Wwise는 최선을 다해 지원해드리지만 모든 이슈가 반드시 해결된다는 보장은 없습니다."}},"technical-support":{title:"기술 지원","support-tier":{pay_2_go:{title:"Pay2Go",description:`온라인에서 사전 구매할 수 있는 단일 지원 티켓입니다.
작업을 더 이상 진행할 수 없을 정도의 심각한 문제인 경우 <AK_BLACK>영업일 기준 2일</AK_BLACK> 내에 초기 대응을 받아보실 수 있습니다.<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>티켓</AK_IRON>",ctaPrimary:"Pay2Go 구매하기"},standard:{title:"일반",description:`Wwise 라이선스와 함께 구매되는 지원 플랜.
작업을 더 이상 진행할 수 없을 정도의 심각한 문제인 경우 <AK_BLACK>영업일 기준 2일</AK_BLACK> 내에 초기 대응을 받아보실 수 있습니다.<AK_RED>*</AK_RED>`,periodOfTickets:"<AK_IRON>티켓</AK_IRON> / 1년",ctaPrimary:"문의하기"},unlimited:{title:"무제한",description:`Wwise 라이선스와 함께 구매되는 지원 플랜.
작업을 더 이상 진행할 수 없을 정도의 심각한 문제인 경우 <AK_BLACK>영업일 기준 2일</AK_BLACK> 내에 초기 대응을 받아보실 수 있습니다.<AK_RED>*</AK_RED>
프리미엄 Wwise 라이선스에는 1년간 무제한 지원이 포함되어 있습니다. 
플래티넘 Wwise 라이선스에는 개발 도중 및 출시 후 6개월 간 무제한 지원이 포함되어 있습니다. 
`,periodOfTickets:"",ctaPrimary:"문의하기"}},"support-queue-fine-print-1":"티켓당 한 가지 주제만 작성해 주세요.","support-queue-fine-print-2":"지원 대기 순서는 접수된 순서와 심각도를 기준으로 합니다. <AK_DEEMPHASIZED>(영업 시간: 몬트리올 -5 GMT, 베이징 +8 GMT. 도쿄 +9 GMT)</AK_DEEMPHASIZED>","business-hours":"Audiokinetic 고객 지원 업무 시간: 월요일~금요일 오전 9시~오후 5시 (미 동부 표준시)  공휴일에는 지원 업무가 이뤄지지 않음을 알려드립니다. ",holidays:{title:"Audiokinetic 휴무일 일정","date-label":"날짜","holiday-name":"휴무일","holiday-line-date":{single:"{{mon}} / {{dateFrom}}",multiple:"{{mon}} / {{dateFrom}}-{{dateTo}}"}}},"need-help":{title:"찾고 계신 것을 아직 찾지 못하셨나요?",subText:"",ctaPrimary:"$t(common:buttons.get-in-touch-bang)"},requests:{requestType:{feature_request:{title:"기능 요청하기",description:"Wwise의 기능에 대해 제안하고 싶으신 점이 있으신가요? 향후 버전에서 있었으면 하는 것들을 알려주세요. 혹은 커뮤니티 Q&A에서 다른 사용자가 낸 아이디어에 투표해 주세요.",ctaPrimary:"기능 요청하기"},report_a_bug:{title:"버그 보고하기",description:"저희는 보고되는 버그와 문제를 해결하기 위한 평가 옵션을 모두 확인합니다. 하지만 모든 버그 보고에 답장을 드리지는 않습니다.",ctaPrimary:"버그 보고하기"}}},"useful-resources":{title:"유용한 관련 자료",subTitle:"저희가 도와드리겠습니다!",integrations:{title:"통합(integration)",resources:[{label:"Unity 통합"},{label:"Unreal 통합"},{label:"WAAPI"}]},documentation:{title:"문서",resources:[{label:"$t(doNotTranslate:audiokinetic-launcher-kr)"},{label:"Wwise 도움말"},{label:"Wwise SDK "}]},samples:{title:"샘플",resources:[{label:"$t(doNotTranslate:wwise-adventure-game)"},{label:"Wwise Audio Lab (와이즈 오디오 랩)"},{label:"Wwise Authoring API(와이즈 저작 API) 팩"}]},education:{title:"학습",resources:[{label:"학습 자료"},{label:"Wwise 자격증"}]}},"wwise-help":{"stand-alone-description":"Wwise <AK_BLACK>커뮤니티 Q&A</AK_BLACK>에서 도움을 받아보세요! 전 세계 Wwise 사용자들과 함께 서로 물음에 답하며 전문지식을 공유하실 수 있습니다."}},"creative-services":{"menu-label":"크리에이티브 서비스",title:"크리에이티브 서비스",description:"저희가 보유한 전문 기술을 여러분의 오디오 프로젝트에서 특정한 필요에 따라 활용하실 수 있는 좋은 방법입니다.",perks:[{name:"맞춤 개발"},{name:"작업 흐름 개선"},{name:"프로젝트 평가"},{name:"통합 과정 지원"}],ctaPrimary:"$t(common:buttons.learn-more)"},documentation:{"menu-label":"문서"},"questions-answers":{"menu-label":"Q&A"},"submit-support-ticket":{"menu-label":"$t(common:buttons.submit-support-ticket)"},"request-feature":{"menu-label":"기능 요청하기"},"report-bug":{"menu-label":"버그 보고"}},OCt={help:CCt,support:BCt,module:ICt},NCt={"menu-label":"$t(doNotTranslate:audiokinetic)",bannerV2Title:"사운드로 새로운 세상을 깨우는 곳",bannerV2SubTitle:"상호작용 오디오 기술의 글로벌 리더",bannerCallToAction:{primaryLabel:"$t(common:audiokineticLauncher.download)",secondaryLabel:"$t(common:buttons.learn-more)"},bannerCallToActionMobile:{primaryLabel:"$t(common:buttons.learn-more)"}},xCt={"menu-label":"$t(doNotTranslate:audiokinetic)",integrations:{title:"통합(integration)",description:"Audiokinetic 솔루션은 내장 시스템을 포함한 모든 기술로 쉽게 통합할 수 있습니다."},platforms:{title:"플랫폼",description:"Audiokinetic은 크로스 플랫폼 오디오 솔루션을 제공합니다."}},KCt={title:"통합(integration)",description:"Audiokinetic 솔루션은 내장 시스템을 포함한 모든 기술로 쉽게 통합할 수 있습니다."},RCt={title:"플랫폼",description:"Audiokinetic은 크로스 플랫폼 오디오 솔루션을 제공합니다."},PCt={title:"AK 블로그","interaction-bubble":"<AK_LINK>AK 블로그를 구독</AK_LINK>해서 커뮤니티로부터 최신 업계 업데이트, Wwise 팁, 상호작용 오디오 이야기를 들어보세요!"},UCt={home:NCt,module:xCt,"home-cards":{"card-a":{title:"미래를 이끌어나가는 몰입형 음향 기술",description:"Audiokinetic은 확장 가능한 최첨단 크로스 플랫폼 상호작용 오디오 솔루션을 제공하는 글로벌 선두주자입니다. 세계 최대 규모의 개발자, OEM, 오디오 제작 회사가 신뢰하는 기술 파트너인 Audiokinetic의 주력 제품인 <AK_WWISE_PRODUCT_PAGE>Wwise</AK_WWISE_PRODUCT_PAGE>는 상호작용 오디오 엔진 시장에 가장 적합한 기준이 되고 있으며, <AK_STRATA_PRODUCT_PAGE>Strata</AK_STRATA_PRODUCT_PAGE>는 바로 편집할 수 있게 준비된 세계 최초의 멀티트랙 사운드 라이브러리입니다."},"card-b":{title:"음향인에게 힘을",description:"몰입형 음향의 역할과 가치를 중심으로 전 세계 산업을 변화시키고 구동점이 되고 있는 Audiokinetic은 가장 크고 빠르게 성장하는 상호 작용 오디오 제작자 커뮤니티에게 힘을 실어줍니다. Audiokinetic은 창의적인 자유를 제공하고 리더십 사고를 지원하며 협업에 영감을 줍니다."},"card-c":{title:"차세대 오디오 제작자와 교육인 육성",description:"세계 곳곳의 400여개 대학과 교육 기관의 교육 파트너인 Audiokinetic은 상호작용 오디오를 가르치는 교육 과정의 발전에 기여합니다. Audiokinetic의 교육 프로그램은 체계적인 상호작용 오디오 자격증과 상호작용 오디오 교육인을 위한 자격증뿐만 아니라 스튜디오와 개발자들에게 팀 연수를 제공합니다."}},integrations:KCt,platforms:RCt,blog:PCt,"related-videos":{title:"동영상 채널","dynamic-interaction-bubble":{YOUTUBE:"<AK_LINK>Audiokinetic의 YouTube 채널을 구독</AK_LINK>해서 지식과 영감을 얻어보세요.",BILIBILI:"<AK_LINK>Audiokinetic의 빌리빌리 채널을 구독</AK_LINK>해서 지식과 영감을 얻어보세요."}}},DCt={"page-title":"Audiokinetic Trademarks","page-info":"<AK_BIG_AND_BLACK>List of Trademarks </AK_BIG_AND_BLACK>","page-description":`<AK_ITALIC>Last Updated {{last_update_date}}</AK_ITALIC>

The following is a non-exhaustive list of Audiokinetic’s trademarks.

The absence of a trademark from this list does not constitute a waiver of Audiokinetic’s trademark or other intellectual property rights concerning that name.
`,"guidelines-title":"<AK_BIG_AND_BLACK>Trademark Guidelines<AK_BIG_AND_BLACK>","other-trademarks":"<AK_BIG_AND_BLACK>Other Trademarks<AK_BIG_AND_BLACK>","guidelines-description":`You may use the Audiokinetic trademarks if such use constitutes a truthful and accurate reference to Audiokinetic products or services for the purpose of, explanation, information, or as an indicator of compatibility.

If you are a licensee of an Audiokinetic trademark or logo and have been provided with special trademark usage guidelines with your license agreement, please follow those guidelines. If your license agreement does not provide usage guidelines, then follow these guidelines.

When using the marks in publications that will be distributed only in the United States, include the appropriate ™, ℠, or ® symbol on first use. For publications that will be distributed outside the United States, do not include trademark symbols. Instead use the appropriate trademark attribution notice, for example: Wwise is a trademark of Audiokinetic Inc., registered in the U.S. and other countries. Any use of the Audiokinetic trademarks or logos must be accompanied by a notice that clearly indicates that the Audiokinetic trademarks or logos are trademarks of Audiokinetic Inc.

Audiokinetic reserves the right in its sole discretion to terminate or modify your permission to display the Audiokinetic trademarks and to take action against any use that does not conform to these guidelines, infringes any Audiokinetic intellectual property or other right, or violates applicable law.  All Audiokinetic trademarks are provided “as is”, and Audiokinetic disclaims any implied or express warranties regarding the same, including warranties of non-infringement.

Please refer to our specific guidelines for <AK_LINK_IN_GAME_CREDITS>In-game Credits</AK_LINK_IN_GAME_CREDITS> and other credits.`},kCt={trademarks:DCt,"legal-notice":{title:"",description:"<AK_NOTICE_LINK>Legal notice</AK_NOTICE_LINK>  Copyright © {{AK_VAR_CURRENT_YEAR}} Audiokinetic Inc. and Conservatory of Recording Arts & Sciences. All rights reserved."}},WCt={"menu-label":"라이선스 & 구독",title:"라이선스 & 구독",strata:{tabLabel:"Strata","no-subscriptions":{title:"라이선스를 찾을 수 없습니다.",description:"이 계정에 라이선스를 추가하려면 <AK_LINK_TO_STRATA_STORE>스토어</AK_LINK_TO_STRATA_STORE>를 방문해 주세요."},subscriptions:{title:"구독",productName:"제품",owner:"소유자",status:"상태",expiration:"만료",nextPayment:{nextPaymentLabel:"다음 청구일은 <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>입니다.",nextGuaranteedPaymentLabel:"<AK_BOLD>{{nextPaymentAmount}}</AK_BOLD>의 다음 지불은 <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>에 처리됩니다.",guaranteedPriceLabel:"할인된 가격은 <AK_BOLD>{{guaranteedPriceUntil}}</AK_BOLD>에 재평가됩니다."},installment:{date:"분납일",amount:"금액",status:"상태","no-installments-personal":"예정된 결제 내역이 없습니다.","no-installments-project":"예정된 결제 내역이 없습니다.","no-installments-enterprise":"소유자 전용 섹션"},subscriptionCancellation:{title:"구독 취소",confirm:"정말로 '{{AK_VAR_SUBSCRIPTION_NAME}}' 구독을 취소하시겠습니까?",fee:"<AK_BOLD>취소 수수료: {{AK_VAR_CANCELLATION_FEE}}</AK_BOLD><br /><AK_BOLD>결제 수단: 기본 카드 ({{AK_VAR_DEFAULT_CARD}})</AK_BOLD>","fee-description":"조기 해지 시 <AK_LINK_TO_DOCUMENTS>구독 약관</AK_LINK_TO_DOCUMENTS>에 따라 <br /><AK_RED>수수료가 부과됩니다</AK_RED>.","successful-cancellation":"{{AK_VAR_SUBSCRIPTION_NAME}} 구독이 성공적으로 취소되었습니다."}},"asset-download":{title:"Strata 컬렉션",description:"컬렉션은 $t(doNotTranslate:audiokinetic-launcher-kr)에서 직접 다운로드할 수 있습니다.",ctas:{primary:"$t(audiokineticLauncher.open)",secondary:"$t(audiokineticLauncher.download)"}},downloads:{title:"다운로드",plugins:"플러그인",version:"버전",installer_links:"설치 관리자"},"license-agreements":{title:"라이선스 계약서","i-agree-bullet-link":"<AK_BULLET>{{AK_FILE_NAME}}</AK_BULLET>","accept-and-sign":"모든 라이선스 계약서에 동의"},licenses:{title:"라이선스",type:"유형",licenseKey:"활성화 키",status:"상태",productName:"관련 제품",licenseKeyCopied:"라이선스 키가 복사되었습니다."},"need-help":{title:"도움이 필요하신가요?",description:"구독에 대해 궁금한 것이 있으시다면 저희에게 문의해 주세요.",ctas:{primary:"Audiokinetic 담당자에게 문의"}}},wwise:{tabLabel:"Wwise",licenses:{title:"",type:"",status:"","relates-to-name":"","relates-to-id":"",licenseKey:"",expirationDate:""}}},$Ct={module:WCt},qCt={bannerV2Title:"Audiokinetic 제품의 라이선스 - 자주 묻는 질문",bannerSubTagline:"","faq-dropdown-selector":"어떤 라이선스에 관심이 있으신가요? ",faq:{strataLicenses:{tabLabel:"Strata 라이선스",content:{q01:{title:"모든 Strata 컬렉션에 접근할 수 있나요?",content:"네. 유료 구독 서비스 중 하나를 이용하는 동안에는 모든 Strata 컬렉션에 접근할 수 있습니다. 무료 구독 서비스에서는 Sample 컬렉션만 이용할 수 있습니다."},q02:{title:"Strata 사용 비용은 얼마인가요?",content:"<AK_STRATA_PRICING_LINK>가격</AK_STRATA_PRICING_LINK> 페이지를 참고해 주세요."},q03:{title:"제 구독 기간 동안 구독 비용이 변할 수 있나요?",content:"아니요. 구독을 확정한 시점의 가격이 구독 전체 기간 동안 적용됩니다."},q04:{title:"언제 지불해야 하나요?",content:"Strata는 연부 분납으로 지불하실 수 있습니다."},q05:{title:"구독 기간은 얼마인가요? ",content:"Strata는 개인 및 기업 구독 모두에 대해 1~3년 기간으로 특정 요구에 맞춤화된 다양한 플랜을 제공합니다. 학생과 교사도 1년의 교육용 플랜 혜택을 누릴 수 있습니다. 자세한 내용은 <AK_STRATA_PRICING_LINK>가격</AK_STRATA_PRICING_LINK> 페이지를 확인하세요."},q06:{title:"신용 카드 정보 업데이트하는 것을 잊어서 결제에 실패하면 어떻게 되나요?",content:"결제되지 않았음을 알리는 메시지를 받게 되며 30일 내에 결제 정보를 업데이트해야 구독을 유지하실 수 있습니다. 30일 이내에 결제를 처리하지 못할 경우 대체 결제 방법에 대해 연락드리겠습니다."},q07:{title:"구독을 구매하기 전에 Strata를 사용해볼 수 있나요?",content:"네. 저희는 <AK_FREE_SUBSCRIPTION_LINK>무료 구독</AK_FREE_SUBSCRIPTION_LINK>을 통해 다양한 Strata 컬렉션 예시가 담긴 샘플 프로젝트를 제공합니다."},q08:{title:"Strata의 이용 약관은 어디에서 확인할 수 있나요?",content:"<AK_STRATA_LICENCING_AGREEMENT>Strata 라이선스 계약서</AK_STRATA_LICENCING_AGREEMENT>와 <AK_STRATA_SUBSCRIPTION_AGREEMENT>구독 계약서</AK_STRATA_SUBSCRIPTION_AGREEMENT>를 방문해 주세요."},q09:{title:"구독을 취소할 수 있나요?",content:"Strata는 다양한 구독 모델을 제공하며 <AK_STRATA_PRICING_LINK>여기</AK_STRATA_PRICING_LINK>에서 자세한 내용을 확인할 수 있습니다. 구독 기간은 합의된 조건에 따라 갱신됩니다. 현지 소비자 법률에 따라 모든 지불은 환불되지 않으며 남아 있는 미지불 부분을 지불해야 합니다. 구독은 현재 지불된 기간이 끝날 때까지 지속됩니다."},q10:{title:"구독 기간이 끝나면 어떻게 되나요?",content:"해당 플랜과 관련된 업데이트된 가격 정보와 함께 구독 만료에 대한 알림이 전송됩니다. 새로운 구독 기간을 선택할 수 있는 기회가 주어지게 됩니다."},q11:{title:"제 팀에 있는 여러 명이 구독을 하려고 합니다. 회사가 구독 관리를 중앙화시켜주는 프로그램이 있나요?",content:"네. 저희는 회사가 팀 구성원에 대한 좌석별 라이선스 배정 권한을 쉽게 관리할 수 있게 기업 구독을 제공해드리고 있습니다. "},q12:{title:"기업 구독은 무엇인가요?",content:`기업 구독은 회사가 여러 사용자를 쉽게 관리할 수 있게 해줍니다.

기업 구독에 대한 더 자세한 내용은 Audiokinetic 담당자에게 문의해 주세요.`},q13:{title:"초기 구독 기간 동안 새로운 구성원이 접근해야 하거나 몇몇 구성원이 팀을 떠나면 어떻게 되나요?",content:`기업 좌석 개수는 언제든지 늘릴 수 있습니다.

전체 사용자가 구매한 좌석의 개수를 초과하지만 않으면 Stata에 접근할 수 있는 사용자를 여러분이 변경할 수 있습니다.

기업 구독을 변경하려면 Audiokinetic 담당자에게 문의해주세요.`},q14:{title:"다운로드한 사운드로 어떤 작업이 허용되나요?",content:`유효한 Strata 구독 기간 동안에는 다음과 같은 작업이 허용됩니다.
    1) 사운드 편집
    2) 사운드 렌더링
    3) SFX 라이브러리에 사운드 추가
    4) 작업 중인 작품에 동기화`},q15:{title:"사운드를 사용한 작업에 제한 사항이 있나요?",content:`네. 음원, 미리 렌더링된 미디어, 사용자가 파생한 미디어는 오디오 애셋 라이브러리로서 다시 패키징하거나 재판매할 수 없습니다. 
라이선스 제약에 관한 자세한 내용은 Stata 라이선스 계약서의 섹션 3에서 확인하실 수 있습니다.

저희 표준 계약서에서 다루지 않은 다른 목적으로 Strata를 사용하시려는 경우 영업팀에게 문의해 주세요.`},q16:{title:"렌더링한 사운드로 어떤 작업이 허용되나요?",content:`렌더링한 사운드를 유효한 구독 기간 도중에 동기화하기만 하면 어떤 미디어에서든지 영구적으로 사용할 수 있습니다.

예를 들어 렌더링한 사운드를 모바일, PC, 콘솔 비디오 게임, 팟캐스트, 라이브 방송에 사용하거나, 작곡, 영화, 라이브 연극/콘서트에 추가하거나, 라디오나 텔레비전에서 방송하거나, 광고에 사용하거나, YouTube, Facebook, Instagram, TikTok 등 소셜 미디어에 게시할 수 있습니다. `},q17:{title:"구독이 끝난 후 개발한 사운드로는 어떤 작업이 허용되나요?",content:`구독이 끝나더라도 <AK_STRATA_LICENCING_AGREEMENT>Strata 라이선스 계약서</AK_STRATA_LICENCING_AGREEMENT>에 따라 사운드가 구독 기간 도중 작품으로 통합되었을 시 해당 사운드를 계속해서 작품의 일부로 사용할 수 있습니다.

하지만 제작하거나 편집한 사운드를 속편이나 확장 팩과 같이 원본 작품에 직접적으로 의존하는 프로젝트에 재사용할 수 있습니다. 이를 제외하고는 Strata를 통해 제공된 음원이나 렌더링된 사운드를 사용하거나 이를 통해 새로운 사운드를 만들 수 없습니다.`},q18:{title:"로열티 프리는 무슨 뜻인가요?",content:"로열티 프리란 여러분이 오디오나 멀티미디어 제작에 통합된 Strata 개인적 혹은 상업적 사용에 대해 추가 비용을 지불하지 않아도 된다는 의미입니다. Strata에 구독하고 나면 사운드를 원하는 프로젝트에서 모두 사용할 수 있는 라이선스가 부여되며, 구독 기간 동안 해당 프로젝트에서 사용한 Strata 사운드에 관해 다른 비용을 전혀 지불하지 않아도 됩니다. "},q19:{title:"원본 Strata 사운드나 제가 Strata를 사용해 만든 원본 사운드를 재판매할 수 있나요?",content:"아니요. Strata는 복사 및 재판매할 수 없으며 개별적인 파일로 배포할 수 없습니다. 구독 기간 동안 작품에 통합되거나 동기화되었을 경우에만 재판매 및 배포할 수 있습니다."},q20:{title:"사운드를 열기 위해 필요한 소프트웨어는 어디서 얻을 수 있나요?",content:`필요한 모든 VST3 플러그인(ENRAGE, Wwise, IEM)은 구독에 포함되며, $t(doNotTranslate:audiokinetic-launcher-kr)에서 다운 받을 수 있습니다.

하지만 <AK_REAPER_LINK>REAPER</AK_REAPER_LINK>는 Strata 구독에 포함되지 않기 때문에 따로 구매하셔야 합니다. `},q21:{title:"제 구독을 다른 사람에게 양도할 수 있나요?",content:`개인 구독은 양도 불가합니다.

기업 구독은 동일한 회사 내에서 좌석을 양도할 수 있습니다.`},q22:{title:"기업 구독은 언제 필요한가요?",content:"기업 구독은 2개 이상의 좌석이 필요하거나 회사를 대신하여 구매할 경우 필요합니다."},q23:{title:"라이선스된 Strata 사운드를 여러 컴퓨터에서 사용할 수 있나요? ",content:"기업 구독의 경우 Strata 콘텐츠를 접근하는 모든 사용자의 Audiokinetic 계정에 유효한 기업 라이선스가 필요합니다. 개인 구독의 경우 구독 계약 조건에 따라 Strata 콘텐츠를 백업할 수 있습니다."},q24:{title:"라이선스에 배상금이 포함되나요?",content:"네. 자세한 내용은 Audiokinetic <AK_STRATA_LICENCING_AGREEMENT>Strata 라이선스 계약서</AK_STRATA_LICENCING_AGREEMENT>를 참고해 주세요."},q25:{title:"프리랜서나 계약직의 경우 고객을 위해 프로젝트에서 Strata를 사용할 수 있나요?",content:"네. 이 라이선스는 Strata 프로젝트나 렌더링된 사운드에서 제공되는 원본 Strata 사운드를 편집하고 렌더링하여 고객님의 프로젝트의 일부로 재판매할 수 있도록 허가합니다. 하지만 원본 Strata 사운드나 편집 및 설계에 사용된 Strata 사운드의 구성 요소를 재판매할 수는 없습니다."},q26:{title:"Strata에 어떤 지적 재산권 보호가 적용되나요?",content:"저희는 상표, 특허, 저작권을 포함한 지적 재산권을 사용하여 Strata를 보호합니다."},q27:{title:"개별적인 Strata 라이선스를 구독한 후 청구서는 어떻게 확인할 수 있나요?",content:"Audiokinetic 계정에 로그인하고 거래 내역으로 가서 청구서를 찾아주세요. 표시된 청구서가 고객님의 요구에 맞지 않을 경우 영업 담당자(혹은 sales@audiokinetic.com)에 문의하여 기업 구독으로 전환하세요. Audiokinetic은 기업간 (B2B) 결제 방식을 지원하며 VAT 일반/특수 청구서를 발행해드릴 수 있습니다."},q28:{title:"3년 구독료 전체를 한 번에 다 선불 결제할 수 있나요?",content:"고객님의 <AK_CONTACT_SALES_LINK>Audiokinetic 영업 담당자</AK_CONTACT_SALES_LINK>에게 문의하여 전체 구독 비용 선불을 포함한 지불 대안 옵션을 상담하세요."},q29:{title:"제 모국어를 사용하여 지불 정보를 입력하고 있습니다. 왜 지불할 때 오류가 뜨나요?",content:"이용에 불편을 드려 죄송합니다. Audiokinetic의 지불 시스템은 현재 서양 문자(로마자)만 지원하고 있습니다. 모국어 대신 영어로 모든 정보를 기재해주시고, 계속해서 오류가 난다면 웹사이트 언어를 영어로 전환해 주세요."},q30:{title:"제가 Strata에 구독하고 다른 여러 사용자가 제 Strata 구독에 접근하도록 할 수 있나요?",content:"이 사용법은 Strata 라이선스와 구독 계약서에 어긋납니다. 다른 사용자는 각자 개별 구독을 구매하거나, 동일한 고용주 하에 함께 작업할 경우 기업 구독을 구매하셔야 합니다. 고객님의 계정은 고객님만 사용하셔야 하며 다른 누구에게도 공유할 수 없습니다. 고객님의 Strata 프로젝트를 다른 사람에게 보여줄 수는 있지만 고객님의 Strata 라이선스로 다른 사람이 작업하는 것은 절대 불가합니다."}}}}},jCt={licensing:qCt},FCt=JSON.parse('{"menu-label":"Strata","bannerV2Title":"새롭게 재탄생한 사운드 효과 라이브러리","bannerV2SubTitle":"","bannerV2Description":"Strata는 동적인 멀티트랙 레이어로 구성되어 지금까지 볼 수 없었던 새로운 작업 방식의 사운드 효과 컬렉션입니다.","pricing-plans-secondary-banner":{"bannerV2Title":"다양한 크리에이터를 위한 유연한 가격 정책","bannerV2SubTitle":"자신에 꼭 맞는 플랜을 선택하고 무제한 사운드 디자인을 경험하세요."},"contextual-banner-image-alt":"Strata 로고","subscribe-strata-newsletter":{"title":"최신 Strata 소식을 받아보세요!","subTitle":"Audiokinetic 계정을 만들어 Strata 뉴스레터를 구독하고 최신 출시 소식을 모두 받아보세요.","subTitleLoggedIn":"Strata 뉴스레터를 구독해 최신 출시 소식을 빠짐 없이 받아보세요.","ctaPrimary":"$t(common:buttons.create-account)","callToActionLoggedInLabel":"$t(common:buttons.subscribe-strata-newsletter)"},"bannerCallToAction":{"primaryLabel":"무료 샘플 받기","secondaryLabel":"지금 구독하기","tertiaryLabel":"컬렉션 살펴보기","gotoPricingPage":"플랜 살펴보기","subLabel":"+++ Strata 컬렉션은 게임과 상호작용 오디오 제품을 위해 특별히 설계되었습니다. 자신만의 고유한 사운드를 손쉽게 만들어 보세요. "},"the-making-of-banner":{"title":"상호작용 오디오를 위한 맞춤 설계","description":"Strata는 단순한 사운드 라이브러리가 아닙니다. Strata는 상호작용 오디오를 위한 완전한 워크플로우를 제공합니다. Strata를 사용하면 모든 요소를 조정하고, 레이어링하고, 수정하여 다양한 창의적 비전에 맞출 수 있습니다.\\n\\n 시간이 지남에 따라 Strata는 단순한 라이브러리를 넘어 각 사용자의 고유한 라이브러리로 진화합니다.","alt-text":"Strata 제작 과정 - 비디오 보기 트리거 이미지","label":"Strata의 메이킹 영상 확인","targetLink":"https://www.youtube.com/embed/KEynYDyY6eI"},"promo-video":{"title":"멀티트랙 형식의 사운드 라이브러리","label":"동영상 보기"},"collections":{"title":"컬렉션 살펴보기","cardAltText":"{{CARD_NAME}} 카드 이미지","soundCount":"{{count}} 사운드","current":{"label":"컬렉션","labelCount":"({{collectionCount}})"},"ctas":{"view-all-collections":"모든 컬렉션 보기"},"coming-soon":{"label":"다음 출시","labelCount":"({{collectionCount}}) 2022년 10월"},"release-schedule":{"title":"출시 일정"},"collection-names":{"aircraft":"Aircraft (항공기)","ambience-detailed-rain":"Ambience Detailed Rain (세부적인 비 환경음)","ambience-doom":"Ambience Doom (죽음 환경음)","ambience-fantasy":"Ambience Fantasy (가상 세계 환경음)","ambience-medieval":"Ambience Medieval (중세 환경음)","ambience-nature":"Ambience Nature (자연 환경음)","ambience-scifi":"Ambience Scifi (SF 환경음)","ambience-urban":"Ambience Urban (도시 환경음)","ambience-warfare":"Ambience Warfare (전투 환경음)","ambience-fire-water":"Ambience Fire and Water (불과 물 환경음)","ambience-space-station":"Ambience Space Station (우주 정거장 환경음)","animal-domestic":"Animal Domestic (가축)","animal-wild":"Animal Wild (야생 동물)","bullets":"Bullets (탄환)","cannons":"Cannons (대포)","cinematic-hits":"Cinematic Hits (시네마틱 타격음)","close-combat":"Close Combat (근거리 전투)","combat-groups":"Combat Groups - Walla (전투 그룹 - 주변 목소리)","combat-groups-p2":"Combat Groups - Callouts (전투 그룹 - 고함)","creature":"Creature (생명체)","creature-ancient":"Creature Ancient (고대 생명체)","creature-humanoid":"Creature Humanoid (생명체 휴머노이드)","creature-movement":"Creature Movement (생명체 움직임)","doors":"Doors (문)","doors-historical":"Doors Historical (옛날 문)","doors-scifi":"Doors Scifi (SF 문)","explosions":"Explosions (폭발음)","footstep":"Footstep (발걸음)","gore":"Gore (고어)","historical-firearms":"Historical Firearms (구식 총기류)","human-movement":"Human Movement (인체 움직임)","heavy-weapons-medieval":"Heavy Weapons Medieval (중세 중화기)","interactable-objects":"Interactable Objects (상호작용 오브젝트)","magic":"Magic (마법)","medieval-weapons":"Medieval Weapons (중세 무기)","modern-firearms":"Modern Firearms (현대 총기류)","physics":"Physics (물리)","physics-debris":"Physics Debris (물리 파편)","physics-destruction":"Physics Destruction (물리 파괴)","quadcopters":"Quadcopters (쿼드콥터)","robotic":"Robotic (로봇)","scifi-weapons":"Scifi Weapons (SF 무기)","sorcery_absorption":"Sorcery Absorption (마법 흡수)","sorcery-strike":"Sorcery Strike (마법 공격)","sorcery-whimsical":"Sorcery Whimsical (기발한 마법)","spaceships":"Spaceships (우주선)","space-station":"Space Station (우주 정거장)","space-station-ambience":"Space Station Ambience (우주 정거장 환경음)","submersion":"Submersion (잠수)","ui-general":"UI General (일반 UI)","ui-modern":"UI Modern (현대 UI)","ui-organic":"UI Organic (유기적 UI)","vehicles":"Vehicles (차량)","voice":"Voice (음성)","warfare":"Warfare (전투)","wwi-firearms":"WWI Firearms (제 1차 세계 대전 총기류)","wwi-shotguns":"WWI Shotguns (제 1차 세계 대전 엽총)","wwi-pistols":"WWI Pistols (제 1차 세계 대전 권총)","wwi-rifles":"WWI Rifles (제 1차 세계 대전 소총)","wwii-firearms":"WWII Firearms (제 2차 세계 대전 총기류)","zombies":"Zombies (좀비)","strata-sample-01":"Strata Sample 01 (Strata 샘플 01)","strata-sample-02":"Strata Sample 02 (Strata 샘플 02)","strata-sample-03":"Strata Sample 03 (Strata 샘플 03)","strata-sample-04-wwi":"Strata Sample 04 (Strata 샘플 04)"}},"testimonials":{"title":"음향 전문가들의 후기"},"stand-alone-descriptions":{"description-a":[{"text":"<AK_BLACK>Strata™</AK_BLACK>는 오직 Audiokinetic만 제공하는 유연한 사운드 디자인 방식을 통해 사용자에게 가장 중요한 창의적 목표에 집중할 수 있게 해줍니다. Strata는 상호작용 오디오 제작을 위해 설계된 고품질 사운드로 선별된 광범위한 라이브러리입니다. Strata 컬렉션에는 완전한 전문적 멀티트랙 REAPER 프로젝트와 무한한 변형음 및 커스터마이징을 위한 원본 음원이 모두 들어 있어, 각기 다른 프로젝트마다 자신만의 고유한 사운드를 손쉽게 만들 수 있습니다. 최고의 사운드 디자이너와 SFX 제공 업체가 제작한 Strata 컬렉션은 원하는 오디오 녹음에 접근할 수 있도록 매월 새롭게 제공됩니다. Strata 라이브러리에 구독해 무한한 창의력을 펼쳐보세요. \\n"}]},"free-samples":{"title":"$t(common:labels.free-samples)","cta-label":"무료 샘플 받기"},"library-list":{"title":"Strata","titleCount":"({{collectionCount}})","cta-label":"구독 구매하기","view-upcoming-releases":"다음 출시될 컬렉션 보기"},"overview-faq":{"title":"자주 묻는 질문","section-data":{"q01":{"sectionTitle":"Strata를 무료로 사용해볼 수 있나요?","description":"네! <AK_LINK_1>여기</AK_LINK_1>에서 무료 샘플 컬렉션을 구독하세요. 무료 샘플 컬렉션에는 읽기 전용 ENRAGE 플러그인이 포함돼있습니다. 효과 속성을 편집할 수는 없지만 모든 사운드는 로열티가 없고 작업하는 프로젝트에 상업적으로 안전하게 사용할 수 있습니다."},"q02":{"sectionTitle":"Strata를 시작하려면 무엇이 필요한가요?","description":"Strata 컬렉션은 멀티트랙 DAW인 REAPER를 사용하여 제작되었습니다. Strata를 멀티트랙 형식으로 완전히 활용하려면 REAPER를 설치해야 합니다. Strata를 시작하기에 앞서 더 자세한 기술적 내용은 <AK_LINK_1>기능 페이지</AK_LINK_1>를 확인하세요."},"q03":{"sectionTitle":"더 많은 정보나 지원은 어떻게 받을 수 있나요?","description":"기타 질문이나 Strata 및 관련 플러그인에서의 기술적인 문제는 커뮤니티 <AK_LINK_1>커뮤니티 Q&A</AK_LINK_1>를 확인하세요.\\n\\n여전히 답변을 찾지 못했나요? <AK_LINK_2>여기서 새로운 질문을 올려보세요</AK_LINK_2>."}}},"needed":{"title":"필요 사항","section-data":{"needed_01":{"sectionTitle":"REAPER","description":"Strata 컬렉션은 REAPER와 함께 사용하도록 설계되었으며, 멀티트랙 기능을 활용하려면 REAPER를 설치해야 합니다.\\n\\nREAPER에 대한 자세한 내용은 <AK_LINK_1> https://www.reaper.fm/</AK_LINK_1>를 참고하세요."},"needed_02":{"sectionTitle":"플러그인","description":"Strata 플러그인은 Strata 디자인 소프트웨어를 매끄럽게 보완하며, 3D 작업을 위한 특수 도구를 제공하고, 효율성을 높이며, 정확한 설계 목표를 달성할 수 있도록 지원합니다.","logos":{"wwise-vst":"Wwise VST3 플러그인","iem":"IEM 플러그인","enrage":"Enrage 플러그인"}},"needed_03":{"sectionTitle":"통합(integration)","description":"Strata를 Soundly, Basehead, Soundminer에 통합하면 내장된 메타데이터를 사용해 효율적으로 검색하고 이를 Strata REAPER 프로젝트의 타임라인의 정확한 위치에서 즉시 열 수 있어 빠른 오디오 커스터마이징이 가능합니다.<br/><br/>이러한 통합이 어떻게 작동하는지 알아보려면 <AK_LINK>Strata 사용 안내</AK_LINK>를 확인하세요.","logos":{"soundly":"Soundly","soundminer":"Soundminer","basehead":"BaseHead"}},"needed_04":{"sectionTitle":"Strata 도구","blocs":{"b00":{"description":"Audiokinetic은 Strata 워크플로우를 향상시키도록 REAPER 확장 기능과 스크립트를 제공합니다."},"b01":{"title":"<AK_LINK>ReaWwise</AK_LINK>","description":"ReaWwise를 사용하면 단 한 번의 클릭으로 간단한 사운드에서부터 복잡한 계층 구조까지, REAPER에서 Wwise로 쉽고 빠르게 전송할 수 있습니다. Wwise 오브젝트 계층 구조를 사전 설정해 저장하고, 와일드카드를 이용해 자동 명명을 지정할 수 있습니다."},"b02":{"title":"<AK_LINK>연관 REAPER 프로젝트 열기</AK_LINK>","description":"빠른 반복 작업은 모든 프로젝트에 있어 필수입니다. 이 스크립트는 Strata 오디오 파일에 포함된 메타데이터를 사용하여 프로젝트를 열고 음원을 찾는 방식을 통해 Strata 오디오 파일과 연관된 REAPER 프로젝트를 Wwise에서 바로 열 수 있습니다."},"b03":{"title":"<AK_LINK>Strata_Copy Selection to Next Project (선택 사항을 다음 프로젝트로 복사)</AK_LINK>","description":"이 REAPER 스크립트 패키지를 사용하면 한 REAPER 프로젝트에서 다른 REAPER 프로젝트로 요소, 트랙 및 플러그인을 쉽게 복사할 수 있습니다."},"b04":{"title":"어디서 찾을 수 있나요?","description":"Audiokinetic의 GitHub 저장소인 <AK_LINK_1>REAPER Tools</AK_LINK_1>를 확인하세요.\\n\\n<AK_LINK_2>ReaPack</AK_LINK_2>은 Strata의 모든 도구를 설치하고 최신 상태로 유지하는 가장 쉽고 빠른 방법입니다."}}}}},"tips-tools":{"title":"툴과 팁 및 개요"},"learn-with-videos":{"title":"Strata 동영상으로 배우기"},"overview-community-videos":{"title":"Strata 사용자들의 비디오"},"strataContains":{"title":"Strata 한눈에 살펴보기","description":"","projects":"REAPER 프로젝트","size":"GB","collections":"컬렉션","soundEffects":"효과음","soundItems":"사운드 항목"},"strata-benefits":{"title":"Strata: 획기적인 사운드 라이브러리의 모든 장점을 누려보세요.","section-data":{"creative-control":{"sectionTitle":"종합적인 크리에이티브 제어 기능","main":{"description":"기존의 고정적이고 이미 렌더링된 파일에서 벗어나세요. Strata의 계층화된 아키텍처를 통해 클립, 트랙, 효과, 소스 파일 등 모든 필수 요소에 완벽하게 접근할 수 있으므로 계획한 대로 정확한 사운드를 구현할 수 있습니다."}},"dynamic-gameplay":{"sectionTitle":"역동적인 게임 플레이를 위한 무한한 변형","main":{"description":"상호작용 오디오로 작업할 때는 변형이 많을 수록 유리하죠. Strata를 사용하면 최초 원본 요소에서 시작해 무한한 변형을 끊없이 생성할 수 있으므로 게임만큼이나 역동적인 사운드 디자인을 만들어낼 수 있습니다 (적어도 출시일 전까지는 말이죠)."}},"learn-from-the-best":{"sectionTitle":"최고 전문가들의 노하우를 나만의 것으로","main":{"description":"사운드 디자인은 커튼 뒤에 숨겨진 마술과도 같습니다. 들으면 알 수 있지만 어떻게 그런 소리가 만들어졌는지는 알기 어렵죠. Strata는 그 커튼을 걷어내고, 최고의 사운드 디자이너가 진행하는 멀티트랙 세션에 직접 접근할 수 있는 기능을 제공합니다. 전문가들의 기술을 배우고, 작업 과정을 살펴보고, 노하우를 이용해 자신만의 시그니처 사운드를 만들어보세요."}},"consistency-by-design":{"sectionTitle":"설계 단계부터 감안된 높은 일관성","main":{"description":"사운드 품질부터 메타데이터에 이르기까지, Strata만의 높은 일관성은 모든 요소가 조화롭게 작동하도록 보장합니다. 프로젝트에 사운드를 손쉽게 통합하여 미적으로 일관된 오디오 스타일을 만들어 보세요."}}}},"benefits":{"title":"Strata의 장점","customization":{"title":"무한한 창의적 커스터마이징","description":"끊임 없이 규모가 커지고 있는 멀티트랙 컬렉션 라이브러리를 탐색해보세요. 클립, 트랙, 렌더링되지 않은 효과, 원본 파일 등 필요한 재료가 모두 들어있습니다. 비교할 수 없는 창의적 커스터마이징을 통해 손끝에서 무한한 사운드 변형을 경험할 수 있습니다."},"consistency":{"title":"설계에 의한 일관성","description":"전반적인 모든 컬렉션, 멀티트랙 프로젝트 레이아웃, 효과, UCS 표준 메타데이터에서의 일관성과 통일성을 유지하며 작업 과정을 단순화시켜보세요. REAPER, Soundminer, Soundly, Wwise, 그리고 곧 Basehead와의 통합을 통해 여러분이 작업 과정을 간소화해보세요."},"efficiency":{"title":"효율성 증가","description":"검색, 편집, 사운드 정리에 소비되는 시간을 줄이고 실제 설계 작업 시간을 확보하세요. 최고의 사운드 디자이너가 제작한 새로운 월간 컬렉션을 사용해 사운드를 처음부터 녹음해야 하는 비용을 줄이고 렌더링된 사운드를 찾고, 정리하고, 편집하거나 비일관적 사운드 파일을 믹싱하는 바쁜 작업에 드는 비용을 줄이세요."},"top_tier":{"title":"최고의 사운드 컬렉션","description":"최고의 사운드 디자이너와 SFX 제공 업체가 제작했으며, 무한한 변형음과 함께 계속해서 성장하는 라이브러리에 접근해보세요."},"reverse_engineering":{"title":"역설계를 통한 학습","description":"업계 최고의 사운드 디자이너의 원본 사운드 디자인 세션에 접근해 이들의 노하우를 배워보세요. 전문가의 작업을 분해하여 따라해보면 그들의 방법과 모범 사례에 즉시 익숙해질 것입니다."}},"plugins":{"title":"플러그인","description":"Strata 플러그인은 Strata 디자인 소프트웨어를 매끄럽게 향상시켜주며, 3D 작업 및 효율성 최적화에 대한 특수 도구를 제공하고 정확한 설계 목표를 성취할 수 있도록 사용자에게 힘을 실어줍니다. 이 강력한 추가 도구를 사용해서 Strata 경험을 한 단계 높여보세요."},"integrations":{"title":"통합(integration)","description":"Soundly, Soundminer, basehead와 매끄러운 통합으로 고품질 사운드에 효율적으로 접근하고, 조화로운 시청각적 우수성을 통해 Strata 프로젝트를 향상시켜 보세요."},"partners":{"title":"제작 파트너","description":"설계 및 제작 과정을 위한 매끄러운 통합, 혁신적 도구, 향상된 효율성으로 창의적 작업 과정을 한 단계 높여보세요."},"production-partners":{"title":"제작 파트너","description":"Audiokinetic은 세계 최고의 창의적 음향 녹음 아티스트 및 사운드 디자이너와 협력하여 고품질 맞춤형 컬렉션을 제작합니다.","partners":{"boom":{"title":"","description":"세계적으로 유명한 음향 효과 제공업체인 Boom Library는 Strata와 협력하여 뛰어난 오디오 품질과 세심하게 제작된 사운드의 광범위한 라이브러리를 제공하며, 전 세계 영화, 게임, 미디어 제작 분야의 전문가들로부터 큰 신뢰를 받고 있습니다."},"digitalRainLab":{"title":"","description":"Digital Rain Lab은 전문 사운드 디자이너/기술 및 SF 전문가들로 구성되어, 영화 촬영부터 자체 상호작용 오디오 시스템 개발까지 다양한 분야에 걸친 노하우를 보유하고 있습니다. Digital Rain Lab은 어떤 프로젝트에든 적합한 최고 품질의 사운드 효과 라이브러리를 찾을 수 있는 최고의 선택입니다."},"rockTheSpeakerBox":{"title":"","description":"수상 경력이 있는 이 곳 오디오 전문가들은, 다양한 플랫폼의 AAA 게임 타이틀의 사운드를 디자인한 20년 경력을 보유하고 있습니다. 이들은 녹음과 디자인에 대한 열정뿐만 아니라 게임 제작의 어려움에 대한 확고한 이해를 가지고 있습니다. 이들의 컬렉션은 게임 사운드 디자이너가 프로젝트 사운드를 다음 단계로 끌어올릴 수 있도록 고안된 고품질 사운드를 결합시킵니다."},"soundexMachina":{"title":"","description":"Digital Rain Lab은 소규모의 녹음 전문가와 사운드 디자이너로 구성되어 발빠른 대응력을 갖고 있는 팀입니다. 전 세계의 사운드 전문가, 개발자, 영화 제작자에게 로열티 없이 컨텍스트 기반의 사운드 효과 라이브러리를 제공합니다."},"spectravelers":{"title":"","description":"저희는 미래에서 온 Spectravelers입니다. 오디오 스펙트럼 시간 포털을 이용한 외계 기술을 사용하여 여행하고 있습니다. 이 여정 동안 많은 오디오 스펙트럼 텍스처를 수집하고 혼합하고 결합하여 여러분들과 공유하고 있습니다!"},"monsterFactory":{"title":"","description":"Monster Factory는 다양한 유형의 가상 몬스터와 생명체를 위한 사운드 제작, 음성 연기, 현지화, 음성 지시 및 사운드 디자인 분야에서 독보적인 전문 지식을 제공합니다."},"biquette":{"title":"","description":"게임 업계에서 20년의 경험을 쌓아온 Biquette Studio(비켓 스튜디오)의 팀은 다큐멘터리, 영화, 비디오 게임을 더욱 풍부하게 만들기 위해 설계된 사실적인 자연 사운드스케이프를 녹음하고 다듬습니다. 이 팀의 DNA는 앰비소닉 및 바이노럴 3D 사운드 녹음 기법을 활용한 사운드의 몰입적이고 공간적인 힘을 중심으로 구축되어 있습니다."},"aftertouch":{"title":"","description":"Aftertouch Audio(애프터터치 오디오)는 고품질의 로열티 프리 사운드 효과 라이브러리를 제작하는 데 전념하는 소규모 사운드 녹음 전문가 및 사운드 디자이너 팀입니다."}}},"what_you_need":{"title":"필요 사항","cards":{"reaper":{"title":"REAPER","description":"Strata 컬렉션은 멀티트랙 DAW인 REAPER를 사용하여 제작되었습니다.\\n\\nStrata를 멀티트랙 형식으로 완전히 활용하려면 REAPER를 설치해야 합니다.\\n\\nREAPER에 대한 더 많은 정보는 \\n<AK_REAPER_LINK>https://www.reaper.fm/</AK_REAPER_LINK>를 참고해 주세요."}}},"with_reawwise":{"title":"ReaWwise™를 통해 REAPER에서 Wwise로 쉽게 가져오세요.","cards":{"reawwise":{"title":"ReaWwise","description":"ReaWwise는 Audiokinetic이 개발한 REAPER  확장 기능으로, 오디오 애셋을 REAPER에서 Wwise로 빠르게 전송할 전송할 수 있게 해줍니다. 이 확장 기능은 REAPER의 렌더 구성 행렬을 통해 복잡한 Wwise 계층 구조 제작을 간소화 및 오토메이션해줍니다.\\n\\n<AK_REAPACK_LINK>ReaPack</AK_REAPACK_LINK>에서 다운로드하고 작업 과정의 속도를 높여보세요."}}},"what_you_get":{"title":"포함 내용","cards":{"strata":{"title":"Strata 3년 구독","description":"구독자로서 여러분은 Strata의 완전한 <AK_STRATA_COLLECTIONS>사운드 컬렉션</AK_STRATA_COLLECTIONS>과 플러그인에 접근할 수 있으며, 기대되는 새로운 컬렉션이 매달 추가됩니다.  \\n\\n현재 Strata에는 다음이 포함되어 있습니다.\\n<AK_BULLET>컬렉션 {{AK_COLLECTION_COUNT}}개</AK_BULLET>\\n<AK_BULLET>효과음 {{AK_SOUND_FX_COUNT}}개 이상</AK_BULLET>\\n<AK_BULLET>음원 아이템 {{AK_SOURCE_ITEM_COUNT}}개 이상</AK_BULLET>\\n\\n곧 출시될 컬렉션은 <AK_STRATA_RELEASE_SCHEDULE>출시 일정</AK_STRATA_RELEASE_SCHEDULE>에서 확인해 주세요."},"vst":{"title":"Wwise VST3 플러그인 스위트","description":"Wwise 플러그인 컬렉션이 VST3 형식으로 포트된 제품입니다.\\n\\n이 플러그인은 해당 기능을 반영하는 이름을 가지고 있으며 Wwise의 런타임 버전으로서 사용되는 동일한 코드를 안정적이고 효율적으로 실행합니다. 전체 문서는 <AK_WWISE_EFFECT_PLUGINS>Wwise Effect 플러그인</AK_WWISE_EFFECT_PLUGINS>을 참고해 주세요.\\n\\n플러그인은 무료로 제공되며 Wwise 프로젝트 라이선스의 조건에 따라 라이선스가 부여됩니다. Wwise를 사용 중일 경우 Wwise 프로젝트가 평가판이더라도 라이선스가 제공됩니다.\\n\\n이 플러그인은 Strata에서 전반적으로 사용되기 때문에 설치해주셔야 합니다."},"enrage":{"title":"ENRAGE 플러그인","description":"<AK_ENRAGE_VIDEO_LINK>ENRAGE</AK_ENRAGE_VIDEO_LINK>는 BOOM Library가 설계한 멀티 모듈 FX 처리 플러그인입니다. 이 플러그인은 50개가 넘는 장치를 In/Out, Delay, Distortion, Modulation, Generator, Pitch, Filter, Imaging, Reverb, Analyzer, Gain & Dynamics로 분명하게 분류하여 제공합니다. 제공되는 10개의 모듈레이션 음원은 Curve, ADSR, Envelope Follower, LFO, Mapping, Delay, Transient Follower, Change Analyzer, Pitch Tracker, Formula(수학을 좋아하는 분들께) 입니다.\\n\\n굉장히 다재다능한 이 플러그인은 REAPER 프로젝트에서 광범위하게 사용되며 BOOM의 디자이너들이 Strata를 위해 특별히 제작한 모든 프리셋이 담겨 있습니다.\\n\\nENRAGE 라이선스는 Strata 구독에 포함됩니다. ENRAGE 플러그인을 승인하기 위해서는 무료 iLok 계정과 iLok 관리 소프트웨어 설치가 필요합니다."},"iem":{"title":"IEM 플러그인 스위트","description":"Institute of Electronic Music and Acoustics(전자 음악 및 음향 학교)의 직원과 학생이 제작한 무료 오픈 소스 오디오 플러그인 스위트이며 최대 7차 앰비소닉 플러그인이 들어 있습니다. 자세한 전체 내용은\\n<AK_IEM_LINK>https://plug-ins.iem.at/</AK_IEM_LINK>에서 확인해 주세요.\\n\\nStrata는 앰비소닉을 사용하는 모든 컬렉션에서 IEM 스위트의 VST3 버전을 사용합니다. 현재 앰비소닉을 사용하는 라이브러리는 Ambience 라이브러리 하나입니다. REAPER 프로젝트는 3차 ACN으로 믹싱되며 IEM 스위트의 디코더를 사용하여  스테레오, 바이노럴, 옥토포닉 3D(octophonic 3D) 및 1~3차 앰비소닉 형식으로 출력하도록 구성되어 있습니다."}}},"faq":{"title":"자주 묻는 질문","description":"","other-faq-links":{"licensing":"라이선스 - 자주 묻는 질문","community":"커뮤니티 FAQ"},"content":{"q01":{"title":"Strata란 무엇인가요?","content":"Strata는 멀티트랙 형식의 다양한 사운드 컬렉션에 접근할 수 있게 해주는 구독 서비스입니다. Audiokinetic이 개발한 Strata는 REAPER와 함께 사용하도록 설계되었습니다."},"q02":{"title":"Strata는 어떤 점에서 독특한가요?","content":"Strata는 멀티트랙 형식으로 제공되며 트랙으로 구성되어 있어 모든 클립 편집과 효과 설정이 나타나있습니다. 기존의 다른 라이브러리와 다르게 Strata는 사운드 디자이너가 렌더링한 사운드를 구성하는 각 요소(클립 편집, 음원, 효과 설정, 등)를 완전히 제어할 수 있게 해주는 유일한 라이브러리입니다."},"q03":{"title":"컬렉션이 어떻게 구성되어 있나요?","content":"모든 컬렉션은 여러 하위 프로젝트가 연결된 메인 REAPER 프로젝트로 구성되어 있습니다. 하위 프로젝트는 오브젝트 유형, 위치, 의도 등 논리적인 구성에 따라 구분되어 있습니다.\\n\\n모든 음원 및 렌더링된 오디오 파일의 이름과 메타데이터는 UCS (유니버셜 카테고리 시스템, Universal Category System)을 따릅니다."},"q04":{"title":"Strata와 사운드 라이브러리언  소프트웨어를 함께 사용할 수 있나요?","content":"네! 모든 음원 및 렌더링된 오디오 파일은 UCS (유니버셜 카테고리 시스템, Universal Category System) 명명 규칙을 따르기 때문에 SoundMiner, Basehead, Soundly 등 SFX 검색 엔진을 사용해서 원하는 사운드를 쉽게 찾을 수 있습니다.\\n\\nStrata에서 원하는 사운드를 찾고난 후 음원을 그대로 사용하거나 관련 REAPER 프로젝트에서 열어 원하는대로 조정할 수 있습니다."},"q05":{"title":"Strata를 Wwise와 함께 사용할 수 있나요?","content":"Strata는 사용 중인 소프트웨어와 상관 없이 전반적인 창의적인 흐름을 향상시키도록 설계되었습니다. 프로젝트는 REAPER의 종합적인 렌더링 기능을 활용하도록 구성되어 콘텐츠 제작과 변형음 생성을 쉽게 만들어줍니다.\\n\\nWwise 사용자는 <AK_REAPACK_LINK>ReaWwise</AK_REAPACK_LINK>를 함께 사용하여 Strata 작업의 생산성을 크게 향상시킬 수 있습니다. 이 REAPER 확장 기능은 단 몇 번의 클릭만으로 Wwise 컨테이너 계층 구조를 쉽게 제작할 수 있게 해줍니다."},"q06":{"title":"Strata는 어떻게 구매할 수 있나요?","content":"Strata는 매월 컨텐츠가 추가되는 구독 서비스입니다. <AK_STRATA_PRICING_LINK>가격</AK_STRATA_PRICING_LINK>과 가장 최신 라이브러리 콘텐츠를 확인해 주세요."},"q07":{"title":"새로운 컬렉션은 얼마나 자주 추가되나요?","content":"새로운 컬렉션은 매달 추가되며 <AK_STRATA_RELEASE_SCHEDULE>Strata 출시 일정</AK_STRATA_RELEASE_SCHEDULE>에 게시됩니다."},"q08":{"title":"더 많은 정보나 지원은 어떻게 받을 수 있나요?","content":"청구서 발행, 구독 조건 혹은 지불에 관한 문제는 <AK_CONTACT_SALES_LINK>영업팀</AK_CONTACT_SALES_LINK>에게 문의해 주세요.\\n\\n기타 질문이나 Strata 및 관련 플러그인에서의 기술적인 문제는 커뮤니티 <AK_STRATA_COMMUNITY_QNA>Q&A</AK_STRATA_COMMUNITY_QNA> 섹션을 방문해 주세요. 원하는 질문을 찾을 수 없을 경우 Q&A에 새로운 질문을 게시해 주세요.  "}}},"community-review":{"title":"사용자들의 후기"}}'),GCt={"menu-label":"Wwise",bannerV2Title:"Wwise는 풍부한 기능을 가진 최첨단 게임 상호 작용 오디오 솔루션입니다.",bannerCallToAction:{primaryLabel:"$t(common:buttons.get-started)",secondaryLabel:"$t(common:buttons.versionFeatures)",tertiaryLabel:"$t(common:buttons.versionFeatures)"},"stand-alone-descriptions":{"description-a":[{text:"상호 작용 오디오와 실시간 성능 기술을 지원하는 Wwise는 완벽한 설계 및 개발 도구 세트를 제공하여 프로젝트의 규모에 상관없이 여러분의 창의적인 오디오 비전을 쉽게 프로토타입하고 현실화할 수 있도록 돕습니다."}],"description-b":"여러분의 상호작용 프로젝트의 특정 요구에 맞는 다양한 무료 및 프리미엄 <AK_LINK>플러그인</AK_LINK>뿐만 아니라 파트너 및 커뮤니티 플러그인을 Wwise와 함께 사용해 보세요."},"stand-alone-title":{"title-a":"음향인에게 힘을"},benefits:{"enhance-creativity":{title:"창의력 향상시키기",description:"Wwise는 제작 파이프라인에 통합되어 오디오 팀이 어떤 제한이나 의존성 없이 창의적인 작업에 집중할 수 있도록 힘을 더해줍니다. 단 하나의 오디오 엔진을 사용하여 저작, 시뮬레이션, 통합, 믹스, 프로파일링해보세요. "},"increase-efficiency":{title:"효율성 향상시키기",description:"Wwise는 종합적인 상호작용 오디오 파이프라인을 통해 여러분의 상호작용 오디오 프로젝트를 간소화해줍니다. 신속한 콘셉트 프로토타입으로 창휘력을 발휘하고 동일한 시간 대비 최고의 작업을 출시해 보세요."}}},YCt={"menu-label":"통합(integration)",bannerV2Title:"통합(integration)",bannerSubTagline:"",sections:{firstParty:{title:"Audiokinetic 개발, 관리",description:"Wwise(와이즈)는 공개 API 기능을 가지고 있어 자체 개발 게임 엔진이나 세계 정상급의 상업용 게임 엔진과도 쉽게 통합할 수 있습니다.",cardSource:{wwise:{title:"Wwise Authoring API(와이즈 저작 API)",description:"새로운 <AK_BLACK>Wwise Authoring API(와이즈 저작 API, WAAPI)</AK_BLACK>는 Wwise와 각종 엔진, 도구, 애플리케이션이 종합적으로 통합되도록 하는 기능을 갖고 있습니다. 모든 인터넷 사용이 가능한 언어, 운영 체제, 환경에서 사용하실 수 있습니다."},unity:{title:"Wwise Unity 통합",description:"<AK_BLACK>Wwise Unity 통합</AK_BLACK>이란 Wwise 사운드 엔진을 Unity 게임에서 이용할 수 있도록 하는 Unity 플러그인입니다. 통합 플러그인에는 Unity 플러그인 라이브러리, C#으로 된 Wwise SDK API, 몇 가지 유용한 구성요소와 에디터 창이 포함되어 있습니다."},unrealEngine:{title:"Wwise Unreal 통합",description:"<AK_BLACK>Wwise Unreal 통합</AK_BLACK>은 Unreal Engine 플러그인으로 Unreal 게임에서 Wwise Sound Engine을 사용할 수 있도록 합니다. 이 통합으로 Unreal Engine Object와 Blueprint를 통해 Wwise 기능을 사용할 수 있게 됩니다. 또한, Unreal Engine의 Level Sequencer와 완전히 통합되며 차단(occlusion)을 지원합니다. <AK_LINK_1>자세히 알아보기</AK_LINK_1>"},reawwise:{title:"ReaWwise™",description:`<AK_BLACK>ReaWwise</AK_BLACK>는 Audiokinetic이 개발한 REAPER 확장 기능으로, 오디오 애셋을 Wwise 프로젝트로 빠르게 전송할 수 있게 해줍니다. 이 확장 기능은 복잡한 Wwise 오디오 구조를 사용자의 REAPER 렌더 구성을 기반으로 제작할 수 있게 해줍니다.
<AK_LINK_1>ReaPack을 통해 다운로드하고 무료로 사용해보세요</AK_LINK_1>`}}},thirdParty:{title:"서드파티 배포",description:"Wwise는 사내 개발 엔진과 세계 최상의 상업용 엔진에 간편하게 통합됩니다. 서드파티 통합은 협력사에서 개발 및 관리하고 있습니다.",cardSource:{cryEngine:{title:"CryEngine(크라이엔진)",description:"이 통합 과정의 개발, 관리, 고객 지원은 <AK_LINK_1>Crytek</AK_LINK_1>에서 담당하고 있습니다. 여기에는 모든 CryEngine의 라이선스 및 구독이 포함되어 있습니다."},nuendo:{title:"Nuendo(누엔도)",description:"이 통합 과정의 개발과 관리는 <AK_LINK_1>Steinberg</AK_LINK_1>에서 담당하고 있습니다. <AK_LINK_2>Game Audio Connect 기능</AK_LINK_2>으로 Nuendo 7 이상의 버전과 Wwise 간의 매끄러운 실시간 연결을 누려보세요. Steinberg는 사운드 제작, 작곡, 대화 녹음, 믹싱, 미들웨어 상호 작용에 맞는 최고의 호환성과 유연성 그리고 풍부한 기능을 제공합니다."},O3DE:{title:"O3DE",description:"이 통합 과정은 <AK_LINK_1>Linux Foundation</AK_LINK_1>이 개발, 관리, 지원하고 있습니다. Open 3D Engine (O3DE)은 Apache 2.0 라이선스를 갖고 있는 멀티 플랫폼 3D 엔진으로서, 개발자와 콘텐츠 크리에이터가 AAA 게임, 시네마급 3D 월드, 고성능 시뮬레이션을 수수료나 상업적 의무 없이 제작할 수 있게 해줍니다."},speechless:{title:"Speechless",description:"이 보이스오버 애셋 관리 통합의 개발과 관리는 <AK_LINK_1>Speechless.games</AK_LINK_1>가 담당하고 있습니다. Speechless는 스크립트, 텍스트 음성 전환, 녹음된 오디오, 현지화를 처리하고 Wwise와 매끄럽게 통합되는 간소화된 솔루션을 제공합니다. 뿐만 아니라 Speechless는 고유한 캐스팅 도구와 전문 성우의 녹음 데이터베이스를 플랫폼 안에서 직접 제공해줍니다."}}},community:{title:"커뮤니티 관리",description:"커뮤니티 통합은 각 커뮤니티가 개발, 관리하고 있습니다. 게임 엔진 통합에 관심이 있으시다면<AK_LINK_1>Wwise SDK</AK_LINK_1>에 대해 알아보세요. 손수 통합 플러그인을 제작하고 싶으시다면 새로운 <AK_LINK_2>Wwise Authoring API(와이즈 저작 API, WAAPI)</AK_LINK_2>에 대해 알아보세요. 각종 엔진, 도구, 애플리케이션과 Wwise의 종합적인 통합이 가능합니다.",cardSource:{baseHead:{title:"BaseHead, LLC(베이스헤드)의 basehead 5.1 통합",description:"이 Wwise 통합은 Wwise와 basehead 간에 오디오 오브젝트와 매개 변수를 주고받을 수 있게 해줍니다. 또한 basehead는 Strata에 대한 네이티브 지원을 제공하여 basehead에서 찾을 수 있는 모든 Strata 렌더링된 오디오 파일에서부터 관련 REAPER 프로젝트를 열 수 있게 해줍니다."},cocos2DX:{title:"COCOS2DX 통합 제작: Kakyoism",description:"이 통합 데모 어플리케이션에는 다양한 Wwise의 기능을 게임과 통합하는 방법을 다룬 일련의 데모가 포함되어 있습니다."},gameMaker:{title:"GameMaker Studio 통합 제작: Caklassen",description:"GameMaker Studio용 Wwise 플러그인입니다. GameMaker Studio는 게임 제작 시스템입니다."},godot:{title:"Godot(고닷)",description:"Developed and maintained by Alessandro Fama, this <AK_LINK_1>GDExtension</AK_LINK_1> library integrates Wwise into the Godot engine for Windows, macOS, Linux, Android, iOS, and Web (experimental)."},reaper:{title:"REAPER 통합 제작: Karl Davis",description:"렌더링한 오디오 파일을 빠르게 Wwise로 불러올 수 있는 REAPER 확장 기능입니다."},reaOpen:{title:"ReaOpen REAPER 통합 제작: Nikola Lukić, Jeremy Rogers",description:"오디오 파일을  선택하여 원본 REAPER 프로젝트를 쉽게 열어주는 간단한 무료 프로그램입니다. "},soundMiner:{title:"Soundminer 통합 제작: Justin Drury",description:"Soundminer는 빠르게 애셋을 찾아내어 조작할 수 있게 해주는 오디오 파일 관리 도구입니다."},WAAPI_BR:{title:"WAAPI 통합 제작: Bernard Rodrigue",description:"Jsfxr for Wwise, WAAPI Text-to-Speech, WAAPI Import by Name과 같은 Bernard Rodrigue의 WAAPI 샘플 프로젝트는 WAAPI의 다양한 기능 중 몇몇을 실제로 보여주기 위해 마련되었습니다. Bernard는 2017년 오스틴 게임 컨퍼런스(Austin Game Conference) 중 자신의 연설과 블로그에서 '<AK_LINK_1>세 개의 WAAPI용 오픈 소스 프로젝트(Three Open Source Projects for the Wwise Authoring API)</AK_LINK_1>'라는 주제로 이 세 가지의 샘플에 대해 이야기한 바 있습니다."}}}}},JCt={"menu-label":"제품",plugins:{"menu-label":"플러그인"},"getting-started":{title:"어떻게 시작하나요?",description:"무료 평가판으로 프로젝트를 등록하세요. 아무런 부대 조건도 없습니다!",step_1:{title:"계정 만들기",description:"계정을 만들어 라이선스와 학습 자료 등 고객님의 프로젝트와 관련된 모든 것들을 관리해보세요."},step_2:{title:"다운로드",description:"$t(doNotTranslate:audiokinetic-launcher-kr)를 다운로드하여 Wwise를 설치하세요. $t(doNotTranslate:audiokinetic-launcher-kr)를 사용하면 프로젝트와 License Key(라이선스 키) 관리하기, 플러그인을 설치하기, 새로운 패치 버전을 설치하여 Wwise 버전 업데이트하기, 등 수많은 작업을 실행할 수 있습니다!"},step_3:{title:"프로젝트 등록하기",description:"프로젝트를 등록해서 사운드 수의 제한이 없고 프리미엄 플러그인 평가판을 써볼 수 있는 Wwise 평가판을 시작해 보세요."}},products:{"wwise-feature-cards":{authoring:{title:"저작",description:"Wwise는 끝없는 가능성을 통해 여러분의 작업에 예술적인 가능성을 열어줍니다. 설계 과정에서 프로그래밍과 성능적인 측면을 걱정할 필요가 없어지며 멀티 플랫폼 개발이 간단해집니다."},"dynamic-mixing":{title:"동적 믹싱",description:"Wwise에 있는 다양한 동적 믹싱 기술은 처리 제약을 유지하면서 갖고 있는 처리 능력을 최대한 알뜰하게 사용하는 동시에 조건이 변함에 따라 사운드의 우선 순위를 관리할 수 있게 해줍니다."},"spatial-audio":{title:"공간 음향",description:"Wwise Spatial Audio(와이즈 공간 음향)은 소리의 전달, 가상 음향, 공간적 정보를 받는 오디오 렌더링에 특수화되어 있으며, 가상 환경을 현실감 있는 느낌으로 구현하여 보다 깊이 몰입할 수 있는 오디오 환경을 쉽게 제작하도록 해줍니다.  Audiokinetic의 연구는 여기에서 멈추지 않습니다. 향후 몇 년간 새로운 공간 음향 기능, 플러그인, 협력사들을 많이 만나보실 수 있도록 최선을 다하겠습니다."},"interactive-music":{title:"상호작용 음악",description:"수상 경력을 통해 업계에서도 인정 받은 Wwise를 이용하면 작곡가의 적응형 음악 제작이 훨씬 간편해집니다. Wwise의 규칙 기반 전환 효과에 따라 음악 큐가 반응하도록 설계하면 언제든지 최적의 세그먼트가 재생되도록 할 수 있습니다."},"sound-design":{title:"런타임 처리 및 합성",description:"Wwise는 기본 사운드 신시사이저 배열을 제공하여 사운드 디자이너가 최소한의 리소스로 무한한 다양성을 생성할 수 있도록 힘을 실어줍니다."}}},integrations:{"menu-label":"통합(integration)",title:"통합(integration)",description:"Wwise는 공개 API를 지원하며 내장 시스템을 포함한 모든 기술로 쉽게 통합할 수 있습니다."},platforms:{title:"플랫폼",description:"Wwise는 크로스 플랫폼 솔루션입니다."},"wwise-integration":{"menu-label":"Wwise 통합"},"wwise-wow":{community:{title:"커뮤니티",description:"Audiokinetic 커뮤니티는 가장 크고 빠르게 성장하는 상호 작용 오디오 커뮤니티입니다. 전세계 제작자와 개발자가 커뮤니티 행사와 Audiokinetic 블로그 및 커뮤니티 Q&A와 같은 전용 채널을 통해 함께 소통하고 협업하고 아이디어를 공유합니다."},documentation:{title:"문서",description:"탄탄한 문서와 샘플 프로젝트를 사용하면 Wwise를 처음 시작할 때 새로운 기능을 빠르게 사용해볼수 있고 오디오 작업 과정에 대해 쉽게 배울 수 있습니다. "},education:{title:"교육",description:"Audiokinetic은 고객님의 요구에 맞춤화된 팀 연수를 제공합니다. 또한 자세한 과정과 샘플 프로젝트가 들어 있는 온라인 학습 자료가 무료로 제공됩니다."},performance:{title:"성능",description:"Wwise는 어림짐작에 의존할 필요 없이 직접적으로 문제를 해결할 수 있게 해줍니다. 강력한 프로파일링 도구를 사용하여 오디오 신호나 오브젝트의 경로를 시각적으로 확인하고 성능 문제가 생기기 전에 찾아내어 쉽게 해결해 보세요."},stability:{title:"안정성",description:"상호 작용 오디오의 가장 안정적인 솔루션이자 최적의 기준이 되고 있는 Wwise를 사용하면 기술적인 위험 부담을 줄일 수 있습니다. "},support:{title:"지원",description:"Audiokinetic의 기술 지원은 작업 도중 맞닥뜨릴 수 있는 문제에 대해 고객님의 걱정을 덜어드립니다. Wwise 프로젝트에 사용할 지원 플랜을 선택하거나 도움이 필요할 때마다 Pay2Go 티켓을 사용해 보세요. Audiokinetic 기술 지원팀은 신속한 문제 해결을 통해 고객님의 팀이 최대한 효율적이고 창의적으로 작업할 수 있도록 돕는 것을 목표로 합니다."}},"supported-platforms":{"menu-label":"$t(common:labels.supported-platforms)"},"creative-services":{"menu-label":"크리에이티브 서비스"},"wwise-spatial-audio":{"menu-label":"공간 음향"}},XCt={strata:FCt,wwise:GCt,integrations:YCt,"wwise-spatial-audio":{bannerV2Title:"Wwise Spatial Audio",bannerV2Description:"사실적이거나 초현실적인 역동적 몰입감을 선사해 보세요!",blocks:{family:{title:"Wwise Spatial Audio",description:"<AK_BOLD>Wwise Spatial Audio</AK_BOLD>는 Wwise의 작업 흐름에 매끄럽게 녹아 제작을 돕는 Audiokinetic 및 서드파티의 플러그인을 비롯한 내장형 공간 음향 기능의 모음을 말합니다. Wwise Spatial Audio는 소리의 전달, 가상 음향, 공간을 이해하는 오디오 렌더링에 특화되어 있습니다. Audiokinetic의 연구는 여기에서 멈추지 않습니다. 향후 몇 년간 새로운 공간 음향 기능, 플러그인, 협력사들을 많이 만나보실 수 있도록 최선을 다하겠습니다."},geometry:{title:"지오메트리",description:"Wwise Spatial Audio Geometry API는 Wwise Reflect 플러그인과 함께 동적 초기 반사음의 시뮬레이션을 위해 허음원(image source)을 계산하는데 이 때 이미터(emitter)와 리스너(listener)의 위치, 게임 지오메트리의 (단순화된) 삼각형들을 사용합니다. 사운드 디자이너는 거리 및 재질과 관련된 속성들을 변경하면서 직접 Wwise Reflect에서 허음원의 위치를 초기 반사음에 적용할 수 있습니다."},roomsAndPortal:{title:"Room(공간)과 Portal(포털)",description:"Wwise Spatial Audio 모듈은 Room(공간)과 Portal(포털)로 불리는 단순한 고수준 지오메트리 관념을 드러내는데, 이는 다른 공간에 위치한 이미터 소리의 전달을 효율적으로 모델링할 수 있게 해줍니다. 공간을 중심으로 하는 사운드 증식의 주요 기능에는 회절(diffraction), 결합(coupling), 리버브의 공간화(spatialization)가 있습니다. 이 도구들을 활용하면 사운드 디자이너가 Wwise에서 오디오 변형의 결과물을 완전히 통제할 수 있습니다. 뿐만 아니라 게임 엔진 특유의, 대개 많은 성능이 요구되는 레이캐스트 기반 장애물을 리스너와 같은 공간에 있는 이미터로 한정시켜 줍니다."},wwiseCore:{title:"Wwise CORE",description:"",cards:{busses:"<AK_BOLD>3D 버스</AK_BOLD>는 신호의 흐름 속에 존재하는 여러 개의 소리 및 리버브 그룹을 서브믹싱하고 그 결과물을 삼차원 세계에 배치함으로써 효율적인 소리 전달 솔루션의 구성 요소를 개발자에게 제공합니다. 이런 점으로 인해 동적인 공간 포털과 지향성 리버브와 같은 공간 음향 효과의 구현에는 3D 버스가 필수적인 요소라고 할 수 있습니다.",ambisonics:"<AK_BOLD>앰비소닉</AK_BOLD>이 Wwise의 보이스(Voice) 파이프라인에 완전히 합류했습니다. 이제 앰비소닉 파일을 불러오고, 다른 채널 구성을 앰비소닉 포맷으로 서브믹스할 수 있는 것은 물론, 궁극적으로는 계속해서 늘어나는 각종 앰비소닉 지원 플랫폼에서 바로 앰비소닉을 재생할 수 있게 되었습니다. 앰비소닉은 크로스 플랫폼 음향 전달 솔루션이자 서라운드 사운드 포맷으로서 듣는 이를 둘러싸고 있는 음장(音場, sound field)을 고른 구(球) 모양으로 표현해내며, 스피커 설정이나 바이노럴 필터와 상관없이 사용 가능합니다.",acoustics:"'Wwise Reflect' 플러그인과 함께 사용되는<AK_BOLD>Acoustic textures</AK_BOLD>(음향 텍스처)는 나무, 콘크리트, 석고판 등과 같은 다양한 재질에서 나는 자연적인 소리를 모방하여 반사면에 반영합니다. 매개 변수를 조절하여 표면의 거친 정도와 특정 주파수의 약화 정도를 정의할 수 있기 때문에 여러분께서 찾으시는 그 재질의 소리를 만들어낼 수 있습니다."}},wwisePlugIns:{title:"Wwise 플러그인",description:"Audiokinetic은 상호작용 사운드 디자인에서 특히 필요했던 부분을 겨냥해, 보다 향상된 Wwise 사용이 가능하도록 다양한 고급 플러그인을 개발하였습니다.",cards:{convolution:"<AK_BOLD>Wwise Convolution</AK_BOLD>(와이즈 컨볼루션)은 아주 작은 방부터 대성당에 이르는 실제 음향 공간 샘플을 토대로 현실감 있는 리버브를 만들어 드립니다. Audiokinetic과 Audio Ease에서 제공하는 임펄스 응답(impulse response, IR)을 이용하실 수도 있고, 이미 가지고 계신 임펄스 응답을 불러와 앰비소닉을 포함한 다양한 채널 구성에 맞춰 쓸 수도 있습니다.",reflect:"<AK_BOLD>Wwise Reflect</AK_BOLD>(와이즈 리플렉트)는 리스너나 이미터가 벽, 천장, 바닥과 같은 반사면과 얼마나 가까운지를 토대로 초기 반사음을 동적으로 렌더링하는 지오메트리 정보 기반 플러그인입니다. Wwise Reflect는 몰입감과 공간 감각을 향상시킬 뿐만 아니라, 제한된 수의 오디오 애셋을 변화무쌍하게 변화하는 환경과 조합함으로써 다양함과 자연스러움을 이끌어냅니다. 또한 Wwise Reflect는 플러그인 전체를 사용자화할 수 있으므로 사운드 디자이너 분들의 예술적인 욕구와, 오늘날의 상호작용 매체의 서사와 스토리텔링에 대한 수요를 모두 만족시켜 드릴 것입니다."}},integrations:{title:"통합(integration)",description:"Wwise Spatial Audio는 자체 개발 엔진과 세계 정상급의 상용 엔진과도 쉽게 통합할 수 있습니다. Wwise Unreal 플러그인과 Wwise Unity 플러그인은 Wwise 저작 도구(Authoring Tool)를 통해서 Reflect 플러그인과 함께 공간, 포털, 3D 배치된 Sound SFX 오브젝트, 음향 텍스처와 같은 기능들을 통해 게임 내 공간 음향 요소들을 통합합니다.",cards:{unreal:"<AK_BOLD>Unreal 5</AK_BOLD> Unreal 5에서의 Wwise Spatial Audio 사용에 대해 <AK_LINK_LEARN_MORE_UNREAL>자세히 알아보세요.</AK_LINK_LEARN_MORE_UNREAL>",unity:"<AK_BOLD>Unity</AK_BOLD> Unity에서의 Wwise Spatial Audio 사용에 대해 <AK_LINK_LEARN_MORE_UNITY>자세히 알아보세요.</AK_LINK_LEARN_MORE_UNITY>"}},wwiseAudioLab:{title:"Wwise Audio Lab (와이즈 오디오 랩)",description:"아이디어를 프로토타이핑하고 다양한 접근 방법들을 평가하며 통제된 가상 환경 안에서 결과물을 다듬어보세요.",cards:{wal:"Wwise Audio Lab(와이즈 오디오 랩, WAL)은 Unreal Engine 4를 사용해 개발된 오픈 소스 게임형 3D 환경이며 Mac, Windows, Oculus, HTC Vive에서 사용 가능합니다. Wwise Audio Lab은 지오메트리 정보를 토대로 하는 동적 초기 반사음, 음향 포털, 지향성 리버브 등의 다양한 공간 음향 수단과 기술을 자랑합니다. 지도 내에 분포된 정보 노드가 소리 전달 현상의 파악을 도와주며, 인게임 옵션으로 다양한 공간 음향 접근법을 바로바로 비교할 수 있습니다. Wwise Audio Lab은 공간 음향의 기능을 실험하려는 목적으로 디자인되었지만, 향후 진행할 프로젝트에 적합한 도구와 방법의 조합을 찾는 분들께서는 본인의 입맛에 맞게 사용자화하여 쓰실 수도 있습니다."},ctas:{getWal:"Wwise Audio Lab 받기"}}}},module:JCt},QCt={"menu-label":"프로필",title:"사용자 프로필"},ZCt={preview:{buttons:{exit:"공개 뷰 종료하기",preview:"공개 프로필 미리 보기"},previewDescription:"이 콘텐츠는 고객님의 프로필이 공개 뷰에서 보이는 방식을 보여줍니다."},visibilityManager:{title:"프로필 공개 설정",description:"Audiokinetic 웹사이트에서 다른 사람이 고객님의 프로필을 보는 방식을 제어합니다. 이 공개 설정은 고객님의 프로필이 '제작자 명단'과 검색 결과에 표시되는 방식을 변경합니다.",mainToggle:"내 프로필 공개하기",profile:"프로필",details:"프로필 세부 정보",about:"관련 정보",experiences:"경력",education:"교육",wwise_certifications:"자격증",portfolio:"포트폴리오",projects:"Wwise 프로젝트",publications:"출판 내용",languages:"언어"}},eBt={title:"아바타 이미지","img-alt":"로드된 아바타 이미지",loadedAvatarImage:"사용자 아바타 이미지",upload:{imageOriginal:"원본 이미지",imagePreview:"아바타 미리보기",imageActual:"실제 크기",imageZoomed:"3배",imageToCrop:"자를 이미지",instruction:"먼저 이미지 파일을 업로드하세요.",dragNDrop:"파일을 선택하거나 <strong>여기로 드래그하세요.</strong>",uploadErrorFileSize:"파일 크기가 제한을 초과합니다. {{AK_VAR_FILE_SIZE_LIMIT}} 미만의 파일을 선택하세요.",uploadErrorFileType:"지원되지 않는 파일 유형입니다. 유효한 파일 유형을 선택하세요 ( {{AK_VAR_FILE_TYPE}} ).",button:"아바타 이미지를 업로드하세요."},formLabels:{avatar:{label:"아바타",placeHolder:""}}},tBt={title:"사용자 정보","no-content":"먼저 성과 이름을 입력해 주세요. <AK_ADD_LINK>여기</AK_ADD_LINK>를 클릭하여 시작해 주세요.",formLabels:{firstName:{label:"이름",placeHolder:"이름을 입력하세요 (필수)."},lastName:{label:"성",placeHolder:"성을 입력하세요 (필수)."},company:{label:"조직 이름",placeHolder:"학교 혹은 회사 (필수 입력 사항)"},companySize:{label:"조직 규모",placeHolder:"학교 혹은 회사"},title:{label:"직함",placeHolder:"학업/업무에 대해 간단히 소개해 주세요."},titleOther:{label:"기타",placeHolder:"직업명 (필수 입력 사항)"},countryCode:{label:"국가",placeHolder:"어디에 거주하고 계신가요?"},avatarImage:{label:"아바타 URL",placeHolder:"AvatarUploader가 여기에 옵니다."},bannerImage:{label:"배너 URL",placeHolder:"BannerUploader가 여기에 옵니다."}},validation:{password:{required:"암호는 필수 입력 사항입니다."},confirmPassword:{required:"암호는 필수 입력 사항입니다."},firstName:{required:"이름은 필수 입력 사항입니다."},lastName:{required:"성은 필수 입력 사항입니다."},company:{required:"조직 이름은 필수 입력 사항입니다."},companySize:{required:"조직 규모는 필수 입력 사항입니다."},title:{required:"직업명은 필수 입력 사항입니다."},titleOther:{required:"'직업명'을 '기타'로 선택하셨기 때문에 '기타' 입력란을 꼭 입력해주셔야 합니다."},countryCode:{required:"국가는 필수 입력 사항입니다."}}},iBt={title:"관련 정보",editing:{defaultItem:"관련 정보",newItem:"새로운 관련 정보 설명",editItem:"관련 정보 설명 편집하기"},"no-content":"자기 소개를 해주세요",formLabels:{about:{label:"관련 정보",placeHol