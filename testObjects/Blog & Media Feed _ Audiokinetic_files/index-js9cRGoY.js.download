`,periodOfTickets:"",ctaPrimary:"联系我们"}},"support-queue-fine-print-1":"每个申请单只涉及一个主题。","support-queue-fine-print-2":"问题按照收到请求的顺序和严重性来排队。<AK_DEEMPHASIZED>（当地工作时间：蒙特利尔 -5 GMT，北京 +8 GMT，东京 +9 GMT）</AK_DEEMPHASIZED>","business-hours":"我们在正常营业时间内提供技术支持：周一至周五，上午9点至下午5点（北美东部标准时间，中国地区采用北京时间）。请注意，节假日期间不提供技术支持服务。 ",holidays:{title:"Audiokinetic 节假日时间表","date-label":"日期","holiday-name":"节假日","holiday-line-date":{single:"{{mon}} / {{dateFrom}}",multiple:"{{mon}} / {{dateFrom}}-{{dateTo}}"}}},"need-help":{title:"还是无法找到所需信息？",subText:"",ctaPrimary:"$t(common:buttons.get-in-touch-bang)"},requests:{requestType:{feature_request:{title:"请求功能",description:"您是否对Wwise有功能提议？在“社区问答”版块告诉我们您希望未来版本提供什么功能或者为其他人的提议投票。",ctaPrimary:"请求功能"},report_a_bug:{title:"报告漏洞",description:"我们会查看记录的所有漏洞报告，并认真评估这些漏洞的修复方案，但不会直接对特定问题做出回应。",ctaPrimary:"报告漏洞"}}},"useful-resources":{title:"实用资源",subTitle:"海量资源，任您查看！",integrations:{title:"集成",resources:[{label:"Unity 集成"},{label:"Unreal Integration"},{label:"WAAPI"}]},documentation:{title:"用户文档",resources:[{label:"$t(doNotTranslate:audiokinetic-launcher)"},{label:"Wwise Help"},{label:"Wwise SDK"}]},samples:{title:"示例",resources:[{label:"$t(doNotTranslate:wwise-adventure-game)"},{label:"Wwise Audio Lab"},{label:"Wwise Authoring API Pack"}]},education:{title:"学习",resources:[{label:"学习材料"},{label:"Wwise 认证"}]}},"wwise-help":{"stand-alone-description":"转到 Wwise <AK_BLACK>社区问答</AK_BLACK>版块求助！提问题，找答案，全球Wwise用户在此分享专业知识。"}},"creative-services":{"menu-label":"创意服务",title:"创意服务",description:"充分借助我们的专业知识，满足自己项目的特定需求。",perks:[{name:"定制化开发"},{name:"工作流程改进"},{name:"项目评审"},{name:"集成支持"}],ctaPrimary:"$t(common:buttons.learn-more)"},documentation:{"menu-label":"用户文档"},"questions-answers":{"menu-label":"问答"},"submit-support-ticket":{"menu-label":"$t(common:buttons.submit-support-ticket)"},"request-feature":{"menu-label":"请求功能"},"report-bug":{"menu-label":"报告漏洞"}},TOt={help:yOt,support:EOt,module:HOt},SOt={"menu-label":"$t(doNotTranslate:audiokinetic)",bannerV2Title:"以声音为媒介，打造全新世界",bannerV2SubTitle:"领略优秀的互动音频技术",bannerCallToAction:{primaryLabel:"$t(common:audiokineticLauncher.download)",secondaryLabel:"$t(common:buttons.learn-more)"},bannerCallToActionMobile:{primaryLabel:"$t(common:buttons.learn-more)"}},VOt={"menu-label":"$t(doNotTranslate:audiokinetic)",integrations:{title:"集成",description:"Audiokinetic 解决方案可轻松整合到各类技术平台（包括嵌入式系统）。"},platforms:{title:"平台",description:"Audiokinetic 可提供跨平台音频解决方案。"}},COt={title:"集成",description:"Audiokinetic 解决方案可轻松整合到各类技术平台（包括嵌入式系统）。"},BOt={title:"平台",description:"Audiokinetic 可提供跨平台音频解决方案。"},IOt={title:"AK 博客","interaction-bubble":"<AK_LINK>订阅 AK 博客</AK_LINK>以便及时了解业界最新动态、Wwise 使用技巧及互动音频创作幕后的故事！"},OOt={home:SOt,module:VOt,"home-cards":{"card-a":{title:"突破创新的互动音频技术",description:"Audiokinetic 是全球领先的跨平台互动音频解决方案提供商之一，可为用户提供性能先进、功能可扩展的音频设计工具。作为领先开发商、OEM 和音频制作公司值得信赖的合作伙伴之一，其旗舰产品 <AK_WWISE_PRODUCT_PAGE>Wwise</AK_WWISE_PRODUCT_PAGE> 已成为业界标配互动音频引擎之一。除此之外，公司还推出了首个以即时可编辑多轨格式提供的音效库 <AK_STRATA_PRODUCT_PAGE>Strata</AK_STRATA_PRODUCT_PAGE>。"},"card-b":{title:"让音频社群如虎添翼",description:"多年来，Audiokinetic 积极整合全球各界资源，以期推动沉浸音频技术的不断发展，并更好地服务互动音频创作者社区。欢迎携手 Audiokinetic，共建互动音频社区，促进业内交流合作。"},"card-c":{title:"培养下一代音频创作者和教育工作者",description:"目前，全球有 400 多所大学和学术机构与 Audiokinetic 建立合作关系，致力于优化互动音频教学课程并设法提高学员技能水平。通过学习相关互动音频课程，您可以获得业内公认的资质，成为认证用户或教育工作者，为个人或团队提供培训服务。"}},integrations:COt,platforms:BOt,blog:IOt,"related-videos":{title:"视频频道","dynamic-interaction-bubble":{YOUTUBE:"<AK_LINK>订阅 Audiokinetic 的 YouTube 频道</AK_LINK>，在学习中获得创作灵感！",BILIBILI:"<AK_LINK>订阅 Audiokinetic 的 BiliBili 频道</AK_LINK>，在学习中获得创作灵感！"}}},NOt={"page-title":"Audiokinetic Trademarks","page-info":"<AK_BIG_AND_BLACK>List of Trademarks </AK_BIG_AND_BLACK>","page-description":`<AK_ITALIC>Last Updated {{last_update_date}}</AK_ITALIC>

The following is a non-exhaustive list of Audiokinetic’s trademarks.

The absence of a trademark from this list does not constitute a waiver of Audiokinetic’s trademark or other intellectual property rights concerning that name.
`,"guidelines-title":"<AK_BIG_AND_BLACK>Trademark Guidelines<AK_BIG_AND_BLACK>","other-trademarks":"<AK_BIG_AND_BLACK>Other Trademarks<AK_BIG_AND_BLACK>","guidelines-description":`You may use the Audiokinetic trademarks if such use constitutes a truthful and accurate reference to Audiokinetic products or services for the purpose of, explanation, information, or as an indicator of compatibility.

If you are a licensee of an Audiokinetic trademark or logo and have been provided with special trademark usage guidelines with your license agreement, please follow those guidelines. If your license agreement does not provide usage guidelines, then follow these guidelines.

When using the marks in publications that will be distributed only in the United States, include the appropriate ™, ℠, or ® symbol on first use. For publications that will be distributed outside the United States, do not include trademark symbols. Instead use the appropriate trademark attribution notice, for example: Wwise is a trademark of Audiokinetic Inc., registered in the U.S. and other countries. Any use of the Audiokinetic trademarks or logos must be accompanied by a notice that clearly indicates that the Audiokinetic trademarks or logos are trademarks of Audiokinetic Inc.

Audiokinetic reserves the right in its sole discretion to terminate or modify your permission to display the Audiokinetic trademarks and to take action against any use that does not conform to these guidelines, infringes any Audiokinetic intellectual property or other right, or violates applicable law.  All Audiokinetic trademarks are provided “as is”, and Audiokinetic disclaims any implied or express warranties regarding the same, including warranties of non-infringement.

Please refer to our specific guidelines for <AK_LINK_IN_GAME_CREDITS>In-game Credits</AK_LINK_IN_GAME_CREDITS> and other credits.`},xOt={trademarks:NOt,"legal-notice":{title:"",description:"<AK_NOTICE_LINK>Legal notice</AK_NOTICE_LINK>  Copyright © {{AK_VAR_CURRENT_YEAR}} Audiokinetic Inc. 和 Conservatory of Recording Arts & Sciences。保留所有权利。<AK_ICP_LINK>沪ICP备2020034184号-1</AK_ICP_LINK><AK_PSB_LINK>沪公网安备 31010402009871号</AK_PSB_LINK>"}},KOt={"menu-label":"授权和订阅",title:"授权和订阅",strata:{tabLabel:"Strata","no-subscriptions":{title:"未找到授权",description:"若要为此帐户添加授权，请访问我们的<AK_LINK_TO_STRATA_STORE>商店</AK_LINK_TO_STRATA_STORE>"},subscriptions:{title:"订阅",productName:"产品",owner:"所有者",status:"项目状态",expiration:"过期",nextPayment:{nextPaymentLabel:"下一账单日期为 <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>。",nextGuaranteedPaymentLabel:"<AK_BOLD>{{nextPaymentAmount}}</AK_BOLD> 的下期付款将在 <AK_BOLD>{{nextPaymentDate}}</AK_BOLD>处理。",guaranteedPriceLabel:"您享受的折扣价将在 <AK_BOLD>{{guaranteedPriceUntil}}</AK_BOLD>予以重新评估。"},installment:{date:"分期付款日期",amount:"金额",status:"项目状态","no-installments-personal":"近期无需支付任何款项","no-installments-project":"近期无需支付任何款项","no-installments-enterprise":"预留给所有者的部分"},subscriptionCancellation:{title:"取消订阅",confirm:'您确定要取消订阅 "{{AK_VAR_SUBSCRIPTION_NAME}}" 吗？',fee:"<AK_BOLD>取消费用：{{AK_VAR_CANCELLATION_FEE}}</AK_BOLD><br /><AK_BOLD>付款方式：默认银行卡 ({{AK_VAR_DEFAULT_CARD}})</AK_BOLD>","fee-description":"根据<br /><AK_LINK_TO_DOCUMENTS>订阅协议</AK_LINK_TO_DOCUMENTS>，提前终止协议会<AK_RED>收取相应费用</AK_RED>。","successful-cancellation":"您的“{{AK_VAR_SUBSCRIPTION_NAME}}”已成功取消。"}},"asset-download":{title:"Strata 合集",description:"通过 $t(doNotTranslate:audiokinetic-launcher) 就可直接下载合集",ctas:{primary:"$t(audiokineticLauncher.open)",secondary:"$t(audiokineticLauncher.download)"}},downloads:{title:"下载",plugins:"插件",version:"版本",installer_links:"安装程序"},"license-agreements":{title:"授权协议","i-agree-bullet-link":"<AK_BULLET>{{AK_FILE_NAME}}</AK_BULLET>","accept-and-sign":"同意所有授权协议"},licenses:{title:"授权",type:"类型",licenseKey:"激活密钥",status:"项目状态",productName:"关联产品",licenseKeyCopied:"授权密钥已复制"},"need-help":{title:"需要帮助？",description:"如对订阅存有任何疑问，请告知我们。",ctas:{primary:"联系 Audiokinetic 代表"}}},wwise:{tabLabel:"Wwise",licenses:{title:"",type:"",status:"","relates-to-name":"","relates-to-id":"",licenseKey:"",expirationDate:""}}},ROt={module:KOt},POt={bannerV2Title:"Audiokinetic 产品授权常见问题解答",bannerSubTagline:"","faq-dropdown-selector":"您对哪种授权感兴趣？ ",faq:{strataLicenses:{tabLabel:"Strata 授权",content:{q01:{title:"我是否可以使用所有 Strata 合集？",content:"是。只要您购买了付费订阅，就可使用所有 Strata 合集。免费订阅仅允许使用示例合集。"},q02:{title:"使用 Strata 需要支付多少费用？",content:"详请参见<AK_STRATA_PRICING_LINK>定价</AK_STRATA_PRICING_LINK>页面。"},q03:{title:"在订阅期间，订阅费用是否会发生变化？",content:"No. 在确认以具体价格订阅后，其在整个订阅期间都是适用的。"},q04:{title:"我需要什么时候支付费用？",content:"Strata 费用可以按年分期付款。"},q05:{title:"订阅的期限是多久？ ",content:"Strata 提供 1-3 年期的各种定制订阅方案，可灵活满足个人和企业用户的特定需求。学生和老师还可选择特别优惠的 1 年期学术方案。有关更多详细信息，请参阅<AK_STRATA_PRICING_LINK>定价</AK_STRATA_PRICING_LINK>页面。"},q06:{title:"如果我忘了更新信用卡信息而无法成功付款怎么办？",content:"您会收到我们向您发送的消息，其中会告知您遗漏了一笔款项，您有 30 天的时间更新付款信息，以确保可以继续使用订阅服务。倘若我们无法在 30 天内处理您的付款，我们会与您联系并商议其他付款方式。"},q07:{title:"我是否可以在购买订阅前试用 Strata？",content:"是。我们通过<AK_FREE_SUBSCRIPTION_LINK>免费订阅</AK_FREE_SUBSCRIPTION_LINK>方式提供了示例工程，其中涵盖了来自各个 Strata 合集的示例。"},q08:{title:"我可以在哪里查看 Strata 的相关条款和条件？",content:"详见 <AK_STRATA_LICENCING_AGREEMENT>Strata 授权协议</AK_STRATA_LICENCING_AGREEMENT>和<AK_STRATA_SUBSCRIPTION_AGREEMENT>订阅协议</AK_STRATA_SUBSCRIPTION_AGREEMENT>。"},q09:{title:"我可以取消自己的订阅吗？",content:"您可以点击<AK_STRATA_PRICING_LINK>此处</AK_STRATA_PRICING_LINK>来详细了解 Strata 提供的各种订阅模式。在订阅到期后，会根据商定的条款续订。依据当地消费者法律法规，所有已付款项均不予退款，且需偿付剩余未付的部分。您的订阅会一直持续到当前付费期限结束。"},q10:{title:"订阅到期后会发生什么？",content:"您会收到关于订阅即将到期的通知以及跟您的方案相关的最新定价信息。届时，您可以选择续期并设定一个新的期限。"},q11:{title:"我需要可供团队多个成员使用的订阅。贵司是否设有允许组织集中管理订阅的方案？",content:"是。我们提供有企业订阅方案，方便组织向团队成员指派席位并进行集中管理。 "},q12:{title:"什么是企业订阅？",content:`企业订阅方便组织管理多个用户。

有关企业订阅的更多详细信息，请联系并咨询 Audiokinetic 代表。`},q13:{title:"如果在首次订阅期间有新的成员要获取权限或有部分成员离开团队该怎么办？",content:`您随时都可以增加企业席位数量。

您可以修改并设定可使用 Strata 的人员，只要用户总数不超过所购席位数就行。

如果需要对企业订阅做出调整，请直接联系 Audiokinetic 代表。`},q14:{title:"我可以对下载的声音做哪些处理？",content:`只要 Strata 订阅有效，就可执行以下处理：
    1) 编辑声音
    2) 渲染声音
    3) 将声音添加到 SFX 库
    4) 同步到正在开发的产品中`},q15:{title:"在对声音的处理方面是否有限制？",content:`是。源媒体、预渲染媒体和用户再创作媒体不能作为音频素材库重新打包或转售。
有关授权限制的详细信息，请参阅《Strata 授权协议》的第 3 节。

如果您要将 Strata 用于任何标准协议规定以外的目的，请联系我们的销售团队。`},q16:{title:"在声音经过渲染后，我可以对它们做哪些处理？",content:`您可以将经过渲染的声音放在任何媒体中并永久使用它们，只要是在有效订阅期限内将渲染媒体同步到产品中就可以。

比如，您可以将其用在任何手机、桌面或主机电子游戏及博客或直播中，将其添加到乐曲、电影或现场戏剧/音乐作品中，通过广播或电视进行播放，将其用在广告中，或者发布到 YouTube、Facebook、Instagram、TikTok 或其他社交媒体上。 `},q17:{title:"在订阅到期后，我可以对自己设计的声音做哪些处理？",content:`如果是在订阅期间在遵守 <AK_STRATA_LICENCING_AGREEMENT>Strata 授权协议</AK_STRATA_LICENCING_AGREEMENT>的情况下将声音整合到产品中，即便是在订阅到期之后，您也可以自由地将这些声音作为产品的一部分来继续使用。

不过，您所创建或编辑的声音仅可重复用在直接依赖于原始作品（包含首次发布的声音）的项目（如续集包或扩展包）中。否则，将无法再创建任何新的声音或使用任何通过 Strata 获取的源声音或渲染声音。`},q18:{title:"免提成是什么意思？",content:"免提成意味着您不需要为出于个人或商业目的将 Strata 声音文件整合到任何音频或多媒体作品中而支付任何额外的费用。在订阅 Strata 后，您就拥有了随时随意将所述声音用在各个项目中的许可。在订阅期间，您不需要为用在这些项目中的 Strata 声音另外支付任何形式的费用。 "},q19:{title:"我是否可以转售原始 Strata 声音或使用 Strata 再创作的原始声音？",content:"No. Strata 声音不允许以单独文件的形式复制、转售或分发。它们只能与在订阅期间所整合或同步到的产品一起转售和分发。"},q20:{title:"我如何才能获取打开这些声音所需的软件？",content:`所有必要的 VST3 插件（ENRAGE、Wwise 和 IEM）都涵盖在了订阅中，并且可从 $t(doNotTranslate:audiokinetic-launcher) 下载。

不过，您需要自行安装所需 <AK_REAPER_LINK>REAPER</AK_REAPER_LINK> 版本，因为其并不包括在 Strata 订阅中。 `},q21:{title:"我可以将自己的订阅转让给其他人吗？",content:`个人订阅是不可转让的。

企业订阅允许在同一组织内转让席位。`},q22:{title:"在什么情况下会需要企业订阅？",content:"在需要 1 个以上席位或者代表组织进行购买的时候，需要选择企业订阅。"},q23:{title:"我可以将授权的 Strata 声音放在多个电脑上吗？ ",content:"对于企业订阅，所有使用 Strata 内容的用户必须具有分配给其 Audiokinetic 帐户的有效企业授权。对于个人订阅，您可以依据订阅协议的相关条款来对 Strata 内容进行备份。"},q24:{title:"授权是否涵盖损害赔偿？",content:"是。有关详细信息，请参阅 Audiokinetic <AK_STRATA_LICENCING_AGREEMENT>Strata 授权协议</AK_STRATA_LICENCING_AGREEMENT>。"},q25:{title:"作为承包商，我是否可以在为客户创建的项目中使用 Strata？",content:"是。您有权对 Strata 工程提供的原始 Strata 声音或渲染好的声音进行编辑和渲染并将其作为工程的一部分转售给您的客户。但是，您无权单独转售原始 Strata 声音或自己再创作的 Strata 声音元素。"},q26:{title:"Strata 目前都有哪些知识产权保护措施？",content:"我们会通过知识产权的使用（包括商标、专利和版权）来保护 Strata。"},q27:{title:"在订阅某项 Strata 授权后，我要怎样才能获取发票？",content:"登录 Audiokinetic 帐户并转到“交易历史记录”即可找到。如果出示的发票不符合您的要求，请直接联系您的销售代表或发送邮件至 sales@audiokinetic.com 以请求转为企业授权。我们支持 B2B 付款方式并可签发 VAT 普通/专用发票。"},q28:{title:"我可以一次性预付 3 年的订阅费用吗？",content:"您可以直接联系 <AK_CONTACT_SALES_LINK>Audiokinetic 销售代表</AK_CONTACT_SALES_LINK>来商讨其他付款方式（包括为整个订阅预付费用）。"},q29:{title:"我在用自己的母语填写付款信息。为什么在付款的时候会遇到错误？",content:"我们抱歉为您带来不便。我们的支付系统目前仅支持西文字符。请用英语而非您的母语输入各项信息。倘若错误仍然存在，请尝试将网站语言切换为英语。"},q30:{title:"我可以订阅 Strata 并让多个用户使用我的 Strata 订阅吗？",content:"这不符合 Strata 授权和订阅协议的规定。其他用户要分别购买个人订阅；若为同一雇主工作，可以购买企业订阅。您的帐户只能自己用，不可以跟其他人共用。您可以向他人展示自己的 Strata 工程，但不可以让别人借用您的 Strata 授权。"}}}}},UOt={licensing:POt},DOt=JSON.parse('{"menu-label":"Strata","bannerV2Title":"突破创新的音效库，业内人士精心打造","bannerV2SubTitle":"","bannerV2Description":"Strata 多轨音效合集采用分层式设计，可帮助您简化工作流程并提升创作效率。","pricing-plans-secondary-banner":{"bannerV2Title":"提供灵活的定价方案，满足每位创作者的需要","bannerV2SubTitle":"选择适合自己的定价方案，来实现各种声音设计构想。"},"contextual-banner-image-alt":"Strata 徽标","subscribe-strata-newsletter":{"title":"及时了解有关 Strata 的最新资讯！","subTitle":"创建 Audiokinetic 帐户来订阅 Strata 简讯并及时了解所有最新发布内容。","subTitleLoggedIn":"订阅 Strata 简讯并及时了解所有最新发布内容。","ctaPrimary":"$t(common:buttons.create-account)","callToActionLoggedInLabel":"$t(common:buttons.subscribe-strata-newsletter)"},"bannerCallToAction":{"primaryLabel":"获取免费示例","secondaryLabel":"马上订阅","tertiaryLabel":"探索合集","gotoPricingPage":"查看方案","subLabel":"+++ Strata 合集专为游戏和互动音频制作而设计。您可以利用其轻松打造自己独有的声音。 "},"the-making-of-banner":{"title":"为互动音频制作精心打造","description":"Strata 不仅提供有声音设计所需的音效素材，还可助您建立完善的互动音频制作工作流程。您可以根据需要修改每个元素，来将自己的创作构想变为现实。\\n\\n 最终，将 Strata 完全融入到工作流程中，变成日常设计密不可分的一部分。","alt-text":"《The Making of Strata》- 点击图片弹出视频","label":"观看《The Making of Strata》","targetLink":"https://www.youtube.com/embed/KEynYDyY6eI"},"promo-video":{"title":"即时可编辑声音库，以多轨工程形式提供","label":"观看视频"},"collections":{"title":"探索合集","cardAltText":"{{CARD_NAME}} 卡片图像","soundCount":"{{count}} 个声音","current":{"label":"合集","labelCount":"({{collectionCount}})"},"ctas":{"view-all-collections":"查看所有合集"},"coming-soon":{"label":"即将发布","labelCount":"({{collectionCount}}) 2022 年 10 月"},"release-schedule":{"title":"发布时间表"},"collection-names":{"aircraft":"Aircraft（飞行器）合集","ambience-detailed-rain":"Ambience Detailed Rain（雨水环境声）合集","ambience-doom":"Ambience Doom（末世环境声）合集","ambience-fantasy":"Ambience Fantasy（奇幻环境声）合集","ambience-medieval":"Ambience Medieval（中古环境声）合集","ambience-nature":"Ambience Nature（自然环境声）合集","ambience-scifi":"Ambience Scifi（科幻环境声）合集","ambience-urban":"Ambience Urban（城市环境声）合集","ambience-warfare":"Ambience Warfare（战争环境声）合集","ambience-fire-water":"Ambience Fire and Water（水火环境声）合集","ambience-space-station":"Ambience Space Station（空间站环境声）合集","animal-domestic":"Animal Domestic（家养动物）合集","animal-wild":"Animal Wild（野生动物）合集","bullets":"Bullets（子弹）合集","cannons":"Cannons（火炮）合集","cinematic-hits":"Cinematic Hits（过场打击）合集","close-combat":"Close Combat（近战）合集","combat-groups":"Combat Groups - Walla（战斗群体 – 群杂）合集","combat-groups-p2":"Combat Groups - Callouts（战斗群体 – 呼喊声）合集","creature":"Creature（生物）合集","creature-ancient":"Creature Ancient（远古生物）合集","creature-humanoid":"Creature Humanoid（类人生物）合集","creature-movement":"Creature Movement（生物动作）合集","doors":"Doors（门户）合集","doors-historical":"Doors Historical（老式门户）合集","doors-scifi":"Doors Scifi（科幻门户）合集","explosions":"Explosions（爆炸声）合集","footstep":"Footstep（脚步声）合集","gore":"Gore（血腥）合集","historical-firearms":"Historical Firearms（老式枪支）合集","human-movement":"Human Movement（人类动作）合集","heavy-weapons-medieval":"Heavy Medieval Weapons（中古重武器）合集","interactable-objects":"Interactable Objects（可交互物体）合集","magic":"Magic（魔法）合集","medieval-weapons":"Medieval Weapons（中古武器）合集","modern-firearms":"Modern Firearms（现代枪支）合集","physics":"Physics（物理）合集","physics-debris":"Physics Debris（物理碎屑）合集","physics-destruction":"Physics Destruction（物理破坏）合集","quadcopters":"Quadcopters（四轴飞行器）合集","robotic":"Robotic（机器人）合集","scifi-weapons":"Scifi Weapons（科幻武器）合集","sorcery_absorption":"Sorcery Absorption（吸收法术）合集","sorcery-strike":"Sorcery Strike（攻击法术）合集","sorcery-whimsical":"Sorcery Whimsical（古怪法术）合集","spaceships":"Spaceships（宇宙飞船）合集","space-station":"Space Station（空间站）合集","space-station-ambience":"Space Station Ambience（空间站环境声）合集","submersion":"Submersion（浸没）合集","ui-general":"UI General（UI 通用）合集","ui-modern":"UI Modern（UI 现代）合集","ui-organic":"UI Organic（UI 有机）合集","vehicles":"Vehicles（车辆）合集","voice":"Voice（语音）合集","warfare":"Warfare（战争）合集","wwi-firearms":"WWI Firearms（一战枪支）合集","wwi-shotguns":"WWI Shotguns（一战霰弹枪）合集","wwi-pistols":"WWI Pistols（一战手枪）合集","wwi-rifles":"WWI Rifles（一战步枪）合集","wwii-firearms":"WWII Firearms（二战枪支）合集","zombies":"Zombies（僵尸）合集","strata-sample-01":"Strata Sample 01（Strata 示例 01）合集","strata-sample-02":"Strata Sample 02（Strata 示例 02）合集","strata-sample-03":"Strata Sample 03（Strata 示例 03）合集","strata-sample-04-wwi":"Strata Sample 04（Strata 示例 04）合集"}},"testimonials":{"title":"来自音频专业人士的评价"},"stand-alone-descriptions":{"description-a":[{"text":"<AK_BLACK>Strata™</AK_BLACK> 可为声音设计提供极大的便捷，让您可以专注于实现自己的创作构想。它是一个专为互动音频制作精心打造的优质声音库。合集包含由专业人士构建的完整多轨 REAPER 工程，其所有原始音频源都可根据需要定制来实现各种变化，从而帮助您毫不费力地为自己的项目打造独有的声音。我们每个月都会发布新的 Strata 合集，均出自顶尖声音设计师和 SFX 提供商，让您可以随时获取与自己相关的录音。马上订阅 Strata 库，尽情实现创作构想！ \\n"}]},"free-samples":{"title":"$t(common:labels.free-samples)","cta-label":"获取免费示例"},"library-list":{"title":"Strata","titleCount":"({{collectionCount}})","cta-label":"购买订阅","view-upcoming-releases":"查看即将发布的合集"},"overview-faq":{"title":"常见问题解答","section-data":{"q01":{"sectionTitle":"我是否可以免费试用 Strata？","description":"是！您可以点击<AK_LINK_1>此处</AK_LINK_1>订阅免费的示例合集。这些免费示例合集中所含的 ENRAGE 插件是只读的。也就是说，您没有办法编辑效果器的属性。不过，所有声音素材都无需支付提成费，您可以放心地用在自己的项目中。"},"q02":{"sectionTitle":"在使用 Strata 之前都需要什么？","description":"Strata 合集采用精心选择的多轨 DAW – REAPER – 构建。为充分发挥 Strata 的多轨优势，需要提前安装所需 REAPER 版本。有关 Strata 快速入门的更多技术细节，请参阅<AK_LINK_1>功能</AK_LINK_1>页面。"},"q03":{"sectionTitle":"我如何能获得支持或更多信息？","description":"如有其他疑问或遇到关于 Strata 或相关插件的技术问题，请访问<AK_LINK_1>社区问答</AK_LINK_1>版块。\\n\\n还是无法找到答案？<AK_LINK_2>点此发布新问题</AK_LINK_2>。"}}},"needed":{"title":"所需工具","section-data":{"needed_01":{"sectionTitle":"REAPER","description":"Strata 合集可结合 REAPER 使用。不过，要安装 REAPER 才能使用其多轨功能。\\n\\n有关 REAPER 的详细信息，请访问 <AK_LINK_1>https://www.reaper.fm/</AK_LINK_1>。"},"needed_02":{"sectionTitle":"插件","description":"Strata 插件可无缝增强 Strata 设计软件，为 3D 设计提供专用的工具来提高效率，帮助用户精准实现增强体验的设计目标。","logos":{"wwise-vst":"Wwise VST3 插件","iem":"IEM 插件","enrage":"Enrage 插件"}},"needed_03":{"sectionTitle":"集成","description":"通过将 Strata 与 Soundly、Basehead 和 Soundminer 集成，您可以使用内嵌元数据快速进行搜索，并在给定时间线位置打开 Strata REAPER 工程，以便根据需要对声音素材做个性化的调节。<br/><br/>查看<AK_LINK>《Strata 用户指南》</AK_LINK>来了解如何使用这些集成包。","logos":{"soundly":"Soundly","soundminer":"Soundminer","basehead":"BaseHead"}},"needed_04":{"sectionTitle":"Strata 工具","blocs":{"b00":{"description":"为了加快 Strata 工作流程，Audiokinetic 开发了一系列 REAPER 扩展和脚本。"},"b01":{"title":"<AK_LINK>ReaWwise</AK_LINK>","description":"有了 ReaWwise，只需点击一次就可快速地将单个声音甚至整个层级结构直接从 REAPER 导出到 Wwise。既可构建 Wwise 对象层级结构并保存为预设，又可使用通配符自动命名。"},"b02":{"title":"<AK_LINK>Open Associated REAPER Project</AK_LINK>","description":"快速迭代非常重要。此脚本可直接从 Wwise 打开与 Strata 音频文件关联的 REAPER 工程，并利用 Strata 音频文件中嵌入的元数据查找原始声音。"},"b03":{"title":"<AK_LINK>Strata_Copy Selection to Next Project</AK_LINK>","description":"此 REAPER 脚本软件包可轻松将媒体项、音轨和插件从某一 REAPER 工程复制到另一 REAPER 工程。"},"b04":{"title":"从哪里获取？","description":"<AK_LINK_1>REAPER Tools</AK_LINK_1> 是我们的 GitHub 存储库。\\n\\n要安装和更新各种 Strata 工具，<AK_LINK_2>ReaPack</AK_LINK_2> 是最便捷的方式。"}}}}},"tips-tools":{"title":"工具、技巧及概览"},"learn-with-videos":{"title":"通过 Strata 视频学习"},"overview-community-videos":{"title":"Strata 社区视频"},"strataContains":{"title":"Strata 概览","description":"","projects":"REAPER 工程","size":"GB","collections":"合集","soundEffects":"音效","soundItems":"素材"},"strata-benefits":{"title":"Strata – 获取突破创新的音效库，充分发挥自身创作潜力","section-data":{"creative-control":{"sectionTitle":"完全掌控，灵活定制","main":{"description":"素材已经备好，想到就能做到！凭借 Strata 的分层架构，您可以访问所有必要元素（如片段、音轨、音效和源文件），并按照自己的创作构想对声音进行个性化的调节。"}},"dynamic-gameplay":{"sectionTitle":"灵活调节素材，实现各种变化","main":{"description":"对互动音频来说，多样变化很重要。Strata 允许根据需要调节原始素材，以此来实现各种各样的声音变化。"}},"learn-from-the-best":{"sectionTitle":"向业内顶尖人士学习，打造独有标志性声音","main":{"description":"声音设计就像魔术一样，通常只见台前不见幕后。Strata 允许直接访问由顶尖声音设计师精心打造的多轨会话。您可以学习他们的创作手法，参考其工作流程和设计创意，打造自己独有的标志性声音。"}},"consistency-by-design":{"sectionTitle":"协调一致，浑然一体","main":{"description":"Strata 提供始终如一的优质音频素材，以确保能够组合出协调的音频效果。您可以将声音轻松整合到游戏中，从而打造出浑然一体的音频体验。"}}}},"benefits":{"title":"Strata 的优势","customization":{"title":"根据创作需要灵活定制，来实现各种各样的变化","description":"多轨合集不断增加，包含各种必要的元素：片段、音轨、未渲染音效及源文件。您可以根据创作需要灵活定制，以此实现各种各样的声音变化。"},"consistency":{"title":"结构协调一致，简化工作流程","description":"所有合集、多轨工程布局、音效和 UCS 标准元数据全部采用协调一致的结构。通过与 REAPER、Soundminer、Soundly、Wwise 和 Basehead 集成简化工作流程。"},"efficiency":{"title":"节省时间，提高效率","description":"减少搜索、编辑和整理声音的时间，从而把精力放在实际的设计工作上。每个月都会发布新的合集，全部出自顶尖声音设计师。无需费力查找、整理和编辑渲染的声音，避免将不一致的声音文件混在一起使用，最大限度地降低自己花在录音上的成本。"},"top_tier":{"title":"顶尖人士打造，不断增添合集","description":"我们每个月都会发布新的 Strata 合集，均出自顶尖声音设计师和 SFX 提供商，助力您根据需要定制来实现各种变化。"},"reverse_engineering":{"title":"逆向设计，快速学习","description":"向业内最优秀的声音设计师学习，领略其别出心裁的声音设计创意。参照现成示例进行逆向设计，快速熟悉其中的方法和窍门。"}},"plugins":{"title":"插件","description":"Strata 插件无缝增强 Strata 设计软件，为 3D 设计提供专用工具来提高效率，帮助用户精准实现自己的设计目标。借助这些强大的附加组件，来提升 Strata 的使用体验。"},"integrations":{"title":"集成","description":"通过与 Soundly、Soundminer 和 basehead 无缝集成来增强 Strata 工程，快速获取自己想要的优质声音并以此实现视觉和听觉体验的完美融合。"},"partners":{"title":"合作伙伴","description":"通过无缝集成简化工作流程，利用创新工具提升创作效率。"},"production-partners":{"title":"合作伙伴","description":"我们与业内顶尖录音师和设计师合作，为用户量身打造了一系列优质的合集。","partners":{"boom":{"title":"","description":"我们与业界知名的音效提供商 Boom Library 合作，携手推出了精心制作且种类繁多的优质声音素材，赢得了电影、游戏和媒体制作等各界人士的信赖。"},"digitalRainLab":{"title":"","description":"Digital Rain Lab 汇集了一众专业的声音设计师和技术实现人员，积累了从电影摄影到自研互动音频系统开发在内的各类经验。在这里，您可以找到可满足任何项目需要的优质音效库。"},"rockTheSpeakerBox":{"title":"","description":"我们是一支屡获殊荣的专业音频团队，目前已经拥有二十年的声音设计经验，并曾为多种平台开发过 AAA 游戏大作。团队成员对录音和设计充满热情，并且对游戏制作有着深入的了解。我们推出的合集中包含各种优质的音效素材，可帮助您将游戏的声音设计提升到新的水平。"},"soundexMachina":{"title":"","description":"我们是一支由录音师和声音设计师组成的小型敏捷团队，专注于为全球各地的声音设计师、游戏开发者和电影制作人提供免提成的高品质音效库。"},"spectravelers":{"title":"","description":"Spectralevers 是个对声音设计充满热情的小团队，致力于为用户提供优质的音效和原创声音素材。"},"monsterFactory":{"title":"","description":"Monster Factory 在声音创作、配音表演、本地化、语音指导和声音设计等领域拥有独特的专长，擅长为各种虚拟的怪物和生物制作生动逼真的音效。"},"biquette":{"title":"","description":"Biquette Studio 团队在电子游戏行业有 20 年的丰富经验，致力为纪录片、电影和游戏捕捉并塑造真切的自然声景。我们的核心理念是借助 Ambisonics 和 3D 双耳录音技术增强声音的沉浸感和空间表现力。"},"aftertouch":{"title":"","description":"Aftertouch Audio 是一个由录音师和声音设计师组成的小团队，致力于打造高品质、免提成的音效库。"}}},"what_you_need":{"title":"所需工具","cards":{"reaper":{"title":"REAPER","description":"Strata 合集采用精心选择的多轨 DAW – REAPER – 构建。\\n\\n为充分发挥 Strata 的多轨优势，需要提前安装所需 REAPER 版本。\\n\\n有关 REAPER 的详细信息，请参阅 <AK_REAPER_LINK>https://www.reaper.fm/</AK_REAPER_LINK>"}}},"with_reawwise":{"title":"借助 ReaWwise™ 就可轻松将素材从 REAPER 导入到 Wwise 中","cards":{"reawwise":{"title":"ReaWwise","description":"ReaWwise 是由 Audiokinetic 开发的 REAPER 扩展，方便将 REAPER 音频素材导入到 Wwise 工程中。该扩展可利用 REAPER 的渲染配置简化并自动创建复杂的 Wwise 层级结构。\\n\\n马上通过 <AK_REAPACK_LINK>ReaPack</AK_REAPACK_LINK> 下载，以此来加快工作流程。"}}},"what_you_get":{"title":"所含内容","cards":{"strata":{"title":"为期三年的 Strata 订阅","description":"作为订阅者，您可以使用 Strata 的所有<AK_STRATA_COLLECTIONS>声音合集</AK_STRATA_COLLECTIONS>和插件。而且，每月都会增添新的合集。\\n\\n目前，Strata 包含：\\n<AK_BULLET>{{AK_COLLECTION_COUNT}} 个合集</AK_BULLET>\\n<AK_BULLET>{{AK_SOUND_FX_COUNT}}+ 音效</AK_BULLET>\\n<AK_BULLET>{{AK_SOURCE_ITEM_COUNT}}+ 源素材</AK_BULLET>\\n\\n有关即将推出的合集，请参阅<AK_STRATA_RELEASE_SCHEDULE>发布时间表</AK_STRATA_RELEASE_SCHEDULE>。"},"vst":{"title":"Wwise VST3 Plug-in Suite","description":"成套 Wwise 插件，移植为 VST3 格式。\\n\\n插件具有直观反映自身功能的名称，其运行与 Wwise 中所用运行时版本相同的代码，稳定且高效。完整文档详见此处：<AK_WWISE_EFFECT_PLUGINS>Wwise 效果器插件</AK_WWISE_EFFECT_PLUGINS>\\n\\n插件免费提供并依据 Wwise 工程授权的条款和条件授权。如果您在使用 Wwise，即便 Wwise 工程为评估授权也可获得相应授权。\\n\\n这些插件在整个 Strata 中均有使用，请务必加以安装。"},"enrage":{"title":"ENRAGE 插件","description":"<AK_ENRAGE_VIDEO_LINK>ENRAGE</AK_ENRAGE_VIDEO_LINK> 是一款由 BOOM Library 开发的多模块 FX 处理插件。它提供 50 多个明确分为不同类别的工具：In/Out、Delay、Distortion、Modulation、Generator、Pitch、Filter、Imaging、Reverb、Analyzer、Gain & Dynamics。其有十个可用调制源：Curve、ADSR、Envelope Follower、LFO、Mapping、Delay、Transient Follower、Change Analyzer、Pitch Tracker 和 Formula（数学应用）。\\n\\n这个插件使用起来非常灵活，在 REAPER 工程中有广泛应用，所有预设均由 BOOM 设计师为 Strata 精心创建。\\n\\n在订阅 Strata 后，会配套提供 ENRAGE 授权。ENRAGE 插件需要一个免费的 iLok 帐户，并且需安装 iLok 管理软件以便获取授权。"},"iem":{"title":"IEM Plug-in Suite","description":"一款免费的开源音频插件套件，包含 Ambisonics 插件（最高 7 阶），由 Institute of Electronic Music and Acoustics 师生打造。全部详情参见此处：\\n<AK_IEM_LINK>https://plug-ins.iem.at/</AK_IEM_LINK>\\n\\n对于所有使用 Ambisonics 的合集，Strata 使用 VST3 版本的 IEM 套件。目前，只有环境声合集使用 Ambisonics。REAPER 工程设为以 3 阶 ACN 混音，并使用 IEM 套件的解码器输出为各种格式，包括立体声、双声道到八声道 3D 及 1 阶、2 阶和 3 阶 Ambisonics。"}}},"faq":{"title":"常见问题","description":"","other-faq-links":{"licensing":"常见授权问题解答","community":"社区常见问题解答"},"content":{"q01":{"title":"Strata 是什么？","content":"Strata 是一项订阅服务，其允许用户使用以多轨格式提供的一系列声音合集。Strata 由 Audiokinetic 开发，可结合 REAPER 使用。"},"q02":{"title":"Strata 有何独特之处？","content":"Strata 以多轨格式提供，内容被分成了不同的音轨，允许调节剪辑片段和效果器的各项设置。相较于其他库，Strata 允许声音设计师完全掌控渲染声音的各项要素（剪辑片段、音频源、效果器设置等）。"},"q03":{"title":"合集的结构是怎样的？","content":"所有合集组成主 Reaper 工程，主工程又关联有多个子工程。子工程基于逻辑组织（如对象类型、位置、用途等）进行拆分。\\n\\n所有源文件和渲染音频文件的文件名称和元数据均采用通用分类系统 (UCS)。"},"q04":{"title":"我是否可以结合 Strata 使用声音库软件？","content":"是！所有源文件和渲染音频文件均采用通用分类系统 (UCS) 命名，方便使用 SFX 搜索引擎（如 SoundMiner、Basehead、Soundly 等）快速查找所需内容。\\n\\n在 Strata 中找到想要的声音后，您可以原样使用源素材，也可打开关联 REAPER 工程来修改声音。"},"q05":{"title":"Strata 可以与 Wwise 结合使用吗？","content":"Strata 旨在提升整体创作流程，无论您使用怎样的软件都无妨。工程经专门配置可充分发挥 REAPER 的各项渲染功能，方便轻松创建内容并使其多样变化。\\n\\nWwise 用户可结合 Strata 使用 <AK_REAPACK_LINK>ReaWwise</AK_REAPACK_LINK> 来大幅提升生产效率。该 REAPER 扩展让用户只需简单操作一下便可轻松创建 Wwise 容器层级结构。"},"q06":{"title":"我要如何购买 Strata？","content":"Strata 是一项订阅服务，每月都会添加新的内容。查看相关<AK_STRATA_PRICING_LINK>定价</AK_STRATA_PRICING_LINK>及最新库内容。"},"q07":{"title":"多久会增添新的合集？","content":"每月都会添加新的合集，详见 <AK_STRATA_RELEASE_SCHEDULE>Strata 发布时间表</AK_STRATA_RELEASE_SCHEDULE>。"},"q08":{"title":"我如何能获得支持或更多信息？","content":"有关开票、订阅条款或付款的问题，请联系我们的<AK_CONTACT_SALES_LINK>销售团队</AK_CONTACT_SALES_LINK>。\\n\\n如有其他疑问或遇到关于 Strata 或相关插件的技术问题，请访问<AK_STRATA_COMMUNITY_QNA>社区问答</AK_STRATA_COMMUNITY_QNA>版块。如果没有找到问题的答案，请在问答版块发布新问题。  "}}},"community-review":{"title":"社区品评"}}'),kOt={"menu-label":"Wwise",bannerV2Title:"Wwise 是目前性能先进、功能丰富的互动音频解决方案。",bannerCallToAction:{primaryLabel:"$t(common:buttons.get-started)",secondaryLabel:"$t(common:buttons.versionFeatures)",tertiaryLabel:"$t(common:buttons.versionFeatures)"},"stand-alone-descriptions":{"description-a":[{text:"Wwise 可提供一整套互动音频设计与开发工具，无论项目规模如何都能帮您轻松完成原型设计，并在此基础上将自己的音频创作构想变为现实。"}],"description-b":"您可以依据互动项目的具体需要结合使用各种免费和付费<AK_LINK>插件</AK_LINK>及合作伙伴和社区插件。"},"stand-alone-title":{"title-a":"让音频社群如虎添翼"},benefits:{"enhance-creativity":{title:"释放创作潜力",description:"您可以将 Wwise 整合到自己的制作管线中，让音频团队专注于创作而无需为琐事分心。只需一个音频引擎就可完成所有设计、模拟、整合、混音和分析工作。 "},"increase-efficiency":{title:"提升开发效率",description:"Wwise 提供一应俱全的互动音频管线，能够帮您简化互动音频项目开发流程。藉此，可快速完成概念原型设计，灵活控制项目的开发进度，按时交付精心打造的作品。"}}},WOt={"menu-label":"集成",bannerV2Title:"集成",bannerSubTagline:"",sections:{firstParty:{title:"由 Audiokinetic 开发和维护",description:"Wwise 提供开放的 API，并且很容易集成到自研游戏引擎以及世界顶级的商业游戏引擎之中。",cardSource:{wwise:{title:"Wwise Authoring API",description:"新的 <AK_BLACK>Wwise Authoring API</AK_BLACK> 方便将 Wwise 全面集成到任何引擎、工具或应用程序中。它可以在任何支持 Internet 的语言，操作系统或环境中使用。"},unity:{title:"Wwise Unity Integration",description:"<AK_BLACK>Wwise Unity Integration</AK_BLACK> 是一款 Unity 插件，方便开发者在 Unity 游戏中使用 Wwise 声音引擎。该集成包含一个 Unity 插件库，Wwise SDK API 的 C# 绑定, 一些有用的组件和编辑窗。"},unrealEngine:{title:"Wwise Unreal Integration",description:"<AK_BLACK>Wwise Unreal Integration</AK_BLACK> 是一款 Unreal Engine 插件，允许开发者在 Unreal 游戏中使用 Wwise 声音引擎。它可以充分利用 Unreal Engine Object 和 Blueprint 来整合诸多 Wwise 功能，还可与 Unreal Engine 的 Level Sequencer 完全集成并提供声笼支持。<AK_LINK_1>了解详情</AK_LINK_1>"},reawwise:{title:"ReaWwise™",description:`<AK_BLACK>ReaWwise</AK_BLACK> 是由 Audiokinetic 开发的 REAPER 扩展，方便将 REAPER 音频素材导入到 Wwise 工程中。该扩展允许基于用户的 REAPER 渲染配置创建复杂的 Wwise 音频结构。
<AK_LINK_1>通过 ReaPack 下载并试用</AK_LINK_1>`}}},thirdParty:{title:"由第三方分发",description:"Wwise 可以轻松集成到自研游戏引擎和世界顶级的商业游戏引擎之中，也可以集成到任何工具和应用中。第三方集成是由我们的合作伙伴开发和维护的。",cardSource:{cryEngine:{title:"CryEngine",description:"此集成包由 <AK_LINK_1>Crytek</AK_LINK_1> 开发、维护并提供技术支持。所有的CryEngine授权和订阅版本都自带本集成。"},nuendo:{title:"Nuendo",description:"此集成包由 <AK_LINK_1>Steinberg</AK_LINK_1> 开发和维护。借助 <AK_LINK_2>Game Audio Connect feature</AK_LINK_2> 实现 Nuendo 7（或更高版本）和 Wwise 之间的实时、无缝连接。Steinberg Nuendo 为声音创作、作曲、对话录音、混音和中间件交互提供高效的兼容性、灵活性和丰富的功能集。"},O3DE:{title:"O3DE",description:"此集成包由 <AK_LINK_1>Linux Foundation</AK_LINK_1> 开发、维护并提供技术支持。Open 3D Engine (O3DE) 是一款 Apache 2.0 授权的跨平台 3D 引擎，允许开发者和内容创作者利用免费资源自由地构建 AAA 游戏、影院级 3D 环境和高保真模拟。"},speechless:{title:"Speechless",description:"此旁白素材管理集成包由 <AK_LINK_1>Speechless.games</AK_LINK_1> 开发和维护。Speechless 可提供与 Wwise 无缝集成的简化解决方案，能满足剧本、语音合成、录音和本地化等各方面需求。另外，Speechless 还包含直接集成到平台中的专有选角工具和专业配音演员录音数据库。"}}},community:{title:"管理的社区",description:"社区集成由社区开发和维护。如有意进一步了解游戏引擎集成，请查看 <AK_LINK_1>Wwise SDK</AK_LINK_1>。如想自行构建集成包，请查看新的 <AK_LINK_2>Wwise Authoring API</AK_LINK_2>。您可以利用其将 Wwise 全面集成到任何引擎、工具或应用程序中。",cardSource:{baseHead:{title:"basehead 5.1 集成 – BaseHead, LLC",description:"此 Wwise 集成允许在 Wwise 和 basehead 之间来回传递音频对象和参数。另外，basehead 还提供对 Strata 的原生支持。藉此，可从 basehead 中的任意 Strata 渲染音频文件打开关联的 REAPER 工程。"},cocos2DX:{title:"COCOS2DX 集成，作者 Kakyoism",description:"该集成演示应用展示了如何将各种 Wwise 功能集成到您的游戏中。"},gameMaker:{title:"GameMaker Studio 集成，作者 Caklassen",description:" 一款用于 GameMaker Studio 的 Wwise 插件。 GameMaker Studio 是一个游戏创作系统。"},godot:{title:"Godot",description:"Developed and maintained by Alessandro Fama, this <AK_LINK_1>GDExtension</AK_LINK_1> library integrates Wwise into the Godot engine for Windows, macOS, Linux, Android, iOS, and Web (experimental)."},reaper:{title:"REAPER 集成 – 由 Karl Davis 开发",description:"该 REAPER 扩展方便将渲染音频文件快速导入到 Wwise 中。"},reaOpen:{title:"ReaOpen REAPER 集成 – 由 Nikola Lukić 和 Jeremy Rogers 开发",description:"利用这款免费的便携程序，您可以快速选择音频文件并打开原始 REAPER 工程。 "},soundMiner:{title:"Soundminer 集成，作者 Justin Drury",description:"Soundminer 是一个音频管理工具，可以帮助用户迅速找到和管理素材。"},WAAPI_BR:{title:"WAAPI 集成，作者 Bernard Rodrigue",description:"WAAPI 示例工程，作者是 Bernard Rodrigue。包括针对 Wwise 的 Jsfxr，WAAPI Text-to-Speech 和 WAAPI Import by Name 在内，这些示例工程用于展示丰富的 WAAPI 功能的一部分。Bernard 在 2017 年 Austin Game Conference 的演讲和他的<AK_LINK_1>《Three Open Source Projects for the Wwise Authoring API》</AK_LINK_1>博文中曾提到这些示例。"}}}}},$Ot={"menu-label":"产品",plugins:{"menu-label":"插件"},"getting-started":{title:"如何开始使用？",description:"注册一个项目，免费进行评估。没有附加条件！",step_1:{title:"创建账户",description:"创建帐户以管理与工程相关的所有内容，包括授权许可、学习材料等等。"},step_2:{title:"下载",description:"下载 $t(doNotTranslate:audiokinetic-launcher) 来安装 Wwise。您可以使用 $t(doNotTranslate:audiokinetic-launcher) 管理自己的工程和授权密钥、安装插件、安装最新补丁版本、更新 Wwise 版本…"},step_3:{title:"注册项目",description:"注册项目来启动 Wwise 评估以解除声音素材数量限制并访问评估版付费插件。"}},products:{"wwise-feature-cards":{authoring:{title:"Authoring",description:"Wwise 内置了大量功能，免去了很多编程麻烦，不需要担心性能问题。而且，其可简化多平台开发流程，有利于充分发挥创作潜力。"},"dynamic-mixing":{title:"动态混音",description:"Wwise 提供各种各样的动态混音技术，允许根据变化条件调节声音的优先级，确保在遵从相关限制的情况下充分利用处理资源。"},"spatial-audio":{title:"Spatial Audio",description:"Wwise Spatial Audio 专门用于声音传播、虚拟声学及基于空间信息的音频渲染，方便轻松构建高度沉浸的音频环境，帮助您打造身临其境般的虚拟世界。Audiokinetic 一直不断地在空间音频领域进行研究。相信今后我们将为大家带来更多有关空间音频的新功能、新插件和合作伙伴。"},"interactive-music":{title:"互动音乐",description:"Wwise 可减轻作曲家的工作负荷，让其自由创作出众的自适应配乐。有了 Wwise，音乐提示便可对基于规则的过渡作出响应，从而确保在给定时刻精准地播放所需段落。"},"sound-design":{title:"运行时处理与合成",description:"Wwise 提供有一系列内置声音合成器，方便声音设计师生成多样变化的声音，确保不会对处理资源产生太大的影响。"}}},integrations:{"menu-label":"集成",title:"集成",description:"Wwise 提供采用开放式结构的 API，可轻松整合到各类技术平台（包括嵌入式系统）。"},platforms:{title:"平台",description:"Wwise 是一款跨平台解决方案。"},"wwise-integration":{"menu-label":"Wwise 集成"},"wwise-wow":{community:{title:"社区",description:"Audiokinetic 社区是目前规模庞大、增长迅速的互动音频社区。来自全球各地的创作者和开发者可通过社区活动和各类专门渠道（如“Audiokinetic 博客”和“社区问答”版块）交流、合作并分享创意。"},documentation:{title:"用户文档",description:"借助详实的文档和示例工程轻松入门，快速了解 Wwise 功能及音频工作流程。 "},education:{title:"教育",description:"我们可以按照您的需求提供专门的团队培训服务。我们的官网上还有免费的学习材料，其中包含全套课程测验和示例工程。"},performance:{title:"性能",description:"Wwise 可提供各种信息，帮助您精准地排查故障。直观地查看音频信号或对象的路径，在发生之前及时识别各类性能问题，借助强大的分析工具轻松加以解决。"},stability:{title:"稳定性",description:"利用目前业界公认的标配互动音频解决方案之一 Wwise 降低技术风险。 "},support:{title:"技术支持",description:"我们的技术支持团队为您保驾护航。您可以选择适用于自己 Wwise 工程的支持方案，也可选择 Pay2Go 来在需要帮助时随时获得帮助。我们的团队会快速解答您提出的问题，保证让您高效率完成音频创作。"}},"supported-platforms":{"menu-label":"$t(common:labels.supported-platforms)"},"creative-services":{"menu-label":"创意服务"},"wwise-spatial-audio":{"menu-label":"Spatial Audio"}},qOt={strata:DOt,wwise:kOt,integrations:WOt,"wwise-spatial-audio":{bannerV2Title:"Wwise Spatial Audio",bannerV2Description:"创造逼真和无与伦比的沉浸式体验！",blocks:{family:{title:"Wwise Spatial Audio",description:"<AK_BOLD>Wwise Spatial Audio</AK_BOLD> 提供一系列内置的空间音频功能。作为对这些功能的补充，我们还提供了多种可无缝集成到 Wwise 制作流程中的自研及第三方插件。Wwise 空间音频专攻声音传播、虚拟声学和考虑空间信息的音频渲染。Audiokinetic 一直不断地在空间音频领域进行研究。相信今后我们将为大家带来更多有关空间音频的新功能、新插件和合作伙伴。"},geometry:{title:"几何结构",description:"结合 Wwise Relect 插件，Wwise 空间音频几何 API 根据发声体和听者位置，以及您游戏（通常简化了的）几何结构的原始三角形来计算声像源，以模拟动态的早期反射。通过调节基于距离和材料的属性，声音设计师直接在 Wwise Reflect 中将声像源位置转换为早期反射。"},roomsAndPortal:{title:"Room 和 Portal",description:"Wwise 空间音频模块公开了一个简单的上层几何抽象概念，称为房间和门户（Rooms and Portals），这使得它能够高效地模拟位于其他房间发声体的声音传播。房间驱动的声音传播，其主要特征是衍射、耦合和混响的空间化。在 Wwise 中，声音设计师可利用工具来实现这些特征，设计师能完全控制接下来的音频转换。此外，你能用该技术限制那些游戏引擎驱动的基于光线投射（raycast）的声障限制在和听者同处一室的发声体上，这类声障处理高度依赖于具体的游戏引擎，而且一般性能上也非常昂贵。"},wwiseCore:{title:"Wwise 核心",description:"",cards:{busses:"<AK_BOLD>3D 总线</AK_BOLD>是开发者构建高效声音传播解决方案的基础。藉此，可在信号流中的任何地方添加混响或对一组声音实施子混音并在 3D 空间中对这些子混音进行定位。这使得它们成为实现空间音频效果器的关键，如动态房间入口和有向混响。",ambisonics:"Wwise 声部管线提供对 <AK_BOLD>Ambisonics</AK_BOLD> 的完全支持。藉此，可以轻松导入 Ambisonics 文件并将其他声道配置混音为 Ambisonics 格式，最终获得可在任何支持 Ambisonics 的平台上播放的 Ambisonics 音频输出。这是一种跨平台的音频传输解决方案，这种环绕声的格式会用一个常规的球面表示法来描述听者周围的声场，并且与扬声器配置和双耳声滤波器无关。",acoustics:"<AK_BOLD>Acoustic Texture</AK_BOLD> 可与 Wwise Reflect 插件一起使用。藉此，可通过反射表面来模拟不同材质（如木材、水泥和石膏板）的自然声。对任意一种材质，确认它的物体表面粗糙度的参数和特定频率减幅量的参数，这些参数将决定这种材质所对应的恰当的声音。"}},wwisePlugIns:{title:"Wwise 插件",description:"Audiokinetic开发了一系列付费插件，专注于互动声音设计的需求和 Wwise 体验的提升。",cards:{convolution:"<AK_BOLD>Wwise Convolution</AK_BOLD> 允许基于各类真实声学空间（小到卧室，大到教堂）中录制的样本打造逼真的混响效果。您可以使用 Audiokinetic 和 AudioEase 提供的冲激响应。也可以在任何声道配置（包括 Ambisonics）中导入您自己的冲激响应。",reflect:"<AK_BOLD>Wwise Reflect</AK_BOLD> 是一款基于几何信息的插件，其可根据发声体/听者与反射表面（如墙壁、天花板和地板）的距离对早期反射实施动态渲染。Wwise Reflect 可以提升沉浸式体验和对虚拟空间的感知，并且将有限的音频素材自然地融入到动态环境中，使得这些有限的素材变得丰富多样。Wwise Reflect 可以全面定制，迎合了声音设计师的艺术需求，以及当下互动媒体叙事的诉求。"}},integrations:{title:"集成",description:"Wwise 空间音频可以很容易地集成到自研的游戏音频以及世界顶级的商业游戏引擎之中。Wwise 的 Unreal 插件和 Wwise 的 Unity 插件可以帮助空间音频元素集成到游戏中， 这是通过一系列功能实现的，比如 Rooms 和 Portals、3D 定位的 Sound SFX 和声学纹理，还有借助 Wwise 设计工具的 Reflect 插件。",cards:{unreal:"<AK_BOLD>Unreal 5</AK_BOLD> <AK_LINK_LEARN_MORE_UNREAL>详细了解如何在 Unreal 5 中使用 Wwise Spatial Audio</AK_LINK_LEARN_MORE_UNREAL>",unity:"<AK_BOLD>Unity</AK_BOLD> <AK_LINK_LEARN_MORE_UNITY>详细了解如何在 Unity 中使用 Wwise Spatial Audio</AK_LINK_LEARN_MORE_UNITY>"}},wwiseAudioLab:{title:"Wwise Audio Lab",description:"根据创意做原型设计，评估不同的方法，并在受控的虚拟环境中改进结果。",cards:{wal:"Wwise Audio Lab (WAL) 是一个采用 Unreal Engine 4 开发的类似游戏的 3D 开源环境，其可在 Mac、Windows、Oculus 和 HTC Vive 上运行。它展示了各种各样的空间音频的方法和技术，比如基于几何构造的动态的早期反射、声学门户、有向混响等。在地图中分布的信息节点有助于识别声音传播现象，而游戏内的选项可用来对不同的空间音频方法做即时的 A-B 比较。尽管 WAL 是为试验空间音频的性能而设计的，但该项目可完全定制，用户可以根据自己项目的实际情况在众多工具和方法中找到最优组合。"},ctas:{getWal:"获取 Wwise Audio Lab"}}}},module:$Ot},jOt={"menu-label":"简介",title:"用户简介"},FOt={preview:{buttons:{exit:"退出公开视图",preview:"预览您的公开资料"},previewDescription:"此内容与公开视图中显示的资料相同。"},visibilityManager:{title:"资料可见性",description:"您可以设置自己的资料可被 Audiokinetic 官网上的哪些人看到。该设置会影响音频人脉网和搜索结果中显示的资料内容。",mainToggle:"将个人简介公开",profile:"简介",details:"详细资料",about:"关于",experiences:"履历",education:"教育",wwise_certifications:"认证",portfolio:"作品集",projects:"Wwise 工程",publications:"出版物",languages:"语言"}},GOt={title:"头像图片","img-alt":"已加载头像图片",loadedAvatarImage:"用户头像图片",upload:{imageOriginal:"原始图片",imagePreview:"头像预览",imageActual:"实际大小",imageZoomed:"3 x",imageToCrop:"要裁剪的图片",instruction:"请先上传图片文件",dragNDrop:"选择文件或<strong>将其拖到此处</strong>",uploadErrorFileSize:"文件大小超出限制。请选择一个小于 {{AK_VAR_FILE_SIZE_LIMIT}} 的文件",uploadErrorFileType:"不支持该文件类型。请选择有效的文件类型 ( {{AK_VAR_FILE_TYPE}} )",button:"上传头像图片"},formLabels:{avatar:{label:"头像",placeHolder:""}}},YOt={title:"用户信息","no-content":"请先输入您的姓名。点击<AK_ADD_LINK>此处</AK_ADD_LINK>开始编辑",formLabels:{firstName:{label:"名字",placeHolder:"键入名字（必填）"},lastName:{label:"姓氏",placeHolder:"键入姓氏（必填）"},company:{label:"组织名称",placeHolder:"学校/公司（必填）"},companySize:{label:"组织规模",placeHolder:"学校/公司"},title:{label:"职务",placeHolder:"说说您是做什么的"},titleOther:{label:"其他",placeHolder:"键入您的职务（必填）"},countryCode:{label:"国家",placeHolder:"您在哪个位置？"},avatarImage:{label:"头像 URL",placeHolder:"AvatarUploader goes here"},bannerImage:{label:"横幅 URL",placeHolder:"BannerUploader goes here"}},validation:{password:{required:"必须填写“密码”字段"},confirmPassword:{required:"必须填写“密码”字段"},firstName:{required:"必须填写“名字”字段"},lastName:{required:"必须填写“姓氏”字段"},company:{required:"必须填写“组织名称”字段"},companySize:{required:"必须填写“组织规模”字段"},title:{required:"必须填写“职务”字段"},titleOther:{required:"您为“职务”选择了“其他”，所以必须填写“其他”字段"},countryCode:{required:"必须填写“国家/地区”字段"}}},JOt={title:"关于",editing:{defaultItem:"关于",newItem:"新建“关于”介绍",editItem:"编辑“关于”介绍"},"no-content":"请简单介绍一下自己",formLabels:{about:{label:"关于",placeHolder:"请简单介绍一下自己"}}},XOt={title:"履历",editing:{defaultItem:"履历",newItem:"新增履历信息",editItem:"编辑履历信息"},"no-content":"您的个人简介中目前没有任何履历信息。",formLabels:{title:{label:"职位",placeHolder:"做了什么？"},organizationName:{label:"公司名称",placeHolder:"哪家机构？"},location:{label:"地点",placeHolder:"什么地方？"},startEndDate:{label:"NEEDED_IN_CODE_BUT_NOT_USED_DO_NOT_TRANSLATE",placeHolder:"NEEDED_IN_CODE_BUT_NOT_USED_DO_NOT_TRANSLATE"},startDate:{label:"开始日期",placeHolder:"选择开始日期"},endDate:{label:"结束日期",placeHolder:"选择结束日期",selectStartDate:"当前日期"},description:{label:"描述",placeHolder:"请简单介绍一下您当时做了什么"}},validation:{title:{required:"必须填写“职务”字段"},organizationName:{required:"必须填写“公司名称”字段"},startDate:{re