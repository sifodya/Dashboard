Go to you inbox for <b>{{AK_NEW_EMAIL_ADDRESS}}</b> and follow instructions to complete change.`,enterValidEmail:"Please enter a valid email address",formLabels:{currentEmail:{label:"Current Email Address",placeHolder:"Confirm your current email address"},primaryEmail:{label:"Primary Email Address",placeHolder:"Confirm your primary email address"},primaryChangeTo:{label:"New Email Address",placeHolder:"Confirm your new email address"}}},"new-email":{formLabels:{primaryEmail:{label:"Current Email",placeHolder:"Type in your current email address"},password:{label:"Password",placeHolder:"Type in password"}},validation:{primaryEmail:{required:"Current email is required"},password:{required:"Current password is required."}}},password:{title:"Password","change-password-btn":"Change password",currentPassword:"Current password",currentPasswordPlaceholder:"Enter your current password",currentPasswordHelperText:"You must specify your current password",newPassword:"New password",newPasswordPlaceholder:"Type your new password",newPasswordHelperText:"'New password' and 'Confirm password' must be identical",newPasswordConfirm:"Confirm password",newPasswordConfirmPlaceholder:"Type your new password again",newPasswordConfirmHelperText:"'Confirm password' and 'New password' must be identical",formLabels:{passwordOld:{label:"Current Password",placeHolder:"Type in your current password"},passwordNew:{label:"New Password",placeHolder:"Type in new password"},passwordNewValidate:{label:"Confirm New Password",placeHolder:"Confirm your new password"}},validation:{passwordOld:{required:"Current password is required."},passwordNew:{required:"New password is required.",minLength:"Password must have at least {{AK_MIN_NB_CHARS}} characters",upperCase:"Requires one uppercase character",lowerCase:"Requires one lowercase character",numberCheck:"Requires one number character"},passwordNewValidate:{required:"Password confirmation is required.",passwordMatch:"New passwords must match"}}},publicQA:{title:"Community Q&A",description:"The Community Q&A is where users ask and answer questions related to Audiokinetic products and services.",primary:"Display Name",points:"Score","no-score":"You don't have a Q&A score yet",formLabels:{displayName:{label:"Display Name",placeHolder:"Type your Community Q&A Display Name","if-null":"Set your Q&A display name"},points:{label:"Engagement Score",placeHolder:"Q&A Engagement Score","if-null":"You don't have a Q&A score yet"}},validation:{displayName:{required:"DisplayName is required",minLength:"DisplayName should contain at least 3 characters"}}},labels:{firstName:"First Name",lastName:"Last Name",readOnly:" (read-only)"}},kQ={"menu-label":"Communications","email-subscriptions":{title:"Email Subscriptions",notifications:{emailSubscriptions:{warning:"* Changes may take up to 24 hours to be reflected",context:"$t(doNotTranslate:notifications.emailSubscriptions)"}}},"social-network-subscriptions":{title:"Supported social media networks"},"system-notifications":{title:"System Notifications",pendingMessage:"<AK_BOLD>Pending</AK_BOLD>: Please check your email for next steps to reactivate your email subscription",notifications:{systemNotifications:{warning:"",context:"$t(doNotTranslate:notifications.systemNotifications)"}}},"preferred-communication-language":{title:"Preferred Communication Language",description:"Specify which language you wish Audiokinetic to use in Invoices, Emails, and other non-website-centric messages. To change the Website's language, use the Website language selector."}},WQ={"menu-label":"Creators Directory","creators-directory-listing":{title:"Certified User Public Profile",switchLabel:"I want to be listed in the Wwise Creators Directory",switchDescription:`This is the option to be listed in the Creators Directory. You control your profile’s appearance for people who are not signed in to Audiokinetic. It affects how your profile appears on the Creators Directory and search engines too.

You can also change the visibility of your profile from Profile section.`,ctas:{gotoProfile:"$t(common:buttons.goto)"}},"associated-companies":{title:"Associated Companies",description:"If you are a Certified User you can choose to be listed with this company in the Content Providers section of the Creators Directory","no-data":"Your profile is not associated to any companies",headers:{companyName:"Company Name",companyNameExplained:`Your associated company
appears in the Creators Directory`,associationOption:"I want to be listed",associationOptionExplained:`Display your name in the
company’s member list`}},"company-registration":{title:"Creators Directory",description:"The Wwise Creators Directory is a place for developers, from indies to AAA, to find audio professionals with Wwise experience to help them with their game audio. If you're at least Wwise-101 certified and are offering professional audio services to the games industry, register your company today!",ctas:{registerCompany:"Register your Company",faq:"FAQ"}}},$Q={"menu-label":"Certifications"},qQ={"menu-label":"Downloads"},jQ={"menu-label":"Documents",certifications:{title:"Certifications",description:"Online Wwise certifications are designed with your learning needs in mind. Develop your skills and get certified whenever you’re ready to establish your experience with Wwise and get the job of your dreams!"},"creators-directory":{title:"Creators Directory"},"license-agreements":{title:"Documents","no-content":"You currently do not have any documents to review in your account","info-box":"Licenses and Agreements attached to your user account will be found here. For licenses and agreements attached at the project level, including Wwise licenses, royalty agreements and more, please visit the specific project page, listed under your <AK_MY_PROJECT_LINK>My Projects</AK_MY_PROJECT_LINK>.",headers:{fileName:"Name",fileType:"Type",fileDate:"Date"}}},FQ={"menu-label":"Billing","payment-methods":{"no-content":"You currently don't have any stored payment methods.",title:"Payment Methods","title-singular":"Payment Method",default:"Default Payment Method",paidSubscriptionsWarning:"Changing your default payment may affect your next subscription renewal.",preDeleteDefaultCardWarning:"Deleting your default payment method will cancel your active subscription and additional charges may occur.",preDeleteCardWithSubscriptionWarning:"Can't delete default method of payment with an <AK_LINK>Active Subscription</AK_LINK>.",setAsDefault:"Set as default",cardNumber:"Card number",expires:"Expires",cardHolderName:"Name on card",billingAddress:"Billing Address","delete-payment-method":"Delete payment method",formLabels:{addButton:{label:"Add a payment method"},cardholderName:{label:"Name on card",placeHolder:"…"},addressNumber:{label:"Street number",placeHolder:"…"},addressLine1:{label:"Address line 1",placeHolder:"…"},addressLine2:{label:"Address line 2",placeHolder:"…"},addressLine3:{label:"Address line 3",placeHolder:"…"},addressLine4:{label:"Address line 4",placeHolder:"…"},city:{label:"City",placeHolder:"…"},region:{label:"Province/State",placeHolder:"…"},postalCode:{label:"Postal/Zip code",placeHolder:"…"},country:{label:"Country",placeHolder:"…"}},validation:{cardholderName:{required:"The Cardholder field is required"},addressNumber:{required:"Street number is required"},addressLine1:{required:"Address line 1 is required"},country:{required:"Country is required"},region:{required:"Region is required"},city:{required:"City is required"},postalCode:{required:"Postal/Zip code is required"}}},"transaction-history":{title:"Transaction History","no-content":"You currently have no transaction history","download-invoice":"Download Invoice",headers:{invoice:"Invoice Number",description:"Description",total:"Total (USD)",date:"Date"},"thank-you":{title:"Thank you for your purchase.",description:"<AK_LINK>Download invoice</AK_LINK> to view your receipt."}}},GQ={"menu-label":"Events (tentative)"},YQ={module:UQ,general:DQ,communications:kQ,creatorsDirectory:WQ,certifications:$Q,downloads:qQ,documents:jQ,billing:FQ,events:GQ,"bug-reports":{"menu-label":"Bug reports (tentative)"}},JQ={bannerV2Title:"The Future is Wwise",bannerCallToAction:{primaryLabel:"$t(common:buttons.get-started-now)",secondaryLabel:"$t(common:audiokineticLauncher.download)"},"wwise-wow":{benefits:{title:"Benefits",stability:{title:"Stability",description:"Reduce technical risk. Wwise is the most reliable solution on the market.",imageUrl:"/images/wwise-wow/stability.svg"},performance:{title:"Performance",description:"Take the guesswork out of troubleshooting. Identify performance issues before they happen and resolve them easily using powerful profiling tools.",imageUrl:"/images/wwise-wow/performance.svg"},support:{title:"Support",description:"Support plans and the Pay2Go option offer customers direct access to our team of developers.",imageUrl:"/images/wwise-wow/support.svg"}},resources:{title:"Resources",documentation:{title:"Documentation",description:"Sample projects and robust documentation in English, Chinese, Japanese and Korean.",imageUrl:"/images/wwise-wow/documentation.svg"},education:{title:"Education & Training",description:"Audiokinetic offers Wwise Certifications for students and educators, as well as customized Team Training for studios.",imageUrl:"/images/wwise-wow/education.svg"},community:{title:"Community",description:"Join the largest and fastest growing interactive audio community of creators and developers.",imageUrl:"/images/wwise-wow/community.svg"}}}},XQ={bannerV2Title:"Gaming and Interactive Media",gaming:{gameComponentLabel:"Shipped Games",gameComponentDescription:"Over 1000 titles shipped every year, powered by Wwise"},arvr:{gameComponentLabel:"Virtual & Extended Reality Experiences",gameComponentDescription:"Over 1000 AR/VR/MR/XR projects powered by Wwise"},cards:{card1:"Pioneering immersive audio technology",card2:[{text:"A trusted partner to the world’s largest developers, OEMs and audio production companies, Audiokinetic has revolutionized interactive audio with its cross platform middleware audio engine, Wwise."},{text:"Today, Wwise is the most comprehensive and advanced interactive audio toolset, empowering sound designers and audio programmers with complete creative control to bring their vision to life."}],card3:"Enterprise agreements with all major game publishers",card4:[{title:"Hundreds of AAA and indie titles",description:"shipped every year, powered by Wwise"},{title:"Hundreds of AR/VR/MR/XR experiences",description:"powered by Wwise"}],card5:"Largest and fastest growing interactive audio community, globally",card6:[{title:"2/3",description:"game audio jobs favor Wwise experience",source:{text:"* Source: <AK_LINK>GameSoundCon</AK_LINK>",AK_LINK:"https://www.gamesoundcon.com/post/game-audio-job-skills-how-to-get-hired-as-a-game-sound-designer"}},{title:"400",description:"Academic Institutions have partnered with Audiokinetic"}]},"secondary-banner":{bannerTagline:"",bannerSubTagline:"Wwise is a leading Audio Middleware for AAA and Midcore games.",bannerSubTaglineSource:{text:"* Source: <AK_LINK>GameSoundCon</AK_LINK>",AK_LINK:"https://www.gamesoundcon.com/post/gamesoundcon-game-audio-industry-survey-2025"}},partners:{title:"Developers we’ve worked with"},integrations:{title:"Integrations",description:"Audiokinetic solutions integrate easily into any technology including embedded systems."},platforms:{title:"An unified content pipeline for all platforms",description:"Wwise is a multi-industry, cross-platform solution. Deploy everywhere. Mobile, desktop, console, AR/VR and more."}},QQ=JSON.parse(`{"bannerV2Title":"Wwise Automotive","bannerV2Description":"Empowering Car Manufacturers to Leverage Interactive Audio","secondary-banner":{"bannerTagline":"","bannerSubTagline":"Wwise Automotive enables safer driving with situational awareness audio cues, and provides drivers with the benefit of customizing a personalized audio experience.","bannerV2Description":"Wwise Automotive enables safer driving with situational awareness audio cues, and provides drivers with the benefit of customizing a personalized audio experience."},"section-header":{"applications":"Applications","features":"Product Features","examples":"Examples of problem solving with Wwise"},"tertiary-banner":{"bannerV2Title":"<AK_FAT_BLACK>Audiokinetic is the global leader in interactive audio technology<AK_FAT_BLACK>","bannerV2LongDescription":"<AK_BULLET>Two decades of complex real-time audio rendering expertise</AK_BULLET><AK_BULLET>A trusted partner to major consumer electronics manufacturers</AK_BULLET><AK_BULLET>Network of renowned plug-in technologies</AK_BULLET>"},"banner-call-to-actions":{"label":"See how it works","targetLink":"https://www.youtube.com/embed/MNh10ObBo8c"},"logo-alt-text":"Wwise Automotive™ Logo","platforms":{"title":"Platforms"},"integrations":{"title":"Integrations"},"cards":{"card1":"AUTOMOTIVE LOGO","card2":[{"text":"Wwise Automotive™ is an audio middleware solution that enables the creation of immersive audio experiences for today's vehicles."}]},"contact-for-more-info":{"title":"Need more info on Wwise Automotive?","cta":"$t(common:buttons.contact-us)"},"automotive-cards":{"application-a":{"title":"Interactive sound generation & immersive audio rendering","description":"<AK_BULLET>Branded sound signature</AK_BULLET><AK_BULLET>Interactive vehicle chimes</AK_BULLET><AK_BULLET>Spatial navigation guidance</AK_BULLET><AK_BULLET>Synthetic engine sound</AK_BULLET><AK_BULLET>Dynamic zone routings</AK_BULLET><AK_BULLET>Context-adaptative rendering</AK_BULLET>"},"application-b":{"title":"Spatial Audio","description":"Audiokinetic's Automotive Spatial Audio redefines in-car sound with dynamic 3D precision, adapting to driving conditions for an immersive experience beyond traditional stereo systems. It's the future of automotive audio, turning every drive into a symphony of emotion."},"application-c":{"title":"Wwise Automotive provides:","description":"<AK_BULLET>Sound Design: sound design tool & ecosystem of providers</AK_BULLET><AK_BULLET>Audio Management: authoring application for audio user experience design and tuning</AK_BULLET><AK_BULLET>In-car Runtime: optimized production car runtime sound engine platforms</AK_BULLET>"},"press-room":{"title":"Press Room","description":"Audiokinetic’s Wwise Automotive enables a new standard for immersive in-car audio in CHANGAN’s new NEVO E07 electric vehicle"}},"automotive-problems-solved-by-wwise":{"examples":{"advancedDriverAssistanceSystem":{"title":"Advanced Driver Assistance Systems (ADAS)","description":"Sound is a good complement to heads up displays (HUD) outside of the field of view","content":[{"text":"The primary reason clients come to us is for interactive sound generation often in combination with 3D sound requirements. A common example of Wwise usage for automotive audio is to create spatial warnings to position sounds in real-time based on sensor input information. Our clients use Wwise capabilities to build Advanced Driver Assistance Systems such as collision warning, parking assistance systems, blind spot alerts, etc."},{"text":"We’ve pushed this concept further recently in a collaboration with Sony to create the perfect auditory complement into a heads up display integration to showcase the value of sound in providing driver with full environment awareness notably for elements outside of the field of view."},{"text":"<AK_BULLET>Collision Warning</AK_BULLET><AK_BULLET>Lane departure warning</AK_BULLET><AK_BULLET>Parking assistance</AK_BULLET><AK_BULLET>Pedestrian / cyclist warning</AK_BULLET><AK_BULLET>Blind spot alert</AK_BULLET><AK_BULLET>Cross-traffic alert</AK_BULLET>"}]},"auditoryNavigationAssistance":{"title":"Auditory Navigation Assistance","description":"Important role for 3D sound technologies to reduce cognitive load","content":[{"text":"Different applications also involve using Wwise to provide driver feedback and guidance using spatial audio cues for navigation assistance while avoiding an over-dependence on visual information to keep the eyes on the road."},{"text":"<AK_BULLET>Spatial sound cues provides direction information</AK_BULLET><AK_BULLET>Avoids over-dependency on visual information</AK_BULLET>"}],"footnote":"Credit: Continental"},"acousticVehicleAlertingSystem":{"title":"Acoustic Vehicle Alerting System (AVAS)","description":"Opportunity for OEMs to give vehicle a unique sonic identity (audio branding)","content":[{"text":"A regulation that OEMs must fulfill requires electric vehicles to emit sounds for pedestrian and cyclists safety that need to evolve with the car runtime parameters (notably speed). "},{"text":"OEMs have seized this opportunity to create unique sound signatures for their vehicles, and tools like Wwise provide a better workflow and clearly separate design (controlled by the OEM) from integration considerations (controlled by Tier1)."},{"text":"Wwise allows one to simulate operation out of the vehicle context (therefore enabling external and offline design) and to perform real-time editing for tuning in-car context towards final stages before production."},{"text":"<AK_BULLET>Mandatory system by regulation</AK_BULLET><AK_BULLET>Need to map real-time parameters to affect sound generation (interactive audio requirements)</AK_BULLET><AK_BULLET>Complex design cycles with many iterations that lasts years require solid workflow</AK_BULLET>"}],"footnote":"Credit: Continental"},"engineSoundGeneration":{"title":"Engine Sound Generation (ESG) & Dynamic Interior Soundscapes","description":"Enable OEMs to develop adaptive experiences independently","content":[{"text":"Similarly to external engine sound generation used for safety purposes, interior engine sound generation systems are also used to provide information about speed / regenerative braking and more. This is also an audio branding opportunity for OEMs."},{"text":""}]},"autonomousDrivingHumanMachineInterfaces":{"title":"Autonomous Driving Human-Machine Interfaces","description":"Sound feedback helps build trust relationship with vehicle","content":[{"text":"We conclude our series of interactive sound generation application examples with perhaps the most forward looking concept where Volvo used Wwise in a research project named Sonic Interaction for Intelligent Cars to address new challenges for human machine interfaces in autonomous driving."},{"text":"The project showed that the use of interactive sound feedback reduces motion sickness and helps to build trust between the vehicle and the user. With the amount of experimentation required to nail those experiences, it’s necessary to iterate rapidly, in VR or in-car, leveraging the same technology and Wwise was a natural fit for this experimentation."},{"text":"Let’s look at a quick 1 min video to see what autonomous driving HMI of the future sound like."}],"footnote":"Credit: Volvo"},"audioManagementRequirements":{"title":"Audio Management Requirements","description":"Control mapping between detection systems and desired audio user experience","content":[{"text":"So far we’ve looked only at interactive sound generation requirements, but some OEMs want to also include more traditional automotive technologies like content upmixing, sound staging and vehicle acoustic tuning for optimizing media playback and to provide more immersive audio rendering."},{"text":"To better respond to these additional audio management requirements we integrated some Sony technologies into Wwise to be able to offer those features on top of interactive sound generation capabilities."},{"text":"There is also real interest and good technical motivations to support object-based audio technology in automotive. This involves delaying the spatial rendering in the processing chain for optimal results regardless of the actual rendering hardware (speaker configuration that is vehicle specific) and for this, the Wwise solution is already in a great position to be able to manage object-based audio experiences with different renderer back-ends, like Dolby ATMOS, Sony360RA and others."},{"text":"Some OEMs are also looking for solutions that integrate more traditional automotive audio requirements\\n<AK_BULLET>Content upmixing</AK_BULLET><AK_BULLET>Sound staging & optimized rendering</AK_BULLET><AK_BULLET>Vehicle acoustic tuning</AK_BULLET>"},{"text":"A new trend in automotive audio is object-based rendering\\n<AK_BULLET>Wwise is well positioned to support the authoring of those experiences to the required scale</AK_BULLET>"}]}}},"automotive-extras":{"safety":[{"title":"Wwise Automotive for Augmented Safety","description":"New requirements for automotive safety drive the adoption of multiple sensor systems (e.g., radar and camera), which feed the car with tremendous amounts of contextual information regarding the car’s environment or the driver’s condition. The dynamic nature of this information requires the use of innovative interactive audio technology."},{"description":"Wwise Automotive utilizes such contextual information and provides various approaches to using sound for safety and guidance applications like ADAS (i.e., various collision warning systems) and AVAS (i.e., external pedestrian warning systems). Wwise Automotive can be easily adapted to provide customized user experiences while empowering vehicle manufacturers to maintain a unique sound signature."}],"comfort":[{"title":"Wwise Automotive for Enhanced Comfort","description":"Increased levels of automation and emerging use cases, such as shared mobility, present new opportunities for a more adaptive in-car entertainment experience. The development of these advanced audio systems requires new workflows and tools that can support effective tuning customizations based on complex sets of real-time parameters provided by the vehicle network integration (e.g., CAN)."},{"description":"Wwise Automotive provides context-aware tunings for applications such as HMI feedback chimes, vehicle noise compensation and automatic level adjustments, as well as advanced audio management capabilities to dramatically enhance the audio listening experience."}]},"automotive-features":{"title":"Features","soundDesign":"Comprehensive interactive sound design for HMI, safety, infotainment and guidance systems","soundSpatialization":"3D sound spatialization adapted to automotive acoustics","audioMixing":"Advanced audio mixing allowing seamless integration of multiple audio streams","dynamicRouting":"Dynamic routings to different outputs based on runtime user settings","realTimeAudioDesign":"Real-time audio design prototyping connected to embedded platforms","realTimeProfiling":"Real-time profiling & debugging CPU, memory usage","currentPlatforms":"Supports current automotive platforms QNX, Linux, Android","plugInArchitecture":"Plug-in architecture for easy integration of partner advanced audio signal processing technologies"},"automotive-partners-tech":{"title":"<AK_FAT_BLACK>Wwise Automotive network of renowned plug-in technologies</AK_FAT_BLACK>"},"automotive-technologies":{"title":"<AK_FAT_BLACK>Wwise Automotive network of renowned technology partners</AK_FAT_BLACK>"}}`),ZQ={bannerV2Title:"Location Based Entertainment",gameComponentLabel:"Featured Experiences","secondary-banner":{bannerTagline:"",bannerSubTagline:"Largest and fastest growing interactive audio community, globally."},"logo-alt-text":"Wwise Logo","contact-for-more-info":{title:"Need more info on Wwise Location Based Entertainment?",cta:"$t(common:buttons.contact-us)"},cards:{card1:"Trailblazing Immersive Audio Technology for Non-standard Configurations",card2:[{text:"Audiokinetic is a game-changer for Location-based Entertainment (LBE) audio development.  Meeting critical industry audio requirements, its audio engine, Wwise, enables the creation of unprecedented immersive experiences with utmost stability and performance."},{text:"Wwise provides out-of-the-box support for irregular speaker setups with up to 255 audio channels and any number of devices. It revolutionizes the production pipeline for LBE audio creators and is the most comprehensive data-driven audio solution."}],card3:"Hundreds of LBE Experiences Powered by Wwise",card4:[{description:"Up to"},{title:"255",description:"audio channels with Wwise ASIO & support for irregular speaker setups"}],card5:[{title:"400",description:"academic institutions teach Wwise around the world"}],card6:[{title:"2/3",description:"interactive audio jobs require Wwise experience"}]},platforms:{title:"Multi-Platform"},integrations:{title:"Integrations"},partners:{title:"Developers we’ve worked with"}},eZ={bannerV2Title:"Training and Simulation","secondary-banner":{bannerTagline:"",bannerSubTagline:"Wwise meets critical simulation technology audio requirements"},cards:{card1:"Pioneering Accurate and Immersive Interactive Audio Technology",card2:[{text:"Audiokinetic powers next-generation audio for Training and Simulation. It revolutionizes the production pipeline for engineers and designers with its audio engine, Wwise, while meeting critical simulation training technology requirements."},{text:"Featuring an optimized runtime sound engine and an authoring application tailored to creating and managing audio for simulation training technology, Wwise is the most comprehensive data-driven solution on the market for implementing immersive, realistic, and accurate representations of simulated environments."}],card3:"The most advanced & scalable audio toolset on the market",card4:[{title:"400",description:"academic institutions teach Wwise around the world"},{title:"2/3",description:"interactive audio jobs require Wwise experience"}]},partners:{title:"Partners"},integrations:{title:"Integrations",description:"Audiokinetic solutions integrate easily into any technology, including embedded systems."},"simple-card-content":[{title:"Comprehensive Interactive Sound Design",description:"Wwise is a data-driven interactive sound engine. It provides a centralized design environment to control all aspects related to simulation audio production. Author, simulate, integrate, mix and profile using one audio engine."},{title:"Advanced Audio Mixing & Spatialization",description:"Wwise features advanced audio mixing to provide seamless integration and prioritization of multiple audio streams. Its sophisticated audio management approach and advanced 3D audio spatialization capabilities can be leveraged to create highly immersive, dynamic and accurate audio experiences."},{title:"Interactivity & Audio Streaming Management",description:"Wwise is a data-driven interactive sound engine. It provides a centralized design environment to control all aspects related to simulation audio production. Author, simulate, integrate, mix and profile using one audio engine."},{title:"Stability & Performance",description:"Reduce technical risk by using Wwise, the most reliable solution and proven standard for interactive audio. Wwise takes the guesswork out of troubleshooting. Visualize the path of audio signals or objects, identify any performance issues before they happen, and resolve them easily using powerful profiling tools."},{title:"Quick Prototyping and Increased Efficiency",description:"Wwise streamlines your interactive audio projects with its comprehensive interactive audio pipeline. Increase efficiency with faster iteration cycles as no scripting is required for 90% of common interactive audio and spatial audio design. The clear division of tasks between programmers and audio designers, and the facility Wwise provides towards building complex behaviors increases the quality of audio delivery and also increases your team’s efficiency."},{title:"Real-time Authoring & Profiling",description:"Wwise authoring, profiling, and real-time editing tools connect to simulation technology and systems, increasing productivity with out-of-the-box features and functionality, all while saving engineers time and money across the audio production pipeline."}],"new-paradigm":{title:"A New Paradigm for Simulation Technology Audio Development","description-texts":[{description:"Wwise empowers simulation technology engineers to fully control the audio experience, without spending long development cycles on integration and coding. A powerful tool for iterating quickly and tuning designs incontext, Wwise provides a unique solution that can be used for prototyping, all the way through production."},{description:"While significantly reducing the efforts required to bring innovative audio features to simulation training technology, Wwise streamlines the audio development workflow while advancing capabilities towards believable training experiences, as well as improved operational training efficacy."}]}},tZ={"menu-label":"Solutions","info-call-to-action":{"your-project":{title:"Tell us about your project, we’re here to help!",subText:"Register your project for a free evaluation. No strings attached!"},"join-the-community":{"email-label":"Email","email-placeholder":"Your Email Address",title:"Join the largest interactive audio community!",subTitle:"Create your Audiokinetic account to access your community, learning content, stay up-to-date with all things interactive audio and manage your projects.",subTitleLoggedIn:"Create your Audiokinetic account to access your community, learning content, stay up-to-date with all things interactive audio and manage your projects.",ctaPrimary:"$t(common:buttons.create-account)",callToActionLoggedInLabel:"$t(common:buttons.subscribe-blog)"}},solutions:{"menu-label":"Solutions","wwise-industry-cards":{"game-card":{title:"Games and Interactive Media",description:"With over 1000 powered by Wwise titles shipped every year, Wwise is the leading audio solution and trusted gold standard."},"consumer-electronics-card":{title:"Consumer Electronics",description:"Wwise enhances the audio experience and interactivity of consumer products."},"lbe-card":{title:"Location&ndash;Based Entertainment",description:"Wwise meets critical industry audio requirements for LBE and caters to specific non-standard configurations, enabling the creation of unprecedented immersive experiences."},"automotive-card":{title:"Wwise Automotive",description:"Wwise Automotive® empowers car manufacturers and suppliers to be in full control of the audio experience without spending long development cycles on technology integration and software development."},"simulation-card":{title:"Training and Simulation",description:"Wwise offers pioneering interactive and spatial audio technology for creating accurate and immersive next-generation simulation experiences."}}},gaming:{"menu-label":"Gaming"},"consumer-electronics":{"menu-label":"Consumer electronics"},lbe:{"menu-label":"LBE"},wwise_automotive:{"menu-label":"Wwise Automotive"},simulation:{"menu-label":"Simulation"},"supported-platforms":{"menu-label":"$t(common:labels.supported-platforms)",platforms:{title:"Platforms",description:"Wwise is a cross-platform solution."}},"powered-by-wwise":{"menu-label":"Powered by Wwise",gameComponentLabel:"Powered by Wwise","info-card":{"release-date":"Release date: ",studios:"By: ","game-engine":"Game Engine: ","game-tags":"Game Tags: "}}},iZ={"common-stuff":{"weird-card":{firstText:[{text:"Wwise streamlines your interactive audio pipeline and enhances your team’s creativity and efficiency."},{text:"Wwise is your audio solution from fast concept prototyping to shipping your best work on time."}],blueText1:"No scripting required for",blueText2:"90% +",blueText3:"of common interactive audio design"}},solutions:JQ,gaming:XQ,wwise_automotive:QQ,lbe:ZQ,simulation:eZ,"consumer-electronics":{bannerV2Title:"Consumer Electronics","secondary-banner":{bannerTagline:"",bannerSubTagline:"Wwise enhances the audio experience and interactivity of consumer products"},cards:{card1:"Empowering Consumer Electronics Manufacturers to Leverage Interactive Audio",card2:[{text:"Audiokinetic provides consumer electronics manufacturers, semiconductor and silicon vendors with customized solutions, addressing new interactive audio and immersivity requirements to enhance products or extend their platforms."},{text:"With software solutions able to scale for a vast array of hardware platforms, including embedded targets, Audiokinetic provides manufacturers with the tools needed to create audio-branded experiences that give their products a distinct sonic identity and the reactive sonic interface customers need to interact with their devices."}],card3:"Scalable and versatile software solution for a vast array of hardware platforms and embedded targets",card4:[{title:"400",description:"academic institutions teach Wwise around the world"},{title:"2/3",description:"interactive audio jobs require Wwise experience"}],card5:"Create branded audio experiences",card6:"Largest and fastest growing interactive audio community, globally"},partners:{title:"Partners"},platforms:{title:"Platforms"},"simple-card-content":[{title:"Robotics / Smart Toys",description:`In robotics and smart toys, sound plays
a key role in giving robots a distinct persona. Wwise provides the ideal tools for creators to iterate very quickly. Creators can finely adapt and customize the reactions of the robot to each situation and provide it with a unique personality that will create an emotional bond between the robot product and consumer.`},{title:"Industrial Applications",description:"In industrial contexts, sound has a very important role to communicate status information to machinery operators. Wwise’s interactive sound generation capabilities make it the perfect vehicle for creating situation-aware audio warning signals and feedback operation sounds to improve efficiency and safety."},{title:"IOT / Smart Home",description:"The internet of things has significantly increased the number of screenless consumer devices we interact with in our daily lives, and many of those interactions must be accomplished through audio. With an increasing number of concurrent applications running on devices such as smart speakers, Wwise provides audio management capabilities for a holistic and coherent audio user experience with custom profiles that can be easily evolved over time with over-the-air updates."},{title:"Mobile Devices",description:"Processing efficiency is vital on mobile devices as it directly impacts battery autonomy. The Audiokinetic team has experience in optimizing audio processing for mobile hardware architectures and providing scalable algorithms that can bring high quality audio digital signal processing algorithms with very low performance impacts. Complex audio graphs can be realized using the full Wwise solution, or through customized audio pipelines which can be designed to meet any specific OEM audio requirements."}],"behind-immersive-audio":{title:"Wwise, the technology behind immersive audio","description-texts":[{description:"Wwise is the most comprehensive data-driven audio solution. It features an optimized runtime sound engine and an authoring application designed to create and manage customized audio experiences on embedded platforms."},{description:"Our team of leading experts is committed to delivering customized, innovative solutions for enhancing the audio experience and interactivity of consumer products. We provide scalable solutions that integrate easily into any technology, including embedded systems."}]}},"powered-by-wwise":{bannerTagline:"Powered by Wwise",gameComponentLabel:"Check out the latest projects made using Wwise!",gameComponentDescription:"With hundreds of titles shipped, Wwise is the leading audio solution and trusted standard for the gaming and interactive audio industry. From indies to AAA studios, the best projects use Wwise!",pbw:{filters:{searchTermPlaceHolder:"Search for games by name",gameEngine:{title:"Game Engine"},gameTags:{title:"Tags"},gamePlatform:{title:"Platform(s)"}}},filters:{searchTermPlaceHolder:"Search for games by name",gameEngine:{title:"Game Engine"},gameTags:{title:"Tags"},gamePlatform:{title:"Platform(s)"}}},module:tZ,"ai-at-ak":JSON.parse(`{"menu-label":"Use of Artificial Intelligence","helmet":{"title":"Use of Artificial Intelligence","description":"Audiokinetic is using internal AI to build tools that assist, not replace, audio creators. No customer data is ever used in this process."},"page-content":{"bannerV2Title":"Use of Artificial Intelligence","ai-partners":{"title":"Plug-in Partners Overview","description":"Audiokinetic is committed to ensuring that partners adhere to the values of AI at Audiokinetic","stickyRowData":{"block01":{"title":""},"block02":{"title":"DO NOT DELETE"},"block03":{"description":"ReadSpeaker's speechEngine for Wwise is a cross-platform, on-device text-to-speech solution for creating natural-sounding speech from any text input. Customize the voice in the authoring tool and send text to be converted into speech from the game runtime. speechEngine for Wwise currently supports 26 languages (including dialects) and 48 voices, with more languages and voices planned for future releases. Taking advantage of the plug-in's runtime capabilities allows you to have any text content in your game read aloud: from UI-narration to multiplayer text chats. Intuitively adjust speech parameters like pitch and speed while keeping the prosody intact, for full control of the speech generated. Along with speech audio, the speechEngine for Wwise also produces word and viseme data, and notifies you when a new word or viseme is encountered in the speech. This can be used to implement word-highlighting or lip-sync functionality. Also supports Speech Synthesis Markup Language (SSML).\\n\\nReadSpeaker is committed to delivering ethical AI-powered voice solutions. Learn more about their approach to <AK_LINK_1>ethical AI voice in gaming here</AK_LINK_1>.\\n\\n<AK_LINK_2>Read more about the ReadSpeaker - speechEngine Plug-in for Wwise</AK_LINK_2>"}}},"glossary":{"title":"Glossary","description":"","stickyRowData":{"block01":{"description":"<AK_LINK_1>Government of Canada Artificial Intelligence (AI) Terminology Concept Map</AK_LINK_1>\\n(Glossary of terms available in English, French, and Spanish)"},"block02":{"description":"<AK_LINK_1>Artificial Intelligence</AK_LINK_1>: Artificial intelligence refers to computer systems that can perform complex tasks normally done by human-reasoning, decision making, creating, etc."},"block03":{"description":"<AK_LINK_1>Machine Learning</AK_LINK_1>: Machine learning uses data and algorithms to train computers to make classifications, generate predictions, or uncover similarities or trends across large datasets."},"block04":{"description":"<AK_LINK_1>Deep Learning</AK_LINK_1>: Deep learning is a subset of machine learning that involves neural networks with many layers. It distinguishes itself from other forms of neural networks primarily through its capability to learn features automatically from data."},"block05":{"description":"<AK_LINK_1>Language Model</AK_LINK_1>: A language model is a statistical model that estimates the probability of a sequence of words in a given language. Also see: <AK_LINK_2>Large</AK_LINK_2>, <AK_LINK_3>Small</AK_LINK_3>, and <AK_LINK_4>Pre-trained</AK_LINK_4> Language Models"},"block06":{"description":"<AK_BOLD>Hybrid Search</AK_BOLD>: A search approach that combines traditional metadata search (e.g., tags, filenames, trigrams) with AI-based similarity filters."},"block07":{"description":"<AK_BOLD>CLAP (Contrastive Language-Audio Pretraining)</AK_BOLD>: A machine learning model that maps both audio and text into a shared embedding space to enable similarity comparisons between them."},"block08":{"description":"<AK_BOLD>SFX-CLAP</AK_BOLD>: An internal variant of the CLAP model developed by Sony AI and adapted for sound effects."},"block09":{"description":"<AK_BOLD>Metadata</AK_BOLD>: Descriptive information about audio files, such as tags, filenames, or categories, traditionally used for search and organization."},"block10":{"description":"<AK_BOLD>Embedding</AK_BOLD>: A numerical representation of data (e.g., audio or text) in a multi-dimensional vector space, typically used for similarity comparisons."},"block11":{"description":"<AK_BOLD>Trigrams</AK_BOLD>: Sequences of three consecutive characters used in text processing to enable approximate matching, typo correction, and prefix searches—for example, “audio” yields “aud,” “udi,” and “dio”."},"block12":{"description":"<AK_BOLD>Media Pool</AK_BOLD>: A centralized repository or collection of audio assets used in content creation workflows, allowing efficient access, organization, and reuse across projects or production stages."},"block13":{"description":"<AK_LINK_1>Strata</AK_LINK_1>: A modular, professionally curated library of music and sound assets for interactive media, developed by Audiokinetic to support dynamic, adaptive audio in games and experiences delivered in multitrack format."},"block14":{"description":"<AK_BOLD>Text-to-Audio / Audio-to-Audio Search</AK_BOLD>: Query types where either a text prompt is used to find similar sounds, or an existing sound clip is used to retrieve related sounds."}}},"responsible-usage":{"title":"Responsible AI at Audiokinetic","description":"","stickyRowData":{"block01":{"description":"Audiokinetic is committed to providing workflows that assist the audio community with the human creation of engaging and immersive interactive experiences. Our goal with Wwise has always been to integrate seamlessly into production pipelines and empower audio teams to focus on being creative, without limitations. Now with thoughtful use of AI, we’re taking that mission even further.\\n\\nThe use of AI at Audiokinetic is aligned with <AK_LINK_1>Sony Group's Initiatives for Responsible AI</AK_LINK_1>, with the aim of utilizing AI technology to enrich people's lifestyles and contribute to the development of society. We will pursue accountability and transparency while actively engaging in dialogue with stakeholders. In practical terms, this means we’re building AI tools that enhance your creative process, not replace human creativity or expertise.\\n\\nWe’re excited to be working on features that can bring people closer to their audio by leveraging the possibilities of AI, Machine Learning, Neural Networks, and other emerging technologies. AI development is conducted internally using licensed data, and no user data is used as part of these processes.\\n\\nPlease <AK_LINK_2>contact us</AK_LINK_2> with any question you may have."}}},"similar-sound-search":{"title":"Wwise Features","description":"Audiokinetic is currently exploring the use of machine learning across various categories. (<AK_LINK_1>See glossary below</AK_LINK_1>)","stickyRowData":{"block01":{"title":"What is Similar Sound Search?","description":"Similar Sound Search is an audio-to-audio and text-to-audio search functionality specifically designed for sound effects. This feature is offered as an optional way to surface additional results as part of the Media Pool in Wwise."},"block02":{"title":"Quick facts:","description":"<AK_BULLET>Similar Sound Search is an AI-powered audio-to-audio and text-to-audio search capability.</AK_BULLET><AK_BULLET>A non-generative AI model is used to return similar audio results as part of the Media Pool.</AK_BULLET><AK_BULLET>Similar Sound Search is an opt-in addition to the Wwise Installation.</AK_BULLET><AK_BULLET>Databases are User defined and populated with audio metadata only.</AK_BULLET>"},"block03":{"description":"Think of Similar Sound Search as having a really smart assistant for your audio library. It leverages a deep learning model to place audio and text into a shared search space where sounds are grouped by both acoustic and semantic similarity. Similar Sound Search allows sound designers to search for sounds using either a text query or a reference audio clip, removing the need for keyword tagging or time-consuming manual navigation through vast audio libraries.\\n\\nThis enables creators to discover new, unexpected matches that would be difficult to find using conventional search methods. For example, a sound labeled “smashing fruit” might surface as a match for “footsteps in mud.”\\n\\nIn particular, Similar Sound Search allows for:<AK_BULLET><AK_BOLD>text to audio retrieval</AK_BOLD>, where a description of the sound is used to find a sample based on its audio content only. This feature is a new way to find audio that would match the description, even if the sound was recorded with a different purpose. e.g. a sound tagged and obtained by “smashing fruits” could be used to create “footsteps in mud”. Such a match would have never been possible with traditional search.</AK_BULLET><AK_BULLET><AK_BOLD>audio to audio retrieval</AK_BOLD>. Sometimes it’s easier to provide an audio example to use as a way to search for similar sounds. The provided audio example and its sonic qualities can be used as a reference to surface relevant and ranked results that are understood abstractly by the trained model.</AK_BULLET>"},"block04":{"description":"In both use cases, Similar Sound Search can be a valuable tool that gives access to sound collections in a new way, without having to manually add metadata. These two techniques naturally enrich the traditional filtering using metadata and work well together to extend the possibilities of existing sound libraries.\\n\\n<AK_LINK_1>Learn more in the Similar Sound Search Documentation</AK_LINK_1>"},"block05":{"title":"Sony AI Collaboration"},"block06":{"description":"The collaboration between Sony AI and Audiokinetic brings together cutting-edge research and industry-leading tools to support audio professionals across game development and interactive media.<br /><br /><AK_LINK_1>Read more in the Press Release</AK_LINK_1><br /><br /><AK_LINK_2>Learn more about Sony AI</AK_LINK_2>"},"block07":{"title":"Ethically Trained"},"block07a":{"description":"The search capability is powered by AI models trained on professionally licensed, professionally-created sound libraries, ensuring production-ready results. The sound libraries were provided by <AK_LINK_1>ProSoundEffects</AK_LINK_1>, <AK_LINK_2>BOOM Library</AK_LINK_2>, and <AK_LINK_3>Strata</AK_LINK_3>."},"block08":{"title":"FAQ"},"block09":{"title":"About Similar Sound Search"},"block10":{"title":"What is Similar Sound Search?"},"block10-1":{"description":"Similar Sound Search is an AI-powered audio-to-audio and text-to-audio search capability."},"block11":{"title":"What technology does Similar Sound Search use?"},"block11-1":{"description":"A non-generative AI model is used to retrieve similar audio results from user-defined databases as part of the Media Pool."},"block12":{"title":"How do I get Similar Sound Search?"},"block12-1":{"description":"Similar Sound Search is an opt-in addition during the Wwise Installation."},"block13":{"title":"Where can I find more info about using Similar Sound Search in Wwise?"},"block13-1":{"description":"<AK_LINK_1>Similar Sound Search Documentation</AK_LINK_1>"},"block14":{"title":"About Similar Sound Search’s use of AI:"},"block15":{"title":"Does Similar Sound Search leverage Generative AI?","description":"No, the non-generative AI (CLAP) model is stored and used locally."},"block15-1":{"description":"No, the non-generative AI (CLAP) model is stored and used locally."},"block16":{"title":"Does the Similar Sound Search feature connect to the Internet?"},"block16-1":{"description":"No, the database used for searching is stored locally and not accessed externally."},"block17":{"title":"Does Similar Sound Search collect or send my data to Audiokinetic?"},"block17-1":{"description":"No, the CLAP model and database is private and Audiokinetic doesn’t collect any of this data."},"block18":{"title":"What data does the Similar Sound Search use to train the AI Model?"},"block18-1":{"description":"Licensed Libraries were used to train the AI Model. (see above)"},"block19":{"title":"Does the Similar Sound Search use my data to train the AI Model?"},"block19-1":{"description":"No, the non-generative AI (CLAP) model is local and is not updated."},"block20":{"title":"Does the Wwise EULA allow Audiokinetic to use my data to train AI?"},"block20-1":{"description":"No, Audiokinetic will not use your data to train AI."}}}}}`)},nZ={buttons:{strata:"Buy Subscription","strata-pricing":"View Pricing Options","strata-trial":"Get Free Samples","more-info":"$t(common:buttons.learn-more)"},bannerTagline:"Strata",bannerSubTagline:"Your sound library, in multitrack format","subscription-description":"Subscription to Strata™","early-adopter-rebate":"Early Adopter Discount","strata-trial":{about:{title:"About Strata",description:`Strata is a multitrack sound FX library with {{collectionCount}} collections comprising over 100,000 high quality audio sources, clip edits, tracks and effect parameters.

<AK_LINK_PRODUCTS_STRATA>Learn More</AK_LINK_PRODUCTS_STRATA>

Get the free collections to immerse yourself in the rich multitrack Strata experience, and discover the incredible learning and creative potential in your hands.`},library:{title:"Free sample collections",description:"<AK_BULLET>The free sample collections include the collections described below plus all the needed effects plug-ins for Strata to function properly in REAPER</AK_BULLET><AK_BULLET>A read-only ENRAGE plug-in is included with the free Strata sample collections</AK_BULLET><AK_BULLET>Step by step instructions on installing and using the free Strata can be found in the <AK_STRATA_STEPS_LINK>Strata User Guide</AK_STRATA_STEPS_LINK></AK_BULLET>"},"price-header":"Discover Strata™","price-title":"Free Sample Collections","price-free":"100% royalty free",title:"$t(common:labels.free-samples)","header-search-result":"Included Samples ({{collectionCount}})","search-title":"Search Results",titleCount:"({{collectionCount}})"},strata:{about:{title:"About Strata",description:`Strata is a multitrack sound FX library with {{collectionCount}} collections comprising over 100,000 high quality audio sources, clip edits, tracks and effect parameters.

<AK_LINK_PRODUCTS_STRATA>Learn More</AK_LINK_PRODUCTS_STRATA>`},"price-header":"","price-title":"Subscription to Strata",title:"Strata Collections","header-search-result":"Included Collections ({{collectionCount}})","search-title":"Search Results",titleCount:"({{collectionCount}})"}},aZ={"menu-label":"Store",bannerTagline:"Strata",bannerSubTagline:"Something amazing happening here soon","free-samples":{"menu-label":"Free Sample",title:"Free Sample",titleCount:"({{collectionCount}})"},store:{"menu-label":"Store",bannerV2Title:"Audiokinetic Store",bannerV2Description:"Audiokinetic products and services at your fingertips!","store-description":"Purchase Plug-ins, Certification exams, Strata, or PAY2GO Support tickets."},pay2go:{"menu-label":"PAY2GO",card:{title:"PAY2GO Support",description:`Need help from an Audiokinetic Engineer?
Get an initial response within <AK_BLACK>2 business days</AK_BLACK> for severe and showstoppers issues!`}},plugins:{"menu-label":"Plug-ins",card:{title:"Plug-ins",description:"Expand your Wwise experience through a selection of Wwise, partner, and community plug-ins. Purchase plug-ins for your Wwise project!"}},certifications:{"menu-label":"Certifications",bannerV2Title:"Certifications",bannerV2Description:"Get certified to demonstrate your proficiency with Wwise, the trusted gold standard for cross-platform interactive and spatial audio development.",card:{title:"Certifications",description:"Being Wwise Certified can be great for your career. Demonstrate your Wwise knowledge and get listed on the Creators Directory!"}},strata:{"menu-label":"Strata",card:{title:"Strata",description:"A new generation of sound libraries, where sounds are delivered in multitrack projects!"},title:"All","search-title":"Search Results",titleCount:"({{collectionCount}})","pricing-info":{title:"Strata Pricing",bullets:{b_1:"<AK_BULLET>The sooner you subscribe to Strata, the less you will pay since prices will increase as new collections are added to the Strata library.</AK_BULLET>",b_2:"<AK_BULLET>The annual price is locked in for the 3 years of the subscription term, with year 2 and 3 installments payable each year.</AK_BULLET>",b_3:"<AK_BULLET>As of {{currentDate}}, pricing of one Strata subscription is {{currentPrice}} per user per year.</AK_BULLET>",b_4:"<AK_BULLET><AK_YELLOW_BG>Buy now! Price will increase to {{futurePrice}} on <AK_FAT_BLACK><AK_NO_WRAP>{{increasePriceDate}} EST</AK_NO_WRAP></AK_FAT_BLACK> at <AK_FAT_BLACK><AK_NO_WRAP>{{increasePriceTime}}</AK_NO_WRAP></AK_FAT_BLACK>.</AK_YELLOW_BG></AK_BULLET>"}},"getting-started-free":{title:"How to get Strata Free Samples",description:"New collections and free samples are periodically added to Strata. Follow these steps to always have the most up-to-date set of downloadable collections.",step_1:{title:"Sign In or Sign Up",description:"Your account allows you to install the $t(doNotTranslate:audiokinetic-launcher), manage your subscriptions and notifications, plus other useful benefits."},step_2:{title:"Follow Shopping Cart Instructions",description:`Follow shopping cart instructions. They will guide you through the process of obtaining your Strata subscription.

The Strata Samples subscription term is <AK_BLACK>3 years at no charge</AK_BLACK>.`},step_3:{title:"Install / $t(common:audiokineticLauncher.open)",description:`Follow in-cart links to open or install the $t(doNotTranslate:audiokinetic-launcher).

Your up-to-date list of approved Strata collections and samples is displayed and downloadable directly from the $t(doNotTranslate:audiokinetic-launcher)`}}},collection:{author:"Author",authors:"Authors","audio-sample":"{{collectionName}} collection preview",share:"Share this:","collection-part-of":{title:"This collection is part of <AK_BLACK>{{AK_LIBRARY_TITLE}}</AK_BLACK>",description:"<AK_PRICING_LINK>Strata Pricing</AK_PRICING_LINK>"},"purchase-button-label":{paid:"View Pricing Options",free:"Get {{what}}"}}},rZ={strata:nZ,"strata-pricing":{bannerV2Title:"Strata Pricing",bannerV2Description:"Which model is the right one for me ?",priceOptions:{title:"Select your licensing model","more-info":"Can't find a suitable option ? View more options!"},priceTable:{plans:{header:"Plan",projectBasedHeader:"Project-based plans"},users:{header:"Users",headerUpTo:"Users <AK_SMALLER>(up to)</AK_SMALLER>"},terms:{header:"Term",headerUpTo:"Term <AK_SMALLER>(up to)</AK_SMALLER>"},prices:{header:"Price"}},tabs:{general:{tabLabel:"General Information",details:{pro:{title:"Professional Subscription",description:`This is available in either a seat-based model, or a project-based model.  If your team is working on multiple projects simultaneously, or has a small number of sound designers, the seat-based approach is likely best for you.  On the other hand, if your studio is dedicated to only one or two simultaneous projects, or has a large number of sound designers, the project-based model is most likely the way to go.

If you are a 3rd party audio team / content provider, the approach may be somewhat dependent on what your partner studio wishes, but either approach will have its benefits.

Talk to us for more information!`},academic:{title:"Academic Subscription",description:"The academic license represents the same full-featured use of Strata as the Professional models, but is limited to students, educators, and workstations within academic institutions.  You must validate your affiliation in order to qualify for this license."},free:{title:"Free Subscription",description:"The free subscription grants you access to royalty-free sample collections with a limited subset of sounds from various collections."}},summary:{title:"Check which plan is best for you",cards:{"user-based":{title:"$t(store:strata-pricing.tabs.user-based.tabLabel)",tabCardExtra:"Best for: <AK_BULLET>individuals</AK_BULLET><AK_BULLET>team working on multiple projects</AK_BULLET><AK_BULLET>content providers</AK_BULLET>"},"project-based":{title:"$t(store:strata-pricing.tabs.project-based.tabLabel)",tabCardExtra:"Best for: <AK_BULLET>non-simultaneous projects</AK_BULLET>"},academic:{title:"$t(store:strata-pricing.tabs.academic.tabLabel)",tabCardExtra:"Best for: <AK_BULLET>students</AK_BULLET><AK_BULLET>academic institutions</AK_BULLET>"},trial:{title:"$t(store:strata-pricing.tabs.trial.tabLabel)",tabCardExtra:"Best for evaluation purposes"}}}},"user-based":{tabLabel:"User-based",details:{general:{title:"",description:"The seat-based subscription is best suited for teams either with multiple active projects in development, or with a small team of sound designers.  This is also a great package for 3rd party audio teams, who may be working on multiple projects with different studios.  If you are only working on a single project, or have a large team of sound designers, the project-based approach may be more suited to your needs."}},additionalInfo:{organisation:{title:"Enterprise / Organisation",description:"<AK_BULLET>Multiple seat licenses can be purchased and managed by an organisation (enterprise subscription)</AK_BULLET>"},technicals:{title:"Technical Specifications",description:"<AK_BULLET>Full Strata experience with all Rendered files and REAPER projects</AK_BULLET><AK_BULLET>Access to all existing & new collections during the subscription term</AK_BULLET><AK_BULLET>Full version of ENRAGE</AK_BULLET>"}}},"project-based":{tabLabel:"Project-based",details:{general:{title:"",description:"The project-based subscription is best suited for teams with one active project in development, or with a large number of sound designers. If you are working on multiple projects, or have a small team of sound designers, the seat-based approach may be more suited to your needs."}},additionalInfo:{technicals:{title:"Technical Specifications",description:"<AK_BULLET>Full Strata experience with all Rendered files and REAPER projects</AK_BULLET><AK_BULLET>Access to all existing & new collections during the subscription term</AK_BULLET><AK_BULLET>Full version of ENRAGE</AK_BULLET>"}}},academic:{tabLabel:"Academic",details:{general:{title:"",description:"This subscription is for students and also available for academic institutions. Students may use their Strata subscription to publish commercial projects."}},additionalInfo:{organisation:{title:"Enterprise / Organisation",description:"<AK_BULLET><AK_LINK_CONTACT_SALES_6>Contact us</AK_LINK_CONTACT_SALES_6> if you're interested in multiple seat licenses for your academic institution as workstation or lab licenses.</AK_BULLET>"},technicals:{title:"Technical Specifications",description:"<AK_BULLET>Full Strata experience with all Rendered files and REAPER projects</AK_BULLET><AK_BULLET>Access to all existing & new collections during the subscription term</AK_BULLET><AK_BULLET>Full version of ENRAGE</AK_BULLET>"}}},trial:{tabLabel:"$t(common:labels.free-samples)",details:{general:{title:"",description:"The free sample subscription grants you access to a small subset of royalty-free sounds from Strata library.  This subscription does not allow editing of the ENRAGE effect properties.  However, any sounds you create for your projects from the free sample collections are legally safe to use in commercial synchronization."}},additionalInfo:{technicals:{title:"Technical Specifications",description:"<AK_BULLET>A tiny fraction of the full library, but a good way to evaluate Strata</AK_BULLET><AK_BULLET>ENRAGE effect can be bypassed but settings cannot be modified</AK_BULLET>"}}}}},module:aZ},oZ={"menu-label":"Strata","strata-img-alt":"Strata header logo"},sZ={"menu-label":"Overview",helmet:{title:"Strata Sound Effects Library | Overview | Audiokinetic",description:"Discover Strata, a professional Sound Effects Library and platform offering curated audio collections for games, films, and media. Explore premium sound design tools today."}},lZ={helmet:{title:"{{AK_VAR_COLLECTION_NAME}} | Sound Effects | Premium SFX | Audiokinetic",description:"{{AK_VAR_COLLECTION_DESCRIPTION}}"}},cZ={"menu-label":"Sound Effects Collections",bannerV2Title:"Sound Effect Collections",bannerV2Description:"Strata is a multitrack sound FX library with {{AK_VAR_COLLECTION_COUNT}} collections comprising over {{AK_VAR_AUDIO_SOURCE_COUNT}} high quality audio sources, clip edits, tracks and effect parameters.",helmet:{title:"Sound Effects Collections | Premium SFX | Audiokinetic",description:"Discover Strata's curated collections of high-quality sound effects, from atmospheric ambiances to dynamic effects. Perfect for games, films, and immersive experiences."},filters:{title:"$t(common:labels.filters)",searchTermPlaceHolder:"Search for collections...",libraries:{title:"Libraries{{AK_VAR_COUNT}}",types:{strata:"Strata Library","strata-trial":"Strata Samples"}},authors:{title:"Authors{{AK_VAR_COUNT}}"},tags:{title:"Tags{{AK_VAR_COUNT}}",types:{new:"$t(common:labels.new)",exclusive:"$t(common:labels.exclusive)",free:"$t(common:labels.free)"}}}},uZ={helmet:{title:"Strata Pricing | Audiokinetic",description:"Discover the pricing plans for the Strata Sound Effects Library. Choose the right subscription to access high-quality game audio assets tailored to your needs."}},dZ={"menu-label":"Features",bannerV2Title:"Features",bannerV2Description:"Strata Library is more than just audio files. Explore its distinctive features and components.","banner-alt":"Strata features banner image"},hZ={"menu-label":"Documentation"},pZ={helmet:{title:"Licensing FAQ | Audiokinetic ",description:"Find answers to your Licensing questions regarding the Audiokinetic Products."}},mZ={module:oZ,overview:sZ,collection:lZ,collections:cZ,"collections-free":{helmet:{title:"Free Sound Effects Collections | Premium SFX | Audiokinetic",description:"Strata Free Sample Library and experience premium-quality sound effects. Perfect for audio professionals in games, films, and interactive projects. Download High-quality Sound Effects."}},pricing:uZ,features:dZ,documentation:hZ,licensing:pZ,"licensing-faq":{"menu-label":"Licensing FAQ"}},vZ={"menu-label":"Purchasing Terms and Conditions",terms:{bannerTagline:"Audiokinetic Purchasing Terms and Conditions","north-america":{"menu-label":"North America",subsidiaries:{"ak-inc":{subsidiary:"Audiokinetic Inc.",pdfs:{canada_fr:"Canada (Français)",canada_en:"Canada (English)",usa_en:"United states (English)"}}}},"asia-pacific":{"menu-label":"Asia Pacific",subsidiaries:{"ak-shanghai":{subsidiary:"Audiokinetic Shanghai Technology Co., Ltd",pdfs:{china_en:"China (English)",china_zh:"China (Chinese)"}},"ak-kk":{subsidiary:"Audiokinetic K.K.",pdfs:{japan_en:"Japan (English)",japan_ja:"Japan (Japanese)"}}}},europe:{"menu-label":"Europe",subsidiaries:{"ak-europe":{subsidiary:"Audiokinetic B.V.",pdfs:{europe_en:"Europe (English)"}}}},"terms-and-conditions":"Terms and Conditions",subsidiary:"Subsidiary","find-terms":"Find the terms and conditions based on your region and specific Audiokinetic subsidiary below:",pdf:"(PDF)",territories:"Territories"}},fZ={module:vZ},gZ={name:"$t(doNotTranslate:testimonials.angel_ignace.name)",title:"$t(doNotTranslate:testimonials.angel_ignace.title)",quote:"After 10 years doing sound for games in both France and Asia while teaching Wwise at many schools worldwide, becoming Wwise Affiliate was the natural next step and i am super happy to bring my experience and help the Wwise community grow worldwide.",avatar:"$t(doNotTranslate:testimonials.angel_ignace.avatar)"},MZ={name:"$t(doNotTranslate:testimonials.anthony_biafore.name)",title:"$t(doNotTranslate:testimonials.anthony_biafore.title)",quote:"My goal is to make Wwise feel approachable and exciting, giving both educators and students the confidence to use it the same way professionals do.",avatar:"$t(doNotTranslate:testimonials.anthony_biafore.avatar)"},_Z={name:"$t(doNotTranslate:testimonials.booker_edwards.name)",title:"$t(doNotTranslate:testimonials.booker_edwards.title)",quote:"I became a Wwise Affiliate Instructor because I’m passionate about music, audio, and interactive sound — and I love helping students connect what they learn in class to real industry practices. It’s incredibly rewarding to see them using the same tools as top game studios and realizing their potential. By bringing Wwise into our courses and workshops, I’m helping build new opportunities for students to launch careers in interactive audio.",avatar:"$t(doNotTranslate:testimonials.booker_edwards.avatar)"},LZ={name:"$t(doNotTranslate:testimonials.brian_doliveira.name)",title:"$t(doNotTranslate:testimonials.brian_doliveira.title)",quote:"Wwise’s music engine to us has become our defacto ‘DAW’ in creating our musical arrangements within the game, allowing us to create complex multi-layered scores that are completely reactive to gameplay."},AZ={name:"$t(doNotTranslate:testimonials.carl_noren.name)",title:"$t(doNotTranslate:testimonials.carl_noren.title)",quote:"We're happy with Strata, got everything set up and expanded our footstep material coverage using the footstep libraries. Those really have great coverage on actions"},zZ={name:"$t(doNotTranslate:testimonials.dave_kalberg.name)",title:"$t(doNotTranslate:testimonials.dave_kalberg.title)",quote:"I love teaching Wwise!\\n\\nInteractive audio is the evolution of our industry that transforms sound from a passive experience into an active, adaptive component of story telling and design. As an Instructor I love teaching interactive audio and preparing a new generation of creators to support all types of immersive interactive experiences from gaming to the metaverse.",avatar:"$t(doNotTranslate:testimonials.dave_kalberg.avatar)"},bZ={name:"$t(doNotTranslate:testimonials.florian_bodenschatz.name)",title:"$t(doNotTranslate:testimonials.florian_bodenschatz.title)",quote:"In my opinion, Strata is more than a tool—it’s a game-changer for sound design. Whether you’re just starting or have years of experience, Strata enhances your craft, speeds up your process, and expands your knowledge in ways that are hard to match."},wZ={name:"$t(doNotTranslate:testimonials.francois_xavier_dupas.name)",title:"$t(doNotTranslate:testimonials.francois_xavier_dupas.title)",quote:"I've used Wwise in numerous games and I love it. It's incredibly powerful, yet it's extremely easy to learn and use. A special mention goes to the interactive music engine: flexible, and well designed, it's a game changer for composers and gives results that can't be achieved anywhere else."},yZ={name:"$t(doNotTranslate:testimonials.jon_vincent.name)",title:"$t(doNotTranslate:testimonials.jon_vincent.title)",quote:"We use Wwise on a daily basis with a team of sound designers and programmers. We found the Designer client to be stable and hugely adjustable to accomplish any audio ends we can think of."},EZ={name:"$t(doNotTranslate:testimonials.marshall_mcgee.name)",title:"$t(doNotTranslate:testimonials.marshall_mcgee.title)",quote:"The library is super high quality. The assets I feel will be useful to tons of game sound designers not only because they're high quality and formatted well, but because of the categories of assets you guys have chosen to add."},HZ={name:"$t(doNotTranslate:testimonials.matt_pirog.name)",title:"$t(doNotTranslate:testimonials.matt_pirog.title)",quote:"You could create a Bachelor to Master level curriculum based on what's in Strata alone."},TZ={name:"$t(doNotTranslate:testimonials.robert_brock.name)",title:"$t(doNotTranslate:testimonials.robert_brock.title)",quote:"When deciding which software we'd teach for our game audio course, Wwise was the clear choice because of its interface, industry adoption and most importantly because of the incredible people at Audiokinetic who have been so helpful and supportive in our curriculum development."},SZ={name:"$t(doNotTranslate:testimonials.simone_cicconi.name)",title:"$t(doNotTranslate:testimonials.simone_cicconi.title)",quote:"I was always fascinated by the depth of Wwise as a sound design tool and I always wanted to know more. I also think  there are several barriers to enter the game audio industry and I think mentoring people can help tearing down the walls. This is what being and affiliate instructor means to me, showing the super powers of interactive audio in order to allow the new audio people to be in control of the audience emotions.",avatar:"$t(doNotTranslate:testimonials.simone_cicconi.avatar)"},VZ={name:"$t(doNotTranslate:testimonials.tim_brown.name)",title:"$t(doNotTranslate:testimonials.tim_brown.title)",quote:"I became a Wwise instructor to help students translate their audio expertise into the world of game audio.  My mission is to make Wwise approachable, showing them how to create truly interactive experiences that are essential to game development and foundational to building a successful career.",avatar:"$t(doNotTranslate:testimonials.tim_brown.avatar)"},CZ={name:"$t(doNotTranslate:testimonials.tyler_gillis.name)",title:"$t(doNotTranslate:testimonials.tyler_gillis.title)",quote:"This collection has done more for me than any school or course has ever done. It's almost like having a pro sound designer sitting next to you, showing you what was recorded, how it was recorded, what it was recorded with, and how it was processed."},BZ={name:"$t(doNotTranslate:testimonials.vasilis_milesis.name)",title:"$t(doNotTranslate:testimonials.vasilis_milesis.title)",quote:"As a Wwise Affiliate Instructor, I want to inspire students to think of every sound as a character, every silence as a choice, and every project as a story waiting to be told. A chance to remind them that sound can be as narrative as dialogue or light.",avatar:"$t(doNotTranslate:testimonials.vasilis_milesis.avatar)"},IZ={angel_ignace:gZ,anthony_biafore:MZ,booker_edwards:_Z,brian_doliveira:LZ,carl_noren:AZ,dave_kalberg:zZ,florian_bodenschatz:bZ,francois_xavier_dupas:wZ,jon_vincent:yZ,marshall_mcgee:EZ,matt_pirog:HZ,robert_brock:TZ,simone_cicconi:SZ,tim_brown:VZ,tyler_gillis:CZ,vasilis_milesis:BZ},OZ={account:{bannerV2Title:"Thank you!","thank-you-summary":" "},automotive:{bannerV2Title:"Thank you!","thank-you-summary":"Thank you for registering your project. Please note that Wwise Automotive is not downloadable through the $t(doNotTranslate:audiokinetic-launcher). We recommend you start your evaluation with the standard Wwise Authoring, available through the $t(doNotTranslate:audiokinetic-launcher), and we will be in touch with you soon about your project and needs, and to provide you with access to download the additional Wwise Automotive components."},launcher:{bannerV2Title:"Thank you!","thank-you-summary":"If your download doesn't start automatically, <AK_LINK>click here to start the download manually</AK_LINK>."},lbe:{bannerV2Title:"Thank you!","thank-you-summary":`Thank you for registering your project! 
Please allow some time for project approval. You will be contacted if we require any clarification.`},course:{bannerV2Title:"Thank you!","thank-you-summary":`Thank you for registering your Course! 
Please note that Courses must be approved by school admins before Audiokinetic can issue a License Key. We will contact you if we need any more details.`},"game-jam":{bannerV2Title:"Thank you!","thank-you-summary":`Thank you for registering your Game Jam! 
Please allow some time for approval. You will be contacted if we require any clarification.`},"non-gaming":{bannerV2Title:"Thank you!","thank-you-summary":" "},"plug-in":{bannerV2Title:"Thank you!","thank-you-summary":"Thank you for registering your plug-in. Your submission will be reviewed soon. We will contact you should we require any clarification, or when your plug-in is approved. Once your plug-in is approved, you will be able to submit your plug-in and marketing material via an SFTP link that will be provided to you."},"plug-in-evaluation":{bannerV2Title:"Thank you!","thank-you-summary":" "},"plug-in-evaluation-gme":{bannerV2Title:"Thank you!","thank-you-summary":" "},"plug-in-sdk":{bannerV2Title:"Thank you!","thank-you-summary":"Thank you for registering your plug-in. Your submission will be reviewed soon. We will contact you should we require any clarification, or when your plug-in is approved. Once your plug-in is approved, you will be able to promote and sell your plug-in for use with Wwise."},project:{bannerV2Title:"Thank you!","thank-you-summary":`Thank you for registering your project! 
Please allow some time for project approval. You will be contacted if we require any clarification.`},school:{bannerV2Title:"Thank you!","thank-you-summary":`Thank you for registering your school! 
You will be contacted if we require any clarification. `},"sign-up":{bannerV2Title:"Thank you!","thank-you-summary":" "},"sign-up-download":{bannerV2Title:"Thank you!","thank-you-summary":" "},students:{bannerV2Title:"Thank you!","thank-you-summary":"Your request for an Audiokinetic Academic License Key has been sent to your Course Project Leader. If you do not receive a response within a week, please contact your Course teacher. Should you need assistance contacting your Course teacher, please <AK_LINK>contact us</AK_LINK> and we can help connect you with your Course Project Leader."},trial:{bannerV2Title:"Thank you!","thank-you-summary":" "},cards:{blog:{title:"Learn From Our Community",description:"Stay informed and learn from your peers! The Audiokinetic blog features various articles by audio professionals, covering numerous interactive audio industry topics and projects.",ctaPrimary:"$t(common:buttons.learn-more)"},check_plugin:{title:"Check Your Plug-in Status",description:"Check the status of your application, edit your information, or reach out if you have any questions.",ctaPrimary:"$t(common:buttons.learn-more)"},creators_directory:{title:"Creators Directory",description:"Seek or get sought! The Audiokinetic Creators Directory empowers the Wwise community by connection audio experts and developers on an international platform.",ctaPrimary:"$t(common:buttons.learn-more)"},discover:{title:"Discover",description:"Discover how you can use Wwise for non-gaming projects.",ctaPrimary:"$t(common:buttons.learn-more)"},discover_lbe:{title:"Discover LBE",description:"Learn more about our free LBE specific plug-ins and more!",ctaPrimary:"$t(common:buttons.learn-more)"},download:{title:"Download",description:"Download the $t(doNotTranslate:audiokinetic-launcher) to install the latest version of Wwise.",ctaPrimary:"$t(common:buttons.learn-more)"},game_jam:{title:"Game Jam",description:"Check out your game jam project page.",ctaPrimary:"$t(common:buttons.learn-more)"},get_certified:{title:"Get Certified",description:"Learn Wwise and get certified to enhance your visibility to employers through the Creators Directory.",ctaPrimary:"$t(common:buttons.learn-more)"},learn:{title:"Learn",description:"Access learning material for free, and get certified to enrich your career.",ctaPrimary:"$t(common:buttons.learn-more)"},license_key:{title:"Update License Key",description:"Update your project's license key from the launcher or download it from your project page.",ctaPrimary:"$t(common:buttons.learn-more)"},register_a_course:{title:"Register A Course",description:"Add a Course that is offered by your school in order to obtain an Academic License Key. You will be able to approve students under courses, which will grant them access to a one-year License Key. This License Key grants an all access pass to Wwise and its plug-ins.",ctaPrimary:"$t(common:buttons.learn-more)"},register_your_project:{title:"Register Your Project",description:"Register your commercial or non-commercial project to get the full evaluation version of Wwise with no sound limitations and full plug-ins access.",ctaPrimary:"$t(common:buttons.learn-more)"},plugins:{title:"Get More",description:"Check out our other plug-ins!",ctaPrimary:"$t(common:buttons.learn-more)"},prepare_plugin:{title:"Prepare Your Plug-in",description:"Access documentation for Technical Requirements and prepare your plug-in for submission.",ctaPrimary:"$t(common:buttons.learn-more)"},submit_marketing:{title:"Submit Your Marketing Material",description:"View Marketing Guidelines so you can gather and submit your store front material such as your plug-in description, logo, and screenshots.",ctaPrimary:"$t(common:buttons.learn-more)"},view_course:{title:"View Course",description:"Check out your newly created Course page. You can now access your project License Key and add students or approve student requests to grant them access to a one-year License Key.",ctaPrimary:"$t(common:buttons.learn-more)"},view_school:{title:"View School",description:"Check out your newly created school page. You can now add courses, add Project leaders, and manage your profile, as School Admin.",ctaPrimary:"$t(common:buttons.learn-more)"},wwise_resources:{title:"Wwise Resources",description:"Consult our online documentation, watch our tutorial videos or check out the sample projects.",ctaPrimary:"$t(common:buttons.learn-more)"}}},NZ={module:OZ},xZ={"menu-label":"Messages"},KZ={module:xZ,"main-component":{title:"Messages | Inbox",tools:{"selected-messages-count":"Selected messages ({{messagesForActionLength}})","select-all-messages":"Select All messages","clear-selection":"Clear selection","mark-selected-message-as-read":"Mark selected message as read","mark-selected-message-as-unread":"Mark selected message as unread","mark-selected-messages-as-read":"Mark selected messages as read","mark-selected-messages-as-unread":"Mark selected messages as unread","delete-selected-messages":"Delete selected messages","select-messages":"Select a message to display.","toaster-messages":{success:{title:"Response sent",description:"Your invitation response has been receive"},error:{title:"Error responding",description:"There was a problem receiving your invitation response"}}}},"delete-what":{invitation:{title:"Decline Invitation",description:"If you decline the invitation, it will be deleted. Are you ok?","button-delete":"$t(common:buttons.decline)"},"uploaded-image":{title:"Delete image",description:"Are you sure you want to delete this image from the server?","button-delete":"$t(common:buttons.delete-forever)"},message:{singular:{title:"Delete Message",description:"Are you sure you want to delete this message?","button-delete":"$t(common:buttons.delete-forever)"},plural:{title:"Delete Messages",description:"Are you sure you want to delete these messages?","button-delete":"$t(common:buttons.delete-forever)"}}}},RZ={"menu-label":"Wwise",logo:"Wwise logo"},PZ={"menu-label":"Overview"},UZ={"menu-label":"Integrations"},DZ={"menu-label":"Documentation"},kZ={"menu-label":"Pricing"},WZ={module:RZ,overview:PZ,"plug-ins":JSON.parse(`{"menu-label":"Plug-ins","bannerV2Title":"Plug-ins & Assets","ctas":{"buildPlugin":"Build your Plug-In","pricingForGames":"Pricing Details","compatibility":"Compatibilities","install":"How to install Plug-ins"},"details":{"author":"Author","type":"Plug-in type(s)","related_asset":"Required plug-in","related_plugin":"Related assets","wwise":"Compatible Wwise versions","platforms":"Compatible platforms","fullCompatibilityTable":"View full compatibility table"},"tabs":{"PLUGINS":{"label":"Plug-ins","searchTermPlaceHolder":"Textual search in Plug-ins..."},"ASSETS":{"label":"Assets","searchTermPlaceHolder":"Textual search in Assets..."},"COMMUNITY":{"label":"Community","searchTermPlaceHolder":"Textual search in Community plug-ins..."}},"filters":{"PLUGINS":{"title":"Filters","searchTermPlaceHolder":"Textual search in Plug-Ins...","filters":{"authorsFilter":"$t(wwise:plug-ins.filters.authorsFilter)","pluginTags":"$t(wwise:plug-ins.filters.pluginTags)","effectTypes":"$t(wwise:plug-ins.filters.effectTypes)","wwiseVersion":"$t(wwise:plug-ins.filters.wwiseVersion)","platforms":"$t(wwise:plug-ins.filters.platforms)"}},"ASSETS":{"title":"Filters","searchTermPlaceHolder":"Textual search in Assets...","filters":{"authors":"$t(wwise:plug-ins.filters.authors)"}},"COMMUNITY":{"title":"Filters","searchTermPlaceHolder":"Textual search in Community Plug-ins...","filters":{"communityInfo":"$t(wwise:plug-ins.filters.communityInfo)"}},"authorsFilter":{"title":"Authors","types":"$t(wwise:plug-ins.authorsFilter)"},"authors":{"title":"Authors"},"pluginTags":{"title":"Tags{{AK_VAR_COUNT}}","types":"$t(wwise:plug-ins.pluginTags)"},"effectTypes":{"title":"Effect Types{{AK_VAR_COUNT}}","types":"$t(wwise:plug-ins.effectTypes)"},"platforms":{"title":"Platforms{{AK_VAR_COUNT}}"},"wwiseVersion":{"title":"Wwise version"},"communityInfo":{"title":"Community Plug-ins","description":"Community plug-ins are developed and maintained by the community. If you are interested in learning more about how to create your own plug-in, check out our <AK_LINK_COMMUNITY_PLUGINS>Developing Community Plug-ins</AK_LINK_COMMUNITY_PLUGINS> page.<br/><br/>If you’d like to have your plug-in featured on this page, please email <AK_LINK_EMAIL_MARKETING>marketing@audiokinetic.com</AK_LINK_EMAIL_MARKETING>."}},"authorsFilter":{"ak":"$t(doNotTranslate:audiokinetic)","certified_partner":"Certified Partner"},"pluginTags":{"built_in":"Built-In","experimental":"Experimental","featured":"Featured","free":"Free","new":"New"},"effectTypes":{"assets":"Assets","acoustics":"Acoustics","built_in":"Built-In","delay":"Delay","distortion":"Distortion","dynamics":"Dynamics","experimental":"Experimental","featured":"Featured","filter":"Filter","free":"Free with License","haptics":"Haptics","impulse_response":"Impulse Response","mastering":"Mastering","modulation":"Modulation","new":"New","routing":"Routing","spatial_audio":"Spatial Audio","synthesis":"Synthesis","text_to_speech":"Text-to-speech","three_d":"3D Audio","voice":"Voice Chat"},"pricing":{"title":"Pricing for games","assetModel":"Model","platformsFirst":"First platform","platformsExtra":"Extra platforms (each)"},"pluginsWithComplexPriceTable":{"crankcase-rev-assets":{"acura_integra":{"name":"$t(doNotTranslate:carNames.acura_integra)","description":"The second generation of the classic Japanese street tuner, this features a 1.6L naturally aspirated B16A engine with VTEC. <i>Original Recording by Bryan Watkins</i>"},"alfa_romeo_competizione":{"name":"$t(doNotTranslate:carNames.alfa_romeo_competizione)","description":"This rare car (one of only 500 built) is equipped with a powerful, 4.7L 450 hp V8 (the same engine as used in Maserati Quattroporte S and Granturismo S).<i>Original Recording by Pole Position Production</i>"},"aston_martin_rapide":{"name":"$t(doNotTranslate:carNames.aston_martin_rapide)","description":"This refined British V12 has a whopping 510 BHP"},"audi_r8":{"name":"$t(doNotTranslate:carNames.audi_r8)","description":"Recorded onboard an amazing R8 with a 525 hp V10 engine. <i>Original Recording by Pole Position Production</i>"},"audi_s6":{"name":"$t(doNotTranslate:carNames.audi_s6)","description":"Imagine crossing a station wagon with a Lamborghini, and you might get this 2007 Audi. It's got a naturally aspirated 5.2 liter V10 435 horsepower engine and a distinctive Milltek exhaust system."},"bmw_740i":{"name":"$t(doNotTranslate:carNames.bmw_740i)","description":"A custom Magnoflow exhaust gives this Bavarian Beast a little blaze in its bauch."},"bmw_m4":{"name":"$t(doNotTranslate:carNames.bmw_m4)","description":"A German luxory car with a few tricks up it's exhaust pipe; a 3L turbocharged straight-six petrol engine modified with cat back."},"chevrolet_camaro_ss":{"name":"$t(doNotTranslate:carNames.chevrolet_camaro_ss)","description":"This modern remake of the classic muscle car features a massive 426 hp 6.2L V8. <i>Original Recording by Pole Position Production</i>"},"chevrolet_camaro_super_hugger":{"name":"$t(doNotTranslate:carNames.chevrolet_camaro_super_hugger)","description":"The second generation Camaro, introduced in 1970 as a car for people who \\"really dig driving\\". Your cousin had one and if you were lucky he picked you up in it after school to go get a soda. <i>Original Recording by Pole Position Production</i>"},"chevrolet_chevelle":{"name":"$t(doNotTranslate:carNames.chevrolet_chevelle)","description":"A quintessential American muscle car and a true King of the Streets. Such a popular body style that even Jack Reacher drives one!"},"chevrolet_corvette":{"name":"$t(doNotTranslate:carNames.chevrolet_corvette)","description":"With the LS7 7.0L engine under the hood, this was the fastest Corvette ever - back in the old days of 2006. <i>Original Recording by Bryan Watkins</i>"},"corvette_c7":{"name":"$t(doNotTranslate:carNames.corvette_c7)","description":"The custom Borla exhaust makes this 6.2 L LT4 supercharged V8 engine from 2016 produce a wonderful new-muscle racket."},"de_tomaso_pantera":{"name":"$t(doNotTranslate:carNames.de_tomaso_pantera)","description":"A sleek Italian sports coupe from 1972. Elvis had one of these, and he shot it (probably jealous). This one has had the original 351 Cleveland replaced with a BMW Alpina B10 V8. <i>Original Recording by Pole Position Production</i>"},"dodge_challenger_440":{"name":"$t(doNotTranslate:carNames.dodge_challenger_440)","description":"A classic big block muscle car with a 440 “Six Pack” engine (three two-barrel Holley carbs). <i>Original Recording by Pole Position Production</i>"},"dodge_challenger":{"name":"$t(doNotTranslate:carNames.dodge_challenger)","description":"Old-school muscle at it's finest. Edelbrock Performer heads, Hooker headers, Magnaflow X-pipe system and a 3 gear automatic transmission."},"dodge_viper":{"name":"$t(doNotTranslate:carNames.dodge_viper)","description":"The big V10 truck motor gives this muscle car its distinctive growl.  <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"ferrari_430":{"name":"$t(doNotTranslate:carNames.ferrari_430)","description":"The successor to the much-loved 360, this Italian sports car contains a mid engine 4.3L V8 that produces the classic Ferrari howl. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"ferrari_458":{"name":"$t(doNotTranslate:carNames.ferrari_458)","description":"This successor to the F430 has a mid-engine setup has a 7-speed dual clutch and a top speed of 202 mph. Mamma mia!"},"ferrari_488":{"name":"$t(doNotTranslate:carNames.ferrari_488)","description":"660 horsepower. I mean.. that seems a little excessive guys. You could definitely pull a lot of wagons with this supercar."},"ferrari_575m":{"name":"$t(doNotTranslate:carNames.ferrari_575m)","description":"The \\"Maranello\\" has a big V12 and screams like a banshee. It's a sure bet that Magnum PI would have driven this Ferrari if only his show had come out 2o years later. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"ford_mustang":{"name":"$t(doNotTranslate:carNames.ford_mustang)","description":"A modern take on classic American muscle; more refined than it's predeccesor, but still a powerful contender. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"ford_puma":{"name":"$t(doNotTranslate:carNames.ford_puma)","description":"This German-built Ford was purpose built for the demands of rallying; in unrelated news, it also bears a striking resemblance to a kittycat. Oh, Puma! I get it."},"ford_rs200":{"name":"$t(doNotTranslate:carNames.ford_rs200)","description":"A Group B rally car with a very fast mid engine mounted 1.8L Inline 4. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"honda_cbr":{"name":"$t(doNotTranslate:carNames.honda_cbr)","description":"Named after the Lockheed SR-71 Blackbird (look it up, cool plane!), this street bike held the title of world's fastest production motorcycle for two years when it hit a top speed of 178.5 mph."},"honda_civic":{"name":"$t(doNotTranslate:carNames.honda_civic)","description":"Not your mom’s grocery getter, this Civic would burn up the Whole Foods parking lot. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"honda_nsx":{"name":"$t(doNotTranslate:carNames.honda_nsx)","description":"The Japanese supercar classic, it pushes its 280 hp 3.0L V6 to an 8000 RPM redline. <i>Original Recording by Bryan Watkins</i>"},"jeep_srt8":{"name":"$t(doNotTranslate:carNames.jeep_srt8)","description":"\\"SRT\\" stands for Street and Racing Technology and there's no doubt that this bad-a** Jeep comes from the same shop that gave us the Viper, Hellcat and Demon."},"lamborghini_huracan":{"name":"$t(doNotTranslate:carNames.lamborghini_huracan)","description":"How do you replace a Gallardo? With this 610 HP beast!</div>"},"lancia_delta_integrale":{"name":"$t(doNotTranslate:carNames.lancia_delta_integrale)","description":"Get your pace notes prepped and jump aboard this 1989 rally car with a turbocharged 2-litre Lancia 16v 4 cylinder engine and Garrett T3 turbocharger.</div>"},"lincoln_navigator":{"name":"$t(doNotTranslate:carNames.lincoln_navigator)","description":"The best way to get to the club with your entourage, this big V8 has a refined roar."},"mazda_rx8":{"name":"$t(doNotTranslate:carNames.mazda_rx8)","description":"The rotary engine, aftermarket exhaust and high revs give this car a signature sound all its own. <i>Original Recording by Bryan Watkins</i>"},"nissan_370z":{"name":"$t(doNotTranslate:carNames.nissan_370z)","description":"The heir to ther throne of the extremely popular 350Z, this Nissan has updated styling, and more imprtantly, more horsepower. <i>Original Recording by Pole Position Production</i>"},"nissan_gt_r":{"name":"$t(doNotTranslate:carNames.nissan_gt_r)","description":"Made really famous by that movie with people driving quick cars in an angry fashion, the Skyline was developed in Japan as a touring race car and has since become an iconic track car all over the World. This car is a third generation model, revived in 1989 after a 10 year hiatus."},"pontiac_grand_prix":{"name":"$t(doNotTranslate:carNames.pontiac_grand_prix)","description":"This mysterious car has murky past, but it sounds like a beast and is sure to intimidate your rivals. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"porsche_997":{"name":"$t(doNotTranslate:carNames.porsche_997)","description":"a.k.a the 911, this has the distinctive flat-6 sound of the preeminent German sports car. <i>Original Recording by Bryan Watkins</i>"},"range_rover":{"name":"$t(doNotTranslate:carNames.range_rover)","description":"Great for dangerous back country expeditions and/or getting your kid to soccer practice in style, there's no denying this SUV's great style and satisfying growl."},"toyota_ch_r":{"name":"$t(doNotTranslate:carNames.toyota_ch_r)","description":"For some mysterious reason, nobody knows what CH-R really stands for. Compact High Rider? Cross Hatch Run? Coupé High–Rider? What we do know is it has a 1.2 litre turbo petrol engine with 4 cylinders and a 6 speed automatic transmission, and sounds pretty cool."},"toyota_gt86":{"name":"$t(doNotTranslate:carNames.toyota_gt86)","description":"Three cars in one (depending where you live)! This is also known as the Subaru BRZ and the Scion FR-S. But really, you can't ignore the proud Japanese lineage of this Hachi-Roku racer, which is said to be the spiritual successor to the AE86. <i>Original Recording by The Audio Guys – www.theaudioguys.co.uk</i>"},"toyota_supra":{"name":"$t(doNotTranslate:carNames.toyota_supra)","description":"This turn of the millenium tuner car is has a smooth purr that hides a whole lot of raw power."},"triumph_bonneville":{"name":"$t(doNotTranslate:carNames.triumph_bonneville)","description":"You can call this bike 'Bonnie' - a great classic British road bike. Cheerio."},"volkswagen_golf":{"name":"$t(doNotTranslate:carNames.volkswagen_golf)","description":"Featuring a rich, powerful sound from the staggered six cylinder configuration and aftermarket exhaust. <i>Original Recording by Bryan Watkins</i>"},"volvo_242":{"name":"$t(doNotTranslate:carNames.volvo_242)","description":"Don't ever say that the Swedes don't know how to make a spiffy race car. This 1975 beauty which is \\"klädd up till tänderna\\" is proof positive."},"vw_van":{"name":"$t(doNotTranslate:carNames.vw_van)","description":"Beloved hippie transportation from the 1960's, the familiar chug of this van evokes a simpler time, with great music and altered states."},"yamaha_24mx":{"name":"$t(doNotTranslate:carNames.yamaha_24mx)","description":"A 125cc dirt bike great for the berms, rollers and whoops on the motocross track."}},"readspeaker":{"adam":{"name":"$t(doNotTranslate:readspeakerVoices.adam","description":"Male voice"},"kayla":{"name":"$t(doNotTranslate:readspeakerVoices.kayla","description":"Female voice"},"sophie":{"name":"$t(doNotTranslate:readspeakerVoices.sophie","description":"Female voice"},"molly":{"name":"$t(doNotTranslate:readspeakerVoices.molly","description":"Female voice"},"gina":{"name":"$t(doNotTranslate:readspeakerVoices.gina","description":"Female voice"},"manuel":{"name":"$t(doNotTranslate:readspeakerVoices.manuel","description":"Male voice"},"carolina":{"name":"$t(doNotTranslate:readspeakerVoices.carolina","description":"Female voice"},"hong":{"name":"$t(doNotTranslate:readspeakerVoices.hong","description":"Male voice"},"hyeryun":{"name":"$t(doNotTranslate:readspeakerVoices.hyeryun","description":"Male voice"},"klara":{"name":"$t(doNotTranslate:readspeakerVoices.klara","description":"Female voice"},"roxane":{"name":"$t(doNotTranslate:readspeakerVoices.roxane","description":"Female voice"},"sayaka":{"name":"$t(doNotTranslate:readspeakerVoices.sayaka","description":"Female voice"}}},"byId":{"ak-asio":{"shortDescription":"Use the Steinberg Audio Stream Input/Output (ASIO) SDK to connect to ASIO compatible devices.","helmetDescription":"Use the Steinberg Audio Stream Input/Output (ASIO) SDK to connect to ASIO compatible devices.","description":"This free plug-in uses the Steinberg Audio Stream Input/Output (ASIO) SDK in order to connect to ASIO compatible devices. It can be used as a source plug-in (input) or an Audio Device (output)."},"ak-channel-router":{"shortDescription":"Route and mix audio to specific target channels.","helmetDescription":"Route and mix audio to specific target channels.","description":"This mixer plug-in lets you route and mix audio to specific target channels. This is especially useful when dealing with an output device with many channels that require non-standard routing."},"altiverb":{"shortDescription":"A library of 49 game-centric impulse responses","helmetDescription":"A library of 49 game-centric impulse responses","description":"This is a library of 49 game-centric impulse responses provided by Audio Ease, which enhances the AK Convolution plug-in. Audio Ease has been traveling the world to record the acoustics of the very best sounding spaces.","mediaURL":["/images/plug-ins/preview/audioease_outdoor_package.jpg"],"detailsData":{"para_1":{"title":"","description":"<AK_BOLD>Requires AK Convolution</AK_BOLD>"},"para_2":{"title":"Outdoor Streets and Alleys","structuredDescription":{"b_1":"<AK_BULLET>Recorded late on a cold windless night in February.</AK_BULLET>","b_2":"<AK_BULLET>No leaves rustling, and no animals or people around.</AK_BULLET>","b_3":"<AK_BULLET>Recordings allow you to immerse players 'outside'.</AK_BULLET>"}},"para_3":{"title":"Business, Park and Domestic Set","structuredDescription":{"b_1":"<AK_BULLET>Contains <AK_BOLD>Outdoor Impulse Responses</AK_BOLD> from streets, alleys and a tunnel.</AK_BULLET>","b_2":"<AK_BULLET>Features small rooms, including living rooms, bathrooms, a classroom, an attic and study rooms.</AK_BULLET>"}},"para_4":{"title":"Transport","structuredDescription":{"b_1":"<AK_BULLET>Features cars ranging from the small Volkswagen Beetle to mini-vans like the Peugeot Partner; includes both front and back seat recordings in some cases.</AK_BULLET>","b_2":"<AK_BULLET>Includes the Sikorski Helicopter and the Blue Angel train.</AK_BULLET>"}},"para_5":{"title":"Forest Set","structuredDescription":{"b_1":"<AK_BULLET>Recorded in the forest of Austerlitz, part of a national park on the Utrechtse Heuvelrug in The Netherlands; this forest has a large variety of trees and is home to deers and birds.</AK_BULLET>","b_2":"<AK_BULLET>Fun Fact: This is where Napoleon decided to settle his army!</AK_BULLET>"}}}},"atmoky-ears":{"shortDescription":"One-stop solution for rendering hyper-realistic spatial audio experiences to headphones","helmetDescription":"One-stop solution for rendering hyper-realistic spatial audio experiences to headphones"},"auro-3d":{"shortDescription":"Provides the most immersive and natural realistic 3D sound experience.","helmetDescription":"Provides the most immersive and natural realistic 3D sound experience.","description":"This is the next generation three-dimensional audio standard. It provides the most immersive and natural realistic 3D sound experience.","mediaURL":["/images/plug-ins/preview/auro3d_headphones.png"],"detailsData":{"para_1":{"title":"Auro-Headphones™","structuredDescription":{"b_1":"<AK_BULLET>Brings cutting-edge 3D audio to all of your players using any pair of headphones.</AK_BULLET>","b_2":"<AK_BULLET>Virtualizes Auro-3D speaker configurations on standard stereo headphones.</AK_BULLET>"}},"para_2":{"title":"High-End Cinema in the Palm of Your Ears","structuredDescription":{"b_1":"<AK_BULLET>Uses Auro’s lauded true immersive 3D audio technology.</AK_BULLET>","b_2":"<AK_BULLET>Allows for action to be experienced like never before.</AK_BULLET>"}},"para_3":{"title":"Ease of Use","structuredDescription":{"b_1":"<AK_BULLET>Includes easy-to-use authoring tools.</AK_BULLET>","b_2":"<AK_BULLET>Integrates easily into existing Wwise workflows.</AK_BULLET>"}}}},"boom-fields-spaces":{"shortDescription":"A collection of 120 impulse responses of various outdoor locations, including fields, forests, hills, public squares, alleys, and more","helmetDescription":"A collection of 120 impulse responses of various outdoor locations, including fields, forests, hills, public squares, alleys, and more","description":"<AK_BOLD>Fields & Spaces IRs</AK_BOLD> by BOOM Library is a collection of 120 impulse responses of various outdoor locations, including fields, forests, hills, public squares, alleys, and more. No library until now provides such a detailed, spatial set of outdoor impulse responses. Allowing the AK Convolution plug-in to apply realistic and immersive reverbs to digital media, this collection can greatly enhance the reality of your work. Available in three formats, stereo, surround and first- and third-order ambisonics and at a variety of distances to ensure your sonic environments are as realistic as possible.","mediaURL":["/images/plug-ins/preview/ir-fields-spaces.jpg"],"priceTableName":{"priceTable_1":"Stereo","priceTable_2":"FOA & Stereo","priceTable_3":"HOA, FOA & Stereo"},"detailsData":{"para_1":{"title":"Advanced Modeling Techniques","description":"Impulse responses for huge outdoor spaces are nearly impossible to naturally record – to start with, it would take massive sound sources and ideal weather conditions. Using their long experience in the industry, BOOM Library has developed advanced modeling techniques to craft perfect impulse responses for nearly any environment and distance"},"para_2":{"title":"Fast, Easy and Immersive","description":"These 3D impulse responses make it simple to position sounds in a variety of expansive locations to achieve fully immersive audio. Recorded with a third order HOA ambisonics receiver, the IRs allow for precise spatial localization. Depending on your needs though, you can choose from ambisonic, stereo, or surround."},"para_3":{"title":"The Sound of the Great Outdoors","description":"Choose from just over 120 different impulse responses for some of the hardest places to record in. Transport your listeners to nearly anywhere outside, from snow-covered hills and thick forests to crowded squares and traffic-filled city streets. These impulse responses have been created with total flexibility in mind."}}},"boom-outdoor":{"shortDescription":"A collection of 68 high-definition outdoor impulse responses","helmetDescription":"A collection of 68 high-definition outdoor impulse responses","description":"<AK_BOLD>Outdoor IRs</AK_BOLD> by BOOM Library offers you 68 high-definition outdoor impulse responses. Recorded and delivered in 192kHz to capture every characteristic detail of the respective location. Use with the AK Convolution plug-in.","mediaURL":["/images/plug-ins/preview/IROutdoor-forest.jpg","/images/plug-ins/preview/IROutdoor-urban.jpg","/images/plug-ins/preview/IROutdoor-field.jpg"],"detailsData":{"para_1":{"title":"Realistic, Fast and Easy Immersion","description":"Use Impulse responses to easily place your sounds into specific locations to achieve realistic and immersive audio."},"para_2":{"title":"Professional Recordings in 192kHz","description":"Attain the clearest and most detailed acoustic image for every location with sounds recorded via high-frequency microphones and without any action in the foreground. Note that the recordings have been downsampled to 96kHz to be compatible with AK Convolution."},"para_3":{"title":"Multiple Outdoor Locations","description":"Select from various outdoor locations such as fields, forests, hills, mountains, valleys and urban locations."}}},"boom-rooms-spaces":{"shortDescription":"A collection of 81 impulse responses of basic rooms as well as uncommon and rare spaces","helmetDescription":"A collection of 81 impulse responses of basic rooms as well as uncommon and rare spaces","description":"<AK_BOLD>Rooms & Spaces IRs</AK_BOLD> by BOOM Library offers you 81 impulse responses of basic rooms such as bathrooms, living rooms and churches, as well as uncommon and rare spaces such as submarine and elevator shaft captures and other useful captures from cars, cinemas and more. Achieve extremely realistic and immersive spatial audio captured with 32 microphone-capsules and be able to place and move objects as believable as you have never experienced it in digital media before. Rooms & Spaces IRs are available in three packages: stereo, first or high order ambisonics, and can be used with the AK Convolution plug-in.","mediaURL":["/images/plug-ins/preview/IR-Rooms-Spaces.jpg"],"priceTableName":{"priceTable_1":"Stereo","priceTable_2":"FOA & Stereo","priceTable_3":"HOA, FOA & Stereo"},"detailsData":{"para_1":{"title":"Realistic, Fast and Easy Immersion","description":"Use 3D Impulse Responses to easily place your sounds into specific and unspecific locations to achieve realistic and immersive spatial audio."},"para_2":{"title":"Basic Rooms and Interesting Spaces","description":"Select out of 81 Impulse Responses from 45 locations. Ranging from strange locations such as a tiny milk can and helmet, to claustrophobic elevator shafts or submarines, and more common spaces such as gyms, big concert halls, churches, theatres, bathrooms, living rooms, kitchens."},"para_3":{"title":"Immersive and Spatial","description":"Recorded natively with a 32 capsule microphone, this package comes in higher order ambisonic to allow for highly detailed spatial locatability. Of course you do not need to pick 3rd order ambisonic. You can also choose between FOA or just stereo, whatever you need."},"para_4":{"title":"Recorded for interactive use","description":"These Impulse Responses have been recorded with as least early reflections as possible to make them as flexible as possible to use. Specifically in conjunction with Wwise Reflect, you will be able to place and move objects in a way that offers the most believable experience in digital media."}}},"compressor":{"shortDescription":"Reduce the dynamic range of a signal by weakening any part of the input signal that is above a pre-defined threshold value.","helmetDescription":"Reduce the dynamic range of a signal by weakening any part of the input signal that is above a pre-defined threshold value."},"convolution-reverb":{"shortDescription":"Create a convincing reverberation based on ambisonics impulse responses of real acoustic spaces, from the smallest room to the largest cathedral","helmetDescription":"Create a convincing reverberation based on ambisonics impulse responses of real acoustic spaces, from the smallest room to the largest cathedral","description":"This plug-in lets you create convincing reverberation based on ambisonics impulse responses of real acoustic spaces, from the smallest room to the largest cathedral. Add Impulse Responses and you’ll be able to build anything.","mediaURL":["/images/plug-ins/preview/wwise_convolution_reverb_4ch.png","/images/plug-ins/preview/wwise_convolution_reverb_mosaic.jpg","/images/plug-ins/preview/wwise_convolution_reverb_mosaic2.jpg"],"detailsData":{"para_1":{"title":"High Quality Reverb Processing","structuredDescription":{"b_1":"<AK_BULLET>Supports high fidelity impulse responses (including 24- and 32-bit formats).</AK_BULLET>","b_2":"<AK_BULLET>Supports all channel configurations including ambisonics.</AK_BULLET>","b_3":"<AK_BULLET>Reduces runtime CPU and memory usage by optimizing impulse response in the time and frequency domains.</AK_BULLET>"}},"para_2":{"title":"Bundled Impulse Responses","structuredDescription":{"b_1":"<AK_BULLET>Includes 20 high quality impulse responses in stereo and ambisonics formats, and 55 ShareSets.</AK_BULLET>","b_2":"<AK_BULLET>Import your own IRs to extend your palette of environments.</AK_BULLET>","b_3":"<AK_BULLET>Get creative by using any sound effects as IRs.</AK_BULLET>"}}}},"crankcase-rev-plugin":{"shortDescription":"Create realistic engine sounds using granular synthesis techniques to eliminate looping.","helmetDescription":"Create realistic engine sounds using granular synthesis techniques to eliminate looping.","description":"Create realistic engine sounds using granular synthesis techniques to eliminate looping.","priceTableName":{"priceTable_1":"Plug-in","priceTable_2":"REV Modeler Tool"},"detailsData":{"para_1":{"title":"Simplicity","structuredDescription":{"b_1":"<AK_BULLET>User friendly and well documented tool, easy to master for any sound designer.</AK_BULLET>","b_2":"<AK_BULLET>Reduces content management overhead.</AK_BULLET>","b_3":"<AK_BULLET>Similar memory usage to the traditional loop-based technique, but fewer voices are used.</AK_BULLET>"}},"para_2":{"title":"Use your own models","description":"If you already have your own REV models, this plug-in will help you modify them and make them interactive."},"para_3":{"title":"REV Modeler Tool","description":"If you already have your own recordings, but not in the REV format, ask for the REV Modeler Tool that will create the right models based on your recording. "},"para_4":{"title":"Authoring compatibility","description":"This plug-in and the Modeler Tool can only be run in the Windows version of the Wwise Authoring tool."}}},"crankcase-rev-assets":{"shortDescription":"More than 40 engine sounds!","helmetDescription":"More than 40 engine sounds!","description":"Use amazingly realistic engine sounds with granular synthesis techniques to eliminate looping.","keyWords":"$t(doNotTranslate:carNames.acura_integra) $t(doNotTranslate:carNames.alfa_romeo_competizione) $t(doNotTranslate:carNames.aston_martin_rapide) $t(doNotTranslate:carNames.audi_r8) $t(doNotTranslate:carNames.audi_s6) $t(doNotTranslate:carNames.bmw_740i) $t(doNotTranslate:carNames.bmw_m4) $t(doNotTranslate:carNames.chevrolet_camaro_ss) $t(doNotTranslate:carNames.chevrolet_camaro_super_hugger) $t(doNotTranslate:carNames.chevrolet_chevelle) $t(doNotTranslate:carNames.chevrolet_corvette) $t(doNotTranslate:carNames.corvette_c7) $t(doNotTranslate:carNames.de_tomaso_pantera) $t(doNotTranslate:carNames.dodge_challenger_440) $t(doNotTranslate:carNames.dodge_challenger) $t(doNotTranslate:carNames.dodge_viper) $t(doNotTranslate:carNames.ferrari_430) $t(doNotTranslate:carNames.ferrari_458) $t(doNotTranslate:carNames.ferrari_488) $t(doNotTranslate:carNames.ferrari_575m) $t(doNotTranslate:carNames.ford_mustang) $t(doNotTranslate:carNames.ford_puma) $t(doNotTranslate:carNames.ford_rs200) $t(doNotTranslate:carNames.honda_cbr) $t(doNotTranslate:carNames.honda_civic) $t(doNotTranslate:carNames.honda_nsx) $t(doNotTranslate:carNames.jeep_srt8) $t(doNotTranslate:carNames.lamborghini_huracan) $t(doNotTranslate:carNames.lancia_delta_integrale) $t(doNotTranslate:carNames.lincoln_navigator) $t(doNotTranslate:carNames.mazda_rx8) $t(doNotTranslate:carNames.nissan_370z) $t(doNotTranslate:carNames.nissan_gt_r) $t(doNotTranslate:carNames.pontiac_grand_prix) $t(doNotTranslate:carNames.porsche_997) $t(doNotTranslate:carNames.range_rover) $t(doNotTranslate:carNames.toyota_ch_r) $t(doNotTranslate:carNames.toyota_gt86) $t(doNotTranslate:carNames.toyota_supra) $t(doNotTranslate:carNames.triumph_bonneville) $t(doNotTranslate:carNames.volkswagen_golf) $t(doNotTranslate:carNames.volvo_242) $t(doNotTranslate:carNames.vw_van) $t(doNotTranslate:carNames.yamaha_24mx)","detailsData":{"para_1":{"title":"Cost Savings","structuredDescription":{"b_1":"<AK_BULLET>Licensing vehicle models saves costs and reduces risk versus recording your own sounds.</AK_BULLET>","b_2":"<AK_BULLET>No insurance, vehicle rentals, location rentals, travel, etc.</AK_BULLET>","b_3":"<AK_BULLET>No difficulties in finding the appropriate real vehicles.</AK_BULLET>","b_4":"<AK_BULLET>Reduced overhead for the team producing the finished content.</AK_BULLET>"}},"para_2":{"title":"Time Savings","structuredDescription":{"b_1":"<AK_BULLET>Enables rapid iteration and very low turnaround time.</AK_BULLET>","b_2":"<AK_BULLET>Represents a massive scope reduction versus traditional loop model building.</AK_BULLET>","b_3":"<AK_BULLET>No difficulties in finding the appropriate real vehicles.</AK_BULLET>","b_4":"<AK_BULLET>Reduced overhead for the team producing the finished content.</AK_BULLET>"}},"para_3":{"title":"REV Content Creator","description":"If you already have your own recordings, but not in the REV format, ask for the REV Content Creator that will create the right models based on your recording."}}},"custom-panner":{"shortDescription":"Author a custom speaker configuration for an audio bus, enabling non-standard VBAP panning to bespoke setups like LBE, theater, and automotive.","helmetDescription":"Author a custom speaker configuration for an audio bus, enabling non-standard VBAP panning to bespoke setups like LBE, theater, and automotive.","description":"The Custom Panner plug-in enables the authoring of a custom speaker position configuration that can be used by an audio bus. The configuration allows for non-standard panning and delivery of sounds to non-standard audio configurations using a Vector Base Amplitude Panning (VBAP) algorithm. Output can be configured for Anonymous or Object Based Mode.","mediaURL":["/images/plug-ins/preview/custom_panner.png"],"detailsData":{"para_1":{"title":"Bespoke Spatialization","description":"Define the precise azimuth and elevation for any number of output channels. Name each channel, set them manually, or use pre-configured ShareSets as a starting point."},"para_2":{"title":"Virtual Speakers","description":"Designate specific speakers as 'Virtual' These positions redistribute signal energy to the closest real speakers to ensure predictable panning in irregular arrays."},"para_3":{"title":"Authoring Control","description":"Isolate any part of your mix using Mute/Solo logic for both real and virtual speakers. Designate any speaker as an LFE channel to remove it from the VBAP algorithm."},"para_4":{"title":"Flexible Output Modes","description":"Choose to output a single, anonymous multichannel object or multiple mono audio objects to match the specific requirements of your audio pipeline."}}},"delay-plugin":{"shortDescription":"Widen the sound and add echoes.","helmetDescription":"Widen the sound and add echoes."},"dolby-atmos":{"shortDescription":"Immerse your players by placing and moving individual sounds all around them in three dimensions, even overhead, with pinpoint precision and realism.","helmetDescription":"Immerse your players by placing and moving individual sounds all around them in three dimensions, even overhead, with pinpoint precision and realism.","description":"Unleash the power of spatial audio with this plug-In. Immerse your players by placing and moving individual sounds all around them in three dimensions, even overhead, with pinpoint precision and realism.","mediaURL":["/images/plug-ins/preview/dolby_atmos_mobile_1.png","/images/plug-ins/preview/dolby_atmos_mobile_2.png","/images/plug-ins/preview/dolby_atmos_mobile_3.jpg"],"detailsData":{"para_1":{"title":"Fully realize your creative vision","structuredDescription":{"b_1":"<AK_BULLET>With spatial or positional audio, Dolby Atmos places game audio all around the consumer. This opens up a whole new dimension for you to bring every detail to life for an intensified gaming experience.</AK_BULLET>","b_2":"<AK_BULLET>Preserve the original sound quality of your audio assets; no need to compromise quality for mobile devices.</AK_BULLET>","b_3":"<AK_BULLET>Give your gamers an extra spatial sense so they know exactly where their enemies are with pinpoint accuracy from either a built-in speaker or a headset.</AK_BULLET>"}},"para_2":{"title":"Single game mix","description":"The progressive 7.1.4, 5.1.2, and stereo down-mixes are generated intelligently and automatically, removing the time and cost needed to do each individually"},"para_3":{"title":"Maintain equivalent experience across devices","structuredDescription":{"b_1":"<AK_BULLET>The large footprint of Dolby Atmos mobile devices ensures an equivalent user experience.</AK_BULLET>","b_2":"<AK_BULLET>Dolby Atmos is supported on select phones from Samsung, Apple, Oppo and Xiaomi. Please refer to the documentation downloaded with the plug-ins for more details on installation and configuration.</AK_BULLET>"}},"para_4":{"title":"Easy-to-use","description":"Seamlessly integrate Dolby Atmos into your audio design workflow. Flexibly designate sounds to be spatialized with Atmos and those that aren't"}}},"expander":{"shortDescription":"Increase the dynamic range of a signal by weakening any part of the input signal that is below a predefined threshold value.","helmetDescription":"Increase the dynamic range of a signal by weakening any part of the input signal that is below a predefined threshold value."},"flanger":{"shortDescription":"Create and control your own flanging.","helmetDescription":"Create and control your own flanging."},"gain":{"shortDescription":"Control of the gain of the full band channels and the LFE channel independently.","helmetDescription":"Control of the gain of the full band channels and the LFE channel independently."},"gme":{"shortDescription":"High fidelity and cost-effective voice chat that fully leverages Wwise's voice pipeline in a seamless integration","helmetDescription":"High fidelity and cost-effective voice chat that fully leverages Wwise's voice pipeline in a seamless integration","description":"<AK_BOLD>Game Multimedia Engine (GME)</AK_BOLD> is a game cloud service by Tencent Cloud, which provides high-quality, cost-efficient and scalable in-game voice communication services for game developers. An end-to-end service that is easy to integrate, GME allows developers to enhance real-time multiplayer experiences so that players can instantly connect with each other around the globe.","mediaURL":["https://www.youtube.com/watch?v=ZaUKyj99FHk","https://www.youtube.com/watch?v=1gTCa_hiAIE","/images/plug-ins/preview/gme.png"],"extrasBlock":{"pricingLink":"<AK_LINK_PRICING_LINK>Pricing Details</AK_LINK_PRICING_LINK>"},"detailsData":{"para_1":{"title":"3D Positional Voice Chats","description":"Virtually reproduce original game sound images in a 3D space, so that game players can hear each other based on their relative locations in the game, offering an immersive and realistic gaming experience."},"para_2":{"title":"Comprehensive Game Voice Services","structuredDescription":{"b_1":"<AK_BULLET>GME can Implement voice chat between two or more players and support ultralarge voice chat rooms with up to 100,000 members.</AK_BULLET>","b_2":"<AK_BULLET>Leverage the Wwise audio pipeline by adding creative effects (e.g. voice changing, reverberation, etc.) to the voice using plug-ins from Wwise or its plug-in partners.</AK_BULLET>"}},"para_3":{"title":"Ultimate Gaming Sound Effect","structuredDescription":{"b_1":"<AK_BULLET>Deep integration with Wwise ingeniously solves the problem where background sound effects are lost when in-game voice is enabled.</AK_BULLET>","b_2":"<AK_BULLET>GME can reduce the voice latency to 200 ms and ensure smooth communication, even in weak network environments with over 70% packet loss and 1,500 ms network jitter.</AK_BULLET>"}},"para_4":{"title":"Cross-Platform Compatibility and Cost-Effective Access","structuredDescription":{"b_1":"<AK_BULLET>GME supports cross-platform communication of mobile games, console games and browser games, and can be used for all iOS devices and over 20,000 models of Android devices.</AK_BULLET>","b_2":"<AK_BULLET>Easy-to-use and the voice chat capability can be integrated using a minimum of four API calls.</AK_BULLET>","b_3":"<AK_BULLET>Fully managed service that is scalable according to the number of concurrent players.</AK_BULLET>"}},"para_5":{"title":"<AK_CONTACT_SALES_LINK>Contact Sales</AK_CONTACT_SALES_LINK>"}}},"guitar-distortion":{"shortDescription":"Mimic the behavior of commonly encountered distortion 'stomp boxes' to obtain typical guitar distortion sounds.","helmetDescription":"Mimic the behavior of commonly encountered distortion 'stomp boxes' to obtain typical guitar distortion sounds."},"harmonizer":{"shortDescription":"Change the pitch of an audio signal without affecting its duration.","helmetDescription":"Change the pitch of an audio signal without affecting its duration."},"impacter":{"shortDescription":"Generate sound variations using cross-synthesis and intuitive physically-informed parameters.","helmetDescription":"Generate sound variations using cross-synthesis and intuitive physically-informed parameters.","description":"Inspired by original SoundSeed Impact Plug-in, it allows designers to load “impact” sound files into the plug-in and generate sound variations using cross-synthesis, as well as manipulations using intuitive physically-informed parameters.","mediaURL":["https://www.youtube.com/watch?v=tSgAbM6N7lw","https://www.youtube.com/watch?v=ApAL50J2iak","/images/plug-ins/preview/impacter.gif","/images/plug-ins/preview/impacter.png"],"detailsData":{"para_1":{"title":"Impacter’s properties allow designers to manipulate the physicality of the source sounds","structuredDescription":{"b_1":"<AK_BULLET>Mass uniquely stretches or compresses the length and pitch of the sound to change its feeling of size or weight.</AK_BULLET>","b_2":"<AK_BULLET>Velocity affects the intensity of the impact, changing the timbre and amplitude of the sound.</AK_BULLET>","b_3":"<AK_BULLET>Position shapes the timbre of the sound as if the impact was occurring at different places on a surface. Think of how a drum skin sounds different at the edges compared to the middle.</AK_BULLET>","b_4":"<AK_BULLET>Roughness adds a metallic inharmonicity to the sound.</AK_BULLET>"}},"para_2":{"title":"The functionality of Wwise has been extended to support Impacter","structuredDescription":{"b_1":"<AK_BULLET>There is no need for an external analysis tool or handling of analysis result files.</AK_BULLET>","b_2":"<AK_BULLET>All the analysis is handled within the Authoring plug-in.</AK_BULLET>","b_3":"<AK_BULLET>Resulting synthesis model is packaged into the project’s soundbanks.</AK_BULLET>"}},"para_3":{"title":"Randomizing parameters and cross synthesis combinations makes Impacter a powerful variation generator","structuredDescription":{"b_1":"<AK_BULLET>When using Impacter with a collection of files, the plug-in will randomize the choice of impact and body with each play event.</AK_BULLET>","b_2":"<AK_BULLET>A small set of footstep sound files for example suddenly becomes many more variation.</AK_BULLET>"}},"para_5":{"title":"<a href=\\"https://media.gowwise.com/files/ImpacterUE4Demo_v2022.1.0_Build40_4.27_Demo.zip\\">Impacter Unreal Engine Demo</a>"}}},"izotope-reverb":{"shortDescription":"Take your sound design projects to the next level.","helmetDescription":"Take your sound design projects to the next level.","description":"With Hybrid Reverb, take your sound design projects to the next level.","detailsData":{"para_1":{"title":"Realism","structuredDescription":{"b_1":"<AK_BULLET>Ultra-realistic effects derived from real-world device modeling.</AK_BULLET>","b_2":"<AK_BULLET>Highest quality processing.</AK_BULLET>"}},"para_2":{"title":"Hybrid Reverb","structuredDescription":{"b_1":"<AK_BULLET>Combines the realism of a convolution-based reverb with the control of a synthetic effect.</AK_BULLET>","b_2":"<AK_BULLET>Allows you to import your own Impulse Responses, extract the early reflections and separately control the reverb tail.</AK_BULLET>","b_3":"<AK_BULLET>Renders Hybrid Reverb via fixed runtime memory usage which is ideal when developing under memory constraints.</AK_BULLET>"}}}},"izotope-trash":{"shortDescription":"Take your sound design projects to the next level.","helmetDescription":"Take your sound design projects to the next level.","description":"With the suite of Trash tools, take your sound design projects to the next level.","priceTableName":{"priceTable_1":"Trash Box Models","priceTable_2":"Trash Dynamics + Delay Bundle","priceTable_3":"Trash Filters","priceTable_4":"Trash Multi-band Distortions","priceTable_5":"Trash Single-band Distortions "},"mediaURL":["/images/plug-ins/preview/izotope_trash.png"],"detailsData":{"para_1":{"title":"Realism","structuredDescription":{"b_1":"<AK_BULLET>Ultra-realistic effects derived from real-world device modeling.</AK_BULLET>","b_2":"<AK_BULLET>Highest quality processing.</AK_BULLET>"}},"para_2":{"title":"Possible Effects","structuredDescription":{"b_3":"<AK_BULLET>Trash Filters - 36 sweepable filter styles.</AK_BULLET>","b_1":"<AK_BULLET>Trash Distortion - 47 distortion models in single or multiband mode.</AK_BULLET>","b_2":"<AK_BULLET>Trash Box Models - 84 speaker, cabinet, amp and effect box models.</AK_BULLET>","b_4":"<AK_BULLET>Trash Dynamics and Delay - Complementary classic effect from Trash to add variety to sound in real time.</AK_BULLET>","b_5":"<AK_BULLET>Each Trash effect is available for licensing on an individual basis.</AK_BULLET>"}}}},"lkc-grim-sync":{"shortDescription":"Advanced REAPER to Wwise bridge system.","helmetDescription":"Advanced REAPER to Wwise bridge system."},"mastering-suite":{"shortDescription":"A cross-platform high quality mastering solution providing subtle to surgical manipulation to your mix","helmetDescription":"A cross-platform high quality mastering solution providing subtle to surgical manipulation to your mix","description":"<AK_BOLD>Mastering Suite</AK_BOLD> is a cross-platform high quality mastering solution providing subtle to surgical manipulation to your mix. Support various rendering scenarios by controlling the dynamic range, equalization curve, limiting and gain of individual channels.","mediaURL":["/images/plug-ins/preview/mastering_suite.jpg"],"detailsData":{"para_1":{"title":"Four essential modules for mastering","structuredDescription":{"b_1":"<AK_BULLET>6-bands Parametric Equalizer with Low/High pass resonant, Peak, Low/High shelf and Low/High pass one-pole filter types.</AK_BULLET>","b_2":"<AK_BULLET>4-bands Compressor offering 3 different link modes.</AK_BULLET>","b_3":"<AK_BULLET>Master Volume module offering per-channel gain faders and the ability to solo and mute each independently for easy audition.</AK_BULLET>","b_4":"<AK_BULLET>Limiter with 3 modes providing access to a subset of attack, release and gain parameters.</AK_BULLET>"}},"para_2":{"title":"Device tuned dynamic and frequency ranges","structuredDescription":{"b_1":"<AK_BULLET>Tailor the dynamic and frequency ranges to match the characteristics of the platforms and portable devices.</AK_BULLET>","b_2":"<AK_BULLET>Choose among 5 built-in ShareSets covering most output contexts: Soundbar, Home Cinema, TV, Headphones and Night Mode.</AK_BULLET>"}},"para_3":{"title":"Enjoy fine-grained control over your mix for maximum consistency","structuredDescription":{"b_1":"<AK_BULLET>Per-channel gain adjustment for up to 7.1.4 channels.</AK_BULLET>","b_2":"<AK_BULLET>Configurable 6-band parametric equalizer with a 4-band compressor allows to pinpoint specific frequency ranges from subtle to surgical adjustments.</AK_BULLET>","b_3":"<AK_BULLET>Control the overall dynamic range of your mix with three adjustable limiting modes: soft, hard and advanced.</AK_BULLET>"}}}},"matrix-reverb":{"shortDescription":"Simulate the sound reflections in an acoustic space effect in game.","helmetDescription":"Simulate the sound reflections in an acoustic space effect in game."},"mcdsp":{"shortDescription":"Award-winning plug-ins, designed for Wwise: FutzBox Lo-Fi Distortion and ML1 Mastering Limiter","helmetDescription":"Award-winning plug-ins, designed for Wwise: FutzBox Lo-Fi Distortion and ML1 Mastering Limiter","description":"McDSP brings a selection of their award-winning plug-ins directly to Wwise: FutzBox Lo-Fi Distortion and ML1 Mastering Limiter.","detailsData":{"para_1":{"title":"Award Winning Plug-ins","structuredDescription":{"b_1":"<AK_BULLET>Built on 15 years of experience.</AK_BULLET>","b_2":"<AK_BULLET>Pioneered by DSP guru Colin McDowell.</AK_BULLET>","b_3":"<AK_BULLET>Used in hundreds of Wwise games!</AK_BULLET>"}},"para_2":{"title":"FutzBox Lo-Fi Distortion","structuredDescription":{"b_1":"<AK_BULLET>Full suite of tools.</AK_BULLET>","b_2":"<AK_BULLET>Synthetic impulse models, filters, distortion, EQ, noise generators, gates and more.</AK_BULLET>","b_3":"<AK_BULLET>Creates low fidelity signals from otherwise well-recorded audio tracks.</AK_BULLET>","b_4":"<AK_BULLET>Perfect for simulating communication devices, radios and televisions.</AK_BULLET>"}},"para_3":{"title":"ML1 Mastering Limiter","structuredDescription":{"b_1":"<AK_BULLET>Flexible brick wall look-ahead coupled with multiple stages of limiting for superior peak detection.</AK_BULLET>","b_2":"<AK_BULLET>Unique Knee and Mode controls.</AK_BULLET>","b_3":"<AK_BULLET>Handle any kind of material with a variety of responses, from transparent to aggressive.</AK_BULLET>"}}}},"meta-xr-audio":{"shortDescription":"Advanced spatial audio for immersive VR/MR experiences","helmetDescription":"Advanced spatial audio for immersive VR/MR experiences","description":"The Meta XR Audio SDK plug-in offers advanced spatial audio capabilities for immersive VR and MR experiences. It features HRTF rendering for precise sound localization, ambisonic rendering for enveloping 3D soundscapes, and basic room acoustic simulation for authentic environmental presence. The plug-in pairs with Meta's Acoustic Ray Tracing capabilities in Unity and Unreal Engine. With its new Universal HRTF (the culmination of years of research), users can accurately locate sound sources in 3D space, while ambisonics file rendering creates immersive soundscapes that draw users into virtual worlds. The plug-in also applies room acoustics models to spatialized sounds, creating realistic reflections and reverberations based on the size, shape, and materials of the room. Proven to be performant and stable on mobile VR headsets, the SDK has been used in hundreds of real-world production applications currently available in the Meta Quest store, and is used extensively by Meta’s internal game studios.","detailsData":{"para_1":{"title":"Immersive Sound Localization","description":"The HRTF renders audio spatially and allows users to precisely locate sound sources in 3D space, including direction, distance, and elevation, creating a much more immersive experience than the standard \\"3D audio\\" rendering capabilities built into game engines. This spatial audio rendering capability provides the foundation for VR and MR audio experience and is fundamental to creating an immersive experience. Our new Universal HRTF is based on years of research and has been proven in extensive internal testing to provide superior localization, elevation, and spectral transparency compared to other HRTF models. Features like HRTF Intensity and volumetric Radius allow sound designers to tweak their spatialization to sound just right for the intended artistic effect."},"para_2":{"title":"Enveloping Environmental Audio","description":"Supports ambisonics file rendering for creating immersive 3D soundscapes that envelop the user, drawing them into the virtual world."},"para_3":{"title":"Authentic Environmental Presence","description":"Applies a basic room acoustics model to spatialized sounds, creating reflections and reverberations characteristic of the environment, making the user feel like they're really there. The size and shape of rooms can be configured along with the materials of each surface to create a truly distinct sound for different environments. For example, an immense stone cavern will sound very different compared to a cozy living room."},"para_4":{"title":"Performant and Stable on Mobile VR Headsets","description":"Proven performance in hundreds of real-world production applications available in the Meta Quest store, including Batman: Arkham Shadow, winner of The Game Awards 2024 VR Game of the Year."}}},"meter":{"shortDescription":"Measure the level of a signal without modifying it, and optionally outputs this level as a Game Parameter.","helmetDescription":"Measure the level of a signal without modifying it, and optionally outputs this level as a Game Parameter."},"motion":{"shortDescription":"Haptic feedback for controllers and control interfaces using sound or authored in Wwise using the Motion source plug-in or the Haptic Clip Player plug-in.","helmetDescription":"Haptic feedback for controllers and control interfaces using sound or authored in Wwise using the Motion source plug-in or the Haptic Clip Player plug-in.","description":"This plug-in lets you use the Wwise Authoring Tool to control not only the sound, but the haptic feedback of your control interface across mulitple platforms. It allows existing audio to be converted into physical vibration and includes authoring source plug-ins to create and manage haptic feedback (controller rumble and vibration) using the same workflow used for audio.","mediaURL":["/images/plug-ins/preview/motion_source.png","/images/plug-ins/preview/motion_haptics_studio.png"],"detailsData":{"para_1":{"title":"Integrated","structuredDescription":{"b_1":"<AK_BULLET>Uses the Wwise hierarchy and features to create and control your haptic feedback.</AK_BULLET>","b_2":"<AK_BULLET>Dynamically adjusts rumble and haptic intensity based on game variables like object proximity.</AK_BULLET>","b_3":"<AK_BULLET>Allows you to flag any sound as the source for your rumble or synthesize your own motion feedback for maximum customizability, including import and use of .haptic files from <a href=\\"https://developers.meta.com/horizon/resources/haptics-studio\\">Meta Haptics Studio</a>, using the <a href=\\"https://www.audiokinetic.com/library/?source=Help&id=haptic_clip_player_plug_in\\">Haptic Clip Player source plug-in</a>.</AK_BULLET>","b_4":"<AK_BULLET>Attaches game physics to motion parameters for unique results.</AK_BULLET>"}},"para_2":{"title":"Lightweight and Cross-Platform","structuredDescription":{"b_1":"<AK_BULLET>Virtually no impact on CPU or memory utilization.</AK_BULLET>","b_2":"<AK_BULLET>Fine-tune the haptic feedback for each target platform supporting controller rumble.</AK_BULLET>"}},"para_3":{"title":"Compatibility","structuredDescription":{"b_1":"<AK_BULLET>Broad support across PC, Consoles and Mobile.</AK_BULLET>","b_2":"<AK_BULLET>Includes support for Meta Quest Controllers via OpenXR and support for Meta Haptics Studio.</AK_BULLET>"}}}},"mssp":{"shortDescription":"","helmetDescription":"","description":"This plug-in enables spatial audio rendering on the Windows 10 and Xbox One platforms. Note that this plug-in will no longer be required starting from Wwise 2021.1.0."},"msspatial":{"shortDescription":"Enable spatial audio rendering on the Windows 10 and Xbox One platforms","helmetDescription":"Enable spatial audio rendering on the Windows 10 and Xbox One platforms"},"multiband-meter":{"shortDescription":"meters multiple frequency bands of the audio signal in one effect."},"oculus-spatializer":{"shortDescription":"Allow monophonic sound sources to be spatialized in 3D relative to the user's head location.","helmetDescription":"Allow monophonic sound sources to be spatialized in 3D relative to the user's head location."},"parametric-eq":{"shortDescription":"Contains a series of properties that you can use to create the Effects for your audio environment.","helmetDescription":"Contains a series of properties that you can use to create the Effects for your audio environment."},"peak-limiter":{"shortDescription":"Control the dynamic range of audio signals.","helmetDescription":"Control the dynamic range of audio signals."},"pitch-shifter":{"shortDescription":"Change the pitch of an audio signal without affecting its duration.","helmetDescription":"Change the pitch of an audio signal without affecting its duration."},"polyspectral":{"shortDescription":"A multiband compressor plug-in, specifically designed with real-time mastering of a game’s mix in mind","helmetDescription":"A multiband compressor plug-in, specifically designed with real-time mastering of a game’s mix in mind"},"readspeaker":{"shortDescription":"Create natural-sounding speech from any text input","helmetDescription":"Create natural-sounding speech from any text input","description":"ReadSpeaker's speechEngine for Wwise is a cross-platform, on-device text-to-speech solution for creating natural-sounding speech from any text input. Customize the voice in the authoring tool and send text to be converted into speech from the game runtime. speechEngine for Wwise supports 26+ languages (including dialects) and 48+ voices, with continuous updates adding new linguistic support and vocal variety (see below for more details). Taking advantage of the plug-in's runtime capabilities allows you to have any text content in your game read aloud: from UI-narration to multiplayer text chats. Intuitively adjust speech parameters like pitch and speed while keeping the prosody intact, for full control of the speech generated. Along with speech audio, the speechEngine for Wwise also produces word and viseme data, and notifies you when a new word or viseme is encountered in the speech. This can be used to implement word-highlighting or lip-sync functionality. Also supports Speech Synthesis Markup Language (SSML).","mediaURL":["https://www.youtube.com/watch?v=-DcDTjxwqk4"],"priceTableName":{"priceTable_1":"Voices"},"detailsData":{"para_1":{"title":"Instantly author and deploy ReadSpeaker voices in Wwise","description":"Control voice parameters through the Authoring tool or via RTPCs, export the voice engine into a Soundbank for use in the game runtime. Text can be sent to the plug-in through Wwise SoundEngine SDK and will produce the speech output in realtime."},"para_2":{"title":"Runtime on-device speech generation","description":"Run TTS locally on device with cross-platform support. Enable dynamic TTS using realtime capable, lightweight speech generation software."},"para_3":{"title":"Real-time speech to visual synchronisation","description":"Access word and viseme information from the produced speech in realtime to dynamically reflect the state of the speech using word information to highlight the currently read word or visemes to synchronize the facial animations with in-game characters."},"para_4":{"title":"Expanding global voice library","description":"Make your game speak multiple languages and regional accents, read localized text with natural-sounding voices using our expanding library of languages and voices."},"para_5":{"title":"Custom Voice Demos","structuredDescription":{"b_1":"Working alongside professional voice talent, ReadSpeaker creates unique digital voice experiences tailored to your game's world, characters, and brand. By extending the reach of voice actors into dynamic, real-time gameplay moments, studios can deliver more personalized and responsive experiences extending the reach of the performers at the heart of their games.","b_2":"Custom voices are created through a collaborative partnership between ReadSpeaker, the studio, and the voice talent. Grounded in consent, transparency, and responsible voice use, each project is developed for a specific game experience, ensuring performers remain central to the process while enabling new possibilities for dynamic, real-time gameplay.","b_3":{"source":"https://prdt.readspeaker.com/ethical-voice-for-game-development","text":"<br/><AK_BOLD>Learn more about ReadSpeaker's approach to ethical voice development <AK_LINK>here</AK_LINK>.</AK_BOLD>"},"b_4_audio":{"source":"https://media.gowwise.com/plugins/samples/speechengine/ENG_Aware.wav","text":"<br/>AWARE<br/><AK_AUDIO_PLAYER></AK_AUDIO_PLAYER>"},"b_5_audio":{"source":"https://media.gowwise.com/plugins/samples/speechengine/ENG_Sportscaster.wav","text":"<br/>Sportscaster<br/><AK_AUDIO_PLAYER></AK_AUDIO_PLAYER><br/>"},"b_6":"These voices are custom demonstrations and are not available for licensing or purchase."}},"para_6":{"title":"Ethical AI Usage","description":"ReadSpeaker is committed to delivering ethical AI-powered voice solutions.\\nLearn more about their approach to <a href=\\"https://www.readspeaker.com/blog/ethical-ai-voice-for-gaming/\\">ethical AI voice in gaming here</a>."}}},"recorder":{"shortDescription":"Record to an AMB, WAV, or WEM file.","helmetDescription":"Record to an AMB, WAV, or WEM file."},"recorder-adm":{"shortDescription":"Record to a WAV file in ADM format.","helmetDescription":"Record to a WAV file in ADM format."},"reflect":{"shortDescription":"Dynamically render early reflections based on the proximity of the listener/emitter to reflective surfaces.","helmetDescription":"Dynamically render early reflections based on the proximity of the listener/emitter to reflective surfaces.","description":"<AK_BOLD>Reflect</AK_BOLD> is a geometry-informed plug-in that dynamically renders early reflections based on the proximity of the listener/emitter to reflective surfaces, such as walls, ceilings, and floors.","mediaURL":["/images/plug-ins/preview/wwise_reflect_preview.png"],"detailsData":{"para_1":{"title":"Sense of Presence and Immersion","structuredDescription":{"b_1":"<AK_BULLET>Use dynamic early reflections to automatically add life to each of your sounds. Any slight movement or rotation from the emitter or listener renders a different audio output, which is much more realistic than standard static rendering.</AK_BULLET>","b_2":"<AK_BULLET>Enrich the sense of space and physicality with surrounding materials using acoustic textures: A four band filter designed to simulate real world absorption of typical materials such as wood, concrete, drywall, and fabric.</AK_BULLET>"}},"para_2":{"title":"Versatility","structuredDescription":{"b_1":"<AK_BULLET>Define custom distance attenuations for early reflections with volume, LPF, HPF, and spread curves.</AK_BULLET>","b_2":"<AK_BULLET>Adapt quality and performance by defining the order of reflections each sound emitter generates.</AK_BULLET>","b_3":"<AK_BULLET>Attach the Speed of Sound property to RTPC for creative slowdown or 'bullet-time' effects.</AK_BULLET>"}}}},"resonance":{"shortDescription":"Includes plug-ins for spatial audio, optimized for performance and multi-platform support. Its advanced features go beyond basic 3D spatialization, providing powerful tools for accurately modeling complex sound environments.","helmetDescription":"Includes plug-ins for spatial audio, optimized for performance and multi-platform support. Its advanced features go beyond basic 3D spatialization, providing powerful tools for accurately modeling complex sound environments."},"roomverb":{"shortDescription":"Simulate sound reflections in an acoustic space in game","helmetDescription":"Simulate sound reflections in an acoustic space in game"},"silence":{"shortDescription":"A sample source plug-in that you can use to create silences where no audio or motion is played.","helmetDescription":"A sample source plug-in that you can use to create silences where no audio or motion is played."},"sidechain-receive":{"shortDescription":"Receive an audio signal from a Sidechain Mix.","helmetDescription":"Receive an audio signal from a Sidechain Mix."},"sidechain-send":{"shortDescription":"Send an audio signal to a Sidechain Mix.","helmetDescription":"Send an audio signal to a Sidechain Mix."},"sine":{"shortDescription":"A sample source plug-in that you can use to generate a range of sounds for your game using the sine waveform.","helmetDescription":"A sample source plug-in that you can use to generate a range of sounds for your game using the sine waveform."},"soundseed-air":{"shortDescription":"Create seamlessly looping exterior ambiences, aircraft engines and other air displacement based special effects.","helmetDescription":"Create seamlessly looping exterior ambiences, aircraft engines and other air displacement based special effects.","description":"<AK_BOLD>Soundseed™ Air</AK_BOLD> includes two sound generator plug-ins. Soundseed Wind creates seamlessly looping exterior ambiences, aircraft engines and other air displacement based special effects. Soundseed Woosh creates close combat swooshes, bullet fly-byes and other motion sounds.","mediaURL":["/images/plug-ins/preview/soundseed_air.png"],"detailsData":{"para_1":{"title":"Infinite Variety","structuredDescription":{"b_1":"<AK_BULLET>Can be used alone or combined as a layer with other pre-recorded sounds to generate rich audio content.</AK_BULLET>","b_2":"<AK_BULLET>Increase immersion by connecting game variables such as speed and distance to the SoundSeed™ Air plug-in parameters.</AK_BULLET>"}},"para_2":{"title":"Versatility","structuredDescription":{"b_1":"<AK_BULLET>Uses very low CPU for synthesis.</AK_BULLET>","b_2":"<AK_BULLET>Minimal memory usage for synthesized sounds.</AK_BULLET>","b_3":"<AK_BULLET>Low impact on CPU and memory opens up options for more or higher quality sounds to be added to your project while staying within budget.</AK_BULLET>"}}}},"soundseed-grain":{"shortDescription":"Granulate and transform audio files with extreme flexibility.","helmetDescription":"Granulate and transform audio files with extreme flexibility.","description":"<AK_BOLD>Soundseed™ Grain</AK_BOLD> is a granular synthesizer which can be added to a Wwise project as a source Plug-In. It allows you to granulate and transform audio files with extreme flexibility.","mediaURL":["https://www.youtube.com/watch?v=MfE6DqXSgXg","https://www.youtube.com/watch?v=2hQ2U9znFlY","/images/plug-ins/preview/soundseed_grain.png"],"detailsData":{"para_1":{"title":"Key Features","structuredDescription":{"b_1":"<AK_BULLET>Independent control of grain duration, emission and pitch.</AK_BULLET>","b_2":"<AK_BULLET>Forward and backward playback.</AK_BULLET>","b_3":"<AK_BULLET>Various envelope shapes and control.</AK_BULLET>","b_4":"<AK_BULLET>Independent 3D spatialization of grains.</AK_BULLET>","b_5":"<AK_BULLET>Visualization features to help design: grains, live slider feedback, envelope preview, VU meter.</AK_BULLET>","b_6":"<AK_BULLET>Per-grain filtering.</AK_BULLET>","b_7":"<AK_BULLET>MIDI control.</AK_BULLET>"}},"para_2":{"title":"Modulation of all properties","structuredDescription":{"b_1":"<AK_BULLET>Modulators embedded in the plug-in UI.</AK_BULLET>","b_2":"<AK_BULLET>RTPC and Wwise Modulators.</AK_BULLET>","b_3":"<AK_BULLET>Quantization to musical scales.</AK_BULLET>"}},"para_3":{"title":"Grain start positions can be snapped to markers","structuredDescription":{"b_1":"<AK_BULLET>Markers can be set automatically by Wwise based on transient detection.</AK_BULLET>","b_2":"<AK_BULLET>Markers can be embedded in the source audio file with an external wave editor.</AK_BULLET>","b_3":"<AK_BULLET>Markers can be set and moved manually.</AK_BULLET>"}},"para_4":{"title":"Optimized file conversions","structuredDescription":{"b_1":"<AK_BULLET>Optimized for speed: supports run-time PCM and ADPCM decoding.</AK_BULLET>","b_2":"<AK_BULLET>Smooth integration with Wwise audio file conversions ShareSets and all their features.</AK_BULLET>"}}}},"spectral":{"shortDescription":"Applies transformations to the frequency spectrum and makes time/frequency domain signal data available to the application to enable enhanced interactivity.","helmetDescription":"Applies transformations to the frequency spectrum and makes time/frequency domain signal data available to the application to enable enhanced interactivity."},"stereo-delay":{"shortDescription":"Create a variety of delay effects that can feedback to other channels in the Left-Right plane.","helmetDescription":"Create a variety of delay effects that can feedback to other channels in the Left-Right plane."},"synth-one":{"shortDescription":"A source plug-in that you can use to generate a wide range of sounds, using two oscillators.","helmetDescription":"A source plug-in that you can use to generate a wide range of sounds, using two oscillators."},"tempest":{"shortDescription":"An effect plug-in that provides high-fidelity cross-platform binauralization of 3D Audio.","helmetDescription":"An effect plug-in that provides high-fidelity cross-platform binauralization of 3D Audio.","description":"The Tempest 3D AudioTech plug-in is an effect plug-in that performs binauralization of Ambisonics and Audio Objects, delivering a high-quality 3D Audio experience with excellent run-time performance and consistent audio processing across all platforms.","mediaURL":["/images/plug-ins/preview/tempest_3d_audiotech_preview.png"],"detailsData":{"para_1":{"title":"High-fidelity Binauralization","description":"With support for 5th-order Ambisonics and Audio Objects, using over one thousand points of real-world measurements sampled around the listener, positioning of audio can be extremely precise and with minimal distortion."},"para_2":{"title":"Cross-platform consistency","description":"With the same inputs and plug-in configuration, the same audio processing is performed across supported platforms. This can greatly reduce the time spent developing, mixing, and testing 3D Audio implementations across your project. A mix validated on one platform can therefore translate consistently to other supported platforms using the same configuration."},"para_3":{"title":"Excellent Performance","description":"Designed to take advantage of the features and architectures available in modern CPUs, the plug-in has low CPU requirements. Combined with the ability to further optimize it to fit your game's use cases and requirements, you can integrate it into your game while keeping your performance budgets under control."}}},"threed-bed-audio-mixer":{"shortDescription":"Reduce the number of Audio Objects passing through a bus by mixing some of them.","helmetDescription":"Reduce the number of Audio Objects passing through a bus by mixing some of them."},"time-stretch":{"shortDescription":"Change the speed or duration of an audio signal without affecting its pitch.","helmetDescription":"Change the speed or duration of an audio signal without affecting its pitch."},"tone-generator":{"shortDescription":"Create audio tones and motion effects using different types of waveforms.","helmetDescription":"Create audio tones and motion effects using different types of waveforms."},"tremolo":{"shortDescription":"Modulates the amplitude of the input signal with an unipolar carrier signal.","helmetDescription":"Modulates the amplitude of the input signal with an unipolar carrier signal."}}}`),integrations:UZ,"powered-by-wwise":{"menu-label":"Powered by Wwise","project-image-alt":"Main image for project {{AK_VAR_PROJECT_ID}}",filters:{pbw:{title:"$t(common:labels.filters)"},gameEngine:{title:"Game Engine"},gamePlatform:{title:"Platforms"},gameTags:{title:"Tags"}}},documentation:DZ,pricing:kZ,"register-project":{"menu-label":"Register My Project"},"supported-platforms":{"menu-label":"Compatibilities",bannerV2Title:"Compatibilities",tableDescription:"Select Wwise version, Engines, Plug-ins and Platform to check the compatibility.",footnotes:{android:"Android : Includes Meta Quest series, Android TV, Pico VR, Vive VR",ios:"iOS : Includes iPadOS, tvOS, visionOS",linux:"Linux : Includes Steam Deck",playstation_4:"PS4 : Includes PS4 Pro, PSVR",playstation_5:"PS5 : Includes PSVR2",windows:"Windows : Includes SteamVR, Vive VR, UWP",xbox_one:"Xbox One : Includes Xbox One X",xbox_series_x:"Xbox Series X : Includes Xbox Series S"},tools:{wwiseVersion:"Wwise version",engines:"Engines{{AK_VAR_COUNT}}",plugins:"Plug-ins{{AK_VAR_COUNT}}",platforms:"Platforms{{AK_VAR_COUNT}}",resetFilters:"Reset Filters",versionWarning:"Compatibility is based on {{AK_VAR_WWISE_VERSION}}",contactSales:"<AK_LINK>Contact Sales</AK_LINK> to request an evaluation.",certifiedDeveloperWarning:"* The following platforms require confirmed developer status confirmation."},filters:{instructionsWhenEmpty:"Select at least one Engine or one Plug-in and at least one Platform",reset:"Reset Default Filters",wwiseVersion:{title:"Wwise version"},engines:{title:"Engines{{AK_VAR_COUNT}}"},plugins:{title:"Plug-ins{{AK_VAR_COUNT}}"},platforms:{title:"Platforms{{AK_VAR_COUNT}}"}}},"spatial-audio":JSON.parse(`{"what-it-is":{"title":"What is Wwise Spatial Audio?","description":"Wwise Spatial Audio is a family of built-in features complemented by in-house and 3rd-party plug-ins that seamlessly integrates with the Wwise production workflow. Wwise Spatial Audio encompasses sound propagation, virtual acoustics, and spatially informed audio rendering. It refers to any technology that processes audio with the goal of convincing you that the sounds originate from the world around you.","section-data":{"three-d-audio":{"sectionTitle":"3D Audio","main":{"description":"3D Audio provides increased spatial precision by delivering audio in an intermediary format that includes information from above and below the listener plane. The system's audio endpoint can then convert this format to a binaural mix when using headphones, or an immersive channel-based mix that includes height channels."}},"acoustics":{"sectionTitle":"Acoustics","main":{"description":"Wwise Acoustics models how sound interacts with a virtual environment, simulating room reverberation and physical phenomena such as reflection, diffraction, and transmission.\\n\\nThe Wwise Spatial Audio module exposes a simple, high-level geometry abstraction that includes Rooms, Portals, and Reverb Zones to efficiently model sound propagation of emitters located in other rooms. The main features of room-driven sound propagation are diffraction, coupling, and spatialization of reverbs. It does so by leveraging the tools at the disposal of the sound designer in Wwise, leaving them full control of the resulting transformations to audio."},"block01":{"title":"Propagation","description":"Wwise Acoustics support sound attenuation around and through obstacles via diffraction and transmission. Diffraction occurs when sound waves strike obstacles or edges and bend around them. Transmission describes sound that passes through obstacles such as walls. Developers can use them to convey audio effects such as people talking in an adjacent room or around a corner."},"block02":{"title":"Early Reflections","description":"Early reflections enhance the feeling of physical space in a virtual environment by simulating sounds bouncing off of surfaces like walls or objects: the closer you are to an object, the faster the reflected sound reaches you. Use the Reflect plug-in for Wwise to simulate early reflections in your game environments."},"block03":{"title":"Late Reverb","description":"Late reverb complements early reflections, by defining the effects of different acoustic spaces on sounds. For example, a radio playing in a large room sounds different than it does in a small, enclosed office or an open area. Wwise provides tools to customize reverb effects according to the different environments in your virtual worlds. A variety of reverb plug-ins are available to suit your needs."}}}},"getting-started":{"title":"Getting Started with Wwise Spatial Audio","description":"Wwise offers a variety of tools, samples, and core features that developers can use to implement Spatial Audio in their virtual environments.","section-data":{"three-d-audio":{"sectionTitle":"3D Audio","main":{"description":"<AK_BULLET>Route sounds across the categories of 3D Audio that include Audio Objects, Main Mix, and Passthrough Mix depending on the spatial precision.</AK_BULLET>\\n<AK_BULLET>Profile and Visualize listeners, emitters, and spread with Wwise Authoring's Audio Object 3D Viewer.</AK_BULLET>"}},"acoustics":{"sectionTitle":"Acoustics","main":{"description":"<AK_BULLET>Enhance acoustics with Rooms that define different physical spaces, and Portals that act as the transition regions between Rooms. Use Reverb Zones to define spaces with distinct Reverb qualities.</AK_BULLET>\\n<AK_BULLET>A variety of Wwise plug-ins support early reflections and late reverb.</AK_BULLET>\\n<AK_BULLET>The Wwise SDK and Geometry API provide tools for developers to implement Spatial Audio directly through code.</AK_BULLET><AK_BULLET>In addition to these, Wwise Authoring supports up to fifth-order ambisonics, and includes experimental support for ADM WAV files.</AK_BULLET>"}},"integrations":{"sectionTitle":"Integrations","main":{"description":"<AK_BULLET>Wwise Spatial Audio integrates easily into in-house game engines as well as the world's most popular commercial game engines. Our integrations help you add Wwise to your Unreal or Unity projects with minimal friction.</AK_BULLET>\\n<AK_BULLET>Unreal and Unity sample projects demonstrate a wide variety of Wwise features, including practical Spatial Audio implementations.</AK_BULLET>"}},"more":{"sectionTitle":"Do more with plug-ins!","main":{"description":""}}}},"three-d-audio":{"title":"3D Audio","section-data":{"support-for-3d-audio":{"sectionTitle":"Support for 3D Audio","main":{"description":"Wwise supports 3D Audio across Apple, Android, PlayStation, Xbox, and Windows platforms, thereby providing even more opportunities to create believable and imaginative audio experiences. The Wwise System Audio Device dynamically adapts to the configured endpoint to render audio in the expected output, be it for headphones or speakers."}},"object-based-routing":{"sectionTitle":"Object-based Routing","main":{"description":"The Object-based audio pipeline allows Wwise to deliver individual audio buffers, along with their Metadata, to the platform's audio output or endpoint. Endpoints that support 3D Audio can use this Metadata, which includes a 3D position and orientation, to render their own spatialized effects. This results in the best possible spatial precision in the delivery of the sound because the endpoint is aware of the listening configuration.This allows the endpoint to use the most appropriate rendering method to deliver the final mix over headphones or speakers."}},"ambisonics":{"sectionTitle":"Ambisonics","main":{"description":"The Wwise voice pipeline fully supports ambisonics. Ambisonic sources are preserved in the pipeline, which makes it easy to import ambisonic files and produce ambisonic output on supported platforms. Mono, stereo, and other sources can be mixed to ambisonic format within Wwise, and ambisonic mixes can be output to any user configuration (5.1, 7.1, mono, and so on). This surround sound format produces a regular spherical representation of the sound field surrounding the listener and is agnostic to speaker configurations and binaural filters."},"block01":{"title":"Supported Ambisonic Formats","description":"Wwise supports the following ambisonic formats and ordering:\\n<AK_BULLET>Up to 5th-order component ordering</AK_BULLET><AK_BULLET>Up to 36 channels</AK_BULLET><AK_BULLET>FuMa ordering for 1st- to 3rd-order spheres</AK_BULLET><AK_BULLET>AmbiX (ACN) ordering for 4th- and 5th-order spheres</AK_BULLET><AK_BULLET>Experimental support for Audio Definition Model (ADM) sources</AK_BULLET>"}},"audio-object-viewer":{"sectionTitle":"Audio Object 3D Viewer","main":{"description":"Wwise Authoring includes an Audio Object 3D Viewer, in which you can visualize the positions of Audio Objects relative to their listener positions and orientations. A sphere surrounding the listener represents the amount of spread."},"audio-object-viewer":{"title":"ADM Source Support (Experimental)","description":"Wwise includes experimental support for the import and playback of Audio Definition Model (ADM) WAV files. These sources can contain complete object-based audio scenes, with channel bed and 3D-positioned dynamic objects, providing an alternative for cinematics and immersive music. These files are handled like regular WAV files as part of the audio file import. An ADM file can be used as a Source in the Actor-Mixer Hierarchy or as a Clip in the Interactive Music Hierarchy."}}}},"acoustics":{"title":"Acoustics","section-data":{"sdk":{"sectionTitle":"Wwise Spatial Audio SDK","main":{"description":"The Wwise Spatial Audio SDK enhances the core Sound Engine with advanced spatialization and environmental effects, creating realistic acoustic simulation by modeling sound reflection, diffraction, and transmission. Developers can define rooms with specific acoustic properties and connect them through portals (such as doors or windows) to simulate natural sound propagation. Geometry can also define boundaries like walls and floors, influencing sound behavior as it interacts with obstacles."},"block01":{"title":"Performance","description":"The SDK is optimized for real-time performance across hardware, with adjustable parameters to balance realism and efficiency, supporting smooth integration into diverse game platforms."}},"room-and-portals":{"sectionTitle":"Rooms and Portals API","main":{"description":"The Rooms and Portals API allows developers to create immersive soundscapes by defining rooms with unique reverb and acoustic properties, connected by portals that let sound travel between spaces. This setup simulates real-world transitions as players move through areas, enhancing spatial awareness and game immersion."}},"geometry":{"sectionTitle":"Wwise Geometry API","main":{"description":"The Geometry API supports detailed acoustic simulations, using triangles tagged with surface absorption and transmission properties to model reflections, diffraction, and transmission. Stochastic raytracing calculates sound paths, with diffraction handled directly by the Sound Engine and reflections managed by the Reflect plug-in."}},"game-object-viewer":{"sectionTitle":"Game Object 3D Viewer","main":{"description":"Wwise Authoring includes a Game Object 3D Viewer, which can be used to display the Rooms, Portals, and Geometry of a game environment. Use the Viewer to see how emitters and listeners move relative to one another in real time, while profiling diffraction, reflection, and transmission paths in your virtual environment."}}}},"integrations":{"title":"Integrations","description":"The Wwise Unreal Integration and the Wwise Unity Integration contain everything you need to add Wwise Spatial Audio features to your Unreal and Unity projects. Use the Unity or Unreal editors to design Spatial Audio Rooms and Portals, use different mesh surfaces for different acoustic effects, and monitor reflections, diffraction and transmission in Wwise to test your audio implementations.","additional-description":{"unreal":{"title":"Unreal","description":"See our Unreal Spatial Audio tutorial to get started with Wwise Spatial Audio in Unreal 5."},"unity":{"title":"Unity","description":"See our Unity Spatial Audio tutorial to get started with Wwise Spatial Audio in Unity."}},"section-data":{"wal":{"sectionTitle":"Wwise Audio Lab","main":{"description":"Prototype ideas, evaluate different approaches, and polish the results in a controlled virtual environment.\\n\\nThe Wwise Audio Lab (WAL), developed with Unreal Engine, is an open-source game-like first-person 3D environment that runs on Windows and Mac. It showcases various spatial audio methods and technologies, such as geometry-informed dynamic early reflections, acoustic portals, oriented reverb, and more. Information nodes distributed in the maps identify sound propagation phenomena, and in-game options allow for instant A/B comparisons between various spatial audio approaches."}},"wag":{"sectionTitle":"Wwise Adventure Game","main":{"description":"Experiment with different Wwise features in a playable game, and see the Wwise Unity Integration in action.\\n\\nThe Wwise Adventure Game (WAG), developed in Unity, is a playable third-person game that demonstrates how to use Wwise to implement various sound experiences in a game environment. WAG is a working example of the Wwise Unity Integration that you can experiment with and customize. WAG uses Spatial Audio Acoustics and supports 3D Audio."}},"gyms":{"sectionTitle":"Gyms (Coming Soon!)","main":{"description":"Wwise Gyms for Unity and Unreal are simple scenes that showcase individual features and also act as functional tests you can run to ensure that features continue to work across updates to Wwise, game engine integrations, and custom game integrations. A collection of levels will demonstrate various Acoustic elements you can interact with in a museum-like experience."}}}},"plug-ins":{"title":"Wwise Plug-ins for Spatial Audio","description":"Audiokinetic has developed a series of standard and premium plug-ins that target the specific needs of interactive sound design and enhance the Wwise experience. For Spatial Audio, the Reflect plug-in supports early reflections. Several plug-ins are available to handle late reverb, including AK Convolution and a variety of algorithmic reverb plug-ins.","section-data":{"reflect":{"sectionTitle":"Reflect","main":{"description":"Reflect is a geometry-informed plug-in that dynamically renders early reflections based on the proximity of the listener/emitter to reflective surfaces such as walls, ceilings, and floors. Reflect enhances immersion and the sense of space by blending them with a dynamic environment: audio output changes based on emitter or listener movements and rotation, and reflection sounds change according to different material surfaces (wood, concrete, fabric, and so on). Reflect offers full customization, so you can send images from your own proprietary Spatial Audio setup if desired."}},"convolution-reverb":{"sectionTitle":"AK Convolution ","main":{"description":"With AK Convolution, you can create convincing reverberations based on samples of real acoustic spaces, from small rooms to the large cathedrals. You can use the impulse responses provided by Audiokinetic and its Certified Partners, or import your own in any channel configuration, including ambisonics."}},"algorithmic-reverb":{"sectionTitle":"Algorithmic Reverb","main":{"description":"RoomVerb and Matrix Reverb are algorithmic reverb plug-ins, which use math to describe the acoustics of a space. RoomVerb properties can be edited in real time and some can be mapped to Game Parameters, providing highly realistic results. Matrix Reverb offers an optimized reverb solution that saves on CPU usage but includes fewer controls than RoomVerb."},"ctas":{"cta01":"Learn More about RoomVerb","cta02":"Learn More about Matrix Reverb"}},"other-plugins":{"sectionTitle":"Other Plug-Ins","main":{"description":"In addition, plug-ins developed by our Certified Partners support major industry formats such as Auro 3D and Dolby Atmos. Check out the 3D Audio and Acoustics categories on our <AK_LINK_1>Plug-ins page</AK_LINK_1>."}}}}}`)},sw=Object.freeze(Object.defineProperty({__proto__:null,about:tX,common:gX,community:_X,customers:AX,doNotTranslate:uc,documentation:EX,errors:WX,featureFlags:dc,footer:qX,gen