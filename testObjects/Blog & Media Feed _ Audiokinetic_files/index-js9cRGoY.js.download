my-strata-library":"My Strata Library"},general:{fourOhFour:"404","description-tester":"Description Tester"},"get-started-dropdown":{"download-wwise":"$t(audiokineticLauncher.download)",pricing:"Pricing","licensing-faq":"Licensing FAQ"},"signup-login":{modeTitle:{SIGN_UP:"Create Account",RESET_PASSWORD:"Reset Password",SIGN_IN:"Sign in",contactForm:"Please sign in to proceed"},email:"Email",password:"Password","do-you-have-an-account":"Already have an account?","btn-login":"Sign In","btn-logout":"Sign Out","btn-reset-pw":"Reset Password","sign-up-confirmation":{title:"Thank You For Signing Up",description:`Get complete access, as well as an enhanced user experience by securing your Audiokinetic account. You can easily do that by checking your email for our confirmation request, and clicking the link to verify your email address!

Note that if you don’t verify your account, it will be deleted on {{nextMonth}}`},"reset-password-confirmation":{title:"Email Sent",description:`We've sent you an email at
