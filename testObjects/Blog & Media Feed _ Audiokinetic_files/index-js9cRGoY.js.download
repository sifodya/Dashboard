:"必须填写“作品集标题”字段"},description:{required:"必须填写“作品集描述”字段"},url:{invalid:"输入有效的 YouTube 或 Soundcloud URL"}},portfolioTypes:{youtube:"YouTube",soundcloud:"SoundCloud",file:"文件"}},tNt={title:"项目","title-singular":"项目","no-content":"您不是任何已发布项目的成员。","has-content":"<AK_FAT_BLACK>{{AK_NUMBER_OF_PROJECTS}}</AK_FAT_BLACK> 个确认的 Wwise 项目"},iNt={title:"出版物","title-singular":"出版物","no-content":"您的个人简介中目前没有列明任何出版物信息。",labels:{title:"出版物标题",url:"出版物外链 URL",publishedDate:"发布日期",description:"描述","add-new-item":"介绍一下您的<AK_BLACK>出版物</AK_BLACK>，并添加到个人简介中"},formLabels:{title:{label:"职位",placeHolder:"您如何命名自己的著作？"},publicationUrl:{label:"出版物 URL（请包含 https://）",placeHolder:"在哪里可以查看该著作？"},publishedDate:{label:"发布日期",placeHolder:"您是在什么时候发布的？"},description:{label:"描述",placeHolder:"可否跟我们详细地说说？"}}},nNt={title:"语言",editing:{defaultItem:"语言",newItem:"新增语言信息",editItem:"编辑语言信息"},"title-singular":"语言","no-content":"您的个人简介中目前没有分享任何语言能力信息。",validation:{language:{required:"必须填写“语言”字段"},languageCode:{required:"必须填写“语言”字段"},proficiency:{required:"必须填写“熟练程度”字段"}},labels:{language:"语言",proficiency:"熟练程度",description:"描述","add-new-item":"向您的个人简历添加新的<AK_BLACK>语言</AK_BLACK>信息"},formLabels:{languageCode:{label:"语言",placeHolder:"您使用哪种语言交谈/阅读/书写？"},language:{label:"语言",placeHolder:"您使用哪种语言交谈/阅读/书写？"},proficiency:{label:"熟练程度",placeHolder:"您的熟练程度如何？"},description:{label:"描述",placeHolder:"您是在哪里学习的？"}},"spoken-languages":{FRA:"法语",ENG:"英语",ARA:"阿拉伯语",BEN:"孟加拉语",DEU:"德语",HIN:"印地语",IND:"印度尼西亚语",JPN:"日语",PAN:"旁遮普语",POR:"葡萄牙语",SPA:"西班牙语",UKR:"乌克兰语",URD:"乌尔都语",ZHO:"中文",RUS:"俄语"},"languages-proficiency":{elementary:"可以简单地沟通交流",limited:"基本能在工作中运用",professional:"能在工作中熟练运用",fullPro:"能在工作中自如运用",native:"达到母语或双语水准"}},aNt={module:jOt,tools:FOt,avatar:GOt,intro:YOt,about:JOt,experiences:XOt,education:QOt,certifications:ZOt,portfolio:eNt,projects:tNt,publications:iNt,languages:nNt,"profile-management":{"account-creation-thank-you":{title:"感谢您在 Audiokinetic.com 创建帐户！",description:"请查看邮件来完成帐户创建并解锁所有可用功能"},"profile-new-password":"设置新的帐户密码","profile-new-email":"设置新的帐户电子邮件地址","basic-information":"基本信息","resend-confirmation-email":"重新发送确认邮件","menu-label":"资料确认",bannerTagline:"资料确认","set-new-password":{title:"重置密码",description:"您即将重置与 <b>{{AK_ACCOUNT_EMAIL_ADDRESS}}</b> 关联的帐户的密码",ctaButton:"重置密码",formLabels:{password:{label:"新密码",placeHolder:"新密码"},confirmPassword:{label:"确认新密码",placeHolder:"确认新密码"}}},"set-new-email":{title:"更新电子邮件地址","description-1":`您将要更新与您的 Audiokinetic 账户关联的电子邮件地址。
